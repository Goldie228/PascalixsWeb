<div class="min-h-screen bg-[#121212] flex flex-col items-center justify-center p-6 text-center">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8">
      <svg class="w-24 h-24 mx-auto text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>

    <!-- Основное сообщение -->
    <div class="bg-[#1A1A1A] rounded-xl p-8 md:p-10 border border-[#3A3A3A] mb-8">
      <h1 class="text-2xl md:text-3xl font-bold text-white mb-6">
        <%= t('account.email_verification.title') %>
      </h1>
      
      <div class="text-gray-300 mb-6 leading-relaxed">
        <%= t('account.email_verification.message') %>
        <div class="mt-3 text-lg font-semibold text-amber-400"><%= @new_email %></div>
      </div>

      <div class="bg-[#2b2b2b] p-4 rounded-lg border border-amber-400/20 mb-6">
        <div class="text-amber-400 font-medium mb-2">
          <%= t('account.email_verification.next_steps_title') %>
        </div>
        <div class="text-white/90 text-left text-sm space-y-2">
          <% t('account.email_verification.next_steps').each_with_index do |step, index| %>
            <div class="flex items-start">
              <div class="text-amber-400 mr-2"><%= index + 1 %>.</div>
              <div><%= step %></div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="text-gray-400 text-sm">
        <%= t('account.email_verification.note') %>
      </div>
    </div>

    <!-- Кнопки действий -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to t('account.email_verification.account_button'), user_account_path, class: "btn bg-amber-400 hover:bg-amber-300 border-none text-[#1a1a1a] font-medium py-3 px-6 rounded transition" %>
    </div>
  </div>
</div>
