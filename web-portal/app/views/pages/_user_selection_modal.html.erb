<%= render 'shared/payment_modal' %>
<dialog id="user_selection_modal" class="modal">
  <div class="modal-box max-w-2xl w-full bg-[#1A1A1A] rounded-lg shadow-lg relative overflow-y-auto max-h-[80vh]">
    <div class="flex flex-col space-y-6 px-8 py-6">
      <!-- Заголовок -->
      <div class="text-center mb-4">
        <h2 class="text-2xl font-bold text-amber-400 mb-2"><%= t('views.users.selection.title') %></h2>
        <p class="text-[#A0A0A0]"><%= t('views.users.selection.description') %></p>
      </div>
      
      <!-- Поиск -->
      <div class="relative">
        <input 
          id="user_search"
          type="text" 
          placeholder="<%= t('views.users.selection.search_placeholder') %>" 
          class="input input-bordered w-full bg-[#2D2D2D] border-[#444] pl-10"
          oninput="searchUsers()">
        <svg class="absolute left-3 top-3 w-5 h-5 text-[#A0A0A0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      
      <!-- Список пользователей -->
      <div id="users_list" class="space-y-3">
        <!-- Сообщение при отсутствии результатов -->
        <div id="no_users_message" class="hidden text-center py-8">
          <p class="text-[#A0A0A0]"><%= t('views.users.selection.no_users_found') %></p>
        </div>
      </div>
      
      <!-- Кнопка загрузки еще -->
      <button 
        id="load_more_btn"
        onclick="loadMoreUsers()"
        class="btn btn-outline border-amber-400 text-amber-400 hover:bg-amber-400/10 mt-4 hidden">
        <%= t('views.users.selection.load_more') %>
      </button>
      
      <!-- Индикатор загрузки -->
      <div id="loading_indicator" class="hidden flex justify-center py-4">
        <div class="animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-amber-400"></div>
      </div>
    </div>
  </div>
  
  <!-- Фон -->
  <form method="dialog" class="modal-backdrop">
    <button><%= t('views.users.selection.close') %></button>
  </form>
</dialog>
<script type="text/javascript">
  // Состояние загрузки
  let isLoading = false;
  
  // Поиск пользователей с задержкой
  let searchTimeout;
  function searchUsers() {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      loadUsers(1);
    }, 300);
  }
  
  // Загрузка пользователей
  function loadUsers(page = 1) {
    if (isLoading) return;
    
    const searchInput = document.getElementById('user_search');
    const searchTerm = searchInput.value.trim();
    
    isLoading = true;
    document.getElementById('loading_indicator').classList.remove('hidden');
    document.getElementById('no_users_message').classList.add('hidden');
    
    const url = `/get_not_public_users?page=${page}&search=${encodeURIComponent(searchTerm)}`;
    
    fetch(url, {
      credentials: 'include',
      headers: {
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      }
    })
    .then(response => {
      if (!response.ok) throw new Error(I18n.t('views.users.selection.loading_error'));
      return response.json();
    })
    .then(data => {
      renderUsers(data.users, page);
      document.getElementById('load_more_btn').style.display = 
        data.has_more ? 'block' : 'none';
      
      // Показать сообщение если нет пользователей
      if (page === 1 && data.users.length === 0) {
        document.getElementById('no_users_message').classList.remove('hidden');
      }
    })
    .catch(error => {
      console.error(I18n.t('views.users.selection.console_error'), error);
      document.getElementById('users_list').innerHTML = `
        <div class="text-center py-4 text-red-400">
          ${I18n.t('views.users.selection.error_message')}${error.message}
        </div>
      `;
    })
    .finally(() => {
      isLoading = false;
      document.getElementById('loading_indicator').classList.add('hidden');
    });
  }
  
  // Отрисовка пользователей
  function renderUsers(users, page) {
    const container = document.getElementById('users_list');
    
    if (page === 1) {
      container.innerHTML = '';
    }
    
    if (users.length === 0 && page === 1) {
      return; // Сообщение покажет loadUsers
    }
    
    users.forEach(user => {
      const userEl = document.createElement('div');
      userEl.className = 'flex items-center gap-4 p-3 bg-[#2D2D2D] rounded-lg hover:bg-[#3A3A3A] cursor-pointer transition-all';
      userEl.onclick = () => selectUser(user);
      
      // Fallback для аватарки
      const avatarUrl = user.avatar_url || '<%= asset_path("steve.webp") %>';
      
      userEl.innerHTML = `
        <img src="${avatarUrl}" 
             alt="${user.nickname}" 
             class="w-10 h-10 rounded-full object-cover"
             onerror="this.onerror=null; this.src='<%= asset_path("steve.webp") %>';">
        <div class="flex-1 min-w-0">
          <p class="text-white font-medium truncate">${user.nickname}</p>
          <p class="text-[#A0A0A0] text-sm truncate">${user.uuid}</p>
        </div>
      `;
      
      container.appendChild(userEl);
    });
  }
</script>
