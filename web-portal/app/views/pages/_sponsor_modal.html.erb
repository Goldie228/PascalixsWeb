<%= render 'shared/payment_modal' %> <!-- Модалка для спонсорства -->
<dialog id="sponsor_modal" class="modal">
  <div class="modal-box max-w-2xl w-full bg-[#1A1A1A] rounded-lg shadow-lg relative overflow-y-auto">
    <!-- Кнопка закрытия -->
    <form method="dialog">
      <button class="btn btn-circle btn-ghost absolute right-6 top-6 p-2 hover:bg-amber-400/20 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" 
             class="w-6 h-6 text-amber-400 hover:text-amber-300 transition-colors" 
             fill="none" 
             viewBox="0 0 24 24" 
             stroke="currentColor">
          <path stroke-linecap="round" 
                stroke-linejoin="round" 
                stroke-width="2" 
                d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </form>
    
    <div class="flex flex-col space-y-6 px-8 py-6">
      <!-- Заголовок -->
      <div class="text-center mb-6">
        <h2 class="text-3xl font-bold text-amber-400 mb-4"><%= t('views.shared.sponsor_modal.title') %></h2>
        <div class="h-1 w-1/3 bg-amber-400 mx-auto rounded"></div>
        <p class="text-[#A0A0A0] mt-4"><%= t('views.shared.sponsor_modal.subtitle') %></p>
      </div>
      
      <!-- Информация о спонсорстве -->
      <div class="bg-[#2D2D2D] p-5 rounded-lg">
        <h3 class="text-xl font-semibold text-amber-400 mb-3"><%= t('views.shared.sponsor_modal.benefits_title') %></h3>
        <div class="flex items-start gap-4 mb-4">
          <%= image_tag "donate/sponsor.png", class: "w-16 h-16" %>
          <div>
            <p class="text-white font-medium"><%= t('views.shared.sponsor_modal.benefits_main') %></p>
            <p class="text-[#A0A0A0]"><%= t('views.shared.sponsor_modal.benefits_sub') %></p>
          </div>
        </div>
        
        <ul class="space-y-3 text-[#A0A0A0] ml-2">
          <li class="flex items-start gap-3">
            <div class="mt-1 w-5 h-5 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><span class="font-medium text-white"><%= t('views.shared.sponsor_modal.special_status') %></span> <%= t('views.shared.sponsor_modal.special_status_location') %></span>
          </li>
          <li class="flex items-start gap-3">
            <div class="mt-1 w-5 h-5 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><span class="font-medium text-white"><%= t('views.shared.sponsor_modal.mention') %></span> <%= t('views.shared.sponsor_modal.mention_location') %></span>
          </li>
        </ul>
      </div>
      
      <!-- Информация о помощи проекту -->
      <div class="bg-gradient-to-br from-[#1f1f1f] to-[#0a0a0a] p-5 rounded-xl border border-amber-400/30">
        <h3 class="text-xl font-semibold text-amber-400 mb-3"><%= t('views.shared.sponsor_modal.funds_title') %></h3>
        <p class="text-[#A0A0A0] mb-4">
          <%= t('views.shared.sponsor_modal.funds_description') %>
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div class="flex items-center gap-3 p-3 bg-[#252525] rounded-lg">
            <div class="w-10 h-10 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
              </svg>
            </div>
            <span class="text-white"><%= t('views.shared.sponsor_modal.server_upgrade') %></span>
          </div>
          
          <div class="flex items-center gap-3 p-3 bg-[#252525] rounded-lg">
            <div class="w-10 h-10 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <span class="text-white"><%= t('views.shared.sponsor_modal.new_features') %></span>
          </div>
        </div>
      </div>
      
      <!-- Кнопка подтверждения -->
      <button 
        onclick="confirmSponsorship()"
        class="btn btn-warning w-full py-3 text-lg font-semibold flex items-center justify-center gap-2">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <%= t('views.shared.sponsor_modal.become_sponsor') %>
      </button>
    </div>
  </div>
  
  <!-- Фон -->
  <form method="dialog" class="modal-backdrop">
    <button><%= t('views.shared.sponsor_modal.close') %></button>
  </form>
</dialog>
<script type="text/javascript">
  // Функция для открытия модалки спонсорства
  function openSponsorModal() {
    const modal = document.getElementById('sponsor_modal');
    if (modal) modal.showModal();
  }
  // Подтверждение спонсорства
  function confirmSponsorship() {
    // Проверяем, загружен ли currentUserId
    const currentUserId = window.currentUserId;
    if (!currentUserId) {
      console.error('User ID not available');
      return;
    }
    
    // Вызываем платежную функцию
    if (typeof openPurchaseModal === 'function') {
      openPurchaseModal(
        'sponsor', 
        currentUserId,
        currentUserId // Для спонсорства получатель = покупатель
      );
      
      // Закрываем модалку
      const sponsorModal = document.getElementById('sponsor_modal');
      if (sponsorModal) sponsorModal.close();
    } else {
      console.error('openPurchaseModal is not defined');
      alert(I18n.t('views.shared.sponsor_modal.payment_unavailable'));
    }
  }
  // Инициализация
  document.addEventListener('DOMContentLoaded', () => {
    // Убедимся, что currentUserId установлен
    if (!window.currentUserId) {
      window.currentUserId = document.body.dataset.currentUserId || '<%= current_user&.id %>';
    }
    
    // Добавляем глобальные функции
    window.openSponsorModal = openSponsorModal;
    window.confirmSponsorship = confirmSponsorship;
  });
</script>
