
<%= render 'shared/navbar' %>

<!-- Основной фон проекта -->
<div class="min-h-screen text-white font-sans" data-controller="gallery">
    
    <!-- Заголовок -->
    <h1 class="text-4xl font-bold text-center mt-12 mb-8"><%= t('views.gallery.title') %></h1>

    <!-- ПАНЕЛЬ УПРАВЛЕНИЯ (Всегда видна) -->
    <div id="galleryControlPanel" class="flex flex-col md:flex-row justify-between items-stretch md:items-center gap-3 md:gap-6 mb-8 px-4 md:px-20 w-full sticky top-15 md:top-30 z-20 bg-[#121212] py-4">
        
        <!-- Сортировка (Стиль Players) -->
        <div class="w-full md:w-auto">
            <div class="form-control">
                <div class="dropdown dropdown-bottom w-full md:w-64">
                    <label tabindex="0" data-action="click->gallery#toggleSortDropdown" class="btn bg-[#121212] border border-white/10 text-white hover:bg-[#1a1a1a] hover:border-amber-400 flex justify-between items-center h-full py-3 px-4 transition-all duration-200">
                        <span class="text-sm md:text-base font-medium" id="currentSortLabel"><%= t('views.gallery.sort.newest') %></span>
                        <svg class="w-4 h-4 text-amber-400 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </label>
                    <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-lg bg-[#2D2D2D] rounded-box w-full mt-1 border border-white/10">
                        <li><a data-action="gallery#setSort" data-sort-value="newest" class="text-white hover:bg-amber-400 hover:text-black transition"><%= t('views.gallery.sort.newest') %></a></li>
                        <li><a data-action="gallery#setSort" data-sort-value="oldest" class="text-white hover:bg-amber-400 hover:text-black transition"><%= t('views.gallery.sort.oldest') %></a></li>
                        <li><a data-action="gallery#setSort" data-sort-value="az" class="text-white hover:bg-amber-400 hover:text-black transition"><%= t('views.gallery.sort.az') %></a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Поиск (Стиль Players) -->
        <div class="w-full md:w-auto mt-2 md:mt-0">
            <div class="relative w-full md:w-[300px]">
                <input
                    type="text"
                    id="gallerySearch"
                    data-action="input->gallery#debouncedSearch"
                    placeholder="<%= t('views.gallery.search.placeholder') %>"
                    class="input w-full bg-[#2D2D2D] text-white placeholder-[#A0A0A0] border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition pl-10 py-3 rounded-lg"
                >
                <div class="absolute left-3 top-1/2 transform -translate-y-1/2 pointer-events-none">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- КОНТЕНТ -->
    <div class="px-4 md:px-20 pb-20 min-h-screen">
        
        <!-- СПИСОК АЛЬБОМОВ -->
        <div id="albumsContainer">
            <!-- Загрузка -->
            <div id="albumsLoader" class="w-full flex justify-center py-20 hidden">
                <div class="w-12 h-12 border-4 border-[#1A1A1A] border-t-amber-400 rounded-full animate-spin"></div>
            </div>

            <!-- Сетка Альбомов -->
            <div id="albumsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Карточки рендерятся тут -->
            </div>

            <!-- Пагинация Альбомов -->
            <div id="albumsPagination" class="flex justify-center items-center gap-2 mt-12 flex-wrap"></div>
        </div>

        <!-- ПРОСМОТР АЛЬБОМА (Скрыт по умолчанию) -->
        <div id="albumViewContainer" class="hidden">
            
            <!-- Навигация: Назад -->
            <div class="mb-8">
                <button data-action="gallery#closeAlbum" class="flex items-center gap-2 text-gray-400 hover:text-white transition font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    <%= t('views.gallery.back') %>
                </button>
            </div>

            <!-- Заголовок Альбома -->
            <div class="bg-[#1A1A1A] rounded-xl p-8 mb-10">
                <h2 id="albumTitle" class="text-3xl md:text-4xl font-bold text-white mb-2"></h2>
                <p id="albumDescription" class="text-gray-400 text-lg"></p>
                <div class="mt-4 flex gap-4 text-sm text-gray-500">
                    <span id="albumDate" class="flex items-center gap-1"></span>
                    <span>•</span>
                    <span id="albumCount"></span>
                </div>
            </div>

            <!-- Сетка Фотографий (Social Media Style: Masonry + Captions) -->
            <div id="photosGrid" class="columns-1 sm:columns-2 md:columns-3 xl:columns-4 gap-6 space-y-6">
                <!-- Фото рендерятся тут -->
            </div>
        </div>
    </div>

    <!-- LIGHTBOX (Минималистичный) -->
    <div id="lightbox" class="fixed inset-0 z-50 bg-black/95 hidden flex justify-center items-center backdrop-blur-sm">
        <!-- Кнопка закрытия -->
        <button data-action="gallery#closeLightbox" class="absolute top-4 right-4 text-white/70 hover:text-amber-400 z-50 p-2 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <!-- Навигация стрелки -->
        <button data-action="gallery#prevPhoto" class="absolute left-4 text-white/50 hover:text-amber-400 z-50 p-4 transition-colors hidden md:block">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </button>
        <button data-action="gallery#nextPhoto" class="absolute right-4 text-white/50 hover:text-amber-400 z-50 p-4 transition-colors hidden md:block">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </button>

        <!-- Изображение -->
        <div class="relative max-h-[85vh] max-w-[90vw]">
            <img id="lightboxImage" src="" alt="<%= t('views.gallery.lightbox.full_view') %>" class="max-h-[85vh] max-w-[90vw] object-contain shadow-2xl rounded-sm">
            
            <!-- Тут выводим название фото, если оно есть -->
            <div id="lightboxCaption" class="hidden absolute bottom-4 left-0 right-0 text-center">
                <span class="bg-black/60 text-white px-4 py-2 rounded-lg text-sm backdrop-blur-md"></span>
            </div>
        </div>
        
        <!-- Счетчик страниц -->
        <div class="absolute bottom-4 left-4 text-gray-400 text-xs font-mono">
            <span id="lightboxCounter"></span>
        </div>
    </div>
</div>

<%= render 'shared/footer' %>
