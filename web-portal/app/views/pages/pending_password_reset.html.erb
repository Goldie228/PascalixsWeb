<div class="min-h-screen bg-[#121212] flex flex-col items-center justify-center p-6 text-center">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8">
      <svg class="w-24 h-24 mx-auto text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
    </div>

    <!-- Основное сообщение -->
    <div class="bg-[#1A1A1A] rounded-xl p-8 md:p-10 border border-[#3A3A3A] mb-8 shadow-xl">
      <h1 class="text-2xl md:text-3xl font-bold text-white mb-6">
        <%= t('views.password_reset.initiated.title') %>
      </h1>
      
      <div class="text-gray-300 mb-6 leading-relaxed">
        <%= t('views.password_reset.initiated.description') %>
        <div class="mt-3 text-lg font-semibold text-amber-400"><%= current_user.discord_account.email %></div>
      </div>

      <div class="bg-[#2b2b2b] p-4 rounded-lg border border-amber-400/20 mb-6">
        <div class="text-amber-400 font-medium mb-2">
          <%= t('views.password_reset.initiated.steps_title') %>
        </div>
        <div class="text-white/90 text-left text-sm space-y-2">
          <div class="flex items-start">
            <div class="text-amber-400 mr-2">1.</div>
            <div><%= t('views.password_reset.initiated.steps.step1') %></div>
          </div>
          <div class="flex items-start">
            <div class="text-amber-400 mr-2">2.</div>
            <div><%= t('views.password_reset.initiated.steps.step2') %></div>
          </div>
          <div class="flex items-start">
            <div class="text-amber-400 mr-2">3.</div>
            <div><%= t('views.password_reset.initiated.steps.step3') %></div>
          </div>
          <div class="flex items-start">
            <div class="text-amber-400 mr-2">4.</div>
            <div><%= t('views.password_reset.initiated.steps.step4') %></div>
          </div>
        </div>
      </div>

      <div class="text-gray-400 text-sm">
        <%= t('views.password_reset.initiated.security_note') %>
      </div>
    </div>

    <!-- Кнопки действий -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to t('views.password_reset.initiated.back_to_profile'), user_account_path, class: "btn bg-amber-400 hover:bg-amber-300 border-none text-[#1a1a1a] font-medium py-3 px-6 rounded transition transform hover:-translate-y-0.5 duration-300" %>
    </div>
  </div>
</div>
