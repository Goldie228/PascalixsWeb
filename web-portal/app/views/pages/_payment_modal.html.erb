<%= render 'shared/payment_modal' %> <dialog id="purchase_modal_123" class="modal">
  <div class="modal-box max-w-2xl w-full bg-[#1A1A1A] rounded-lg shadow-lg relative h-auto overflow-y-auto">
    <!-- Кнопка закрытия -->
    <form method="dialog">
      <button class="btn btn-circle btn-ghost absolute right-6 top-6 p-2 hover:bg-amber-400/20 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" 
             class="w-6 h-6 text-amber-400 hover:text-amber-300 transition-colors" 
             fill="none" 
             viewBox="0 0 24 24" 
             stroke="currentColor">
          <path stroke-linecap="round" 
                stroke-linejoin="round" 
                stroke-width="2" 
                d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </form>
    
    <!-- Основное содержимое -->
    <div class="flex flex-col space-y-6 px-8 py-6">
      <!-- Заголовок с изображением ключа -->
      <div class="flex flex-col items-center mb-6 mt-4">
        <%= image_tag "donate/key.png", alt: t('views.shared.donate_modal.access_key_alt'), class: "w-24 h-24 mb-4" %>
        <h2 class="text-3xl font-bold text-center text-amber-400 mb-2"><%= t('views.shared.donate_modal.title') %></h2>
        <div class="h-1 w-[70%] bg-amber-400 mx-auto rounded mb-2"></div>
        <p class="text-[#A0A0A0] mt-2 text-center"><%= t('views.shared.donate_modal.description') %></p>
      </div>
      
      <!-- Якорь для доната -->
      <div class="bg-gradient-to-r from-amber-400/10 to-transparent p-4 border-l-4 border-amber-400 rounded-lg">
        <div class="flex items-start gap-3">
          <div class="bg-amber-400/20 p-2 rounded-lg flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-semibold text-amber-400 mb-1"><%= t('views.shared.donate_modal.support_title') %></h3>
            <p class="text-white">
              <%= raw t('views.shared.donate_modal.support_description') %>
            </p>
          </div>
        </div>
      </div>
      
      <!-- Преимущества -->
      <div class="mt-4">
        <h3 class="text-xl font-semibold text-amber-400 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <%= t('views.shared.donate_modal.benefits_title') %>
        </h3>
        <ul class="space-y-3 text-[#A0A0A0]">
          <li class="flex items-start gap-3">
            <div class="mt-1 w-5 h-5 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><span class="font-medium text-white"><%= t('views.shared.donate_modal.full_participation') %></span> - <%= t('views.shared.donate_modal.full_participation_description') %></span>
          </li>
          <li class="flex items-start gap-3">
            <div class="mt-1 w-5 h-5 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><span class="font-medium text-white"><%= t('views.shared.donate_modal.real_influence') %></span> - <%= t('views.shared.donate_modal.real_influence_description') %></span>
          </li>
          <li class="flex items-start gap-3">
            <div class="mt-1 w-5 h-5 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><span class="font-medium text-white"><%= t('views.shared.donate_modal.economic_freedom') %></span> - <%= t('views.shared.donate_modal.economic_freedom_description') %></span>
          </li>
          <li class="flex items-start gap-3">
            <div class="mt-1 w-5 h-5 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><span class="font-medium text-white"><%= t('views.shared.donate_modal.unique_events') %></span> - <%= t('views.shared.donate_modal.unique_events_description') %></span>
          </li>
          <li class="flex items-start gap-3">
            <div class="mt-1 w-5 h-5 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><span class="font-medium text-white"><%= t('views.shared.donate_modal.priority_status') %></span> - <%= t('views.shared.donate_modal.priority_status_description') %></span>
          </li>
        </ul>
      </div>
      
      <!-- Информация о донате -->
      <div class="mt-6 bg-[#2D2D2D] p-5 rounded-lg">
        <h3 class="text-xl font-semibold text-amber-400 mb-3 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
          </svg>
          <%= t('views.shared.donate_modal.donation_usage_title') %>
        </h3>
        <div class="mt-4 space-y-4">
          <div class="flex items-start gap-4">
            <div class="mt-0.5 w-6 h-6 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
              </svg>
            </div>
            <div>
              <h4 class="font-medium text-white"><%= t('views.shared.donate_modal.server_stability') %></h4>
              <p class="text-sm text-[#A0A0A0] mt-1">
                <%= t('views.shared.donate_modal.server_stability_description') %>
              </p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="mt-0.5 w-6 h-6 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <h4 class="font-medium text-white"><%= t('views.shared.donate_modal.game_mechanics') %></h4>
              <p class="text-sm text-[#A0A0A0] mt-1">
                <%= t('views.shared.donate_modal.game_mechanics_description') %>
              </p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="mt-0.5 w-6 h-6 rounded-full bg-amber-400/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <div>
              <h4 class="font-medium text-white"><%= t('views.shared.donate_modal.regular_updates') %></h4>
              <p class="text-sm text-[#A0A0A0] mt-1">
                <%= t('views.shared.donate_modal.regular_updates_description') %>
              </p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Кнопка с акцентом -->
      <div class="mt-4 text-center">
        <button class="btn btn-warning rounded-full text-[#1A1A1A] px-12 py-3 text-lg font-semibold hover:bg-[#FFC400] shadow-lg hover:shadow-xl transition duration-200 ease-in-out flex items-center gap-2 mx-auto"
                onclick="openPurchaseModal()">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5 2a2 2 0 00-2 2v14l3.5-2 3.5 2 3.5-2 3.5 2V4a2 2 0 00-2-2H5zm2.5 3a1.5 1.5 0 100 3 1.5 1.5 0 000-3zm6.207.293a1 1 0 00-1.414 0l-6 6a1 1 0 101.414 1.414l6-6a1 1 0 000-1.414zM12.5 10a1.5 1.5 0 100 3 1.5 1.5 0 000-3z" clip-rule="evenodd" />
          </svg>
          <%= t('views.shared.donate_modal.support_button') %>
        </button>
        
        <p class="mt-3 text-sm text-[#A0A0A0]">
          <%= raw t('views.shared.donate_modal.support_thanks') %>
        </p>
      </div>
      
      <!-- Техподдержка -->
      <div class="text-center border-t border-[#2D2D2D] pt-4 mt-2">
        <p class="text-[#A0A0A0] text-sm">
          <%= raw t('views.shared.donate_modal.support_question') %>
        </p>
      </div>
    </div>
  </div>
  
  <!-- Фон -->
  <form method="dialog" class="modal-backdrop bg-black/80">
    <button></button>
  </form>
</dialog>

<script type="text/javascript">
  function openModal() {
    const modal = document.getElementById('purchase_modal_123');
    if (modal) modal.showModal();
  }
  
  function closeSecondModal() {
    const modal = document.getElementById('second_modal');
    if (modal) modal.close();
  }
</script>
