window.currentAvatarStatus = 'none';

// Функция для обновления аватаров в кружках предпросмотра
function updateAvatarPreviews(avatarUrl) {
  if (!avatarUrl || avatarUrl === 'https://ui-avatars.com/api/?name=User&background=333&color=fff') {
    const placeholderUrl = 'https://ui-avatars.com/api/?name=User&background=333&color=fff';
    document.getElementById('current-avatar-small').src = placeholderUrl;
    document.getElementById('current-avatar-medium').src = placeholderUrl;
    document.getElementById('current-avatar-large').src = placeholderUrl;
    return;
  }

  const img = new Image();
  
  img.onload = function() {
    document.getElementById('current-avatar-small').src = avatarUrl;
    document.getElementById('current-avatar-medium').src = avatarUrl;
    document.getElementById('current-avatar-large').src = avatarUrl;
    
    if (window.currentAvatarBlobUrl && window.currentAvatarBlobUrl !== avatarUrl) {
      URL.revokeObjectURL(window.currentAvatarBlobUrl);
    }
    window.currentAvatarBlobUrl = avatarUrl;
  };
  
  img.onerror = function() {
    const placeholderUrl = 'https://ui-avatars.com/api/?name=User&background=333&color=fff';
    document.getElementById('current-avatar-small').src = placeholderUrl;
    document.getElementById('current-avatar-medium').src = placeholderUrl;
    document.getElementById('current-avatar-large').src = placeholderUrl;
  };
  
  img.src = avatarUrl;
}

// Функция для получения CSRF-токена
function getCsrfToken() {
  let token = document.querySelector('meta[name="csrf-token"]')?.content;
  return token;
}

// Функция для обновления статуса аватара
function updateAvatarStatus(status) {
  const statusData = avatarStatuses[status] || avatarStatuses.none;
  
  const statusIndicator = document.getElementById('avatar-status-indicator');
  const statusText = document.getElementById('avatar-status-text');
  const statusInfo = document.getElementById('avatar-status-info');
  
  if (statusIndicator) statusIndicator.className = `w-3 h-3 rounded-full ${statusData.color}`;
  if (statusText) statusText.textContent = statusData.text;
  if (statusInfo) statusInfo.textContent = statusData.info;
}

