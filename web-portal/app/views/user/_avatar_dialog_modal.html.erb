<dialog id="avatar_modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="avatar-modal-title">
  <div class="scale-in">
    <div class="flex items-center justify-center min-h-screen bg-black/50">
      <div class="modal-box max-w-2xl w-full bg-[#1A1A1A] rounded-lg shadow-lg relative h-auto overflow-y-auto">
        <!-- Кнопка закрытия -->
        <form method="dialog" class="absolute right-6 top-6 z-10" form="avatar_modal">
          <button class="btn btn-circle btn-ghost text-amber-400 hover:bg-amber-400/20" aria-label="<%= t('views.users.avatar_modal.close_modal') %>">
            <svg xmlns="http://www.w3.org/2000/svg" 
                 class="w-6 h-6" 
                 fill="none" 
                 viewBox="0 0 24 24" 
                 stroke="currentColor">
              <path stroke-linecap="round" 
                    stroke-linejoin="round" 
                    stroke-width="2" 
                    d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </form>
        
        <!-- Основное содержимое -->
        <div class="flex flex-col space-y-6">
          <!-- Заголовок -->
          <div class="flex flex-col items-center mb-6 mt-4">
            <h2 id="avatar-modal-title" class="text-3xl font-bold text-center text-amber-400 mb-2"><%= t('views.users.avatar_modal.title') %></h2>
            <p class="text-gray-300 text-center"><%= t('views.users.avatar_modal.subtitle') %></p>
          </div>
          
          <!-- Текущий аватар и статус -->
          <div class="bg-[#2E2E2E] rounded-lg p-5">
            <h3 class="text-xl font-semibold text-amber-400 mb-3 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
              </svg>
              <%= t('views.users.avatar_modal.current_avatar_section') %>
            </h3>
            
            <div class="flex flex-col items-center">
              <!-- Аватар в разных размерах -->
              <div class="flex flex-wrap justify-center gap-4 mb-4">
                <div class="flex flex-col items-center">
                  <div class="w-16 h-16 rounded-full bg-gray-700 overflow-hidden border-2 border-gray-600">
                    <img id="current-avatar-small" src="#" alt="<%= t('views.users.avatar_modal.current_avatar_alt') %>" class="w-full h-full object-cover">
                  </div>
                  <span class="text-xs text-gray-400 mt-1"><%= t('views.users.avatar_modal.size_small') %></span>
                </div>
                <div class="flex flex-col items-center">
                  <div class="w-24 h-24 rounded-full bg-gray-700 overflow-hidden border-2 border-amber-400">
                    <img id="current-avatar-medium" src="#" alt="<%= t('views.users.avatar_modal.current_avatar_alt') %>" class="w-full h-full object-cover">
                  </div>
                  <span class="text-xs text-gray-400 mt-1"><%= t('views.users.avatar_modal.size_medium') %></span>
                </div>
                <div class="flex flex-col items-center">
                  <div class="w-32 h-32 rounded-full bg-gray-700 overflow-hidden border-2 border-gray-600">
                    <img id="current-avatar-large" src="#" alt="<%= t('views.users.avatar_modal.current_avatar_alt') %>" class="w-full h-full object-cover">
                  </div>
                  <span class="text-xs text-gray-400 mt-1"><%= t('views.users.avatar_modal.size_large') %></span>
                </div>
              </div>
              
              <!-- Статус аватара -->
              <div class="mt-4 w-full max-w-md">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-gray-400"><%= t('views.users.avatar_modal.status_label') %></span>
                  <div class="flex items-center gap-2">
                    <div id="avatar-status-indicator" class="w-3 h-3 rounded-full bg-yellow-500"></div>
                    <span id="avatar-status-text" class="text-amber-400"><%= t('views.users.avatar_modal.status_pending') %></span>
                  </div>
                </div>
                
                <!-- Информация о статусе -->
                <div id="avatar-status-info" class="text-sm text-gray-400 mt-2">
                  <%= t('views.users.avatar_modal.status_info_pending') %>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Загрузка нового аватара -->
          <div class="bg-[#2E2E2E] rounded-lg p-5">
            <h3 class="text-xl font-semibold text-amber-400 mb-3 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
              <%= t('views.users.avatar_modal.upload_new_section') %>
            </h3>
            
            <div id="avatar-upload-section">
              <!-- Область для загрузки -->
              <div 
                id="avatar-drop-area"
                class="border-2 border-dashed border-gray-600 rounded-xl p-8 text-center cursor-pointer hover:bg-[#1A1A1A] hover:border-amber-400 transition-all duration-300 mb-4"
                ondragover="handleAvatarDragOver(event)"
                ondragleave="handleAvatarDragLeave(event)"
                ondrop="handleAvatarDrop(event)"
                role="button"
                tabindex="0"
                aria-label="<%= t('views.users.avatar_modal.upload_area_label') %>"
              >
                <input
                  type="file" 
                  id="avatar-input" 
                  class="hidden" 
                  accept=".jpg,.jpeg,.png<%= ',.gif' if current_user.is_sponsor %>"
                  onchange="handleAvatarFile(this.files)"
                  aria-label="<%= t('views.users.avatar_modal.select_file_label') %>"
                >
                <div class="flex flex-col items-center justify-center">
                  <div class="w-16 h-16 bg-amber-400/20 rounded-full flex items-center justify-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                  </div>
                  <p class="text-gray-300 mb-3 text-lg"><%= t('views.users.avatar_modal.drag_drop_text') %></p>
                  <button 
                    type="button" 
                    class="btn btn-warning"
                    onclick="document.getElementById('avatar-input').click()"
                    aria-label="<%= t('views.users.avatar_modal.select_file_label') %>"
                  >
                    <%= t('views.users.avatar_modal.select_file_button') %>
                  </button>
                  <p class="text-gray-400 text-sm mt-3">
                    <%= t('views.users.avatar_modal.file_info') %>
                    <% if current_user.is_sponsor %>
                      <span class="text-amber-400">GIF доступен для спонсоров</span>
                    <% end %>
                  </p>
                </div>
              </div>
              
              <!-- Предпросмотр загруженного аватара -->
              <div id="avatar-preview-container" class="hidden">
                <div class="relative rounded-xl overflow-hidden border border-gray-600">
                  <img id="avatar-preview" src="" class="w-full h-auto object-contain">
                  <!-- Индикатор GIF -->
                  <div id="gif-indicator" class="gif-indicator hidden">GIF</div>
                  <button 
                    id="avatar-remove-button"
                    type="button" 
                    class="absolute top-3 right-3 w-8 h-8 bg-red-500 hover:bg-red-600 text-white rounded-full flex items-center justify-center transition-all duration-300 hidden"
                    onclick="removeAvatar()"
                    aria-label="<%= t('views.users.avatar_modal.remove_avatar_label') %>"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </button>
                </div>
                
                <!-- Кнопка редактирования -->
                <div class="mt-4 flex justify-center">
                  <button 
                    id="crop-avatar-button"
                    type="button" 
                    class="btn btn-outline text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black w-64 inline-flex items-center space-x-2"
                    onclick="openCropModal()"
                    aria-label="<%= t('views.users.avatar_modal.crop_photo_button') %>"
                  >
                    <span><%= t('views.users.avatar_modal.crop_photo_button') %></span>
                  </button>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Кнопки действий -->
          <div class="flex flex-col sm:flex-row justify-center gap-3 mt-4">
            <button 
              id="upload-avatar-btn"
              class="btn btn-warning w-full sm:w-auto disabled:opacity-50 disabled:cursor-not-allowed"
              onclick="uploadAvatar()"
              disabled
              aria-label="<%= t('views.users.avatar_modal.upload_avatar_button') %>"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
              <%= t('views.users.avatar_modal.upload_avatar_button') %>
            </button>
            
            <!-- Кнопка удаления текущего аватара -->
            <button 
              id="delete-avatar-btn"
              class="btn btn-error w-full sm:w-auto hidden"
              onclick="confirmDeleteAvatar()"
              aria-label="<%= t('views.users.avatar_modal.delete_avatar_button') %>"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
              <%= t('views.users.avatar_modal.delete_avatar_button') %>
            </button>
            
            <button 
              type="button" 
              class="btn btn-ghost text-gray-300 hover:bg-[#2E2E2E] w-full sm:w-auto"
              onclick="closeAvatarModal()"
              aria-label="<%= t('views.users.avatar_modal.cancel_button') %>"
            >
              <%= t('views.users.avatar_modal.cancel_button') %>
            </button>
          </div>
          
          <!-- Пояснение о модерации -->
          <div class="bg-[#1A1A1A] border border-gray-700 rounded-lg p-4">
            <p class="text-gray-300 text-sm">
              <%= t('views.users.avatar_modal.moderation_info') %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Фон -->
  <form method="dialog" class="modal-backdrop bg-black/50" form="avatar_modal">
    <button aria-label="<%= t('views.users.avatar_modal.close_modal') %>"></button>
  </form>
</dialog>

<!-- Модальное окно для обрезки аватара -->
<dialog id="crop_modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="crop-modal-title">
  <div class="scale-in">
    <div class="flex items-center justify-center min-h-screen bg-black/50">
      <div class="modal-box max-w-4xl w-full bg-[#1A1A1A] rounded-lg shadow-lg relative h-auto overflow-y-auto">
        <!-- Кнопка закрытия -->
        <form method="dialog" class="absolute right-6 top-6 z-10" form="crop_modal">
          <button class="btn btn-circle btn-ghost text-amber-400 hover:bg-amber-400/20" aria-label="<%= t('views.users.avatar_modal.close_modal') %>">
            <svg xmlns="http://www.w3.org/2000/svg" 
                 class="w-6 h-6" 
                 fill="none" 
                 viewBox="0 0 24 24" 
                 stroke="currentColor">
              <path stroke-linecap="round" 
                    stroke-linejoin="round" 
                    stroke-width="2" 
                    d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </form>
        
        <!-- Основное содержимое -->
        <div class="flex flex-col space-y-6">
          <!-- Заголовок -->
          <div class="flex flex-col items-center mb-6 mt-4">
            <h2 id="crop-modal-title" class="text-3xl font-bold text-center text-amber-400 mb-2"><%= t('views.users.avatar_modal.crop_title') %></h2>
            <p class="text-gray-300 text-center"><%= t('views.users.avatar_modal.crop_subtitle') %></p>
          </div>
          
          <!-- Область для обрезки -->
          <div class="bg-[#2E2E2E] rounded-lg p-5">
            <div class="flex justify-center">
              <div class="relative w-full max-w-md h-96 bg-gray-800 rounded-lg overflow-hidden">
                <img id="crop-image" class="w-full h-full object-contain hidden">
              </div>
            </div>
            
            <!-- Инструменты обрезки -->
            <div class="flex justify-center mt-4 space-x-4">
              <button type="button" class="btn btn-sm btn-outline text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="rotateCrop(-90)">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <%= t('views.users.avatar_modal.rotate_left_button') %>
              </button>
              <button type="button" class="btn btn-sm btn-outline text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="rotateCrop(90)">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
                <%= t('views.users.avatar_modal.rotate_right_button') %>
              </button>
              <button type="button" class="btn btn-sm btn-outline text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="resetCrop()">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
                </svg>
                <%= t('views.users.avatar_modal.reset_button') %>
              </button>
            </div>
          </div>
          
          <!-- Кнопки действий -->
          <div class="flex flex-col sm:flex-row justify-center gap-3 mt-4">
            <button 
              type="button" 
              class="btn btn-warning w-full sm:w-auto"
              onclick="applyCrop()"
              aria-label="<%= t('views.users.avatar_modal.apply_button') %>"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <%= t('views.users.avatar_modal.apply_button') %>
            </button>
            
            <button 
              type="button" 
              class="btn btn-ghost text-gray-300 hover:bg-[#2E2E2E] w-full sm:w-auto"
              onclick="closeCropModal()"
              aria-label="<%= t('views.users.avatar_modal.cancel_button') %>"
            >
              <%= t('views.users.avatar_modal.cancel_button') %>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Фон -->
  <form method="dialog" class="modal-backdrop bg-black/50" form="crop_modal">
    <button aria-label="<%= t('views.users.avatar_modal.close_modal') %>"></button>
  </form>
</dialog>

<!-- Модальное окно подтверждения удаления аватара -->
<dialog id="confirm_avatar_deletion_modal" class="modal">
  <div class="modal-box w-full max-w-xl bg-[#1A1A1A] border border-red-500 p-8 rounded">
    <h3 class="text-2xl text-red-400 font-bold mb-4">
      <%= t('views.users.avatar_modal.delete_confirmation_title') %>
    </h3>

    <p class="text-sm text-[#AAAAAA] leading-relaxed mb-6">
      <%= t('views.users.avatar_modal.delete_confirmation_text') %>
    </p>

    <div class="modal-action flex justify-end space-x-3">
      <button
        type="button"
        class="btn text-sm px-4 py-2 text-gray-300 bg-[#2D2D2D] hover:bg-[#3A3A3A] transition"
        onclick="closeAvatarDeletionModal()"
      >
        <%= t('views.users.avatar_modal.cancel_button') %>
      </button>

      <button
        id="confirm-delete-avatar-btn"
        type="button"
        class="btn bg-red-600 text-white hover:bg-red-700 px-4 py-2 text-sm font-semibold transition"
        onclick="proceedAvatarDeletion()"
      >
        <%= t('views.users.avatar_modal.delete_avatar_button') %>
      </button>
    </div>
  </div>

  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>


