// Функция для открытия модального окна аватара
function openAvatarModal() {
  cleanupModalEventListeners();
  
  const modal = document.getElementById('avatar_modal');
  if (modal) {
    if (modal.open) {
      modal.close();
    }
    
    resetModalState();
    
    const closeHandler = () => closeAvatarModal();
    modal.addEventListener('close', closeHandler);
    modalEventListeners.push({ element: modal, type: 'close', handler: closeHandler });
    
    modal.showModal();
    loadCurrentAvatar();
  } else {
    showNotification(I18n.t('views.users.avatar_modal.error_modal_not_found'));
  }
}

function loadCurrentAvatar() {
  let authServiceUrl = "";
  try {
    authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>" || "";
  } catch (e) {
    console.error("Error getting IDENTITY_SERVICE_URL:", e);
  }
  
  if (!authServiceUrl) {
    authServiceUrl = window.location.origin;
  }
  
  const url = `${authServiceUrl}/api/v1/discord_avatar/${playerUserIdAvatar}`;
  
  fetch(url, {
    method: 'GET',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': getCsrfToken(),
      'X-User-ID': playerUserIdAvatar
    },
    credentials: 'same-origin'
  })
  .then(response => {
    if (!response.ok) {
      throw new Error('Network response was not ok');
    }
    return response.json();
  })
  .then(data => {
    if (data && data.id) {
      if (data.url) {
        fetch(data.url)
          .then(response => response.blob())
          .then(blob => {
            currentAvatarBlob = blob;
            originalAvatarBlob = blob;
            
            const blobUrl = URL.createObjectURL(blob);
            updateAvatarPreviews(blobUrl);
            
            const previewImg = document.getElementById('avatar-preview');
            if (previewImg) previewImg.src = blobUrl;
            
            const previewContainer = document.getElementById('avatar-preview-container');
            const dropArea = document.getElementById('avatar-drop-area');
            if (previewContainer) previewContainer.classList.remove('hidden');
            if (dropArea) dropArea.style.display = 'none';
            
            const removeBtn = document.getElementById('avatar-remove-button');
            if (removeBtn) removeBtn.classList.remove('hidden');
            
            const deleteBtn = document.getElementById('delete-avatar-btn');
            if (deleteBtn) deleteBtn.classList.remove('hidden');
            
            const uploadBtn = document.getElementById('upload-avatar-btn');
            if (uploadBtn) uploadBtn.disabled = false;
            
            // Проверяем, является ли текущий аватар GIF
            if (blob.type === 'image/gif') {
              const gifIndicator = document.getElementById('gif-indicator');
              if (gifIndicator) gifIndicator.classList.remove('hidden');
              const cropBtn = document.getElementById('crop-avatar-button');
              if (cropBtn) cropBtn.style.display = 'none';
            }
          })
          .catch(error => {
            const avatarUrl = 'https://ui-avatars.com/api/?name=User&background=333&color=fff';
            updateAvatarPreviews(avatarUrl);
          });
      } else {
        const avatarUrl = 'https://ui-avatars.com/api/?name=User&background=333&color=fff';
        updateAvatarPreviews(avatarUrl);
      }
      
      currentAvatarStatus = data.status || 'none';
      updateAvatarStatus(currentAvatarStatus);
    } else {
      const avatarUrl = 'https://ui-avatars.com/api/?name=User&background=333&color=fff';
      updateAvatarPreviews(avatarUrl);
      currentAvatarStatus = 'none';
      updateAvatarStatus(currentAvatarStatus);
    }
  })
  .catch(error => {
    const avatarUrl = 'https://ui-avatars.com/api/?name=User&background=333&color=fff';
    updateAvatarPreviews(avatarUrl);
    currentAvatarStatus = 'none';
    updateAvatarStatus(currentAvatarStatus);
  });
}

// Обработчики drag-and-drop для аватара
function handleAvatarDragOver(e) {
  e.preventDefault();
  e.stopPropagation();
  const dropArea = document.getElementById('avatar-drop-area');
  if (dropArea) dropArea.classList.add('border-amber-400', 'bg-amber-900/30');
}

function handleAvatarDragLeave(e) {
  e.preventDefault();
  e.stopPropagation();
  const dropArea = document.getElementById('avatar-drop-area');
  if (dropArea) dropArea.classList.remove('border-amber-400', 'bg-amber-900/30');
}

function handleAvatarDrop(e) {
  e.preventDefault();
  e.stopPropagation();
  const dropArea = document.getElementById('avatar-drop-area');
  if (dropArea) dropArea.classList.remove('border-amber-400', 'bg-amber-900/30');
  
  const files = e.dataTransfer.files;
  if (files.length > 0) {
    handleAvatarFile(files);
  }
}

function isValidFileType(file) {
  const allowedTypes = ['image/jpeg', 'image/png'];
  if (window.isSponsor) {
    allowedTypes.push('image/gif');
  }
  return allowedTypes.includes(file.type);
}

// Обработка выбранного файла аватара
function handleAvatarFile(files) {
  if (files.length === 0) return;
  
  const file = files[0];
  
  // Проверка на GIF для не-спонсоров
  if (file.type === 'image/gif' && !window.isSponsor) {
    showNotification(I18n.t('views.users.avatar_modal.error_gif_for_sponsors_only'));
    return;
  }
  
  if (!isValidFileType(file)) {
    showNotification(I18n.t('views.users.avatar_modal.error_file_type'));
    return;
  }
  
  if (file.size > 5 * 1024 * 1024) {
    showNotification(I18n.t('views.users.avatar_modal.error_file_size'));
    return;
  }
  
  originalAvatarFile = file;
  avatarFile = file;
  croppedFile = null;
  currentAvatarBlob = null;
  originalAvatarBlob = null;
  avatarUploaded = false;
  
  // Для GIF файлов используем специальную обработку
  if (file.type === 'image/gif') {
    handleGifFile(file);
  } else {
    handleImageFile(file);
  }
}

function handleImageFile(file) {
  createBasicCroppedFile(file, function(blobUrl) {
    const previewImg = document.getElementById('avatar-preview');
    if (previewImg) previewImg.src = blobUrl;
    
    updateAvatarPreviews(blobUrl);
    
    const previewContainer = document.getElementById('avatar-preview-container');
    if (previewContainer) previewContainer.classList.remove('hidden');
    
    const removeBtn = document.getElementById('avatar-remove-button');
    if (removeBtn) removeBtn.classList.remove('hidden');
    
    const dropArea = document.getElementById('avatar-drop-area');
    if (dropArea) dropArea.style.display = 'none';
    
    const uploadBtn = document.getElementById('upload-avatar-btn');
    if (uploadBtn) uploadBtn.disabled = false;
    
    // Скрываем индикатор GIF для изображений
    const gifIndicator = document.getElementById('gif-indicator');
    if (gifIndicator) gifIndicator.classList.add('hidden');
    
    // Показываем кнопку обрезки для изображений
    const cropBtn = document.getElementById('crop-avatar-button');
    if (cropBtn) cropBtn.style.display = 'block';
    
    currentAvatarStatus = 'draft';
    updateAvatarStatus(currentAvatarStatus);
  });
}

