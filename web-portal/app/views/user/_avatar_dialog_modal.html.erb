}

function proceedAvatarDeletion() {
  let authServiceUrl = "";
  try {
    authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>" || "";
  } catch (e) {
    console.error("Error getting IDENTITY_SERVICE_URL:", e);
  }
  
  if (!authServiceUrl) {
    authServiceUrl = window.location.origin;
  }
  
  const url = `${authServiceUrl}/api/v1/discord_avatar/${playerUserIdAvatar}`;

  fetch(url, {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': getCsrfToken(),
      'X-User-ID': playerUserIdAvatar
    },
    credentials: 'same-origin'
  })
  .then(response => {
    if (response.status === 204) {
      return { success: true };
    }
    
    if (!response.ok) {
      return response.text().then(text => {
        let errorData;
        try {
          errorData = JSON.parse(text);
        } catch (e) {
          errorData = { message: text };
        }
        throw new Error(errorData.error || errorData.message || 'Network response was not ok');
      });
    }
    
    return response.json();
  })
  .then(data => {
    showNotification(I18n.t('views.users.avatar_modal.notification_avatar_deleted'));
    
    const deletionModal = document.getElementById('confirm_avatar_deletion_modal');
    const avatarModal = document.getElementById('avatar_modal');
    
    if (deletionModal) deletionModal.close();
    if (avatarModal) avatarModal.close();
    
    setTimeout(() => {
      window.location.reload();
    }, 1000);
  })
  .catch(error => {
    showNotification(I18n.t('views.users.avatar_modal.notification_delete_error') + ': ' + error.message);
    
    const deletionModal = document.getElementById('confirm_avatar_deletion_modal');
    if (deletionModal) deletionModal.close();
  });
}

// Открытие модального окна обрезки
function openCropModal() {
  if (window.cropper) {
    closeCropModal();
  }
  
  // Проверяем, не является ли файл GIF
  if (originalAvatarFile && originalAvatarFile.type === 'image/gif') {
    showNotification(I18n.t('views.users.avatar_modal.error_gif_editing_unavailable'));
    return;
  }
  
  const modal = document.getElementById('crop_modal');
  const cropImage = document.getElementById('crop-image');
  
  if (!modal || !cropImage) {
    showNotification(I18n.t('views.users.avatar_modal.error_crop_modal_not_found'));
    return;
  }
  
  let imageSource;
  
  if (originalAvatarFile) {
    const reader = new FileReader();
    reader.onload = function(e) {
      imageSource = e.target.result;
      setupCropper(imageSource);
    };
    reader.readAsDataURL(originalAvatarFile);
    return;
  } else if (originalAvatarBlob) {
    imageSource = URL.createObjectURL(originalAvatarBlob);
    setupCropper(imageSource);
    return;
  } else {
    showNotification(I18n.t('views.users.avatar_modal.error_no_original_image'));
    return;
  }
}

// Настройка кроппера
function setupCropper(imageSource) {
  const cropImage = document.getElementById('crop-image');
  const modal = document.getElementById('crop_modal');
  
  cropImage.src = imageSource;
  cropImage.classList.remove('hidden');
  modal.showModal();
  
  setTimeout(() => {
    if (window.cropper) {
      window.cropper.destroy();
      window.cropper = null;
    }
    
    if (typeof Cropper === 'undefined') {
      showNotification(I18n.t('views.users.avatar_modal.error_cropper_not_loaded'));
      return;
    }
    
    try {
      window.cropper = new Cropper(cropImage, {
        aspectRatio: 1,
        viewMode: 1,
        autoCropArea: 0.8,
        responsive: true,
        checkCrossOrigin: false,
        background: false,
        guides: true,
        center: true,
        highlight: false,
        cropBoxMovable: true,
        cropBoxResizable: true,
        toggleDragModeOnDblclick: false,
        minCropBoxWidth: 100,
        minCropBoxHeight: 100
      });
    } catch (error) {
      showNotification(I18n.t('views.users.avatar_modal.error_cropper_init'));
      window.cropper = null;
    }
  }, 100);
}

// Поворот изображения при обрезке
function rotateCrop(degrees) {
  if (!window.cropper || typeof window.cropper.rotate !== 'function') {
    showNotification(I18n.t('views.users.avatar_modal.error_rotate_unavailable'));
    return;
  }
  
  try {
    window.cropper.rotate(degrees);
  } catch (error) {
    showNotification(I18n.t('views.users.avatar_modal.error_rotate_image'));
  }
}

// Сброс обрезки
function resetCrop() {
  if (window.cropper && typeof window.cropper.reset === 'function') {
    try {
      window.cropper.reset();
    } catch (error) {
      showNotification(I18n.t('views.users.avatar_modal.error_reset_crop'));
    }
  } else {
    showNotification(I18n.t('views.users.avatar_modal.error_reset_unavailable'));
  }
}

function applyCrop() {
  if (!window.cropper || typeof window.cropper.getCroppedCanvas !== 'function') {
    showNotification(I18n.t('views.users.avatar_modal.error_crop_unavailable'));
    return;
  }
  
  try {
    croppedCanvas = window.cropper.getCroppedCanvas({
      width: 400,
      height: 400,
      minWidth: 256,
      minHeight: 256,
      maxWidth: 4096,
      maxHeight: 4096,
      fillColor: '#fff',
      imageSmoothingEnabled: true,
      imageSmoothingQuality: 'high',
    });
    
    if (croppedCanvas) {
      // Определяем MIME type оригинального файла
      const originalMimeType = originalAvatarFile ? originalAvatarFile.type : 'image/jpeg';
      
      croppedCanvas.toBlob(function(blob) {
        if (blob) {
          // Сохраняем оригинальное имя файла или создаем новое с правильным расширением
          const originalName = originalAvatarFile ? originalAvatarFile.name : "avatar." + (originalMimeType.split('/')[1] || 'jpg');
          croppedFile = new File([blob], originalName, { type: originalMimeType });
          
          const blobUrl = URL.createObjectURL(blob);
          
          const previewImg = document.getElementById('avatar-preview');
          if (previewImg) previewImg.src = blobUrl;
          
          updateAvatarPreviews(blobUrl);
          
          currentAvatarStatus = 'draft';
          updateAvatarStatus(currentAvatarStatus);
          
          closeCropModal();
          
          showNotification(I18n.t('views.users.avatar_modal.notification_photo_cropped'));
        } else {
          showNotification(I18n.t('views.users.avatar_modal.error_create_file'));
        }
      }, originalMimeType, 0.9);
    } else {
      showNotification(I18n.t('views.users.avatar_modal.error_crop_image'));
    }
  } catch (error) {
    showNotification(I18n.t('views.users.avatar_modal.error_crop_operation'));
    closeCropModal();
  }
}

// Закрытие модального окна обрезки
function closeCropModal() {
  const modal = document.getElementById('crop_modal');
  
  if (window.cropper) {
    try {
      const cropImage = document.getElementById('crop-image');
      if (cropImage) {
        cropImage.classList.add('hidden');
        cropImage.src = '';
      }
      window.cropper.destroy();
    } catch (error) {
      console.error('Error in crop cleanup:', error);
    } finally {
      window.cropper = null;
    }
  }
  
  if (modal && modal.open) {
    modal.close();
  }
}

// Функция для закрытия модального окна аватара
function closeAvatarModal() {
  const modal = document.getElementById('avatar_modal');
  
  if (window.cropper) {
    try {
      window.cropper.destroy();
    } catch (error) {
      console.error('Error destroying cropper:', error);
    } finally {
      window.cropper = null;
    }
  }
  
  if (window.currentAvatarBlobUrl) {
    URL.revokeObjectURL(window.currentAvatarBlobUrl);
    window.currentAvatarBlobUrl = null;
  }
  
  if (modal && modal.open) {
    modal.close();
  }
  
  avatarFile = null;
  originalAvatarFile = null;
  originalAvatarBlob = null;
  croppedCanvas = null;
  croppedFile = null;
  currentAvatarBlob = null;
  avatarUploaded = false;
}

// Функция для базового кадрирования изображения (квадрат по центру)
function createBasicCroppedFile(inputFile, callback) {
  // Для GIF файлов используем оригинал без изменений
  if (inputFile.type === 'image/gif') {
    const blobUrl = URL.createObjectURL(inputFile);
    callback(blobUrl);
    return;
  }
  
  const img = new Image();
  const reader = new FileReader();
  
  reader.onload = function(e) {
    img.onload = function() {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      
      const size = Math.min(img.width, img.height);
      canvas.width = size;
      canvas.height = size;
      
      const sx = (img.width - size) / 2;
      const sy = (img.height - size) / 2;
      
      ctx.drawImage(img, sx, sy, size, size, 0, 0, size, size);
      
      // Сохраняем оригинальный формат для предпросмотра
      const mimeType = inputFile.type || 'image/jpeg';
      canvas.toBlob(function(blob) {
        const blobUrl = URL.createObjectURL(blob);
        callback(blobUrl);
      }, mimeType, 0.9);
    };
    img.src = e.target.result;
  };
  
  reader.readAsDataURL(inputFile);
}

// Функция для загрузки аватара на сервер
function uploadAvatar() {
  let fileToSend = null;
  
  // Для GIF файлов отправляем оригинал без изменений
  if (originalAvatarFile && originalAvatarFile.type === 'image/gif') {
    fileToSend = originalAvatarFile;
    proceedWithUpload(fileToSend);
    return;
  }
  
  if (croppedFile) {
    fileToSend = croppedFile;
    proceedWithUpload(fileToSend);
  } else if (originalAvatarFile) {
    createBasicCroppedFileForUpload(originalAvatarFile, function(croppedFile) {
      fileToSend = croppedFile;
      proceedWithUpload(fileToSend);
    });
  } else if (originalAvatarBlob) {
    const tempFile = new File([originalAvatarBlob], "temp_avatar.jpg", { type: originalAvatarBlob.type });
    createBasicCroppedFileForUpload(tempFile, function(croppedFile) {
      fileToSend = croppedFile;
      proceedWithUpload(fileToSend);
    });
  } else {
    showNotification(I18n.t('views.users.avatar_modal.error_no_file'));
    return;
  }
}

// Функция для базового кадрирования для отправки (возвращает File объект)
function createBasicCroppedFileForUpload(inputFile, callback) {
  // Для GIF файлов возвращаем оригинал
  if (inputFile.type === 'image/gif') {
    callback(inputFile);
    return;
  }
  
  const img = new Image();
  const reader = new FileReader();
  
  reader.onload = function(e) {
    img.onload = function() {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      
      const size = Math.min(img.width, img.height);
      canvas.width = size;
      canvas.height = size;
      
      const sx = (img.width - size) / 2;
      const sy = (img.height - size) / 2;
      
      ctx.drawImage(img, sx, sy, size, size, 0, 0, size, size);
      
      // Сохраняем оригинальный формат файла
      const mimeType = inputFile.type || 'image/jpeg';
      canvas.toBlob(function(blob) {
        const fileName = inputFile.name || "avatar." + (mimeType.split('/')[1] || 'jpg');
        const croppedFile = new File([blob], fileName, { type: mimeType });
        callback(croppedFile);
      }, mimeType, 0.9);
    };
    img.src = e.target.result;
  };
  
  reader.readAsDataURL(inputFile);
}

function proceedWithUpload(fileToSend) {
  if (typeof I18n === 'undefined') {
    showNotification("Ошибка: библиотека переводов не загружена");
    return;
  }
  
  const formData = new FormData();
  formData.append('avatar', fileToSend);
  
  let authServiceUrl = "";
  try {
    authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>" || "";
  } catch (e) {
    console.error("Error getting IDENTITY_SERVICE_URL:", e);
  }
  
  if (!authServiceUrl) {
    authServiceUrl = window.location.origin;
  }
  
  const url = `${authServiceUrl}/api/v1/discord_avatar/${playerUserIdAvatar}`;
  
  fetch(url, {
    method: 'POST',
    headers: {
      'X-CSRF-Token': getCsrfToken(),
      'X-User-ID': playerUserIdAvatar
    },
    body: formData,
    credentials: 'same-origin'
  })
  .then(response => {
    if (!response.ok) {
      throw new Error('Network response was not ok');
    }
    return response.json();
  })
  .then(data => {
    showNotification(I18n.t('views.users.avatar_modal.notification_avatar_uploaded'));
    
    avatarUploaded = true;
    currentAvatarStatus = 'pending';
    updateAvatarStatus(currentAvatarStatus);
    
    closeAvatarModal();
  })
  .catch(error => {
    showNotification(I18n.t('views.users.avatar_modal.notification_upload_error'));
  });
}

// Делаем функции глобально доступными
window.openAvatarModal = openAvatarModal;
window.openAvatarDialog = openAvatarModal;
window.closeAvatarModal = closeAvatarModal;
window.closeAvatarDialog = closeAvatarModal;
window.handleAvatarDragOver = handleAvatarDragOver;
window.handleAvatarDragLeave = handleAvatarDragLeave;
