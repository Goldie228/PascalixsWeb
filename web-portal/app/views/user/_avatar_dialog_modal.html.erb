window.removeAvatar = removeAvatar;
window.confirmDeleteAvatar = confirmDeleteAvatar;
window.closeAvatarDeletionModal = closeAvatarDeletionModal;
window.proceedAvatarDeletion = proceedAvatarDeletion;
window.openCropModal = openCropModal;
window.closeCropModal = closeCropModal;
window.applyCrop = applyCrop;
window.rotateCrop = rotateCrop;
window.resetCrop = resetCrop;
window.uploadAvatar = uploadAvatar;

// Инициализация при загрузке документа
document.addEventListener('DOMContentLoaded', function() {
  const style = document.createElement('style');
  style.innerHTML = `
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
      animation: fadeIn 0.3s ease-out forwards;
    }
  `;
  document.head.appendChild(style);
  
  // Проверка поддержки Dialog API
  if (!window.HTMLDialogElement) {
    const dialogs = document.querySelectorAll('dialog');
    dialogs.forEach(dialog => {
      dialog.showModal = function() {
        this.style.display = 'block';
        this.setAttribute('open', '');
      };
      dialog.close = function() {
        this.style.display = 'none';
        this.removeAttribute('open');
      };
    });
  }
});
