<% if @edit %>
  <%= render 'about_me_modal' %>
  <%= render "youtube_link_modal" %>
  <%= render "twitch_bind_modal" %>
  <%= render "tiktok_bind_modal" %>
  <%= render "are_you_sure_modal" %>
  <%= render "appeal_punishment_modal" %>
  <%= render "avatar_dialog_modal" %>
<% end %>

<% if @player.present? && @player.user_id.present? && \
  @player.user_id != current_user.id && !@user_is_banned && !@user_is_muted %>
  <%= render 'report_user_modal' %>
<% end %>

<%= render 'shared/navbar' %>

<div class="scale-in">
  <%= render 'profile_head' %>
</div>

<div class="scale-in">
  <%= render 'bank_account' %>
</div>

<div class="scale-in">
  <%= render 'integration' %>
</div>

<div class="scale-in">
  <%= render 'about_me' %>
</div>

<% if @edit %>
  <div class="scale-in">
    <%= render 'punishments' %>
  </div>
<% end %>

<%= render 'shared/footer' %>
