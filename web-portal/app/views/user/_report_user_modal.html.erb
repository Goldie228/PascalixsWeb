<dialog id="report_modal" class="modal">
  <div class="modal-box max-w-2xl w-full bg-[#1A1A1A] border-2 border-amber-400 relative overflow-y-auto max-h-[90vh]">
    <!-- Заголовок модального окна -->
    <div class="flex justify-between items-center mb-6 pb-4 border-b border-amber-400/30">
      <h2 id="modal-title" class="text-2xl font-bold text-amber-400 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <%= t('reports.modal.title') %>
      </h2>
      <!-- Кнопка отзыва жалобы (видна только при редактировании) -->
      <button id="revoke-report-btn" class="hidden px-4 py-2 bg-red-500/20 hover:bg-red-500/30 text-red-400 border border-red-500/50 rounded-lg flex items-center transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <%= t('reports.modal.revoke_button') %>
      </button>
    </div>
    
    <!-- Форма жалобы -->
    <form id="report_form">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <!-- Скрытое поле для ID жалобы (при редактировании) -->
      <input type="hidden" id="report_id" name="report_id" value="">
      
      <!-- Поле заголовка -->
      <div class="mb-6">
        <label for="report_title" class="block text-white mb-2 text-lg">
          <b><%= t('reports.form.title_label') %></b> <span class="text-red-500">*</span>
        </label>
        <input 
          type="text" 
          id="report_title" 
          name="report_title"
          class="input input-bordered w-full bg-[#262626] text-white text-lg"
          maxlength="80"
          placeholder="<%= t('reports.form.title_placeholder') %>"
          required
        >
        <div class="text-right mt-1">
          <span id="titleCharCount" class="text-gray-400">0/80</span>
        </div>
      </div>
      
      <!-- Поле описания -->
      <div class="mb-6">
        <label for="report_description" class="block text-white mb-2 text-lg">
          <b><%= t('reports.form.description_label') %></b> <span class="text-red-500">*</span>
        </label>
        <textarea 
          id="report_description" 
          name="report_description" 
          class="textarea textarea-bordered w-full min-h-[200px] bg-[#262626] text-white text-lg" 
          maxlength="5000" 
          placeholder="<%= t('reports.form.description_placeholder') %>"
          required
        ></textarea>
        <div class="text-right mt-1">
          <span id="descCharCount" class="text-gray-400">0/5000</span>
        </div>
      </div>
      
      <!-- Блок загрузки файлов -->
      <div class="mb-6">
        <!-- Контейнер для заголовка и области загрузки -->
        <div id="file-upload-section">
          <label class="block text-white mb-2 text-lg">
            <b><%= t('reports.form.files_label') %></b>
            <span class="text-sm text-gray-400 block"><%= t('reports.form.files_info') %></span>
          </label>
          
          <!-- Индикатор оставшегося места -->
          <div class="mb-3 bg-[#262626] rounded-lg p-3 border border-[#333]">
            <div class="flex justify-between items-center mb-1">
              <span class="text-gray-300 text-sm"><%= t('reports.form.storage_used') %></span>
              <span id="storage-used" class="text-amber-400 text-sm">0 МБ / 2048 МБ</span>
            </div>
            <div class="w-full bg-[#1A1A1A] rounded-full h-2">
              <div id="storage-bar" class="bg-amber-400 h-2 rounded-full" style="width: 0%"></div>
            </div>
          </div>
          
          <!-- Drag-and-drop область -->
          <div 
            id="drop-area"
            class="border-2 border-dashed border-amber-400/50 rounded-xl p-10 text-center cursor-pointer hover:bg-[#222222] hover:border-amber-400 transition-all duration-300 mb-4 transform hover:scale-[1.02]"
            ondragover="handleDragOver(event)"
            ondragleave="handleDragLeave(event)"
            ondrop="handleDrop(event)"
          >
            <input 
              type="file" 
              id="file-input" 
              class="hidden" 
              multiple 
              accept=".jpg,.jpeg,.png,.mp4"
              onchange="handleFiles(this.files)"
            >
            <div class="flex flex-col items-center justify-center">
              <div class="w-16 h-16 bg-amber-500/20 rounded-full flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
              </div>
              <p class="text-gray-300 mb-3 text-lg"><%= t('reports.form.drag_drop_text') %></p>
              <button 
                type="button" 
                class="px-5 py-2.5 bg-amber-400 hover:bg-amber-500 text-[#1A1A1A] font-medium rounded-lg transition-colors duration-300 shadow-md hover:shadow-lg"
                onclick="document.getElementById('file-input').click()"
              >
                <%= t('reports.form.select_files_button') %>
              </button>
              <p class="text-gray-400 text-sm mt-3"><%= t('reports.form.files_limit') %></p>
            </div>
          </div>
        </div>
        
        <!-- Контейнер для предпросмотра -->
        <div id="preview-container" class="grid grid-cols-2 md:grid-cols-3 gap-3 mt-4"></div>
        
        <!-- Скрытые поля для URL существующих файлов -->
        <div id="existing-files-container"></div>
      </div>
      
      <!-- Кнопки -->
      <div class="modal-action flex justify-end space-x-2">
        <button 
          type="submit" 
          id="report_submit" 
          class="btn btn-warning text-[#1A1A1A] text-lg hover:bg-[#FFC400] shadow-lg hover:shadow-xl transition duration-200"
        >
          <%= t('reports.form.submit_button') %>
        </button>
        <button 
          type="button" 
          class="btn btn-outline btn-warning text-lg hover:text-[#1A1A1A] shadow-lg hover:shadow-xl transition duration-200" 
          onclick="closeReportModal()"
        >
          <%= t('reports.form.cancel_button') %>
        </button>
      </div>
    </form>
  </div>
  
  <!-- Фон -->
  <form method="dialog" class="modal-backdrop">
    <button></button>
  </form>
</dialog>
<!-- Улучшенное модальное окно для просмотра медиа -->
<dialog id="media-viewer-modal" class="modal">
  <div class="modal-box max-w-6xl w-full bg-[#1A1A1A] border-2 border-amber-400 shadow-none relative overflow-hidden">
    <!-- Заголовок с информацией о файле -->
    <div class="flex justify-between items-center p-4 border-b border-amber-400/30">
      <h3 id="media-title" class="text-xl font-bold text-amber-400 truncate max-w-[70%]"></h3>
      <div class="flex space-x-3">
        <button id="download-media" class="btn btn-circle btn-sm btn-outline border-amber-400 text-amber-400 hover:bg-amber-400 hover:text-[#1A1A1A] shadow-md transition-all duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
        <button onclick="closeMediaViewer()" class="btn btn-circle btn-sm btn-outline border-amber-400 text-amber-400 hover:bg-amber-400 hover:text-[#1A1A1A] shadow-md transition-all duration-200 font-bold text-lg">
          ×
        </button>
      </div>
    </div>
    
    <!-- Контейнер для медиа -->
    <div class="relative w-full flex items-center justify-center min-h-[50vh] max-h-[80vh] bg-[#0D0D0D]">
      <!-- Индикатор загрузки -->
      <div id="media-loader" class="absolute inset-0 flex items-center justify-center bg-[#1A1A1A] z-10">
        <div class="flex flex-col items-center">
          <div class="w-12 h-12 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
          <span class="text-amber-400 mt-2"><%= t('reports.media.loading') %></span>
        </div>
      </div>
      
      <!-- Медиа контент -->
      <div id="media-container" class="w-full h-full flex items-center justify-center">
        <!-- Здесь будет динамически добавляться контент -->
      </div>
      
      <!-- Навигация (если несколько файлов) -->
      <button id="prev-media" class="absolute left-6 top-1/2 transform -translate-y-1/2 btn btn-circle btn-sm btn-outline border-amber-400 text-amber-400 hover:bg-amber-400 hover:text-[#1A1A1A] hidden shadow-md transition-all duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
      </button>
      <button id="next-media" class="absolute right-6 top-1/2 transform -translate-y-1/2 btn btn-circle btn-sm btn-outline border-amber-400 text-amber-400 hover:bg-amber-400 hover:text-[#1A1A1A] hidden shadow-md transition-all duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
    
    <!-- Информация о файле -->
    <div class="p-4 border-t border-amber-400/30 flex justify-between items-center">
      <div class="text-gray-400 text-sm">
        <span id="media-info"></span>
      </div>
      <div id="media-counter" class="text-amber-400 text-sm"></div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop bg-black/90">
    <button>close</button>
  </form>
</dialog>
<script type="text/javascript">
  // Хранилище для файлов
  let uploadedFiles = [];
  let existingFiles = [];
  let currentMediaIndex = 0;
  let isEditMode = false;
  let reportId = null;
  const MAX_FILE_SIZE = 2 * 1024 * 1024 * 1024;
  const MAX_TOTAL_SIZE = 2 * 1024 * 1024 * 1024;
  const MAX_FILES = 12; // Увеличено до 12 файлов
  
  // Функции для работы с модальным окном
  async function openReportModal(userId) {
    const modal = document.getElementById('report_modal');
    modal.dataset.userId = userId;
    reportId = userId;
    
    try {
      // Сначала загружаем данные
      await loadReportData(userId, modal);
    } catch (error) {
      console.error('Error loading report data:', error);
      showAlertNotification('<%= t('reports.errors.load_data_error') %>');
    }
  }
  async function loadReportData(reportId, modal) {
    const modalTitle = document.getElementById('modal-title');
    const submitButton = document.getElementById('report_submit');
    const revokeButton = document.getElementById('revoke-report-btn');
    try {
      const authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>";
      const reporterId = "<%= current_user.id %>";
      const url = `${authServiceUrl}/api/v1/reports/${reportId}?reporter_id=${reporterId}`;
      const response = await fetch(url, {
        headers: {
          "Accept": "application/json"
        }
      });
      const report = await response.json();
      if (response.status === 404) {
        // 🆕 Жалоба не найдена — предполагаем создание новой
        resetForm();
        isEditMode = false;
        modalTitle.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <%= t('reports.modal.title') %>
        `;
        submitButton.textContent = '<%= t('reports.form.submit_button') %>';
        revokeButton.classList.add('hidden');
        if (modal) modal.showModal();
        return;
      }
      // 💡 Проверка на лимит: если пришёл 403 или специфическая ошибка
      if (response.status === 403 && report.error?.includes("активных жалоб")) {
        showAlertNotification("<%= t('reports.errors.reports_limit') %>");
        return; // ⛔️ Не продолжаем дальше, модалка не открывается
      }
      // ⛔️ Остальные невалидные состояния
      if (!response.ok || (report.error && report.status !== 404) || report.is_active === 'f' || report.is_active === false) {
        return;
      }
      // ✅ Заполняем форму
      document.getElementById('report_id').value = report.id;
      document.getElementById('report_title').value = report.title;
      document.getElementById('report_description').value = report.description;
      updateCharCounters();
      if (report.attachments && report.attachments.length > 0) {
        existingFiles = report.attachments;
        renderAllMedia();
      }
      isEditMode = true;
      modalTitle.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5h2m-2 4h2m-2 4h2m-7 4h10c1.333 0 2-.667 2-2V7c0-1.333-.667-2-2-2H7c-1.333 0-2 .667-2 2v10c0 1.333.667 2 2 2z" />
        </svg>
        <%= t('reports.modal.edit_title') %>
      `;
      submitButton.textContent = '<%= t('reports.form.save_button') %>';
      revokeButton.classList.remove('hidden');
      // Открываем модальное окно только после загрузки данных
      if (modal) modal.showModal();
    } catch (error) {
      console.error('Error loading report data:', error);
      showAlertNotification(error.message || '<%= t('reports.errors.load_data_error') %>');
      isEditMode = false;
      modalTitle.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <%= t('reports.modal.title') %>
      `;
      submitButton.textContent = '<%= t('reports.form.submit_button') %>';
      revokeButton.classList.add('hidden');
      resetForm();
    }
  }
  
  // Обновление скрытых полей с URL существующих файлов
  function updateExistingFilesUrls() {
    const container = document.getElementById('existing-files-container');
    container.innerHTML = '';
    
    existingFiles.forEach((file, index) => {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = `existing_files[${index}]`;
      input.value = file.url;
      container.appendChild(input);
    });
  }
  
  // Функция отображения существующих файлов (только серверных)
  function displayExistingFiles() {
    const previewContainer = document.getElementById('preview-container');
    
    // Удаляем только элементы существующих файлов, не трогая локальные
    const existingPreviews = previewContainer.querySelectorAll('[id^="existing-file-"]');
    existingPreviews.forEach(preview => preview.remove());
    
    existingFiles.forEach((file) => {
      const previewId = `existing-file-${file.id}`;
      const previewItem = document.createElement('div');
      previewItem.className = 'relative group overflow-hidden rounded-xl bg-[#262626] border border-[#333] transition-all duration-300 hover:border-amber-400/50 hover:shadow-lg hover:shadow-amber-500/10 transform hover:scale-[1.02]';
      previewItem.id = previewId;
      previewItem.dataset.fileId = file.id;
      
      const previewContent = document.createElement('div');
      previewContent.className = 'relative w-full h-40 flex items-center justify-center cursor-pointer';
      
      const removeBtn = document.createElement('button');
      removeBtn.className = 'absolute top-2 right-2 z-20 w-8 h-8 bg-red-500/90 hover:bg-red-600 text-white rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-lg';
      removeBtn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      `;
      
      removeBtn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        removeExistingFile(file.id);
      };
      
      previewContent.appendChild(removeBtn);
      
      const loader = document.createElement('div');
      loader.className = 'absolute inset-0 bg-[#1A1A1A]/80 flex items-center justify-center z-10';
      loader.innerHTML = `
        <div class="flex flex-col items-center">
          <div class="w-10 h-10 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
          <span class="text-xs mt-2 text-amber-400"><%= t('reports.media.loading') %></span>
        </div>
      `;
      previewContent.appendChild(loader);
      
      if (file.content_type.startsWith('image/')) {
        const img = document.createElement('img');
        img.src = file.url;
        img.className = 'w-full h-full object-cover';
        
        img.onload = () => {
          loader.remove();
          img.classList.add('animate-fadeIn');
        };
        
        img.onerror = () => {
          loader.remove();
          const placeholder = document.createElement('div');
          placeholder.className = 'w-full h-full bg-[#1A1A1A] flex flex-col items-center justify-center';
          placeholder.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-amber-400 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          `;
          previewContent.appendChild(placeholder);
        };
        
        previewContent.onclick = (event) => {
          event.preventDefault();
          event.stopPropagation();
          const allFiles = getAllFiles();
          const fileIndex = allFiles.findIndex(f => f.id === file.id && f.type === 'existing');
          openMediaViewer(fileIndex);
        };
        
        previewContent.appendChild(img);
      } else if (file.content_type === 'video/mp4') {
        loader.remove();
        
        const videoPlaceholder = document.createElement('div');
        videoPlaceholder.className = 'w-full h-full bg-[#1A1A1A] flex flex-col items-center justify-center';
        
        const videoIcon = document.createElement('div');
        videoIcon.className = 'w-14 h-14 bg-amber-500/90 rounded-full flex items-center justify-center';
        videoIcon.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
          </svg>
        `;
        
        previewContent.onclick = (event) => {
          event.preventDefault();
          event.stopPropagation();
          const allFiles = getAllFiles();
          const fileIndex = allFiles.findIndex(f => f.id === file.id && f.type === 'existing');
          openMediaViewer(fileIndex);
        };
        
        videoPlaceholder.appendChild(videoIcon);
        previewContent.appendChild(videoPlaceholder);
      }
      
      previewItem.appendChild(previewContent);
      previewContainer.appendChild(previewItem);
    });
  }
  
  // Получение объединенного списка всех файлов
  function getAllFiles() {
    const allFiles = [];
    
    existingFiles.forEach(file => {
      allFiles.push({
        ...file,
        type: 'existing'
      });
    });
    
    uploadedFiles.forEach(file => {
      allFiles.push({
        ...file,
        type: 'uploaded'
      });
    });
    
    return allFiles;
  }
  
  // Открытие медиа для существующих файлов
  function openMediaViewer(fileIndex = 0) {
    const allFiles = getAllFiles();
    
    if (allFiles.length === 0) return;
    
    currentMediaIndex = fileIndex;
    
    const modal = document.getElementById('media-viewer-modal');
    document.getElementById('media-loader').style.display = 'flex';
    document.getElementById('media-container').innerHTML = '';
    
    updateMediaCounter();
    updateNavigationButtons();
    
    const file = allFiles[currentMediaIndex];
    if (file.type === 'existing') {
      loadExistingMedia(file);
    } else {
      loadMedia(file);
    }
    
    modal.showModal();
  }
  
  // Загрузка существующего медиа
  function loadExistingMedia(file) {
    const container = document.getElementById('media-container');
    
    if (file.content_type.startsWith('image/')) {
      const img = document.createElement('img');
      img.src = file.url;
      img.className = 'max-w-full max-h-[70vh] object-contain';
      
      img.onload = function() {
        document.getElementById('media-loader').style.display = 'none';
        updateMediaInfo(file, 'image');
      };
      
      img.onerror = function() {
        document.getElementById('media-loader').style.display = 'none';
        showAlertNotification('<%= t('reports.errors.image_load_error') %>');
      };
      
      container.appendChild(img);
    } else if (file.content_type === 'video/mp4') {
      const video = document.createElement('video');
      video.src = file.url;
      video.className = 'max-w-full max-h-[70vh] object-contain';
      video.controls = true;
      
      video.onloadeddata = function() {
        document.getElementById('media-loader').style.display = 'none';
        updateMediaInfo(file, 'video');
      };
      
      video.onerror = function() {
        document.getElementById('media-loader').style.display = 'none';
        showAlertNotification('<%= t('reports.errors.video_load_error') %>');
      };
      
      container.appendChild(video);
    }
  }
  
  // Обновление информации о медиа
  function updateMediaInfo(file, type) {
    let info = '';
    let fileSize = 0;
    
    if (file.file_size !== undefined && !isNaN(file.file_size)) {
      fileSize = file.file_size;
    } else if (file.size !== undefined && !isNaN(file.size)) {
      fileSize = file.size;
    } else if (file.filesize !== undefined && !isNaN(file.filesize)) {
      fileSize = file.filesize;
    } else if (file.byte_size !== undefined && !isNaN(file.byte_size)) {
      fileSize = file.byte_size;
    }
    
    if (type === 'image') {
      info = `<%= t('reports.media.image_info') %> ${formatFileSize(fileSize)}`;
    } else if (type === 'video') {
      info = `<%= t('reports.media.video_info') %> ${formatFileSize(fileSize)}`;
    }
    
    document.getElementById('media-info').textContent = info;
  }
  // Удаление существующего файла
  function removeExistingFile(fileId) {
    const fileIndex = existingFiles.findIndex(f => f.id === fileId);
    if (fileIndex === -1) return;
    
    const file = existingFiles[fileIndex];
    const previewItem = document.getElementById(`existing-file-${fileId}`);
    
    if (!window.filesToDelete) {
      window.filesToDelete = [];
    }
    window.filesToDelete.push(fileId);
    
    if (previewItem) {
      previewItem.classList.add('animate-fadeOut');
      setTimeout(() => {
        // Удаляем из массива
        existingFiles.splice(fileIndex, 1);
        
        // Обновляем только существующие файлы, не трогая локальные
        renderAllMedia()
      }, 300);
    } else {
      // Удаляем из массива
      existingFiles.splice(fileIndex, 1);
      
      // Обновляем только существующие файлы, не трогая локальные
      renderAllMedia()
    }
  }
  
  // Сброс формы
  function resetForm() {
    document.getElementById('report_id').value = '';
    document.getElementById('report_title').value = '';
    document.getElementById('report_description').value = '';
    
    uploadedFiles = [];
    existingFiles = [];
    window.filesToDelete = [];
    document.getElementById('preview-container').innerHTML = '';
    document.getElementById('existing-files-container').innerHTML = '';
    
    isEditMode = false;
    reportId = null;
    
    updateCharCounters();
    renderAllMedia();
    
    const modalTitle = document.getElementById('modal-title');
    const submitButton = document.getElementById('report_submit');
    const revokeButton = document.getElementById('revoke-report-btn');
    
    modalTitle.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <%= t('reports.modal.title') %>
    `;
    submitButton.textContent = '<%= t('reports.form.submit_button') %>';
    revokeButton.classList.add('hidden');
  }
  
  // Отзыв жалобы
  async function revokeReport() {
    if (!reportId) return;
    
    try {
      const response = await fetch(`/revoke_report/${reportId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        },
        credentials: 'same-origin'
      });
      
      if (response.ok) {
        resetForm();
        
        const modalTitle = document.getElementById('modal-title');
        const submitButton = document.getElementById('report_submit');
        const revokeButton = document.getElementById('revoke-report-btn');
        
        modalTitle.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <%= t('reports.modal.title') %>
        `;
        submitButton.textContent = '<%= t('reports.form.submit_button') %>';
        revokeButton.classList.add('hidden');
        
        showNotification('<%= t('reports.notifications.report_revoked') %>');
      } else {
        const data = await response.json();
        showAlertNotification('<%= t('reports.errors.revoke_error') %>');
      }
    } catch (error) {
      console.error('Error revoking report:', error);
      showAlertNotification('<%= t('reports.errors.revoke_error') %>');
    }
  }
  
  function closeReportModal() {
    const modal = document.getElementById('report_modal');
    if (modal) modal.close();
    resetForm();
  }
  
  // Функция закрытия медиа-просмотра с освобождением ресурсов
  function closeMediaViewer() {
    const modal = document.getElementById('media-viewer-modal');
    modal.close();
    
    // Останавливаем видео и освобождаем ресурсы
    const video = document.querySelector('#media-container video');
    if (video) {
      video.pause();
      if (video.src.startsWith('blob:')) {
        URL.revokeObjectURL(video.src);
      }
    }
    
    // Освобождаем ресурсы для изображений
    const images = document.querySelectorAll('#media-container img');
    images.forEach(img => {
      if (img.src.startsWith('blob:')) {
        URL.revokeObjectURL(img.src);
      }
    });
    
    // Очищаем контейнер
    document.getElementById('media-container').innerHTML = '';
  }
  function loadMedia(file) {
    const container = document.getElementById('media-container');
    const loader = document.getElementById('media-loader');
    if (!file.file) {
      loader.style.display = 'none';
      showAlertNotification('<%= t('reports.errors.file_not_found') %>');
      return;
    }
    const isLocalFile = typeof file.file !== 'string';
    const mimeType = file.file?.type || '';
    if (mimeType.startsWith('image/')) {
      const img = document.createElement('img');
      img.className = 'max-w-full max-h-[70vh] object-contain';
      if (isLocalFile) {
        const reader = new FileReader();
        reader.onload = (e) => {
          img.src = e.target.result;
          loader.style.display = 'none';
          updateMediaInfo(file, 'image');
        };
        reader.onerror = () => {
          loader.style.display = 'none';
          showAlertNotification('<%= t('reports.errors.file_read_error') %>');
        };
        reader.readAsDataURL(file.file);
      } else {
        img.src = file.file;
        img.onload = () => {
          loader.style.display = 'none';
          updateMediaInfo(file, 'image');
        };
        img.onerror = () => {
          loader.style.display = 'none';
          showAlertNotification('<%= t('reports.errors.image_load_error') %>');
        };
      }
      container.appendChild(img);
    } else if (mimeType === 'video/mp4') {
      const video = document.createElement('video');
      video.className = 'max-w-full max-h-[70vh] object-contain';
      video.controls = true;
      if (isLocalFile) {
        const reader = new FileReader();
        reader.onload = (e) => {
          video.src = e.target.result;
          loader.style.display = 'none';
          updateMediaInfo(file, 'video');
        };
        reader.onerror = () => {
          loader.style.display = 'none';
          showAlertNotification('<%= t('reports.errors.file_read_error') %>');
        };
        reader.readAsDataURL(file.file);
      } else {
        video.src = file.file;
        video.onloadeddata = () => {
          loader.style.display = 'none';
          updateMediaInfo(file, 'video');
        };
        video.onerror = () => {
          loader.style.display = 'none';
          showAlertNotification('<%= t('reports.errors.video_load_error') %>');
        };
      }
      container.appendChild(video);
    } else {
      loader.style.display = 'none';
      showAlertNotification('<%= t('reports.errors.unknown_media_format') %>');
    }
  }
  function formatFileSize(bytes) {
    if (bytes === 0 || isNaN(bytes)) return '0 Bytes';
    
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }
  
  function updateMediaCounter() {
    const counter = document.getElementById('media-counter');
    const allFiles = getAllFiles();
    
    if (allFiles.length > 1) {
      counter.textContent = `${currentMediaIndex + 1} / ${allFiles.length}`;
    } else {
      counter.textContent = '';
    }
  }
  
  function updateNavigationButtons() {
    const prevBtn = document.getElementById('prev-media');
    const nextBtn = document.getElementById('next-media');
    const allFiles = getAllFiles();
    
    if (allFiles.length > 1) {
      prevBtn.classList.remove('hidden');
      nextBtn.classList.remove('hidden');
      
      prevBtn.disabled = currentMediaIndex === 0;
      nextBtn.disabled = currentMediaIndex === allFiles.length - 1;
    } else {
      prevBtn.classList.add('hidden');
      nextBtn.classList.add('hidden');
    }
  }
  
  // Функция навигации между медиа с освобождением ресурсов
  function navigateMedia(direction) {
    const allFiles = getAllFiles();
    
    if (allFiles.length <= 1) return;
    
    // Освобождаем ресурсы текущего медиа перед переключением
    const currentMedia = document.querySelector('#media-container img, #media-container video');
    if (currentMedia) {
      if (currentMedia.tagName === 'VIDEO') {
        currentMedia.pause();
      }
      if (currentMedia.src.startsWith('blob:')) {
        URL.revokeObjectURL(currentMedia.src);
      }
    }
    
    if (direction === 'prev' && currentMediaIndex > 0) {
      currentMediaIndex--;
    } else if (direction === 'next' && currentMediaIndex < allFiles.length - 1) {
      currentMediaIndex++;
    } else {
      return;
    }
    
    document.getElementById('media-loader').style.display = 'flex';
    document.getElementById('media-container').innerHTML = '';
    
    updateMediaCounter();
    updateNavigationButtons();
    
    const file = allFiles[currentMediaIndex];
    if (file.type === 'existing') {
      loadExistingMedia(file);
    } else {
      loadMedia(file);
    }
  }
  
  // Drag-and-drop обработчики
  function handleDragOver(e) {
    e.preventDefault();
    e.stopPropagation();
    document.getElementById('drop-area').classList.add('border-amber-400', 'bg-[#222222]');
  }
  
  function handleDragLeave(e) {
    e.preventDefault();
    e.stopPropagation();
    document.getElementById('drop-area').classList.remove('border-amber-400', 'bg-[#222222]');
  }
  
  function handleDrop(e) {
    e.preventDefault();
    e.stopPropagation();
    document.getElementById('drop-area').classList.remove('border-amber-400', 'bg-[#222222]');
    
    const dt = e.dataTransfer;
    const files = dt.files;
    
    handleFiles(files);
  }
  
  // Функция обработки выбранных файлов
  function handleFiles(files) {
    if (!files || files.length === 0) return;
    
    const totalFiles = (existingFiles ? existingFiles.length : 0) + uploadedFiles.length + files.length;
    
    if (totalFiles > MAX_FILES) {
      showAlertNotification(I18n.t('reports.errors.max_files', { count: MAX_FILES }));
      return;
    }
    
    let currentTotalSize = getCurrentTotalSize();
    
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      
      const validTypes = ['image/jpeg', 'image/png', 'video/mp4'];
      if (!validTypes.includes(file.type)) {
        showAlertNotification(`<%= t('reports.errors.invalid_file_format', file_name: '${file.name}') %>`);
        continue;
      }
      
      if (file.size > MAX_FILE_SIZE) {
        showAlertNotification(`<%= t('reports.errors.file_too_large', file_name: '${file.name}') %>`);
        continue;
      }
      
      if (currentTotalSize + file.size > MAX_TOTAL_SIZE) {
        showAlertNotification(I18n.t('reports.errors.total_size_exceeded', {
          remaining_space: formatFileSize(MAX_TOTAL_SIZE - currentTotalSize)
        }));
        continue;
      }
      
      const fileObj = {
        id: `file-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
        file: file,
        type: file.type,
        size: file.size,
        name: file.name
      };
      
      uploadedFiles.push(fileObj);
      createFilePreview(fileObj);
      currentTotalSize += file.size;
    }
    renderAllMedia();
  }
  
  // Получение текущего общего размера файлов
  function getCurrentTotalSize() {
    let totalSize = 0;
    
    existingFiles.forEach(file => {
      let fileSize = 0;
      if (file.file_size !== undefined && !isNaN(file.file_size)) {
        fileSize = file.file_size;
      } else if (file.size !== undefined && !isNaN(file.size)) {
        fileSize = file.size;
      } else if (file.filesize !== undefined && !isNaN(file.filesize)) {
        fileSize = file.filesize;
      } else if (file.byte_size !== undefined && !isNaN(file.byte_size)) {
        fileSize = file.byte_size;
      }
      totalSize += fileSize;
    });
    
    uploadedFiles.forEach(fileObj => {
      totalSize += fileObj.size;
    });
    
    return totalSize;
  }
    
  // Обновление индикатора использования места
  function updateStorageIndicator() {
    const totalSize = getCurrentTotalSize();
    const usedElement = document.getElementById('storage-used');
    const barElement = document.getElementById('storage-bar');
    
    const usedMB = (totalSize / (1024 * 1024)).toFixed(2);
    const totalMB = (MAX_TOTAL_SIZE / (1024 * 1024)).toFixed(2);
    const percentage = Math.min(100, (totalSize / MAX_TOTAL_SIZE) * 100);
    
    usedElement.textContent = `${usedMB} МБ / ${totalMB} МБ`;
    barElement.style.width = `${percentage}%`;
    
    if (percentage > 90) {
      barElement.classList.remove('bg-amber-400', 'bg-green-500');
      barElement.classList.add('bg-red-500');
    } else if (percentage > 70) {
      barElement.classList.remove('bg-red-500', 'bg-green-500');
      barElement.classList.add('bg-amber-400');
    } else {
      barElement.classList.remove('bg-red-500', 'bg-amber-400');
      barElement.classList.add('bg-green-500');
    }
  }
  
  // Обновленная функция создания превью для новых файлов
  function createFilePreview(fileObj) {
    const previewContainer = document.getElementById('preview-container');
    const previewId = `preview-${fileObj.id}`;
    
    const previewItem = document.createElement('div');
    previewItem.className = 'relative group overflow-hidden rounded-xl bg-[#262626] border border-[#333] transition-all duration-300 hover:border-amber-400/50 hover:shadow-lg hover:shadow-amber-500/10 transform hover:scale-[1.02]';
    previewItem.id = previewId;
    previewItem.dataset.fileId = fileObj.id;
    
    const previewContent = document.createElement('div');
    previewContent.className = 'relative w-full h-40 flex items-center justify-center cursor-pointer';
    
    const removeBtn = document.createElement('button');
    removeBtn.className = 'absolute top-2 right-2 z-20 w-8 h-8 bg-red-500/90 hover:bg-red-600 text-white rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-lg';
    removeBtn.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    `;
    removeBtn.onclick = (e) => {
      e.preventDefault();
      e.stopPropagation();
      removeFilePreview(previewId, fileObj.id);
    };
    
    const loader = document.createElement('div');
    loader.className = 'absolute inset-0 bg-[#1A1A1A]/80 flex items-center justify-center z-10';
    loader.innerHTML = `
      <div class="flex flex-col items-center">
        <div class="w-10 h-10 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
        <span class="text-xs mt-2 text-amber-400"><%= t('reports.media.loading') %></span>
      </div>
    `;
    
    previewContent.appendChild(removeBtn);
    previewContent.appendChild(loader);
    previewItem.appendChild(previewContent);
    previewContainer.appendChild(previewItem);
    
    // Используем FileReader для создания превью
    const reader = new FileReader();
    
    reader.onload = function(e) {
      loader.remove();
      
      if (fileObj.type.startsWith('image')) {
        const img = document.createElement('img');
        img.src = e.target.result;
        img.className = 'w-full h-full object-cover';
        
        img.onload = () => {
          img.classList.add('animate-fadeIn');
        };
        
        previewContent.onclick = (event) => {
          event.preventDefault();
          event.stopPropagation();
          const allFiles = getAllFiles();
          const fileIndex = allFiles.findIndex(f => f.id === fileObj.id);
          openMediaViewer(fileIndex);
        };
        
        previewContent.appendChild(img);
      } 
      else if (fileObj.type === 'video/mp4') {
        const video = document.createElement('video');
        video.src = e.target.result;
        video.className = 'w-full h-full object-cover';
        video.muted = true;
        
        const videoIcon = document.createElement('div');
        videoIcon.className = 'absolute inset-0 flex items-center justify-center bg-black/40';
        videoIcon.innerHTML = `
          <div class="w-14 h-14 bg-amber-500/90 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
            </svg>
          </div>
        `;
        
        previewContent.onclick = (event) => {
          event.preventDefault();
          event.stopPropagation();
          const allFiles = getAllFiles();
          const fileIndex = allFiles.findIndex(f => f.id === fileObj.id);
          openMediaViewer(fileIndex);
        };
        
        previewContent.appendChild(video);
        previewContent.appendChild(videoIcon);
      }
    };
    
    reader.onerror = function() {
      loader.remove();
      const placeholder = document.createElement('div');
      placeholder.className = 'w-full h-full bg-[#1A1A1A] flex flex-col items-center justify-center';
      placeholder.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-amber-400 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span class="text-amber-400 text-sm"><%= t('reports.media.load_error') %></span>
      `;
      previewContent.appendChild(placeholder);
    };
    
    // Читаем файл как Data URL
    reader.readAsDataURL(fileObj.file);
  }
  function renderAllMedia() {
    displayExistingFiles();
    displayUploadedFiles();
    updateDropAreaVisibility();
    updateStorageIndicator();
  }
  
  // Удаление превью (для локальных файлов)
  function removeFilePreview(previewId, fileId) {
    const previewItem = document.getElementById(previewId);
    if (previewItem) {
      previewItem.classList.add('animate-fadeOut');
      setTimeout(() => {
        // Удаляем из массива
        uploadedFiles = uploadedFiles.filter(f => f.id !== fileId);
        
        // Обновляем только локальные файлы, не трогая серверные
        renderAllMedia();
      }, 300);
    }
  }
  // Функция отображения загруженных файлов (только локальных)
  function displayUploadedFiles() {
    const previewContainer = document.getElementById('preview-container');
    
    // Удаляем только элементы локальных файлов, не трогая серверные
    const uploadedPreviews = previewContainer.querySelectorAll('[id^="preview-"]');
    uploadedPreviews.forEach(preview => preview.remove());
    
    // Пересоздаем превью для всех локальных файлов
    uploadedFiles.forEach(fileObj => {
      createFilePreview(fileObj);
    });
  }
    
  // Обновление видимости области загрузки
  function updateDropAreaVisibility() {
    const fileUploadSection = document.getElementById('file-upload-section');
    const totalFiles = (existingFiles ? existingFiles.length : 0) + uploadedFiles.length;
    
    if (fileUploadSection) {
      if (totalFiles >= MAX_FILES) {
        fileUploadSection.classList.add('hidden');
      } else {
        fileUploadSection.classList.remove('hidden');
      }
    }
  }
  
  // Сброс загруженных файлов
  function resetFileUploads() {
    uploadedFiles = [];
    document.getElementById('preview-container').innerHTML = '';
    renderAllMedia();
  }
  
  // Обновление счетчиков символов
  function updateCharCounters() {
    const titleInput = document.getElementById('report_title');
    const descTextarea = document.getElementById('report_description');
    const titleCounter = document.getElementById('titleCharCount');
    const descCounter = document.getElementById('descCharCount');
    const submitButton = document.getElementById('report_submit');
    
    if (titleInput && descTextarea) {
      const updateCounters = () => {
        const titleLength = titleInput.value.length;
        const descLength = descTextarea.value.length;
        
        titleCounter.textContent = `${titleLength}/80`;
        descCounter.textContent = `${descLength}/5000`;
        
        if (titleLength > 70) {
          titleCounter.classList.add('text-amber-400');
          titleCounter.classList.remove('text-gray-400');
        } else {
          titleCounter.classList.add('text-gray-400');
          titleCounter.classList.remove('text-amber-400');
        }
        
        if (descLength > 4500) {
          descCounter.classList.add('text-amber-400');
          descCounter.classList.remove('text-gray-400');
        } else {
          descCounter.classList.add('text-gray-400');
          descCounter.classList.remove('text-amber-400');
        }
        
        submitButton.disabled = !(titleInput.value.trim() && descTextarea.value.trim());
      };
      
      titleInput.addEventListener('input', updateCounters);
      descTextarea.addEventListener('input', updateCounters);
      updateCounters();
    }
  }
  
  // Обработчик отправки формы
  function setupReportForm() {
    const reportForm = document.getElementById('report_form');
    if (reportForm) {
      reportForm.addEventListener('submit', function(event) {
        event.preventDefault();
        submitReport();
      });
    }
  }
  // Функция отправки жалобы
  async function submitReport() {
    const title = document.getElementById('report_title').value;
    const description = document.getElementById('report_description').value;
    
    if (!title.trim() || !description.trim()) {
      showAlertNotification("<%= t('reports.errors.empty_fields') %>");
      return;
    }
    
    const reportedUserId = document.querySelector('#report_modal').dataset.userId;
    if (!reportedUserId) {
      showAlertNotification("<%= t('reports.errors.no_user_specified') %>");
      return;
    }
    
    const submitButton = document.getElementById('report_submit');
    const originalText = submitButton.innerHTML;
    submitButton.disabled = true;
    submitButton.innerHTML = `
      <span class="loading loading-spinner loading-md"></span>
      <span class="ml-2"><%= t('reports.form.sending') %></span>
    `;
    
    try {
      const formData = new FormData();
      formData.append('title', title);
      formData.append('description', description);
      formData.append('reported_user_id', reportedUserId);
      const reporterId = "<%= current_user.id %>";
      formData.append('reporter_id', reporterId);
      
      if (window.filesToDelete && window.filesToDelete.length > 0) {
        const validFilesToDelete = window.filesToDelete.filter(id => {
          return id !== null && 
                 id !== undefined && 
                 id !== "" && 
                 id !== "null" && 
                 !isNaN(id) && 
                 id > 0;
        });
        
        validFilesToDelete.forEach((fileId, index) => {
          formData.append(`files_to_delete[${index}]`, fileId);
        });
      }
      
      existingFiles.forEach((file, index) => {
        formData.append(`existing_files[${index}]`, file.url);
      });
      
      uploadedFiles.forEach((fileObj, index) => {
        formData.append(`files[${index}]`, fileObj.file);
      });
      
      // Формируем URL для прямого запроса к сервису авторизации
      const authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>";
      const url = `${authServiceUrl}/api/v1/user/add_report/${reportedUserId}`;
      
      const response = await fetch(url, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        },
        credentials: 'include'
      });
      
      const data = await response.json();
      
      if (response.ok) {
        closeReportModal();
        showNotification("<%= t('reports.notifications.report_sent') %>");
      } else {
        showAlertNotification("<%= t('reports.errors.send_error') %>");
      }
    } catch (error) {
      console.error('Error:', error);
      showAlertNotification("<%= t('reports.errors.send_error') %>");
    } finally {
      submitButton.disabled = false;
      submitButton.innerHTML = originalText;
    }
  }
  
  // Инициализация при загрузке документа
  document.addEventListener('DOMContentLoaded', function() {
    updateCharCounters();
    setupReportForm();
    
    const style = document.createElement('style');
    style.innerHTML = `
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes fadeOut {
        from { opacity: 1; transform: scale(1); }
        to { opacity: 0; transform: scale(0.95); }
      }
      .animate-fadeIn {
        animation: fadeIn 0.3s ease-out forwards;
      }
      .animate-fadeOut {
        animation: fadeOut 0.3s ease-in forwards;
      }
    `;
    document.head.appendChild(style);
    
    renderAllMedia();
    
    document.getElementById('prev-media').addEventListener('click', () => navigateMedia('prev'));
    document.getElementById('next-media').addEventListener('click', () => navigateMedia('next'));
    
    document.getElementById('download-media').addEventListener('click', function() {
      const allFiles = getAllFiles();
      
      if (allFiles.length > 0 && currentMediaIndex >= 0) {
        const file = allFiles[currentMediaIndex];
        
        if (file.type === 'existing') {
          fetch(file.url)
            .then(response => response.blob())
            .then(blob => {
              const url = window.URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = url;
              a.download = file.filename || 'file';
              document.body.appendChild(a);
              a.click();
              window.URL.revokeObjectURL(url);
              document.body.removeChild(a);
            })
            .catch(error => {
              console.error('Error downloading file:', error);
              showAlertNotification('<%= t('reports.errors.download_error') %>');
            });
        } else {
          const link = document.createElement('a');
          link.href = URL.createObjectURL(file.file);
          link.download = file.file.name;
          link.click();
        }
      }
    });
    
    document.getElementById('revoke-report-btn').addEventListener('click', revokeReport);
  });
</script>
