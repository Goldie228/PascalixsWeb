<div class="w-full mx-auto pb-8 px-4 sm:px-6 lg:px-8" data-user-id="<%= current_user.id %>" data-user-nickname="<%= current_user.minecraft_account.nickname %>" data-time-zone="<%= session[:time_zone] || 'UTC' %>" data-user-locale="<%= current_user.locale || I18n.locale %>">
    <h1 class="text-4xl font-bold text-center mb-10 text-white"><%= t('views.admin.donations.index.title') %></h1>
    
    <!-- Панель управления -->
    <div class="bg-[#1A1A1A] rounded-2xl p-6 mb-10 border border-[#2D2D2D] shadow-xl">
        <!-- Первая строка элементов управления -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
            <div class="form-control w-full md:w-auto">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-amber-400 font-semibold text-sm md:text-base"><%= t('views.admin.donations.index.records_per_page') %></span>
                    
                    <div class="dropdown dropdown-end">
                        <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                            <span class="text-xs md:text-sm" id="perPageLabel">50</span>
                            <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </label>
                        <ul class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-32 mt-1">
                            <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="25">25</a></li>
                            <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="50">50</a></li>
                            <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="75">75</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Вторая строка элементов управления -->
        <div class="grid grid-cols-1 md:flex md:flex-row gap-4 md:gap-6 justify-between mb-6">
            <div class="flex flex-col md:flex-row gap-4 md:gap-6 w-full md:w-auto">
                <div class="form-control w-full md:w-auto">
                    <div class="flex items-center gap-2">
                        <span class="text-amber-400 font-semibold text-sm md:text-base"><%= t('views.admin.donations.index.sort_direction') %></span>
                        
                        <div class="dropdown dropdown-end">
                            <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                                <span class="text-xs md:text-sm" id="sortOrderLabel"><%= t('views.admin.donations.index.sort_descending') %></span>
                                <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </label>
                            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-44 md:w-52 mt-1">
                                <li><a href="#" class="sort-order-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="asc"><%= t('views.admin.donations.index.sort_ascending') %></a></li>
                                <li><a href="#" class="sort-order-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="desc"><%= t('views.admin.donations.index.sort_descending') %></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <div class="form-control w-full md:w-auto">
                    <div class="flex items-center gap-2">
                        <span class="text-amber-400 font-semibold text-sm md:text-base"><%= t('views.admin.donations.index.sort_by') %></span>
                        <div class="dropdown dropdown-end">
                            <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                                <span class="text-xs md:text-sm truncate max-w-[100px] md:max-w-none" id="sortByLabel"><%= t('views.admin.donations.index.creation_date') %></span>
                                <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </label>
                            <ul class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-44 md:w-52 mt-1">
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="purchase_type"><%= t('views.admin.donations.index.donation_type') %></a></li>
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="status"><%= t('views.admin.donations.index.status') %></a></li>
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="amount"><%= t('views.admin.donations.index.amount') %></a></li>
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="created_at"><%= t('views.admin.donations.index.creation_date') %></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Фильтры -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-amber-400 mb-1"><%= t('views.admin.donations.index.purchase_type_filter') %></label>
                <select id="purchaseTypeFilter" class="select select-sm md:select-md w-full bg-[#2D2D2D] text-white border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
                    <option value=""><%= t('views.admin.donations.index.all_types') %></option>
                    <option value="pass_purchase"><%= t('views.admin.donations.index.pass_purchase') %></option>
                    <option value="pass_gift"><%= t('views.admin.donations.index.pass_gift') %></option>
                    <option value="sponsor"><%= t('views.admin.donations.index.sponsor') %></option>
                    <option value="unban"><%= t('views.admin.donations.index.unban') %></option>
                    <option value="unmute"><%= t('views.admin.donations.index.unmute') %></option>
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-amber-400 mb-1"><%= t('views.admin.donations.index.status_filter') %></label>
                <select id="statusFilter" class="select select-sm md:select-md w-full bg-[#2D2D2D] text-white border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
                    <option value=""><%= t('views.admin.donations.index.all_statuses') %></option>
                    <option value="pending"><%= t('views.admin.donations.index.pending') %></option>
                    <option value="approved"><%= t('views.admin.donations.index.approved') %></option>
                    <option value="rejected"><%= t('views.admin.donations.index.rejected') %></option>
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-amber-400 mb-1"><%= t('views.admin.donations.index.date_from') %></label>
                <input type="date" id="dateFromFilter" class="input input-sm md:input-md w-full bg-[#2D2D2D] text-white border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-amber-400 mb-1"><%= t('views.admin.donations.index.date_to') %></label>
                <input type="date" id="dateToFilter" class="input input-sm md:input-md w-full bg-[#2D2D2D] text-white border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
            </div>
        </div>
    </div>
    
    <!-- Контейнер для карточек донаций - изменено на 2 колонки на десктопе -->
    <div id="donationsContainer" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Карточки будут загружены через JavaScript -->
    </div>
    
    <!-- Пагинация -->
    <div id="paginationContainer" class="flex justify-center items-center gap-2 mt-10 flex-wrap px-4 overflow-x-auto">
        <!-- Пагинация будет загружена через JavaScript -->
    </div>
</div>
<!-- Добавляем модальное окно для подтверждения удаления -->
<dialog id="confirm_purchase_deletion_modal" class="modal">
  <div class="modal-box w-full max-w-xl bg-[#1A1A1A] border border-red-500 p-8 rounded">
    <h3 class="text-2xl text-red-400 font-bold mb-4 break-words hyphens-auto">
      <%= t('views.admin.donations.index.confirm_deletion_title') %>
    </h3>
    <p class="text-sm text-[#AAAAAA] leading-relaxed mb-6 break-words hyphens-auto">
      <%= t('views.admin.donations.index.confirm_deletion_text') %>
      <span id="purchase-info-to-delete" class="text-amber-400 font-semibold"></span>?<br>
      <%= t('views.admin.donations.index.confirm_deletion_irreversible') %>
    </p>
    <div class="modal-action flex justify-end space-x-3 flex-wrap gap-y-2">
      <button
        type="button"
        class="btn text-sm px-4 py-2 text-gray-300 bg-[#2D2D2D] hover:bg-[#3A3A3A] transition whitespace-nowrap"
        onclick="closePurchaseDeletionModal()"
      >
        <%= t('views.admin.donations.index.cancel') %>
      </button>
      <button
        id="delete-purchase-btn"
        type="button"
        class="btn bg-red-600 text-white hover:bg-red-700 px-4 py-2 text-sm font-semibold transition whitespace-nowrap"
        onclick="proceedPurchaseDeletion()"
      >
        <%= t('views.admin.donations.index.delete') %>
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>
<div id="donation-images" 
     data-pass-purchase="<%= asset_path('donate/donate.png') %>" 
     data-pass-gift="<%= asset_path('donate/present.png') %>" 
     data-sponsor="<%= asset_path('donate/sponsor.png') %>" 
     data-unban="<%= asset_path('donate/unban.png') %>" 
     data-unmute="<%= asset_path('donate/mute.png') %>">
</div>
<script>
    // Создаем объект с переводами, переданными из Rails
    const translations = {
        loading_data: "<%= j t('views.admin.donations.index.loading_data') %>",
        error_loading_data: "<%= j t('views.admin.donations.index.error_loading_data') %>",
        error_loading_data_table: "<%= j t('views.admin.donations.index.error_loading_data_table') %>",
        no_data: "<%= j t('views.admin.donations.index.no_data') %>",
        view_button: "<%= j t('views.admin.donations.index.view_button') %>",
        delete_button: "<%= j t('views.admin.donations.index.delete_button') %>",
        confirm_delete: "<%= j t('views.admin.donations.index.confirm_delete') %>",
        delete_success: "<%= j t('views.admin.donations.index.delete_success') %>",
        delete_error: "<%= j t('views.admin.donations.index.delete_error') %>",
        confirm_deletion_title: "<%= j t('views.admin.donations.index.confirm_deletion_title') %>",
        confirm_deletion_text: "<%= j t('views.admin.donations.index.confirm_deletion_text') %>",
        confirm_deletion_irreversible: "<%= j t('views.admin.donations.index.confirm_deletion_irreversible') %>",
        cancel: "<%= j t('views.admin.donations.index.cancel') %>",
        delete: "<%= j t('views.admin.donations.index.delete') %>",
        previous_page: "<%= j t('views.admin.donations.index.previous_page') %>",
        next_page: "<%= j t('views.admin.donations.index.next_page') %>",
        sort_ascending: "<%= j t('views.admin.donations.index.sort_ascending') %>",
        sort_descending: "<%= j t('views.admin.donations.index.sort_descending') %>",
        pending: "<%= j t('views.admin.donations.index.pending') %>",
        approved: "<%= j t('views.admin.donations.index.approved') %>",
        rejected: "<%= j t('views.admin.donations.index.rejected') %>",
        pass_purchase: "<%= j t('views.admin.donations.index.pass_purchase') %>",
        pass_gift: "<%= j t('views.admin.donations.index.pass_gift') %>",
        sponsor: "<%= j t('views.admin.donations.index.sponsor') %>",
        unban: "<%= j t('views.admin.donations.index.unban') %>",
        unmute: "<%= j t('views.admin.donations.index.unmute') %>",
        table_headers: {
            purchase_type: "<%= j t('views.admin.donations.index.table_headers.purchase_type') %>",
            status: "<%= j t('views.admin.donations.index.table_headers.status') %>",
            amount: "<%= j t('views.admin.donations.index.table_headers.amount') %>",
            creation_date: "<%= j t('views.admin.donations.index.table_headers.creation_date') %>",
            actions: "<%= j t('views.admin.donations.index.table_headers.actions') %>"
        }
    };
    
    // Получаем текущую локаль из Rails
    const currentLocale = "<%= I18n.locale %>";
    let purchaseIdToDelete = null;
    
    // Получаем пути к изображениям из data-атрибутов
    const donationImages = {
        pass_purchase: document.getElementById('donation-images').getAttribute('data-pass-purchase'),
        pass_gift: document.getElementById('donation-images').getAttribute('data-pass-gift'),
        sponsor: document.getElementById('donation-images').getAttribute('data-sponsor'),
        unban: document.getElementById('donation-images').getAttribute('data-unban'),
        unmute: document.getElementById('donation-images').getAttribute('data-unmute')
    };
    
    // Функция для получения перевода
    function t(key) {
        const keys = key.split('.');
        let result = translations;
        
        for (const k of keys) {
            if (result[k] === undefined) {
                return key;
            }
            result = result[k];
        }
        
        return result;
    }
    
    // Инициализация обработчиков событий
    document.addEventListener('DOMContentLoaded', function() {
        // Загрузка данных при загрузке страницы
        loadPurchases();
        
        // Обработчики для выпадающих списков
        document.querySelectorAll('.per-page-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                perPage = parseInt(this.getAttribute('data-value'));
                document.getElementById('perPageLabel').textContent = perPage;
                currentPage = 1; // Сбрасываем на первую страницу
                loadPurchases();
            });
        });
        
        document.querySelectorAll('.sort-order-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                sortOrder = this.getAttribute('data-value');
                document.getElementById('sortOrderLabel').textContent = 
                    sortOrder === 'asc' ? t('sort_ascending') : t('sort_descending');
                loadPurchases();
            });
        });
        
        document.querySelectorAll('.sort-by-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                sortBy = this.getAttribute('data-value');
                document.getElementById('sortByLabel').textContent = this.textContent;
                loadPurchases();
            });
        });
        
        // Обработчики для фильтров - динамическое обновление при изменении
        document.getElementById('purchaseTypeFilter').addEventListener('change', function() {
            filters.purchase_type = this.value;
            currentPage = 1;
            loadPurchases();
        });
        
        document.getElementById('statusFilter').addEventListener('change', function() {
            filters.status = this.value;
            currentPage = 1;
            loadPurchases();
        });
        
        document.getElementById('dateFromFilter').addEventListener('change', function() {
            filters.from = this.value;
            currentPage = 1;
            loadPurchases();
        });
        
        document.getElementById('dateToFilter').addEventListener('change', function() {
            filters.to = this.value;
            currentPage = 1;
            loadPurchases();
        });
    });
    
    // Глобальные переменные для хранения параметров
    let currentPage = 1;
    let perPage = 50;
    let sortBy = 'created_at';
    let sortOrder = 'desc';
    let filters = {
        purchase_type: '',
        status: '',
        from: '',
        to: ''
    };
    let isLoading = false; // Флаг для отслеживания состояния загрузки
    
    // Получаем ID пользователя, никнейм, временную зону и локаль из data-атрибутов
    const actorId = document.querySelector('[data-user-id]').getAttribute('data-user-id');
    const userNickname = document.querySelector('[data-user-nickname]').getAttribute('data-user-nickname');
    const timeZone = document.querySelector('[data-time-zone]').getAttribute('data-time-zone');
    const userLocale = document.querySelector('[data-user-locale]').getAttribute('data-user-locale');
    
    // Функции для управления глобальным индикатором загрузки
    function showGlobalLoading() {
        // Создаем индикатор загрузки, если его еще нет
        if (!document.getElementById('global-loading')) {
            const loadingDiv = document.createElement('div');
            loadingDiv.id = 'global-loading';
            loadingDiv.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
            loadingDiv.innerHTML = `
                <div class="flex flex-col items-center">
                    <div class="w-16 h-16 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
                    <span class="mt-4 text-amber-400 text-lg">${t('loading_data')}</span>
                </div>
            `;
            document.body.appendChild(loadingDiv);
        }
    }
    
    function hideGlobalLoading() {
        const loadingDiv = document.getElementById('global-loading');
        if (loadingDiv) {
            loadingDiv.remove();
        }
    }
    
    // Функция для отображения индикатора загрузки в контейнере
    function showLoading() {
        isLoading = true;
        
        // Для контейнера донаций
        const donationsContainer = document.getElementById('donationsContainer');
        if (donationsContainer) {
            donationsContainer.innerHTML = `
                <div class="col-span-full flex flex-col items-center justify-center py-10 w-full">
                    <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-400 mx-auto"></div>
                    <span class="mt-4 text-white font-medium">${t('loading_data')}</span>
                </div>
            `;
        }
    }
    
    // Функция для загрузки данных с API
    async function loadPurchases() {
        // Если уже идет загрузка, не выполняем новый запрос
        if (isLoading) return;
        
        try {
            // Показываем индикатор загрузки
            showLoading();
            
            // Формируем URL с параметрами
            const params = new URLSearchParams();
            params.append('page', currentPage);
            params.append('per', perPage);
            params.append('sort_by', sortBy);
            params.append('sort_order', sortOrder);
            
            // Добавляем фильтры
            Object.keys(filters).forEach(key => {
                if (filters[key]) {
                    params.append(key, filters[key]);
                }
            });
            
            const authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>";
            const url = `${authServiceUrl}/api/v1/purchases/${userNickname}?${params.toString()}`;
            
            // Отправляем запрос с куками и заголовком X-Actor-Id
            const response = await fetch(url, {
                method: 'GET',
                credentials: 'include', // Включаем куки
                headers: {
                    'X-Actor-Id': actorId
                }
            });
            
            if (!response.ok) {
                throw new Error(`Ошибка HTTP: ${response.status}`);
            }
            
            const data = await response.json();
            
            // Обновляем контейнер с донациями
            updateDonationsContainer(data.purchases);
            
            // Обновляем пагинацию
            updatePagination(data.pagination);
            
        } catch (error) {
            showAlertNotification(t('error_loading_data'));
            
            // Показываем сообщение об ошибке в контейнере
            const donationsContainer = document.getElementById('donationsContainer');
            if (donationsContainer) {
                donationsContainer.innerHTML = `
                    <div class="col-span-full bg-[#383838] rounded-lg p-4 shadow-md text-red-400 text-center">
                        ${t('error_loading_data_table')}
                    </div>
                `;
            }
        } finally {
            // Сбрасываем флаг загрузки
            isLoading = false;
        }
    }
    
    // Функция для получения названия статуса покупки
    function getStatusName(status) {
        const names = {
            'pending':  t('pending'),
            'approved': t('approved'),
            'rejected': t('rejected')
        };
    
        return names[status] || status;
    }
    
    // Функция для обновления контейнера с донациями
    function updateDonationsContainer(purchases) {
        const donationsContainer = document.getElementById('donationsContainer');
        
        if (purchases.length === 0) {
            donationsContainer.innerHTML = `
                <div class="col-span-full bg-[#383838] rounded-xl p-8 shadow-lg border border-[#2D2D2D] text-center">
                    <div class="flex flex-col items-center justify-center py-6">
                        <svg class="w-16 h-16 text-amber-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                        <h3 class="text-xl font-semibold text-white mb-2">${t('no_data')}</h3>
                        <p class="text-gray-400">Попробуйте изменить параметры фильтрации</p>
                    </div>
                </div>
            `;
            return;
        }
        
        // Обновляем контейнер с донациями
        donationsContainer.innerHTML = purchases.map(purchase => {
            // Форматируем дату с учетом временной зоны и локали пользователя
            const createdDate = formatDateWithTimeZone(purchase.created_at, timeZone, userLocale);
            
            // Используем функцию getStatusName для определения статуса
            const statusText = getStatusName(purchase.status);
            
            // Определяем класс для статуса
            let statusClass = '';
            let statusIcon = '';
            switch (purchase.status) {
                case 'pending':
                    statusClass = 'bg-amber-400 text-black';
                    statusIcon = `
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    `;
                    break;
                case 'approved':
                    statusClass = 'bg-green-500 text-black';
                    statusIcon = `
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                    `;
                    break;
                case 'rejected':
                    statusClass = 'bg-red-500 text-black';
                    statusIcon = `
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    `;
                    break;
                default:
                    statusClass = 'bg-[#525252] text-white';
                    break;
            }
            
            // Получаем изображение для типа покупки
            const purchaseImage = donationImages[purchase.purchase_type] || donationImages.pass_purchase;
            
            return `
                <div class="donation-card bg-[#383838] rounded-2xl p-6 shadow-lg border border-[#2D2D2D] transition-all duration-300 hover:shadow-amber-900/20 hover:border-amber-400/30 group" 
                     data-purchase-id="${purchase.id}" 
                     data-purchaser-uuid="${purchase.purchaser_minecraft_uuid}" 
                     data-purchase-type="${purchase.purchase_type}"
                     data-target-user-id="${purchase.target_user_id || ''}">
                    <div class="flex justify-between items-start mb-5">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 flex items-center justify-center bg-[#2D2D2D] rounded-xl group-hover:bg-amber-400/10 transition-colors">
                                <img src="${purchaseImage}" alt="${getPurchaseTypeText(purchase.purchase_type)}" class="w-7 h-7 object-contain">
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-white">${getPurchaseTypeText(purchase.purchase_type)}</h3>
                            </div>
                        </div>
                        <span class="px-3 py-1.5 rounded-full ${statusClass} text-xs font-medium flex items-center">
                            ${statusIcon}
                            ${statusText}
                        </span>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4 mb-5">
                        <div class="bg-[#2D2D2D] p-4 rounded-xl">
                            <p class="text-gray-400 text-xs mb-1 uppercase tracking-wider">${t('table_headers.amount')}</p>
                            <p class="text-white font-bold text-xl">${purchase.amount} ${purchase.currency}</p>
                        </div>
                        <div class="bg-[#2D2D2D] p-4 rounded-xl">
                            <p class="text-gray-400 text-xs mb-1 uppercase tracking-wider">${t('table_headers.creation_date')}</p>
                            <p class="text-white text-sm">${createdDate}</p>
                        </div>
                    </div>
                    
                    <div class="flex justify-end">
                        <div class="flex gap-2">
                            <button class="btn btn-sm bg-amber-400 text-black hover:bg-amber-300 border-none transition view-btn flex items-center gap-1" data-id="${purchase.id}">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                ${t('view_button')}
                            </button>
                            <button class="btn btn-sm bg-red-500 text-white hover:bg-red-400 border-none transition delete-btn flex items-center gap-1" data-id="${purchase.id}">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                                ${t('delete_button')}
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
        
        // Добавляем обработчики событий для кнопок действий
        addActionListeners();
    }
    
    // Функция для открытия модального окна удаления покупки
    function openPurchaseDeletionModal(purchaseId, purchaseInfo) {
        purchaseIdToDelete = purchaseId;
        document.getElementById('purchase-info-to-delete').textContent = purchaseInfo;
        const modal = document.getElementById('confirm_purchase_deletion_modal');
        if (modal) modal.showModal();
    }
    
    // Функция для закрытия модального окна удаления покупки
    function closePurchaseDeletionModal() {
        const modal = document.getElementById('confirm_purchase_deletion_modal');
        if (modal) modal.close();
        purchaseIdToDelete = null;
    }
    
    // Функция для подтверждения удаления покупки
    function proceedPurchaseDeletion() {
        if (purchaseIdToDelete) {
            deletePurchase(purchaseIdToDelete);
            closePurchaseDeletionModal();
        }
    }
    
    // Функция для удаления покупки
    async function deletePurchase(purchaseId) {
        try {
            // Показываем глобальный индикатор загрузки
            showGlobalLoading();
            
            const authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>";
            const url = `${authServiceUrl}/api/v1/purchases/${purchaseId}`;
            
            // Отправляем DELETE запрос
            const response = await fetch(url, {
                method: 'DELETE',
                credentials: 'include', // Включаем куки
                headers: {
                    'X-Actor-Id': actorId
                }
            });
            
            if (!response.ok) {
                throw new Error(`Ошибка HTTP: ${response.status}`);
            }
            
            // Показываем уведомление об успехе
            showNotification(t('delete_success'));
            
            // Обновляем список покупок
            loadPurchases();
            
        } catch (error) {
            showAlertNotification(t('delete_error'));
            console.error('Ошибка при удалении покупки:', error);
        } finally {
            // Скрываем глобальный индикатор загрузки
            hideGlobalLoading();
        }
    }
    
    // Функция для форматирования даты с учетом временной зоны и локали пользователя
    function formatDateWithTimeZone(dateString, timeZone, locale) {
        const date = new Date(dateString);
        
        // Преобразование временной зоны в формат IANA
        const timeZoneNameMap = {
            'Moscow': 'Europe/Moscow',
            'Kaliningrad': 'Europe/Kaliningrad',
            'Samara': 'Europe/Samara',
            'Yekaterinburg': 'Asia/Yekaterinburg',
            'Omsk': 'Asia/Omsk',
            'Krasnoyarsk': 'Asia/Krasnoyarsk',
            'Irkutsk': 'Asia/Irkutsk',
            'Yakutsk': 'Asia/Yakutsk',
            'Vladivostok': 'Asia/Vladivostok',
            'Magadan': 'Asia/Magadan',
            'Kamchatka': 'Asia/Kamchatka'
        };
        
        // Получаем правильный формат временной зоны или используем переданную
        const ianaTimeZone = timeZoneNameMap[timeZone] || timeZone;
        
        try {
            // Опции форматирования
            const options = {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                timeZone: ianaTimeZone
            };
            
            // Форматируем дату с учетом локали пользователя
            return new Intl.DateTimeFormat(locale, options).format(date);
        } catch (error) {
            console.error('Ошибка с временной зоной ' + ianaTimeZone + ':', error);
            
            // В случае ошибки используем UTC
            const options = {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                timeZone: 'UTC'
            };
            
            return new Intl.DateTimeFormat(locale, options).format(date);
        }
    }
    
    // Функция для обновления пагинации
    function updatePagination(pagination) {
        const container = document.getElementById('paginationContainer');
        const totalPages = Math.ceil(pagination.total / pagination.per);
        
        if (totalPages <= 1) {
            container.innerHTML = '';
            return;
        }
        
        let paginationHTML = '';
        
        // Определяем диапазон страниц для отображения
        let pageRange = [];
        if (totalPages <= 7) {
            pageRange = Array.from({length: totalPages}, (_, i) => i + 1);
        } else {
            if (currentPage <= 4) {
                pageRange = [1, 2, 3, 4, 5, '...', totalPages];
            } else if (currentPage >= totalPages - 3) {
                pageRange = [1, '...', totalPages - 4, totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
            } else {
                pageRange = [1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages];
            }
        }
        
        // Кнопка "Предыдущая"
        if (currentPage > 1) {
            paginationHTML += `
                <button class="btn border-amber-400 bg-[#121212] text-white hover:bg-[#1a1a1a] transition btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${currentPage - 1}">
                    ${t('previous_page')}
                </button>
            `;
        }
        
        // Страницы
        pageRange.forEach(page => {
            if (page === '...') {
                paginationHTML += `<span class="text-white px-2 whitespace-nowrap">...</span>`;
            } else {
                const isActive = page === currentPage;
                paginationHTML += `
                    <button class="btn border-amber-400 transition ${isActive ? 'bg-amber-400 text-black font-semibold shadow-md' : 'bg-[#121212] text-white hover:bg-[#1a1a1a]'} btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${page}">
                        ${page}
                    </button>
                `;
            }
        });
        
        // Кнопка "Следующая"
        if (currentPage < totalPages) {
            paginationHTML += `
                <button class="btn border-amber-400 bg-[#121212] text-white hover:bg-[#1a1a1a] transition btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${currentPage + 1}">
                    ${t('next_page')}
                </button>
            `;
        }
        
        container.innerHTML = paginationHTML;
        
        // Добавляем обработчики событий для кнопок пагинации
        document.querySelectorAll('.page-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                currentPage = parseInt(this.getAttribute('data-page'));
                loadPurchases();
            });
        });
    }
    
    // Функция для добавления обработчиков событий для кнопок действий
    function addActionListeners() {
        // Кнопка "Просмотр"
        document.querySelectorAll('.view-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                // Находим родительский элемент (карточку) по классу donation-card
                const parent = this.closest('.donation-card');
                
                if (!parent) return;
                
                // Получаем данные о покупке из атрибутов
                const purchaserUuid = parent.getAttribute('data-purchaser-uuid');
                const purchaseType = parent.getAttribute('data-purchase-type');
                const targetUserId = parent.getAttribute('data-target-user-id');
                
                // Определяем, нужно ли передавать target_user_id
                // Только для типа pass_gift (подарок проходки) и только если target_user_id не пустой
                let recipientUuid = null;
                if (purchaseType === 'pass_gift' && targetUserId && targetUserId !== '') {
                    recipientUuid = targetUserId;
                }
                
                // Проверяем, существует ли функция открытия модального окна администратора
                if (typeof openAdminPurchaseModal === 'function') {
                    // Вызываем функцию открытия модального окна администратора с правильными параметрами
                    openAdminPurchaseModal(purchaseType, purchaserUuid, recipientUuid, userNickname);
                }
            });
        });
        
        // Кнопка "Удалить"
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const purchaseId = this.getAttribute('data-id');
                
                // Находим родительский элемент (карточку) по классу donation-card
                const parent = this.closest('.donation-card');
                
                if (!parent) return;
                
                // Получаем информацию о покупке для отображения в модальном окне
                let purchaseInfo = '';
                if (parent.querySelector('h3')) {
                    const purchaseType = parent.querySelector('h3').textContent.trim();
                    const amount = parent.querySelector('.grid div:first-child p:last-child').textContent.trim();
                    purchaseInfo = `${purchaseType} (${amount})`;
                }
                
                // Открываем модальное окно подтверждения удаления
                openPurchaseDeletionModal(purchaseId, purchaseInfo);
            });
        });
    }
        
    // Функция для получения текстового представления типа покупки
    function getPurchaseTypeText(type) {
        switch (type) {
            case 'pass_purchase': return t('pass_purchase');
            case 'pass_gift': return t('pass_gift');
            case 'sponsor': return t('sponsor');
            case 'unban': return t('unban');
            case 'unmute': return t('unmute');
            default: return type;
        }
    }
    
    // Функция для отображения уведомления
    function showNotification(message) {
        // Проверяем, существует ли функция для отображения уведомлений
        if (typeof window.showNotification === 'function') {
            window.showNotification(message);
        } else {
            // Запасной вариант - вывод в консоль
            console.log('Notification:', message);
        }
    }
    
    // Функция для отображения уведомления об ошибке
    function showAlertNotification(message) {
        // Проверяем, существует ли функция для отображения уведомлений об ошибках
        if (typeof window.showAlertNotification === 'function') {
            window.showAlertNotification(message);
        } else {
            // Запасной вариант - вывод в консоль
            console.error('Alert Notification:', message);
        }
    }
</script>
