  <!-- Основной контент -->
  <div class="bg-[#1A1A1A] w-full md:h-93 md:rounded-r-lg md:rounded-l-none rounded-b-lg shadow-lg overflow-hidden">
    <div class="relative flex flex-col md:flex-row md:justify-start items-center justify-center h-full p-5 md:p-10">
      
      <!-- Блок с изображением -->
	  <div class="flex md:hidden lg:flex md:items-start justify-center pr-0 md:pr-6 pt-6 pb-6 max-h-[450px] max-w-[550px]">
	    <%= image_tag "profile_page/1.png", class: "rounded-lg max-h-full w-auto" %>
      </div>
      
      <!-- Текстовый блок -->
      <div class="text-center md:text-left mt-4 md:mt-0">
        <h1 class="text-white text-3xl md:text-4xl"><strong>Национальная Партия Октадиана</strong></h1>
        <div class="flex flex-wrap items-center justify-center md:justify-start pt-2 gap-2">
          <div class="text-white bg-red-500 rounded-lg pt-1 pb-1 pl-3 pr-3 inline-block">
            Улица Маяковского 1
          </div>
          <div class="text-white bg-red-500 rounded-lg pt-1 pb-1 pl-3 pr-3 inline-block">
            Улица Машерова 4
          </div>
        </div>
        <h3 class="text-gray-400 pt-4">
          Партия, созданная во благо Октодиана и его будущего. Партия продвигает правые идеи, которые желает народ!
        </h3>
      </div>
    </div>
  </div>
