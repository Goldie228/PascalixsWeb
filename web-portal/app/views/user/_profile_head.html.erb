<div class="bg-[#1A1A1A] rounded-lg shadow-lg mt-4 mb-4 mx-auto w-[90%] max-w-8xl overflow-hidden px-4 py-8">
  <div class="flex flex-col items-center md:flex-row">
    
    <!-- Avatar -->
    <div class="relative mb-6 md:mb-0 md:ml-8">
      <div class="relative w-[150px] md:w-[208px] aspect-square flex items-center justify-center group">
        <div class="relative w-full h-full flex items-center justify-center">
          <!-- Обводка с анимацией уменьшения -->
          <div class="absolute z-10 inset-0 rounded-full border-4"
               style="border-color: <%= @web_role_color.presence || '#A0A0A0' %>;">
          </div>
          
          <!-- Изображение без обводки -->
          <img
            src="<%= @player.discord_account.avatar %>"
            class="object-cover w-full h-full rounded-full transition-all duration-300 group-hover:brightness-75 z-0"
            onerror="this.onerror=null;this.src='<%= asset_path('steve.webp') %>';"
          >
          
          <!-- Иконка камеры (появляется при наведении) -->
          <% if @edit %>
            <div class="absolute inset-0 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 cursor-pointer rounded-full z-20" 
                 onclick="openAvatarModal()">
              <div class="bg-black/50 rounded-full p-3 flex items-center justify-center mb-2">
                <!-- Иконка камеры -->
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-white">
                  <g transform="matrix(0.43 0 0 0.43 12 12)" >
                    <path style="stroke: white; stroke-width: 3; stroke-dasharray: none; stroke-linecap: round; stroke-dashoffset: 0; stroke-linejoin: miter; stroke-miterlimit: 10; fill: none; fill-rule: nonzero; opacity: 1;" 
                          transform=" translate(-25, -25)" 
                          d="M 46 12 L 37 12 C 35.531 12 34.516 8 33 8 L 17 8 C 15.484 8 14.469 12 13 12 L 4 12 C 2.895 12 2 12.896 2 14 L 2 40 C 2 41.104 2.895 42 4 42 L 46 42 C 47.104 42 48 41.104 48 40 L 48 14 C 48 12.896 47.104 12 46 12 z M 25 20 L 25 34 M 18 27 L 32 27" 
                          stroke-linecap="round" />
                  </g>
                </svg>
              </div>
              <span class="text-white text-sm font-semibold bg-black/70 px-2 py-1 rounded-full transition-opacity">
                <%= t('avatar.change') %>
              </span>
            </div>
          <% end %>
          <% if @web_role.present? && @web_role != "User" %>
            <div class="z-30">
              <%= render "status" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
        
    <!-- Основной текст -->
    <div class="w-full md:ml-8 text-center md:text-left">
      <% if @nickname %>
        <div class="flex flex-col md:flex-row items-center md:items-start flex-wrap gap-2">
          <h1 class="truncate font-extrabold text-3xl md:text-4xl">
            <%= @nickname %>
          </h1>
          <div class="flex flex-wrap justify-center gap-2">
            <% if @web_role.present? && !(@web_role.include?("User") || @web_role.include?("Player")) %>
              <div
                class="text-white text-sm font-bold rounded-full px-4 py-1 md:px-6 md:py-2 w-fit text-md md:text-xl"
                style="background-color: <%= @web_role_color %>;"
              >
                <%= @web_role %>
              </div>
            <% end %>
            <% media_labels = [] %>
            <% if @player.youtube_url.present? %>
              <% media_labels << { name: "YOUTUBER", color: "#FF0000" } %>
            <% end %>
            <% if @player.twitch_url.present? %>
              <% media_labels << { name: "TWITCHER", color: "#9146FF" } %>
            <% end %>
            <% if @player.tiktok_url.present? %>
              <% media_labels << { name: "TIKTOKER", color: "#69C9D0" } %>
            <% end %>
            <% if @player.is_sponsor %>
              <% media_labels << { name: "SPONSOR", color: "#FFD700" } %>
            <% end %>
            <% media_labels.each do |label| %>
              <div
                class="text-black text-sm font-bold rounded-full px-4 py-1 md:px-6 md:py-2 w-fit text-md md:text-xl shadow-md"
                style="background-color: <%= label[:color] %>;"
              >
                <%= label[:name] %>
              </div>
            <% end %>
            <% if @is_banned %>
              <div
                class="text-white text-sm font-bold rounded-full px-4 py-1 md:px-6 md:py-2 w-fit text-md md:text-xl shadow-md"
                style="background-color: #dc2626;"
              >
                BAN
              </div>
            <% elsif @is_muted %>
              <div
                class="text-black text-sm font-bold rounded-full px-4 py-1 md:px-6 md:py-2 w-fit text-md md:text-xl shadow-md"
                style="background-color: #ca8a04;"
              >
                MUTE
              </div>
            <% end %>
          </div>
        </div>
        <h2
          class="mt-2 text-md md:text-xl"
          style="color: <%= @web_role_color.presence || '#A0A0A0' %>;"
        >
          @<%= @player.discord_account.username %>
        </h2>
      <% elsif @player.discord_account.present? %>
        <span class="text-md md:text-xl font-bold text-white truncate">
          <%= @player.discord_account.username %>
        </span>
      <% end %>
      <!-- Minecraft роли -->
      <div
        id="roles-container"
        class="flex flex-wrap gap-2 mt-4 justify-center md:justify-start"
      >
        <% if @web_role.present? && @web_role != "User" %>
          <% first_roles   = @mc_roles.first(11) %>
          <% remaining     = @mc_roles.drop(11) || [] %>
          <% first_roles.each do |_, role| %>
            <% color = role["color"] || role[:color] %>
            <% name  = role["name"]  || role[:name]  %>
            <span
              class="badge badge-soft text-sm md:text-xl h-auto w-auto"
              style="background-color: rgba(<%= color.scan(/\w\w/).map { |c| c.hex }.join(', ') %>, 0.2); color: <%= color %>; border: 0;"
            >
              <%= name %>
            </span>
          <% end %>
          <% if remaining.any? %>
            <span
              id="show-more"
              class="badge badge-soft cursor-pointer transition-colors hover:bg-gray-600/20 text-sm md:text-xl h-auto w-auto"
              style="background-color: rgba(128,128,128,0.2); color: #989898; border: 0;"
              onclick="toggleRoles()"
            >
              +<%= remaining.size %>...
            </span>
            <div id="hidden-roles" class="hidden flex flex-wrap gap-2">
              <% remaining.each do |_, role| %>
                <% color = role["color"] || role[:color] %>
                <% name  = role["name"]  || role[:name]  %>
                <span
                  class="badge badge-soft text-sm md:text-xl h-auto w-auto"
                  style="background-color: rgba(<%= color.scan(/\w\w/).map { |c| c.hex }.join(', ') %>, 0.2); color: <%= color %>; border: 0;"
                >
                  <%= name %>
                </span>
              <% end %>
              <span
                class="badge badge-soft cursor-pointer transition-colors hover:bg-gray-600/20 text-sm md:text-xl h-auto w-auto"
                style="background-color: rgba(128,128,128,0.2); color: #989898; border: 0;"
                onclick="toggleRoles()"
              >
                <%= t("roles.collapse") %>
              </span>
            </div>
          <% end %>
        <% else %>
          <span
            class="badge badge-soft text-sm md:text-xl h-auto w-auto"
            style="background-color: rgba(128,128,128,0.2); color: #989898; border: 0;"
          >
            <%= t("roles.no_pass") %>
          </span>
        <% end %>
      </div>
    </div>
    
    <% if @player.present? && @player.user_id.present? && \
    @player.user_id != current_user.id && !@user_is_banned && !@user_is_muted %>
      <!-- Кнопка жалобы на пользователя (для десктопа) -->
      <div class="hidden md:flex md:items-center md:justify-center md:mr-8">
        <button 
          onclick="openReportModal('<%= @player.user_id %>')"
          class="flex items-center justify-center gap-2 bg-[#2D2D2D] hover:bg-red-600 text-white font-bold py-2 px-4 rounded-lg transition-colors duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          <%= t('report.player_button.trigger') %>
        </button>
      </div>
      <!-- Кнопка жалобы на пользователя (для мобильной версии) -->
      <div class="md:hidden mt-6 flex justify-center">
        <button 
          onclick="openReportModal('<%= @player.user_id %>')"
          class="flex items-center justify-center gap-2 bg-[#2D2D2D] hover:bg-red-600 text-white font-bold py-3 px-6 rounded-lg transition-colors duration-200 w-full max-w-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          <%= t('report.player_button.trigger') %>
        </button>
      </div>
    <% end %>
  </div>
</div>

<script>
  function toggleRoles() {
    const hiddenRoles = document.getElementById('hidden-roles');
    const showMoreButton = document.getElementById('show-more');
    
    hiddenRoles.classList.toggle('hidden');
    showMoreButton.classList.toggle('hidden');
    
    // Прокрутка к новым элементам при разворачивании
    if (!hiddenRoles.classList.contains('hidden')) {
      hiddenRoles.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }
</script>
