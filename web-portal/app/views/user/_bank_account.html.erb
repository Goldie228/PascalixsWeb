<div class="mx-auto pb-4 w-[90%] max-w-8xl">
	<div class="flex flex-col md:flex-row md:items-start md:justify-start">
		<div>
			<h1 class="text-white text-3xl pb-4"><b>Банковский счёт</b></h1>

			<div class="relative pb-4">
			  <!-- Основной фон -->
			  <div class="w-full md:w-80 h-[152px] md:h-38 bg-amber-400 rounded-tl-md rounded-tr-[64px] rounded-bl-md rounded-br-md"></div>
			  
			  <!-- Правый выступ -->
			  <div class="absolute top-[96px] right-0 w-[136px] h-[56px] bg-amber-400 rounded-lg 
			              md:top-24 md:w-34 md:left-51"></div>
			  
			  <!-- Основная карточка - ИЗМЕНЕНИЯ ЗДЕСЬ -->
			  <div class="absolute botton-2 top-[0px] left-2 w-[calc(100%-8px)] h-[144px] bg-[#1A1A1A] rounded-lg ml-0
			              md:w-[332px] md:left-2 md:top-0">
			    <!-- Индикатор -->
			    <div class="absolute top-[100px] right-5 w-[52px] h-[24px] bg-amber-400 rounded-sm 
			                md:top-25 md:w-13 md:left-66"></div>
			    
			    <!-- Текстовый контент -->
			    <div class="absolute left-4 top-4 md:left-8 md:top-5">
			      <div class="text-white text-2xl md:text-2xl">Личный счёт</div>
			      <div class="text-white text-4xl md:text-4xl mt-1">640000 МАР</div>
			      <div class="text-gray-400 text-base md:text-md mt-1">10000 стаков</div>
			    </div>
			  </div>
			</div>

			<div class="relative">
			  <!-- Основной фон -->
			  <div class="w-full md:w-80 h-[152px] md:h-38 bg-red-500 rounded-tl-md rounded-tr-[64px] rounded-bl-md rounded-br-md"></div>
			  
			  <!-- Правый выступ -->
			  <div class="absolute top-[96px] right-0 w-[136px] h-[56px] bg-red-500 rounded-lg 
			              md:top-24 md:w-34 md:left-51"></div>
			  
			  <!-- Основная карточка - ИЗМЕНЕНИЯ ЗДЕСЬ -->
			  <div class="absolute botton-2 top-[0px] left-2 w-[calc(100%-8px)] h-[144px] bg-[#1A1A1A] rounded-lg ml-0
			              md:w-[332px] md:left-2 md:top-0">
			    <!-- Индикатор -->
			    <div class="absolute top-[100px] right-5 w-[52px] h-[24px] bg-red-500 rounded-sm 
			                md:top-25 md:w-13 md:left-66"></div>
			    
			    <!-- Текстовый контент -->
			    <div class="absolute left-4 top-4 md:left-8 md:top-5">
			      <div class="text-white text-2xl md:text-2xl">Счёт партии</div>
			      <div class="text-white text-4xl md:text-4xl mt-1">1488 МАР</div>
			      <div class="text-gray-400 text-base md:text-md mt-1">24 стаков</div>
			    </div>
			  </div>
			</div>
		</div>

		<%= render "batch_info" %>
	</div>
</div>
