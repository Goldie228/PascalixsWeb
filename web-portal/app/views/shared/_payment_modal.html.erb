<dialog id="purchase_modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="purchase-modal-title">
  <div class="scale-in">
    <div class="flex items-center justify-center min-h-screen bg-black/50">
      <div class="modal-box max-w-2xl w-full bg-[#1A1A1A] rounded-lg shadow-lg relative h-auto overflow-y-auto">
        <!-- Кнопка закрытия -->
        <form method="dialog" class="absolute right-6 top-6 z-10" form="purchase_modal">
          <button class="btn btn-circle btn-ghost text-amber-400 hover:bg-amber-400/20" aria-label="<%= t('views.purchases.modal.close_modal') %>">
            <svg xmlns="http://www.w3.org/2000/svg" 
                 class="w-6 h-6" 
                 fill="none" 
                 viewBox="0 0 24 24" 
                 stroke="currentColor">
              <path stroke-linecap="round" 
                    stroke-linejoin="round" 
                    stroke-width="2" 
                    d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </form>
        
        <!-- Основное содержимое -->
        <div class="flex flex-col space-y-6">
          <!-- Заголовок -->
          <div class="flex flex-col items-center mb-6 mt-4">
            <h2 id="purchase-modal-title" class="text-3xl font-bold text-center text-amber-400 mb-2"><%= t('views.purchases.modal.confirm_donation') %></h2>
            <p class="text-gray-300 text-center"><%= t('views.purchases.modal.upload_receipt_for_confirmation') %></p>
          </div>
          
          <!-- Информация о покупке -->
          <div class="bg-[#2E2E2E] rounded-lg p-5">
            <h3 class="text-xl font-semibold text-amber-400 mb-3 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <%= t('views.purchases.modal.details') %>
            </h3>
            <div class="grid grid-cols-2 gap-4 mt-4">
              <div>
                <p class="text-gray-400 text-sm"><%= t('views.purchases.modal.type') %></p>
                <p id="purchase-type" class="text-gray-300 font-medium">Получение проходки</p>
              </div>
              <div>
                <p class="text-gray-400 text-sm"><%= t('views.purchases.modal.amount') %></p>
                <p id="purchase-amount" class="text-gray-300 font-medium">3.00 USD</p>
              </div>
              <div>
                <p class="text-gray-400 text-sm"><%= t('views.purchases.modal.status') %></p>
                <p id="purchase-status" class="text-amber-400 font-medium">Ожидает</p>
              </div>
            </div>
          </div>
          
          <!-- Реквизиты для доната -->
          <div class="bg-[#2E2E2E] rounded-lg p-5">
            <h3 class="text-xl font-semibold text-amber-400 mb-3 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z" />
                <path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd" />
              </svg>
              <%= t('views.purchases.modal.payment_details') %>
            </h3>
            
            <div class="grid grid-cols-2 gap-4 mt-4">
              <div class="flex flex-col items-center p-4 bg-[#1A1A1A] rounded-lg">
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/a/a4/Mastercard_2019_logo.svg/2560px-Mastercard_2019_logo.svg.png" 
                     alt="Mastercard" class="h-12 mb-2">
                <p class="text-gray-400 text-sm"><%= t('views.purchases.modal.mastercard') %></p>
                <p class="text-gray-300 font-medium">1234 5678 9012 3456</p>
              </div>
              
              <div class="flex flex-col items-center p-4 bg-[#1A1A1A] rounded-lg">
                <img src="https://upload.wikimedia.org/wikipedia/commons/5/5e/Visa_Inc._logo.svg" 
                     alt="Visa" class="h-12 mb-2">
                <p class="text-gray-400 text-sm"><%= t('views.purchases.modal.visa') %></p>
                <p class="text-gray-300 font-medium">9876 5432 1098 7654</p>
              </div>
            </div>
          </div>
          
          <!-- Загрузка чека -->
          <div class="bg-[#2E2E2E] rounded-lg p-5">
            <h3 class="text-xl font-semibold text-amber-400 mb-3 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
              <%= t('views.purchases.modal.receipt_upload') %>
            </h3>
            
            <div id="receipt-upload-section">
              <!-- Область для загрузки -->
              <div 
                id="receipt-drop-area"
                class="border-2 border-dashed border-gray-600 rounded-xl p-8 text-center cursor-pointer hover:bg-[#1A1A1A] hover:border-amber-400 transition-all duration-300 mb-4"
                ondragover="handleReceiptDragOver(event)"
                ondragleave="handleReceiptDragLeave(event)"
                ondrop="handleReceiptDrop(event)"
                role="button"
                tabindex="0"
                aria-label="<%= t('views.purchases.modal.receipt_upload_area') %>"
              >
                <input 
                  type="file" 
                  id="receipt-input" 
                  class="hidden" 
                  accept=".jpg,.jpeg,.png"
                  onchange="handleReceiptFile(this.files)"
                  aria-label="<%= t('views.purchases.modal.select_receipt_file') %>"
                >
                <div class="flex flex-col items-center justify-center">
                  <div class="w-16 h-16 bg-amber-400/20 rounded-full flex items-center justify-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                  </div>
                  <p class="text-gray-300 mb-3 text-lg"><%= t('views.purchases.modal.drag_receipt_here') %></p>
                  <button 
                    type="button" 
                    class="btn btn-warning"
                    onclick="document.getElementById('receipt-input').click()"
                    aria-label="<%= t('views.purchases.modal.select_receipt_file') %>"
                  >
                    <%= t('views.purchases.modal.choose_file') %>
                  </button>
                  <p class="text-gray-400 text-sm mt-3"><%= t('views.purchases.modal.supported_formats') %></p>
                </div>
              </div>
              
              <!-- Предпросмотр загруженного чека -->
              <div id="receipt-preview-container" class="hidden">
                <div class="relative rounded-xl overflow-hidden border border-gray-600">
                  <img id="receipt-preview" src="" class="w-full h-auto object-contain">
                  <button 
                    id="receipt-button"
                    type="button" 
                    class="absolute top-3 right-3 w-8 h-8 bg-red-500 hover:bg-red-600 text-white rounded-full flex items-center justify-center transition-all duration-300 hidden"
                    onclick="removeReceipt()"
                    aria-label="<%= t('views.purchases.modal.delete_receipt') %>"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
          <!-- Кнопки действий -->
          <div class="flex flex-col sm:flex-row justify-center gap-3 mt-4">
            <button 
              id="submit-receipt-btn"
              class="btn btn-warning w-full sm:w-auto disabled:opacity-50 disabled:cursor-not-allowed"
              onclick="submitReceipt()"
              disabled
              aria-label="<%= t('views.purchases.modal.submit_receipt') %>"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <%= t('views.purchases.modal.submit_receipt') %>
            </button>
            
            <button 
              type="button" 
              class="btn btn-ghost text-gray-300 hover:bg-[#2E2E2E] w-full sm:w-auto"
              onclick="closePurchaseModal()"
              aria-label="<%= t('views.purchases.modal.cancel') %>"
            >
              <%= t('views.purchases.modal.cancel') %>
            </button>
          </div>
          <!-- Пояснение о проверке админом -->
          <div id="review-note" class="bg-[#1A1A1A] border border-gray-700 rounded-lg p-4">
            <p class="text-gray-300 text-sm">
              <%= t('views.purchases.modal.admin_review_note') %>
            </p>
          </div>
                    
          <!-- Техподдержка -->
          <div class="text-center border-t border-gray-700 pt-4 mt-2">
            <p class="text-gray-400 text-sm">
              <%= t('views.purchases.modal.support_note') %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Фон -->
  <form method="dialog" class="modal-backdrop bg-black/50" form="purchase_modal">
    <button aria-label="<%= t('views.purchases.modal.close_modal') %>"></button>
  </form>
</dialog>

<!-- Модальное окно для просмотра чека -->
<dialog id="receipt-viewer-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="receipt-viewer-title">
  <div class="scale-in">
    <div class="flex items-center justify-center min-h-screen min-w-screen bg-black/5">
      <div class="card bg-[#1A1A1A] shadow-xl rounded-lg w-[95%] max-w-4xl mx-auto max-h-[90vh] overflow-hidden flex flex-col">
        <!-- Заголовок -->
        <div class="flex justify-between items-center p-4 border-b border-gray-700 flex-shrink-0">
          <h3 id="receipt-viewer-title" class="text-xl font-bold text-amber-400"><%= t('views.purchases.modal.receipt_viewer_title') %></h3>
          <div class="flex space-x-3">
            <button id="download-receipt" class="btn btn-circle btn-sm btn-outline border-amber-400 text-amber-400 hover:bg-amber-400 hover:text-black" aria-label="<%= t('views.purchases.modal.download_receipt') %>">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <button onclick="closeReceiptViewer()" class="btn btn-circle btn-sm btn-outline border-amber-400 text-amber-400 hover:bg-amber-400 hover:text-black font-bold text-lg" aria-label="<%= t('views.purchases.modal.close_receipt_viewer') %>">
              ×
            </button>
          </div>
        </div>
        
        <!-- Контейнер для чека -->
        <div class="relative w-full flex items-center justify-center flex-grow overflow-auto bg-[#121212]">
          <!-- Индикатор загрузки -->
          <div id="receipt-loader" class="absolute inset-0 flex items-center justify-center bg-[#121212] z-10">
            <div class="flex flex-col items-center">
              <div class="w-12 h-12 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
              <span class="text-amber-400 mt-2"><%= t('views.purchases.modal.loading') %></span>
            </div>
          </div>
          
          <!-- Контент чека -->
          <div id="receipt-container" class="w-full h-full flex items-center justify-center p-4">
            <!-- Здесь будет динамически добавляться контент -->
          </div>
        </div>
        
        <!-- Информация о файле -->
        <div class="p-4 border-t border-gray-700 flex justify-between items-center flex-shrink-0">
          <div class="text-gray-400 text-sm">
            <span id="receipt-info"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Фон -->
  <form method="dialog" class="modal-backdrop bg-black/50 backdrop-blur-sm" form="receipt-viewer-modal">
    <button aria-label="<%= t('views.purchases.modal.close_receipt_viewer') %>"></button>
  </form>
</dialog>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fadeIn {
    animation: fadeIn 0.3s ease-out forwards;
  }
  
  /* Стили для глобального индикатора загрузки */
  #global-loading {
    transition: opacity 0.3s ease;
  }
</style>

<script type="text/javascript">
  // Оборачиваем код в IIFE для избежания глобальных переменных
  (function() {
    // Локализация через ERB
    const translations = {
      status_pending: "<%= t('views.purchases.modal.status_pending') %>",
      error_loading_purchases: "<%= t('views.purchases.modal.error_loading_purchases') %>",
      receipt_submitted: "<%= t('views.purchases.modal.receipt_submitted') %>",
      replace_receipt: "<%= t('views.purchases.modal.replace_receipt') %>",
      revoke_receipt: "<%= t('views.purchases.modal.revoke_receipt') %>",
      deleting: "<%= t('views.purchases.modal.deleting') %>",
      receipt_revoked: "<%= t('views.purchases.modal.receipt_revoked') %>",
      error_revoking_receipt: "<%= t('views.purchases.modal.error_revoking_receipt') %>",
      error_revoking_receipt_retry: "<%= t('views.purchases.modal.error_revoking_receipt_retry') %>",
      error_no_receipt_info: "<%= t('views.purchases.modal.error_no_receipt_info') %>",
      loading_price: "<%= t('views.purchases.modal.loading_price') %>",
      error_getting_price: "<%= t('views.purchases.modal.error_getting_price') %>",
      loading: "<%= t('views.purchases.modal.loading') %>",
      submit_receipt: "<%= t('views.purchases.modal.submit_receipt') %>",
      please_upload_receipt: "<%= t('views.purchases.modal.please_upload_receipt') %>",
      sending: "<%= t('views.purchases.modal.sending') %>",
      receipt_deleted: "<%= t('views.purchases.modal.receipt_deleted') %>",
      receipt_submitted_for_review: "<%= t('views.purchases.modal.receipt_submitted_for_review') %>",
      error_submitting_receipt: "<%= t('views.purchases.modal.error_submitting_receipt') %>",
      error_submitting_receipt_retry: "<%= t('views.purchases.modal.error_submitting_receipt_retry') %>",
      price_unavailable: "<%= t('views.purchases.modal.price_unavailable') %>",
      status_approved: "<%= t('views.purchases.modal.status_approved') %>",
      status_rejected: "<%= t('views.purchases.modal.status_rejected') %>",
      status_refunded: "<%= t('views.purchases.modal.status_refunded') %>",
      type_pass_purchase: "<%= t('views.purchases.modal.type_pass_purchase') %>",
      type_pass_gift: "<%= t('views.purchases.modal.type_pass_gift') %>",
      type_donation: "<%= t('views.purchases.modal.type_donation') %>",
      type_sponsor: "<%= t('views.purchases.modal.type_sponsor') %>",
      type_unban: "<%= t('views.purchases.modal.type_unban') %>",
      type_unmute: "<%= t('views.purchases.modal.type_unmute') %>",
      please_select_image: "<%= t('views.purchases.modal.please_select_image') %>",
      file_size_exceeded: "<%= t('views.purchases.modal.file_size_exceeded', size: '5 MB') %>",
      receipt_viewer_alt: "<%= t('views.purchases.modal.receipt_viewer_alt') %>",
      error_loading: "<%= t('views.purchases.modal.error_loading') %>",
      error_loading_receipt_retry: "<%= t('views.purchases.modal.error_loading_receipt_retry') %>",
      receipt_info: "<%= t('views.purchases.modal.receipt_info') %>"
    };
    
    // Константы
    const MAX_FILE_SIZE = 5 * 1024 * 1024; // 5 МБ
    const ALLOWED_FILE_TYPES = ['image/jpeg', 'image/png'];
    
    // Переменные в области видимости IIFE
    let receiptFile = null;
    let existingReceipt = null; // Хранит информацию о существующем чеке
    let removeExistingReceipt = false; // Флаг для удаления существующего чека
    let purchaseData = {
      type: 'pass_purchase',
      amount: '3.00',
      currency: 'USD',
      status: translations.status_pending,
      id: null,
      targetUserId: null
    };
    
    // Функция для получения CSRF-токена
    function getCsrfToken() {
      let token = document.querySelector('meta[name="csrf-token"]')?.content;
      return token;
    }
    
    // Функция для загрузки списка покупок с кэшированием
    async function loadUserPurchases(filters = {}) {
      try {
        const queryParams = new URLSearchParams();
        if (filters.purchase_type) queryParams.append('purchase_type', filters.purchase_type);
        if (filters.status) queryParams.append('status', filters.status);
        if (filters.target_user_id) queryParams.append('target_user_id', filters.target_user_id);
        const url = `/purchases?${queryParams.toString()}`;
        
        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken() || ''
          },
          credentials: 'same-origin'
        });
        
        if (response.ok) {
          const purchases = await response.json();
          return purchases;
        } else {
          showAlertNotification(translations.error_loading_purchases);
          return [];
        }
      } catch (error) {
        showAlertNotification(translations.error_loading_purchases);
        return [];
      }
    }
    
    // Обновленная функция открытия модального окна покупки
    async function openPurchaseModal(purchaseType = 'pass_purchase', purchaseId = null, targetId = null, price = null) {
      // Сохраняем targetId
      purchaseData.targetUserId = targetId;
      
      // Показываем глобальный индикатор загрузки
      showGlobalLoading();
      
      try {
        // Сбрасываем флаг удаления существующего чека
        removeExistingReceipt = false;
        document.getElementById('receipt-preview-container').classList.remove('hidden');
        
        // Формируем фильтры для загрузки покупок
        const filters = {
          purchase_type: purchaseType,
          status: 'pending'
        };
        
        // Если указан targetId, добавляем его в фильтры
        if (targetId) {
          filters.target_user_id = targetId;
        }
        
        // Загружаем покупки пользователя с фильтрами
        const purchases = await loadUserPurchases(filters);
        
        // Только после получения данных открываем модальное окно
        const modal = document.getElementById('purchase_modal');
        modal.showModal();
        
        // Если есть покупки с таким типом и статусом pending, берем последнюю
        const purchase = purchases.length > 0 ? purchases[purchases.length - 1] : null;
        
        if (purchase) {
          // Обновляем данные покупки
          purchaseData.type = purchase.purchase_type;
          purchaseData.amount = purchase.amount.toString();
          purchaseData.currency = purchase.currency || 'USD';
          purchaseData.status = purchase.status;
          purchaseData.id = purchase.id;
          
          // Если есть target_user_id в существующей покупке, используем его
          if (purchase.target_user_id) {
            purchaseData.targetUserId = purchase.target_user_id;
          }
          
          // Обновляем интерфейс
          document.getElementById('purchase-type').textContent = getPurchaseTypeName(purchaseData.type);
          document.getElementById('purchase-amount').textContent = `${purchaseData.amount} ${purchaseData.currency}`;
          updateStatusDisplay(purchaseData.status);
          
          // Если есть чеки, отображаем первый
          if (purchase.receipt) {
            existingReceipt = purchase.receipt; // receipt - это объект, а не массив
            displayReceipt(existingReceipt);
            
            // Скрываем область загрузки чека
            document.getElementById('receipt-drop-area').style.display = 'none';
            // Деактивируем кнопку отправки, если статус не pending
            const submitBtn = document.getElementById('submit-receipt-btn');
            if (purchase.status !== 'pending') {
              submitBtn.disabled = true;
              submitBtn.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                ${translations.receipt_submitted}
              `;
            } else {
              // Если статус pending, показываем кнопку замены чека
              const replaceButton = document.createElement('button');
              replaceButton.type = 'button';
              replaceButton.id = 'replace-receipt';
              replaceButton.className = [
                'replace-receipt-btn',
                'btn', 'btn-warning',  // daisyUI: оранжевый акцент
                'btn-md',
                'w-full',
                'flex', 'items-center', 'justify-center', 'gap-2',
                'shadow-md', 'hover:shadow-lg',
                'transition', 'duration-200',
                'mt-4'
              ].join(' ');
              replaceButton.setAttribute('aria-label', translations.replace_receipt);
              // Используем простую иконку "refresh" из Heroicons
              replaceButton.innerHTML = `
                <span>${translations.replace_receipt}</span>
              `;
              replaceButton.onclick = function () {
                // Показываем область загрузки
                document.getElementById('receipt-drop-area').style.display = 'block';
                
                // Скрываем превью текущего чека и очищаем изображение
                document.getElementById('receipt-preview-container').classList.add('hidden');
                document.getElementById('receipt-preview').src = '';
                document.getElementById('receipt-button').classList.add('hidden');
                
                // Деактивируем кнопку отправки
                const submitBtn = document.getElementById('submit-receipt-btn');
                if (submitBtn) {
                  submitBtn.disabled = true;
                  submitBtn.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                     <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                   </svg>
                   ${translations.submit_receipt}
                  `;
                }
                
                // Сбрасываем переменную с файлом чека
                receiptFile = null;
                
                // Удаляем кнопки "Заменить чек" и "Отозвать чек"
                const replaceBtn = document.getElementById('replace-receipt');
                const revokeBtn = document.getElementById('revoke-receipt');
                if (replaceBtn) replaceBtn.remove();
                if (revokeBtn) revokeBtn.remove();
              };
              // Создаем кнопку "Отозвать чек"
              const revokeButton = document.createElement('button');
              revokeButton.type = 'button';
              revokeButton.id = 'revoke-receipt';
              revokeButton.className = [
                'revoke-receipt-btn',
                'btn', 'btn-outline', 'btn-error',  // daisyUI: красная обводка
                'btn-md',
                'w-full',
                'flex', 'items-center', 'justify-center', 'gap-2',
                'shadow-md', 'hover:shadow-lg',
                'transition', 'duration-200',
                'mt-2'
              ].join(' ');
              revokeButton.setAttribute('aria-label', translations.revoke_receipt);
              revokeButton.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span>${translations.revoke_receipt}</span>
              `;
              revokeButton.onclick = async function() {
                if (!existingReceipt || !purchaseData.id) {
                  showAlertNotification(translations.error_no_receipt_info);
                  return;
                }
                removeReceipt()
                
                // Показываем индикатор загрузки на кнопке
                revokeButton.disabled = true;
                revokeButton.innerHTML = `
                  <span class="loading loading-spinner loading-sm"></span>
                  <span class="ml-2">${translations.deleting}</span>
                `;
                
                try {
                  const csrfToken = getCsrfToken();
                  
                  // Отправляем DELETE запрос на сервер
                  const response = await fetch(`/purchases/${purchaseData.id}`, {
                    method: 'DELETE',
                    headers: {
                      'Content-Type': 'application/json',
                      'X-CSRF-Token': csrfToken
                    },
                    credentials: 'same-origin'
                  });
                  
                    if (response.ok) {
                      // Успешное удаление
                      showNotification(translations.receipt_revoked);
                      
                      // Скрываем превью чека
                      document.getElementById('receipt-preview-container').classList.add('hidden');
                      
                      // Показываем область загрузки
                      document.getElementById('receipt-drop-area').style.display = 'block';
                      
                      // Сбрасываем состояние
                      existingReceipt = null;
                      receiptFile = null;
                      
                      // Обновляем статус покупки
                      purchaseData.status = translations.status_pending;
                      updateStatusDisplay(purchaseData.status);
                      
                      // Удаляем кнопки
                      replaceButton.remove();
                      revokeButton.remove();
                      
                      // Кнопка отправки должна быть неактивна, так как нет чека
                      document.getElementById('submit-receipt-btn').disabled = true;
                      document.getElementById('submit-receipt-btn').innerHTML = `
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                        ${translations.submit_receipt}
                      `;
                    } else {
                    const errorData = await response.json();
                    const errorMessage = errorData.errors ? errorData.errors.join(', ') : translations.error_revoking_receipt;
                    showAlertNotification(errorMessage);
                  }
                } catch (error) {
                  showAlertNotification(translations.error_revoking_receipt_retry);
                } finally {
                  // Восстанавливаем кнопку
                  revokeButton.disabled = false;
                  revokeButton.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <span>${translations.revoke_receipt}</span>
                  `;
                  updatePurchaseData(purchaseType, null);
                  closePurchaseModal();
                }
              };
              // Удаляем старые кнопки, если они есть
              const receiptUploadSection = document.getElementById('receipt-upload-section');
              receiptUploadSection.querySelector('.replace-receipt-btn')?.remove();
              receiptUploadSection.querySelector('.revoke-receipt-btn')?.remove();
              // Добавляем новые кнопки
              receiptUploadSection.appendChild(replaceButton);
              receiptUploadSection.appendChild(revokeButton);
            }
          }
        } else {
          // Показываем индикатор загрузки цены
          const amountElement = document.getElementById('purchase-amount');
          amountElement.textContent = translations.loading_price;
          
          // Обновление данных покупки в зависимости от типа (теперь асинхронное)
          await updatePurchaseData(purchaseType, null);
          
          // Если передана цена, устанавливаем её (но теперь мы получаем цену из auth_service, поэтому этот параметр может быть не нужен)
          if (price) {
            purchaseData.amount = price.toString();
            // Обновляем отображение суммы
            document.getElementById('purchase-amount').textContent = `${purchaseData.amount} ${purchaseData.currency}`;
          }
          
          // Показываем область загрузки
          document.getElementById('receipt-drop-area').style.display = 'block';
          
          // Сброс для новой покупки
          resetForNewPurchase();
          
          // Если цена не установлена (равна null), то блокируем кнопку отправки и выводим сообщение
          if (purchaseData.amount === null) {
            document.getElementById('submit-receipt-btn').disabled = true;
            showAlertNotification(translations.error_getting_price);
          }
        }
        
        const replaceBtn = document.getElementById('replace-receipt');
        const receiptBtn = document.getElementById('receipt-button');
        if (receiptBtn) {
          receiptBtn.classList.toggle('hidden', !!replaceBtn);
        }
      } catch (error) {
        showAlertNotification(translations.error_loading_purchases);
      } finally {
        // Скрываем глобальный индикатор загрузки
        hideGlobalLoading();
      }
    }
    
    // Функции для управления глобальным индикатором загрузки
    function showGlobalLoading() {
      // Создаем индикатор загрузки, если его еще нет
      if (!document.getElementById('global-loading')) {
        const loadingDiv = document.createElement('div');
        loadingDiv.id = 'global-loading';
        loadingDiv.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
        loadingDiv.innerHTML = `
          <div class="flex flex-col items-center">
            <div class="w-16 h-16 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
            <span class="text-amber-400 mt-4 text-lg">${translations.loading}</span>
          </div>
        `;
        document.body.appendChild(loadingDiv);
      }
    }
    
    function hideGlobalLoading() {
      const loadingDiv = document.getElementById('global-loading');
      if (loadingDiv) {
        loadingDiv.remove();
      }
    }
    
    function resetForNewPurchase() {
      receiptFile = null;
      existingReceipt = null;
      removeExistingReceipt = false;
      // Не сбрасываем targetUserId, так как он нужен для подарка
      document.getElementById('receipt-input').value = '';
      
      const previewContainer = document.getElementById('receipt-preview-container');
      if (previewContainer) {
        // Убедимся, что контейнер скрыт
        previewContainer.classList.add('hidden');
        const previewImg = document.getElementById('receipt-preview');
        if (previewImg) {
          previewImg.src = '';
        }
      }
      
      // Удаляем кнопки
      document.getElementById('replace-receipt')?.remove();
      document.getElementById('revoke-receipt')?.remove();
      
      // Сбрасываем класс ошибки у элемента суммы
      const amountElement = document.getElementById('purchase-amount');
      amountElement.classList.remove('text-red-500');
      
      document.getElementById('submit-receipt-btn').disabled = true;
      document.getElementById('submit-receipt-btn').innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        ${translations.submit_receipt}
      `;
      updateStatusDisplay('');
    }
    
    // Функция для обновления отображения статуса
    function updateStatusDisplay(status) {
        const statusElement = document.getElementById('purchase-status');
        const statusContainer = statusElement.closest('div'); // Находим родительский контейнер
        
        if (!status || status.trim() === '') {
            // Если статус пустой, скрываем весь блок статуса
            statusContainer.style.display = 'none';
        } else {
            // Если статус есть, показываем блок и устанавливаем значение
            statusContainer.style.display = '';
            statusElement.textContent = getStatusName(status);
        }
    }
    
    // Функция для отправки чека на сервер
    async function submitReceipt() {
      // Проверяем, есть ли что отправлять
      if (!receiptFile && !existingReceipt && !removeExistingReceipt) {
        showAlertNotification(translations.please_upload_receipt);
        return;
      }
      
      const submitBtn = document.getElementById('submit-receipt-btn');
      const originalText = submitBtn.innerHTML;
      
      // Отображение индикатора загрузки
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <span class="loading loading-spinner loading-md"></span>
        <span class="ml-2">${translations.sending}</span>
      `;
      
      try {
        // Проверка CSRF-токена
        const csrfToken = getCsrfToken();
        
        // Создание FormData для отправки файла
        const formData = new FormData();
        
        // Если это новая покупка (нет ID)
        if (!purchaseData.id) {
          formData.append('purchase[purchase_type]', purchaseData.type);
          formData.append('purchase[amount]', purchaseData.amount);
          formData.append('purchase[currency]', purchaseData.currency);
          formData.append('purchase[purchaser_user_id]', getCurrentUserId());
          if (purchaseData.type === 'pass_gift' && purchaseData.targetUserId) {
            formData.append('purchase[target_user_id]', purchaseData.targetUserId);
          }
        }
        
        // Добавляем чек, если он есть
        if (receiptFile) {
          formData.append('receipt', receiptFile);
        }
        
        // Если нужно удалить существующий чек, добавляем флаг
        if (removeExistingReceipt && existingReceipt) {
          formData.append('remove_receipt', 'true');
          formData.append('existing_receipt_id', existingReceipt.id);
        }
        
        // Определяем URL и метод в зависимости от того, создаем ли мы новую покупку или обновляем существующую
        let url, method;
        if (purchaseData.id) {
          url = `/purchases/${purchaseData.id}`;
          method = 'PATCH';
        } else {
          url = '/purchases';
          method = 'POST';
        }
        
        const response = await fetch(url, {
          method: method,
          body: formData,
          headers: {
            'X-CSRF-Token': csrfToken
          },
          credentials: 'same-origin'
        });
        
        const data = await response.json();
        
        if (response.ok) {
          // Обновление статуса покупки
          purchaseData.status = 'pending';
          updateStatusDisplay(purchaseData.status);
          
          // Если это была новая покупка, обновляем ID
          if (!purchaseData.id && data.id) {
            purchaseData.id = data.id;
          }
          
          // Обновляем информацию о существующем чеке
          if (data.receipt && data.receipt.length > 0) {
            existingReceipt = data.receipt[0];
            displayReceipt(existingReceipt);
            document.getElementById('receipt-drop-area').style.display = 'none';
          } else if (removeExistingReceipt) {
            // Если чек был удален, скрываем превью и показываем область загрузки
            document.getElementById('receipt-preview-container').classList.add('hidden');
            document.getElementById('receipt-drop-area').style.display = 'block';
            existingReceipt = null;
          }
          
          // Сбрасываем флаг удаления чека
          removeExistingReceipt = false;
          
          // Закрытие модального окна
          closePurchaseModal();
          
          // Показ уведомления об успешной отправке
          if (removeExistingReceipt) {
            showNotification(translations.receipt_deleted);
          } else {
            showNotification(translations.receipt_submitted_for_review);
          }
        } else {
          // Показываем ошибки от сервера
          const errorMessage = data.errors ? data.errors.join(', ') : translations.error_submitting_receipt;
          showAlertNotification(errorMessage);
        }
      } catch (error) {
        showAlertNotification(translations.error_submitting_receipt_retry);
      } finally {
        // Восстановление кнопки
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    }
    
    // Функция для получения ID текущего пользователя
    function getCurrentUserId() {
      // Предполагаем, что ID пользователя хранится в мета-теге или в глобальной переменной
      const userIdMeta = document.querySelector('meta[name="current-user-id"]');
      if (userIdMeta) {
        return userIdMeta.getAttribute('content');
      }
      
      // Альтернативный вариант - если ID доступен через глобальную переменную
      if (typeof currentUserId !== 'undefined') {
        return currentUserId;
      }
      
      return null;
    }
    
    function displayReceipt(receipt) {
      const previewContainer = document.getElementById('receipt-preview-container');
      let previewImg = document.getElementById('receipt-preview');
      
      if (!previewImg) {
        previewImg = document.createElement('img');
        previewImg.id = 'receipt-preview';
        previewImg.className = 'w-full h-auto object-contain';
        previewImg.setAttribute('loading', 'lazy');
        previewContainer.appendChild(previewImg);
      }
      
      // Удаляем предыдущий обработчик
      const newPreviewImg = previewImg.cloneNode(true);
      previewImg.parentNode.replaceChild(newPreviewImg, previewImg);
      
      // Убираем параметры запроса из URL и добавляем временную метку
      const baseUrl = receipt.url.split('?')[0];
      const imageUrl = `${baseUrl}?t=${new Date().getTime()}`; // Добавляем timestamp для избежания кэширования
      
      // Устанавливаем изображение
      newPreviewImg.src = imageUrl;
      
      // Добавляем обработчики
      newPreviewImg.onload = function() {
        previewContainer.classList.remove('hidden');
      };
      // Добавляем обработчик для просмотра в полном размере
      newPreviewImg.onclick = function() {
        openReceiptViewer(imageUrl);
      };
    }
    
    // Функция для получения цены продукта
    async function getProductPrice(productType) {
      try {
        // Проверяем, что URL сервиса определен
        const authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>";
        
        // Если URL не определен или содержит шаблонный код, используем значение по умолчанию
        const authServiceUrlFromEnv = '<%= ENV['IDENTITY_SERVICE_URL'] %>';
        const url = authServiceUrl && !authServiceUrl.includes('<%')
                    ? `${authServiceUrl}/api/v1/product/${productType}`
                    : `${authServiceUrlFromEnv}/api/v1/product/${productType}`;
        
        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken() || ''
          },
          credentials: 'same-origin'
        });
        
        if (response.ok) {
          const data = await response.json();
          return data.price;
        } else if (response.status === 404) {
          return null;
        } else if (response.status === 422) {
          return null;
        } else {
          return null;
        }
      } catch (error) {
        return null;
      }
    }
    
    // Обновленная функция для обновления данных покупки
    async function updatePurchaseData(type, id) {
      purchaseData.type = type;
      purchaseData.id = id;
      // Обновление интерфейса
      document.getElementById('purchase-type').textContent = getPurchaseTypeName(type);
      
      // Показываем индикатор загрузки цены
      const amountElement = document.getElementById('purchase-amount');
      amountElement.textContent = translations.loading_price;
      
      // Получаем цену продукта из auth_service
      const price = await getProductPrice(type);
      
      if (price !== null) {
        purchaseData.amount = price.toString();
        purchaseData.currency = 'USD'; // Устанавливаем валюту по умолчанию
        amountElement.textContent = `${purchaseData.amount} ${purchaseData.currency}`;
        amountElement.classList.remove('text-red-500');
        
        // Активируем кнопку отправки, если есть чек
        if (receiptFile || existingReceipt) {
          document.getElementById('submit-receipt-btn').disabled = false;
        }
      } else {
        // Если не удалось получить цену, показываем ошибку и блокируем кнопку отправки
        purchaseData.amount = null;
        purchaseData.currency = 'USD';
        amountElement.textContent = translations.price_unavailable;
        amountElement.classList.add('text-red-500');
        
        // Блокируем кнопку отправки
        const submitBtn = document.getElementById('submit-receipt-btn');
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          ${translations.error_getting_price}
        `;
        
        showAlertNotification(translations.error_getting_price);
      }
    }
    
    // Функция для получения названия статуса покупки
    function getStatusName(status) {
      const names = {
        'pending': translations.status_pending,
        'approved': translations.status_approved,
        'rejected': translations.status_rejected,
        'refunded': translations.status_refunded
      };
      
      return names[status] || status;
    }
    
    // Функция для получения названия типа покупки
    function getPurchaseTypeName(type) {
      const names = {
        'pass_purchase': translations.type_pass_purchase,
        'pass_gift': translations.type_pass_gift,
        'donation': translations.type_donation,
        'sponsor': translations.type_sponsor,
        'unban': translations.type_unban,
        'unmute': translations.type_unmute
      };
      
      return names[type] || translations.type_donation;
    }
    
    // Функция для форматирования размера файла
    function formatFileSize(bytes) {
      if (bytes === 0) return '0 Bytes';
      
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }
    
    function closePurchaseModal() {
      const modal = document.getElementById('purchase_modal');
      if (!modal) return;
      try {
       // Удаляем кнопки
       document.getElementById('replace-receipt')?.remove();
       document.getElementById('revoke-receipt')?.remove();
       
       // Прячем зону дропа и превью
       const dropArea = document.getElementById('receipt-drop-area');
       if (dropArea) dropArea.style.display = 'none';
       
       const preview = document.getElementById('receipt-preview-container');
       if (preview) {
         // Убедимся, что контейнер скрыт
         preview.classList.add('hidden');
         const previewImg = document.getElementById('receipt-preview');
         if (previewImg) {
           previewImg.src = '';
         }
       }
       
       // Очищаем файл-инпут
       const fileInput = document.getElementById('receipt-input');
       if (fileInput) fileInput.value = '';
       
       // Сбрасываем кнопку отправки
       const submitBtn = document.getElementById('submit-receipt-btn');
       if (submitBtn) {
         submitBtn.disabled = false;
         submitBtn.innerHTML = `
           <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
             <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
           </svg>
           ${translations.submit_receipt}
         `;
       }
       
       // Сбрасываем targetUserId только при закрытии модального окна
       purchaseData.targetUserId = null;
       
       // Сброс бизнес-состояния
       resetForNewPurchase();
       
       // Очищаем текстовые поля с информацией о покупке
       const typeEl = document.getElementById('purchase-type');
       const amountEl = document.getElementById('purchase-amount');
       const statusEl = document.getElementById('purchase-status');
       if (typeEl) typeEl.textContent = '';
       if (amountEl) amountEl.textContent = '';
       if (statusEl) statusEl.textContent = '';
      } finally {
       // Закрываем модалку
       modal.close();
      }
      updateStatusDisplay('');
    }
    
    // Обработчики drag-and-drop для чека
    function handleReceiptDragOver(e) {
      e.preventDefault();
      e.stopPropagation();
      document.getElementById('receipt-drop-area').classList.add('border-amber-400', 'bg-amber-900/30');
    }
    
    function handleReceiptDragLeave(e) {
      e.preventDefault();
      e.stopPropagation();
      document.getElementById('receipt-drop-area').classList.remove('border-amber-400', 'bg-amber-900/30');
    }
    
    function handleReceiptDrop(e) {
      e.preventDefault();
      e.stopPropagation();
      document.getElementById('receipt-drop-area').classList.remove('border-amber-400', 'bg-amber-900/30');
      
      const files = e.dataTransfer.files;
      if (files.length > 0) {
        handleReceiptFile(files);
      }
    }
    
    function recreatePreviewImage() {
      const previewContainer = document.getElementById('receipt-preview-container');
      const oldPreviewImg = document.getElementById('receipt-preview');
      
      // Удаляем старое изображение, если оно существует
      if (oldPreviewImg) {
        oldPreviewImg.remove();
      }
      
      // Создаем новое изображение
      const newPreviewImg = document.createElement('img');
      newPreviewImg.id = 'receipt-preview';
      newPreviewImg.className = 'w-full h-auto object-contain cursor-pointer';
      newPreviewImg.setAttribute('loading', 'lazy');
      
      // Добавляем новое изображение в контейнер
      const imageWrapper = previewContainer.querySelector('.relative');
      if (imageWrapper) {
        imageWrapper.appendChild(newPreviewImg);
      } else {
        previewContainer.appendChild(newPreviewImg);
      }
      
      return newPreviewImg;
    }
    
    // Обработка выбранного файла чека
    function handleReceiptFile(files) {
      if (files.length === 0) return;
      const file = files[0];
      
      // Проверка типа файла
      if (!ALLOWED_FILE_TYPES.includes(file.type)) {
        showAlertNotification(translations.please_select_image);
        return;
      }
      
      // Проверка размера файла
      if (file.size > MAX_FILE_SIZE) {
        showAlertNotification(translations.file_size_exceeded);
        return;
      }
      
      receiptFile = file;
      // Сбрасываем флаг удаления существующего чека при загрузке нового
      removeExistingReceipt = false;
      
      // Пересоздаем элемент изображения
      const previewImg = recreatePreviewImage();
      
      // Отображение предпросмотра
      const reader = new FileReader();
      reader.onload = function(e) {
        // Устанавливаем новое изображение
        previewImg.src = e.target.result;
        
        // Добавляем обработчик для просмотра чека в полном размере
        previewImg.onclick = function() {
          openReceiptViewer(e.target.result);
        };
        
        // Показываем контейнер предпросмотра
        document.getElementById('receipt-preview-container').classList.remove('hidden');
        
        // Показываем кнопку удаления чека
        const receiptBtn = document.getElementById('receipt-button');
        if (receiptBtn) {
          receiptBtn.classList.remove('hidden');
        }
        
        // Скрываем область загрузки
        document.getElementById('receipt-drop-area').style.display = 'none';
        
        // Активируем кнопку отправки только после загрузки нового чека и если цена получена
        if (purchaseData.amount !== null) {
          document.getElementById('submit-receipt-btn').disabled = false;
        }
      };
      reader.readAsDataURL(file);
    }
    
    // Удаление загруженного чека
    function removeReceipt() {
      // Проверяем, есть ли существующий чек на сервере
      if (existingReceipt) {
        // Если есть, устанавливаем флаг для его удаления
        removeExistingReceipt = true;
      } else {
        // Если нет, просто сбрасываем файл
        receiptFile = null;
      }
      
      // Сбрасываем интерфейс
      document.getElementById('receipt-input').value = '';
      document.getElementById('receipt-preview-container').classList.add('hidden');
      document.getElementById('receipt-drop-area').style.display = 'block';
      
      // Кнопка отправки должна быть неактивна, так как нет чека
      document.getElementById('submit-receipt-btn').disabled = true;
      document.getElementById('submit-receipt-btn').innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        ${translations.submit_receipt}
      `;
    }
    
    function openReceiptViewer(imageSource) {
      const modal = document.getElementById('receipt-viewer-modal');
      const container = document.getElementById('receipt-container');
      const loader = document.getElementById('receipt-loader');
      const downloadBtn = document.getElementById('download-receipt');
      
      // Отображение индикатора загрузки
      loader.style.display = 'flex';
      container.innerHTML = '';
      
      // Проверяем, является ли источник base64-строкой
      const isBase64 = imageSource.startsWith('data:image');
      
      // Если это base64, скрываем кнопку скачивания
      if (isBase64) {
        downloadBtn.style.display = 'none';
      } else {
        downloadBtn.style.display = '';
        // Сохраняем URL в data-атрибуте
        downloadBtn.setAttribute('data-receipt-url', imageSource);
      }
      
      // Создание изображения для чека
      const img = document.createElement('img');
      img.src = imageSource;
      img.className = 'max-w-full max-h-[70vh] object-contain';
      img.alt = translations.receipt_viewer_alt;
      img.setAttribute('loading', 'lazy');
      
      // Устанавливаем crossOrigin для изображений с сервера
      if (!imageSource.startsWith('data:')) {
        img.crossOrigin = "use-credentials";
      }
      
      img.onload = function() {
        loader.style.display = 'none';
        
        // Обновление информации о файле
        document.getElementById('receipt-info').textContent = translations.receipt_info;
      };
      
      img.onerror = function() {
        loader.style.display = 'none';
        container.innerHTML = `
          <div class="text-center p-8">
            <div class="text-amber-400 text-5xl mb-4">⚠️</div>
            <h3 class="text-xl font-bold text-white mb-2">${translations.error_loading}</h3>
            <p class="text-amber-400/70">${translations.error_loading_receipt_retry}</p>
          </div>
        `;
      };
      
      container.appendChild(img);
      modal.showModal();
    }
    
    async function downloadFile(url, fallbackName = 'receipt') {
      const a = document.createElement('a');
      a.style.display = 'none';
      document.body.appendChild(a);
      try {
        const res = await fetch(url, { credentials: 'include' }); // если авторизация по кукам
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        // Пытаемся вытащить имя из заголовка, иначе fallback
        const cd = res.headers.get('Content-Disposition') || '';
        const nameMatch = cd.match(/filename\*?=(?:UTF-8''|")?([^\";]+)/i);
        const fileName = nameMatch ? decodeURIComponent(nameMatch[1]) : fallbackName;
        const blob = await res.blob();
        const objectUrl = URL.createObjectURL(blob);
        a.href = objectUrl;
        a.download = fileName;
        a.click();
        URL.revokeObjectURL(objectUrl);
      } finally {
        document.body.removeChild(a);
      }
    }
    
    // Закрытие модального окна просмотра чека
    function closeReceiptViewer() {
      document.getElementById('receipt-drop-area').style.display = 'none';
      const modal = document.getElementById('receipt-viewer-modal');
      const downloadBtn = document.getElementById('download-receipt');
      
      // Очищаем data-атрибут и показываем кнопку
      downloadBtn.removeAttribute('data-receipt-url');
      downloadBtn.style.display = '';
      
      modal.close();
    }
    
    // Инициализация при загрузке документа
    document.addEventListener('DOMContentLoaded', function() {
      // Добавляем один обработчик для кнопки скачивания
      const downloadBtn = document.getElementById('download-receipt');
      downloadBtn.addEventListener('click', function() {
        const receiptUrl = this.getAttribute('data-receipt-url');
        if (receiptUrl) {
          downloadFile(receiptUrl, 'receipt.png');
        }
      });
      
      // Добавление стилей для анимаций
      const style = document.createElement('style');
      style.innerHTML = `
        @keyframes fadeIn {
          from { opacity: 0; transform: translateY(-10px); }
          to { opacity: 1; transform: translateY(0); }
        }
        .animate-fadeIn {
          animation: fadeIn 0.3s ease-out forwards;
        }
      `;
      document.head.appendChild(style);
      
      // Проверка поддержки Dialog API
      if (!window.HTMLDialogElement) {
        // Простая реализация полифилла для Dialog API
        const dialogs = document.querySelectorAll('dialog');
        dialogs.forEach(dialog => {
          dialog.showModal = function() {
            this.style.display = 'block';
            this.setAttribute('open', '');
          };
          dialog.close = function() {
            this.style.display = 'none';
            this.removeAttribute('open');
          };
        });
      }
      
      // Добавляем обработчик закрытия модального окна
      const modal = document.getElementById('purchase_modal');
      modal.addEventListener('close', function() {
        resetForNewPurchase();
        
        // Удаляем кнопку замены чека
        const replaceButton = document.querySelector('#receipt-upload-section button[onclick*="' + translations.replace_receipt + '"]');
        if (replaceButton) {
          replaceButton.remove();
        }
      });
      
      // Управление фокусом при открытии модального окна
      modal.addEventListener('open', function() {
        // Перемещаем фокус на первый интерактивный элемент
        const firstFocusable = modal.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        if (firstFocusable) {
          firstFocusable.focus();
        }
      });
      
      // При закрытии возвращаем фокус на элемент, который открыл модальное окно
      modal.addEventListener('close', function() {
        const opener = document.activeElement;
        if (opener && opener.tagName === 'BUTTON') {
          opener.focus();
        }
      });
      
      // Делаем функции доступными глобально (только те, которые используются извне)
      window.openPurchaseModal = openPurchaseModal;
      window.closePurchaseModal = closePurchaseModal;
      window.submitReceipt = submitReceipt;
      window.handleReceiptDragOver = handleReceiptDragOver;
      window.handleReceiptDragLeave = handleReceiptDragLeave;
      window.handleReceiptDrop = handleReceiptDrop;
      window.handleReceiptFile = handleReceiptFile;
      window.removeReceipt = removeReceipt;
      window.openReceiptViewer = openReceiptViewer;
      window.closeReceiptViewer = closeReceiptViewer;
    });
  })();
</script>
