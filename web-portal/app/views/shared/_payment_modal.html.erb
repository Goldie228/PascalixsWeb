<dialog id="purchase_modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="purchase-modal-title">
  <div class="scale-in">
    <div class="flex items-center justify-center min-h-screen bg-black/50">
      <div class="modal-box max-w-2xl w-full bg-[#1A1A1A] rounded-lg shadow-lg relative h-auto overflow-y-auto">
        <!-- Кнопка закрытия -->
        <form method="dialog" class="absolute right-6 top-6 z-10" form="purchase_modal">
          <button class="btn btn-circle btn-ghost text-amber-400 hover:bg-amber-400/20" aria-label="<%= t('views.purchases.modal.close_modal') %>">
            <svg xmlns="http://www.w3.org/2000/svg" 
                 class="w-6 h-6" 
                 fill="none" 
                 viewBox="0 0 24 24" 
                 stroke="currentColor">
              <path stroke-linecap="round" 
                    stroke-linejoin="round" 
                    stroke-width="2" 
                    d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </form>
        
        <!-- Основное содержимое -->
        <div class="flex flex-col space-y-6">
          <!-- Заголовок -->
          <div class="flex flex-col items-center mb-6 mt-4">
            <h2 id="purchase-modal-title" class="text-3xl font-bold text-center text-amber-400 mb-2"><%= t('views.purchases.modal.confirm_donation') %></h2>
            <p class="text-gray-300 text-center"><%= t('views.purchases.modal.upload_receipt_for_confirmation') %></p>
          </div>
          
          <!-- Информация о покупке -->
          <div class="bg-[#2E2E2E] rounded-lg p-5">
            <h3 class="text-xl font-semibold text-amber-400 mb-3 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <%= t('views.purchases.modal.details') %>
            </h3>
            <div class="grid grid-cols-2 gap-4 mt-4">
              <div>
                <p class="text-gray-400 text-sm"><%= t('views.purchases.modal.type') %></p>
                <p id="purchase-type" class="text-gray-300 font-medium">Получение проходки</p>
              </div>
              <div>
                <p class="text-gray-400 text-sm"><%= t('views.purchases.modal.amount') %></p>
                <p id="purchase-amount" class="text-gray-300 font-medium">3.00 USD</p>
              </div>
              <div>
                <p class="text-gray-400 text-sm"><%= t('views.purchases.modal.status') %></p>
                <p id="purchase-status" class="text-amber-400 font-medium">Ожидает</p>
              </div>
            </div>
          </div>
          
          <!-- Реквизиты для доната -->
          <div class="bg-[#2E2E2E] rounded-lg p-5">
            <h3 class="text-xl font-semibold text-amber-400 mb-3 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z" />
                <path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd" />
              </svg>
              <%= t('views.purchases.modal.payment_details') %>
            </h3>
            
            <div class="grid grid-cols-2 gap-4 mt-4">
              <div class="flex flex-col items-center p-4 bg-[#1A1A1A] rounded-lg">
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/a/a4/Mastercard_2019_logo.svg/2560px-Mastercard_2019_logo.svg.png" 
                     alt="Mastercard" class="h-12 mb-2">
                <p class="text-gray-400 text-sm"><%= t('views.purchases.modal.mastercard') %></p>
                <p class="text-gray-300 font-medium">1234 5678 9012 3456</p>
              </div>
              
              <div class="flex flex-col items-center p-4 bg-[#1A1A1A] rounded-lg">
                <img src="https://upload.wikimedia.org/wikipedia/commons/5/5e/Visa_Inc._logo.svg" 
                     alt="Visa" class="h-12 mb-2">
                <p class="text-gray-400 text-sm"><%= t('views.purchases.modal.visa') %></p>
                <p class="text-gray-300 font-medium">9876 5432 1098 7654</p>
              </div>
            </div>
          </div>
          
          <!-- Загрузка чека -->
          <div class="bg-[#2E2E2E] rounded-lg p-5">
            <h3 class="text-xl font-semibold text-amber-400 mb-3 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
              <%= t('views.purchases.modal.receipt_upload') %>
            </h3>
            
            <div id="receipt-upload-section">
              <!-- Область для загрузки -->
              <div 
                id="receipt-drop-area"
                class="border-2 border-dashed border-gray-600 rounded-xl p-8 text-center cursor-pointer hover:bg-[#1A1A1A] hover:border-amber-400 transition-all duration-300 mb-4"
                ondragover="handleReceiptDragOver(event)"
                ondragleave="handleReceiptDragLeave(event)"
                ondrop="handleReceiptDrop(event)"
                role="button"
                tabindex="0"
                aria-label="<%= t('views.purchases.modal.receipt_upload_area') %>"
              >
                <input 
                  type="file" 
                  id="receipt-input" 
                  class="hidden" 
                  accept=".jpg,.jpeg,.png"
                  onchange="handleReceiptFile(this.files)"
                  aria-label="<%= t('views.purchases.modal.select_receipt_file') %>"
                >
                <div class="flex flex-col items-center justify-center">
                  <div class="w-16 h-16 bg-amber-400/20 rounded-full flex items-center justify-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                  </div>
                  <p class="text-gray-300 mb-3 text-lg"><%= t('views.purchases.modal.drag_receipt_here') %></p>
                  <button 
                    type="button" 
                    class="btn btn-warning"
                    onclick="document.getElementById('receipt-input').click()"
                    aria-label="<%= t('views.purchases.modal.select_receipt_file') %>"
                  >
                    <%= t('views.purchases.modal.choose_file') %>
                  </button>
                  <p class="text-gray-400 text-sm mt-3"><%= t('views.purchases.modal.supported_formats') %></p>
                </div>
              </div>
              
              <!-- Предпросмотр загруженного чека -->
              <div id="receipt-preview-container" class="hidden">
                <div class="relative rounded-xl overflow-hidden border border-gray-600">
                  <img id="receipt-preview" src="" class="w-full h-auto object-contain">
                  <button 
                    id="receipt-button"
                    type="button" 
                    class="absolute top-3 right-3 w-8 h-8 bg-red-500 hover:bg-red-600 text-white rounded-full flex items-center justify-center transition-all duration-300 hidden"
                    onclick="removeReceipt()"
                    aria-label="<%= t('views.purchases.modal.delete_receipt') %>"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
          <!-- Кнопки действий -->
          <div class="flex flex-col sm:flex-row justify-center gap-3 mt-4">
            <button 
              id="submit-receipt-btn"
              class="btn btn-warning w-full sm:w-auto disabled:opacity-50 disabled:cursor-not-allowed"
              onclick="submitReceipt()"
              disabled
              aria-label="<%= t('views.purchases.modal.submit_receipt') %>"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <%= t('views.purchases.modal.submit_receipt') %>
            </button>
            
            <button 
              type="button" 
              class="btn btn-ghost text-gray-300 hover:bg-[#2E2E2E] w-full sm:w-auto"
              onclick="closePurchaseModal()"
              aria-label="<%= t('views.purchases.modal.cancel') %>"
            >
              <%= t('views.purchases.modal.cancel') %>
            </button>
          </div>
          <!-- Пояснение о проверке админом -->
          <div id="review-note" class="bg-[#1A1A1A] border border-gray-700 rounded-lg p-4">
            <p class="text-gray-300 text-sm">
              <%= t('views.purchases.modal.admin_review_note') %>
            </p>
          </div>
                    
          <!-- Техподдержка -->
          <div class="text-center border-t border-gray-700 pt-4 mt-2">
            <p class="text-gray-400 text-sm">
              <%= t('views.purchases.modal.support_note') %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Фон -->
  <form method="dialog" class="modal-backdrop bg-black/50" form="purchase_modal">
    <button aria-label="<%= t('views.purchases.modal.close_modal') %>"></button>
  </form>
</dialog>

<!-- Модальное окно для просмотра чека -->
<dialog id="receipt-viewer-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="receipt-viewer-title">
  <div class="scale-in">
    <div class="flex items-center justify-center min-h-screen min-w-screen bg-black/5">
      <div class="card bg-[#1A1A1A] shadow-xl rounded-lg w-[95%] max-w-4xl mx-auto max-h-[90vh] overflow-hidden flex flex-col">
        <!-- Заголовок -->
        <div class="flex justify-between items-center p-4 border-b border-gray-700 flex-shrink-0">
          <h3 id="receipt-viewer-title" class="text-xl font-bold text-amber-400"><%= t('views.purchases.modal.receipt_viewer_title') %></h3>
          <div class="flex space-x-3">
            <button id="download-receipt" class="btn btn-circle btn-sm btn-outline border-amber-400 text-amber-400 hover:bg-amber-400 hover:text-black" aria-label="<%= t('views.purchases.modal.download_receipt') %>">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <button onclick="closeReceiptViewer()" class="btn btn-circle btn-sm btn-outline border-amber-400 text-amber-400 hover:bg-amber-400 hover:text-black font-bold text-lg" aria-label="<%= t('views.purchases.modal.close_receipt_viewer') %>">
              ×
            </button>
          </div>
        </div>
        
        <!-- Контейнер для чека -->
        <div class="relative w-full flex items-center justify-center flex-grow overflow-auto bg-[#121212]">
          <!-- Индикатор загрузки -->
          <div id="receipt-loader" class="absolute inset-0 flex items-center justify-center bg-[#121212] z-10">
            <div class="flex flex-col items-center">
              <div class="w-12 h-12 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
              <span class="text-amber-400 mt-2"><%= t('views.purchases.modal.loading') %></span>
            </div>
          </div>
          
          <!-- Контент чека -->
          <div id="receipt-container" class="w-full h-full flex items-center justify-center p-4">
            <!-- Здесь будет динамически добавляться контент -->
          </div>
        </div>
        
        <!-- Информация о файле -->
        <div class="p-4 border-t border-gray-700 flex justify-between items-center flex-shrink-0">
          <div class="text-gray-400 text-sm">
            <span id="receipt-info"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Фон -->
  <form method="dialog" class="modal-backdrop bg-black/50 backdrop-blur-sm" form="receipt-viewer-modal">
    <button aria-label="<%= t('views.purchases.modal.close_receipt_viewer') %>"></button>
  </form>
</dialog>
