<dialog id="edit-player-modal" class="modal">
  <form method="dialog"
        class="modal-box bg-[#1A1A1A] text-white p-0 w-full max-w-full md:max-w-4xl">
    <div class="flex flex-col pt-8 pb-4 px-6 gap-4">
      <button
        type="button"
        onclick="closeEditModal()"
        aria-label="<%= I18n.t('common.close') %>"
        class="self-end btn btn-circle btn-ghost hover:bg-[#333333]">
        <svg xmlns="http://www.w3.org/2000/svg"
             class="w-6 h-6 text-gray-400 hover:text-gray-500 transition-colors"
             fill="none"
             viewBox="0 0 24 24"
             stroke="currentColor">
          <path stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <h3 id="modal-title" class="text-2xl font-semibold text-center">
        <%= I18n.t('admin.players.edit.modal_title', nickname: 'Noname') %>
      </h3>
    </div>
    <div class="flex flex-col md:flex-row">
      <div class="md:w-1/4 bg-[#1A1A1A] p-2 md:p-4 flex md:block justify-center overflow-x-auto space-x-2 md:space-x-0 md:space-y-2 scrollbar-hide">
        <button type="button" id="tab-profile" onclick="switchTab('profile')"
        class="btn btn-ghost flex-shrink-0 text-white hover:bg-[#2D2D2D] md:w-full"><%= I18n.t('admin.players.tabs.profile') %></button>
        <button type="button" id="tab-security" onclick="switchTab('security')"
                class="btn btn-ghost flex-shrink-0 text-white hover:bg-[#2D2D2D] md:w-full"><%= I18n.t('admin.players.tabs.security') %></button>
        <button type="button" id="tab-restrictions" onclick="switchTab('restrictions')"
                class="btn btn-ghost flex-shrink-0 text-white hover:bg-[#2D2D2D] md:w-full"><%= I18n.t('admin.players.tabs.restrictions') %></button>
      </div>
      <div class="w-px bg-[#2D2D2D] hidden md:block"></div>
      <div class="w-full md:w-3/4 p-4 md:p-6 space-y-4 bg-[#1A1A1A]">
        <div id="tab-content-profile">
          <%= render "profile_tab" %>
        </div>
        <div id="tab-content-security" class="hidden">
          <%= render "security_tab" %>
        </div>
        <div id="tab-content-restrictions" class="hidden">
          <%= render "restrictions_tab" %>
        </div>
      </div>
    </div>
  </form>
</dialog>

<script>
  window.PUNISHMENT_LABELS = {
    ru: {
      active: "<%= I18n.with_locale(:ru) { I18n.t('admin.players.punishments.status.active') } %>",
      expired: "<%= I18n.with_locale(:ru) { I18n.t('admin.players.punishments.status.expired') } %>"
    },
    en: {
      active: "<%= I18n.with_locale(:en) { I18n.t('admin.players.punishments.status.active') } %>",
      expired: "<%= I18n.with_locale(:en) { I18n.t('admin.players.punishments.status.expired') } %>"
    }
  };
  window.PUNISHMENT_MESSAGES = {
    noActive: "<%= I18n.t('admin.players.punishments.no_active') %>",
    noHistory: "<%= I18n.t('admin.players.punishments.no_history') %>",
    cancel: "<%= I18n.t('common.cancel') %>",
    permanent: "<%= I18n.t('admin.players.restrictions.permanent') %>"
  };
</script>

<script>
  function openEditModal() {
    document.getElementById('edit-player-modal').showModal();
    switchTab('profile');
  }
  function closeEditModal() {
    document.getElementById('edit-player-modal').close();
  }
  function switchTab(tab) {
    const tabs = ['profile', 'security', 'restrictions'];
    tabs.forEach(t => {
      document.getElementById(`tab-content-${t}`).classList.add('hidden');
      document.getElementById(`tab-${t}`).classList.remove('bg-amber-400', 'text-black');
      document.getElementById(`tab-${t}`).classList.add('text-white');
    });
    document.getElementById(`tab-content-${tab}`).classList.remove('hidden');
    document.getElementById(`tab-${tab}`).classList.remove('text-white');
    document.getElementById(`tab-${tab}`).classList.add('bg-amber-400', 'text-black');
  }
  function getStatusCode(rawStatus) {
    for (const lang of ["ru", "en"]) {
      for (const [code, text] of Object.entries(PUNISHMENT_LABELS[lang])) {
        if (text === rawStatus) return code;
      }
    }
    return "unknown";
  }
  function statusBadge(statusText) {
    const code = getStatusCode(statusText);
    const locale = "<%= I18n.locale %>";
    const localizedLabel =
      window.PUNISHMENT_LABELS?.[locale]?.[code] || statusText;
    let badgeColor, textColor;
    switch (code) {
      case "active":
        badgeColor = "rgba(34,197,94,0.2)";
        textColor  = "#22C55E";
        break;
      case "expired":
        badgeColor = "rgba(239,68,68,0.2)";
        textColor  = "#EF4444";
        break;
      case "cancelled":
        badgeColor = "rgba(234,179,8,0.2)";
        textColor  = "#EAB308";
        break;
      default:
        badgeColor = "rgba(107,114,128,0.2)";
        textColor  = "#6B7280";
    }
    return `<span class="badge h-auto w-auto text-sm md:text-base"
                  style="background-color: ${badgeColor};
                         color: ${textColor};
                         border: 0px;">
              ${localizedLabel}
            </span>`;
  }
  function isStatusActive(rawStatus) {
    return Object.values(PUNISHMENT_LABELS).some(lang => lang.active === rawStatus);
  }
  function renderPunishments(punishments, nickname) {
    const activeBody  = document.getElementById("active-punishments-body");
    const historyBody = document.getElementById("history-punishments-body");
    let activeRows  = "";
    let historyRows = "";
    punishments.forEach(p => {
      const issuedAt  = p.issued_at;
      
      // Обработка даты окончания: если срок более 50 лет - показываем "Перманентный"
      let expiresAtDisplay;
      if (p.expires_at) {
        // Преобразуем дату из формата "DD.MM.YYYY HH:MM:SS" в формат, понятный для Date
        const dateParts = p.expires_at.split(' ');
        const dateComponent = dateParts[0].split('.');
        const timeComponent = dateParts[1].split(':');
        
        // Создаем дату в формате YYYY-MM-DDTHH:MM:SS
        const formattedDate = `${dateComponent[2]}-${dateComponent[1]}-${dateComponent[0]}T${timeComponent[0]}:${timeComponent[1]}:${timeComponent[2]}`;
        const expireDate = new Date(formattedDate);
        const now = new Date();
        
        // Проверяем, что дата корректно распарсилась
        if (isNaN(expireDate.getTime())) {
          console.error("Invalid date format:", p.expires_at);
          expiresAtDisplay = p.expires_at;
        } else {
          const diffYears = (expireDate - now) / (1000 * 60 * 60 * 24 * 365); // Разница в годах
          
          if (diffYears > 50) {
            expiresAtDisplay = window.PUNISHMENT_MESSAGES.permanent;
          } else {
            expiresAtDisplay = p.expires_at;
          }
        }
      } else {
        expiresAtDisplay = "—";
      }
      
      const badgeHtml = statusBadge(p.status);
      const cancelBtn = isStatusActive(p.status)
        ? `<button class="btn btn-sm text-sm bg-red-400 text-[#1A1A1A]
                          hover:bg-red-500 transition rounded"
                   onclick="cancelPunishment('${nickname}', '${p.issued_at}')">
             ${PUNISHMENT_MESSAGES.cancel}
           </button>`
        : "";
      const rowHtml = `<tr>
        <td class="py-3 px-4">${p.type}</td>
        <td class="py-3 px-4">${p.reason}</td>
        <td class="py-3 px-4">${issuedAt}</td>
        <td class="py-3 px-4">${expiresAtDisplay}</td>
        <td class="py-3 px-4">${badgeHtml}</td>
        <td class="py-3 px-4">${cancelBtn}</td>
      </tr>`;
      if (isStatusActive(p.status)) {
        activeRows += rowHtml;
      } else {
        historyRows += rowHtml.replace(`<td class="py-3 px-4">${cancelBtn}</td>`, "");
      }
    });
    activeBody.innerHTML = activeRows || `<tr><td colspan="6" class="py-3 px-4 text-center text-gray-400">${PUNISHMENT_MESSAGES.noActive}</td></tr>`;
    historyBody.innerHTML = historyRows || `<tr><td colspan="5" class="py-3 px-4 text-center text-gray-400">${PUNISHMENT_MESSAGES.noHistory}</td></tr>`;
  }
  function cancelPunishment(nickname, issuedAt) {
    fetch(`/admin/players/punishments/${nickname}/cancel`, {
      method: "POST",
      headers: {
        "Accept": "application/json",
        "Content-Type": "application/json"
      },
      body: JSON.stringify({ nickname, issued_at: issuedAt })
    })
    .then(response => {
      if (!response.ok) throw new Error("<%= I18n.t('common.errors.temporary') %>");
      return response.json();
    })
    .then(data => {
      showNotification("<%= I18n.t('admin.players.notifications.updated') %>");
    })
    .catch(error => {
      showAlertNotification("<%= I18n.t('common.errors.temporary') %>");
    });
  }
  function loadPlayerEdit(button) {
    const locale   = "<%= locale %>";
    const nickname = button.dataset.nickname;
    fetch(`/admin/players/${nickname}/edit_player`, {
      headers: { 'Accept': 'application/json' }
    })
      .then(response => {
        if (!response.ok) throw new Error("<%= I18n.t('admin.players.errors.load_failed') %>");
        return response.json();
      })
      .then(data => {
        const resolvedNick = data.nickname || data.discord || "<%= I18n.t('admin.players.default_nickname') %>";
        document.getElementById("modal-title").innerText =
          `<%= I18n.t('admin.players.edit.modal_title') %>: ${resolvedNick}`;
        document.getElementById("email").value   = data.email || "";
        document.getElementById("discord").value = data.discord || "";
        const passSelect = document.getElementById("pass");
        passSelect.value = data.pass_access ? "true" : "false";
        const sponsorSelect = document.getElementById("sponsor");
        sponsorSelect.value = data.is_sponsor ? "true" : "false";
        const addBtn = document.getElementById("add-restriction-btn");
        if (addBtn) {
          addBtn.dataset.nickname = resolvedNick;
        }
        renderPunishments(data.punishments, nickname);
        openEditModal();
      })
      .catch(error => {
        showAlertNotification("<%= I18n.t('admin.players.errors.load_failed_retry') %>");
      });
  }
</script>
