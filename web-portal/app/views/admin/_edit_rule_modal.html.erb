<dialog id="edit_rule_modal" class="modal">
  <div class="modal-box max-w-2xl w-full bg-[#1A1A1A] border-2 border-amber-400 relative h-auto overflow-y-auto">
    <div class="p-4">
      <!-- Заголовок -->
      <h2 class="text-2xl text-amber-400 font-bold mb-6"><%= t('views.admin.punishment_rules.edit.title') %></h2>
      
      <!-- Форма редактирования правила -->
      <%= form_with url: "#{ENV['IDENTITY_SERVICE_URL']}/api/v1/punishment_reasons",
              method: :patch,
              local: false,
              id: "edit_rule_form",
              data: { remote: false } do |f| %>
        <div class="space-y-4">
          <!-- Номер правила (теперь можно редактировать) -->
          <div>
            <label class="block text-white mb-2">
              <b><%= t('views.admin.punishment_rules.edit.rule_number_label') %></b>
            </label>
            <%= f.number_field :rule_number, 
                class: "w-full bg-[#2D2D2D] text-white rounded-lg p-3 border border-[#3d3d3d] focus:border-amber-400 focus:outline-none",
                required: true %>
          </div>
          
          <!-- Описание правила -->
          <div>
            <label class="block text-white mb-2">
              <b><%= t('views.admin.punishment_rules.edit.description_label') %></b>
            </label>
            <%= f.text_area :description, 
                class: "w-full bg-[#2D2D2D] text-white rounded-lg p-3 border border-[#3d3d3d] focus:border-amber-400 focus:outline-none min-h-[120px]",
                placeholder: t('views.admin.punishment_rules.edit.description_placeholder'),
                required: true %>
          </div>
          
          <!-- Тип наказания -->
          <div>
            <label class="block text-white mb-2">
              <b><%= t('views.admin.punishment_rules.edit.punishment_type_label') %></b>
            </label>
            <div class="grid grid-cols-2 gap-4">
              <label class="flex items-center space-x-2 cursor-pointer">
                <%= f.radio_button :punishment_type, "mute", 
                    class: "form-radio text-amber-400 bg-[#2D2D2D] border-[#3d3d3d] focus:ring-amber-400" %>
                <span class="text-white"><%= t('views.admin.punishment_rules.edit.punishment_type_mute') %></span>
              </label>
              <label class="flex items-center space-x-2 cursor-pointer">
                <%= f.radio_button :punishment_type, "ban", 
                    class: "form-radio text-amber-400 bg-[#2D2D2D] border-[#3d3d3d] focus:ring-amber-400" %>
                <span class="text-white"><%= t('views.admin.punishment_rules.edit.punishment_type_ban') %></span>
              </label>
            </div>
          </div>
          
          <!-- Цена -->
          <div>
            <label class="block text-white mb-2">
              <b><%= t('views.admin.punishment_rules.edit.price_label') %></b>
            </label>
            <%= f.number_field :price, 
                class: "w-full bg-[#2D2D2D] text-white rounded-lg p-3 border border-[#3d3d3d] focus:border-amber-400 focus:outline-none",
                placeholder: t('views.admin.punishment_rules.edit.price_placeholder'),
                min: "0",
                step: "0.01",
                required: true %>
          </div>
          
          <!-- Сообщение об ошибке -->
          <div id="edit_rule_error_message" class="hidden bg-red-900/30 text-red-400 p-3 rounded-lg border border-red-700">
            <p><%= t('views.admin.punishment_rules.edit.save_error_message') %></p>
          </div>
        </div>
        
        <!-- Кнопки действий -->
        <div class="flex justify-end space-x-3 mt-6">
          <button 
            type="button"
            class="btn btn-outline btn-warning text-xl hover:text-[#1A1A1A] shadow-lg hover:shadow-xl transition duration-200"
            onclick="document.getElementById('edit_rule_modal').close()"
          >
            <%= t('views.admin.punishment_rules.edit.cancel_button') %>
          </button>
          <button 
            type="submit"
            id="edit_rule_btn"
            class="btn bg-amber-400 text-black text-xl hover:bg-amber-500 shadow-lg hover:shadow-xl transition duration-200 border-none"
          >
            <%= t('views.admin.punishment_rules.edit.save_button') %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
  <!-- Фон -->
  <form method="dialog" class="modal-backdrop">
    <button></button>
  </form>
</dialog>
<script type="text/javascript">
  // Функция для открытия модального окна редактирования правила
  window.openEditRuleModal = function(ruleNumber) {
    const modal = document.getElementById('edit_rule_modal');
    if (!modal) {
      console.error('Edit rule modal not found!');
      return;
    }
    
    // Сбрасываем форму
    document.getElementById('edit_rule_form').reset();
    
    // Скрываем сообщение об ошибке
    document.getElementById('edit_rule_error_message').classList.add('hidden');
    
    // Получаем данные правила с сервера
    const authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>";
    fetch(`${authServiceUrl}/api/v1/punishment_reasons/${ruleNumber}`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-User-ID': '<%= current_user.id %>'
      }
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! Status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      if (data.reason) {
        // Заполняем форму данными
        const form = document.getElementById('edit_rule_form');
        form.rule_number.value = data.reason.rule_number;
        form.description.value = data.reason.description;
        form.price.value = data.reason.price;
        
        // Устанавливаем тип наказания
        if (data.reason.punishment_type) {
          const punishmentTypeRadio = form.querySelector(`input[name="punishment_type"][value="${data.reason.punishment_type}"]`);
          if (punishmentTypeRadio) {
            punishmentTypeRadio.checked = true;
          }
        }
        
        // Открываем модалку после заполнения формы
        modal.showModal();
      } else {
        showNotification(I18n.t('views.admin.punishment_rules.edit.load_data_error'));
      }
    })
    .catch(error => {
      console.error('Error loading rule:', error);
      showNotification(I18n.t('views.admin.punishment_rules.edit.load_error_with_message', { error: error.message }));
    });
  };
  
  // Обработка отправки формы
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('edit_rule_form');
    if (!form) return;
    
    form.addEventListener('submit', function(event) {
      event.preventDefault();
      event.stopPropagation(); // Останавливаем распространение события
      
      const submitBtn = document.getElementById('edit_rule_btn');
      const errorMessage = document.getElementById('edit_rule_error_message');
      
      // Блокируем кнопку на время отправки
      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = I18n.t('views.admin.punishment_rules.edit.saving_button_text');
      
      // Скрываем предыдущее сообщение об ошибке
      errorMessage.classList.add('hidden');
      
      // Получаем данные формы
      const formData = new FormData(form);
      const originalRuleNumber = formData.get('rule_number'); // Сохраняем оригинальный номер для URL
      
      // Создаем объект с данными для отправки в формате JSON
      const requestData = {
        rule_number: formData.get('rule_number'),
        description: formData.get('description'),
        punishment_type: formData.get('punishment_type'),
        price: formData.get('price')
      };
      
      // Отправляем запрос на обновление правила
      const authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>";
      fetch(`${authServiceUrl}/api/v1/punishment_reasons/${originalRuleNumber}`, {
        method: 'PATCH',
        body: JSON.stringify(requestData),
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content,
          'X-User-ID': '<%= current_user.id %>'
        }
      })
      .then(response => {
        // Если ответ успешный (2xx), считаем операцию выполненной
        if (response.ok) {
          // Проверяем, есть ли контент в ответе
          const contentLength = response.headers.get('content-length');
          if (contentLength && contentLength !== '0') {
            // Если есть контент, пытаемся распарсить как JSON
            const contentType = response.headers.get('content-type');
            if (contentType && contentType.includes('application/json')) {
              return response.json().then(data => {
                return { status: 'ok', data };
              }).catch(() => {
                // Не удалось распарсить JSON, но ответ успешный
                return { status: 'ok', data: null };
              });
            }
          }
          // Ответ успешный, но без контента или не JSON
          return { status: 'ok', data: null };
        }
        
        // Если ответ не успешный, пытаемся получить сообщение об ошибке
        const contentType = response.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
          return response.json().then(data => {
            throw { status: 'error', data };
          });
        } else {
          // Если ответ не JSON, просто бросаем ошибку со статусом
          throw { status: 'error', message: `Ошибка HTTP: ${response.status}` };
        }
      })
      .then(result => {
        // Если мы здесь, значит операция успешна
        // Показываем уведомление об успехе
        showNotification(I18n.t('views.admin.punishment_rules.edit.success_message'));
        
        // Закрываем модалку
        document.getElementById('edit_rule_modal').close();
        
        // Перезагружаем страницу для обновления списка правил
        window.location.reload();
      })
      .catch(error => {
        console.error('Error updating rule:', error);
        
        // Показываем общее сообщение об ошибке
        let errorMessageText = I18n.t('views.admin.punishment_rules.edit.update_error_message');
        if (error.data && error.data.message) {
          errorMessageText = error.data.message;
        } else if (error.message) {
          errorMessageText = error.message;
        }
        
        errorMessage.querySelector('p').textContent = errorMessageText;
        errorMessage.classList.remove('hidden');
      })
      .finally(() => {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      });
      
      return false; // Предотвращаем стандартную отправку формы
    });
  });
</script>
