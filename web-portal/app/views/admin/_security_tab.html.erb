<div class="space-y-4">
  <h4 class="text-xl font-semibold"><%= I18n.t('admin.players.security.title') %></h4>
  <div class="w-full h-px bg-[#2D2D2D]"></div>

  <div class="relative">
    <label for="new_password" class="block text-sm mb-1"><%= I18n.t('admin.players.security.new_password') %></label>
    <input
      id="new_password"
      type="password"
      class="input w-full bg-[#2D2D2D] text-white focus:outline-none focus:bg-[#2D2D2D]" />
    <button 
      type="button" 
      id="togglePassword"
      class="absolute right-3 mt-3 password-toggle text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-2 rounded-full transition ease-in-out duration-200"
      aria-label="<%= I18n.t('admin.players.security.show_password') %>">
      <svg class="w-6 h-6" aria-hidden="true" fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
      </svg>
    </button>
  </div>

  <div class="relative">
    <label for="confirm_password" class="block text-sm mb-1"><%= I18n.t('admin.players.security.confirm_password') %></label>
    <input
      id="confirm_password"
      type="password"
      class="input w-full bg-[#2D2D2D] text-white focus:outline-none focus:bg-[#2D2D2D]" />
    <button 
      type="button" 
      id="togglePasswordConfirmation"
      class="absolute mt-3 right-3 password-toggle text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-2 rounded-full transition ease-in-out duration-200"
      aria-label="<%= I18n.t('admin.players.security.show_password') %>">
      <svg class="w-6 h-6" aria-hidden="true" fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
      </svg>
    </button>
  </div>

  <button id="change-password-btn"
          type="button"
          class="btn bg-amber-400 text-black hover:bg-[#FFC400] transition duration-150">
    <%= I18n.t('admin.players.security.change_password') %>
  </button>
</div>

<script>
  function setupPasswordToggle(toggleId, passwordId) {
    const toggleBtn = document.getElementById(toggleId);
    const passwordField = document.getElementById(passwordId);

    if (toggleBtn && passwordField) {
      toggleBtn.addEventListener("click", function () {
        const isHidden = passwordField.getAttribute("type") === "password";
        passwordField.setAttribute("type", isHidden ? "text" : "password");

        toggleBtn.innerHTML = isHidden
          ? `<svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24">
               <path stroke="currentColor" stroke-width="2" d="M21 12c0 1.2-4.03 6-9 6s-9-4.8-9-6c0-1.2 4.03-6 9-6s9 4.8 9 6Z"/>
               <path stroke="currentColor" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
             </svg>`
          : `<svg class="w-6 h-6 text-gray-300" fill="none" viewBox="0 0 24 24">
               <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                 d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
             </svg>`;
      });
    }
  }

  setupPasswordToggle("togglePassword", "new_password");
  setupPasswordToggle("togglePasswordConfirmation", "confirm_password");

  document.getElementById("change-password-btn").addEventListener("click", function () {
    const newPassword     = document.getElementById("new_password").value;
    const confirmPassword = document.getElementById("confirm_password").value;

    const nickname = document.getElementById("add-restriction-btn")?.dataset.nickname;

    if (!nickname) {
      showAlertNotification("<%= I18n.t('admin.players.errors.undefined_nickname') %>");
      return;
    }

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    fetch(`/admin/players/${nickname}/change_password`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": csrfToken,
        "Accept": "application/json"
      },
      body: JSON.stringify({
        new_password: newPassword,
        confirm_password: confirmPassword
      })
    })
    .then(async response => {
      const data = await response.json();

      if (!response.ok) {
        const msg = data?.error || `<%= I18n.t('common.errors.generic') %>: ${response.status}`;
        throw new Error(msg);
      }

      showNotification("<%= I18n.t('admin.players.security.password_changed') %>");
      document.getElementById("new_password").value = "";
      document.getElementById("confirm_password").value = "";
    })
    .catch(error => {
      showAlertNotification("<%= I18n.t('common.errors.request_failed') %>");
    });
  });
</script>
