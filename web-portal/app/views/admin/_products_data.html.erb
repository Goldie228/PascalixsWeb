<div class="w-full max-w-7xl mx-auto px-3 sm:px-4 py-6 sm:py-8">
  <h1 class="text-white text-2xl sm:text-3xl md:text-4xl font-extrabold mb-6 text-center"><%= t('views.admin.products.price_management.title') %></h1>
  
  <!-- Контейнер для карточек товаров -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6" id="productsContainer">
    <!-- Карточки товаров будут загружены через JavaScript -->
  </div>

  
  <!-- Индикатор загрузки -->
  <div id="loadingIndicator" class="hidden flex justify-center items-center py-8 sm:py-12">
    <div class="flex flex-col items-center">
      <div class="w-12 h-12 sm:w-16 sm:h-16 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
      <span class="mt-3 sm:mt-4 text-amber-400 text-sm sm:text-lg"><%= t('views.admin.products.price_management.loading') %></span>
    </div>
  </div>
</div>
<!-- Модальное окно для подтверждения обновления цены -->
<div id="confirmModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 px-3 py-4">
  <div class="bg-[#2D2D2D] rounded-xl p-4 sm:p-6 max-w-md w-full mx-2 border-2 border-amber-400">
    <h3 class="text-white text-lg sm:text-xl font-bold mb-3 sm:mb-4"><%= t('views.admin.products.price_management.modal.title') %></h3>
    <div class="text-gray-300 text-sm sm:text-base mb-4 sm:mb-6">
      <p class="mb-2"><%= t('views.admin.products.price_management.modal.confirmation_text') %></p>
      <p id="modalProductName" class="text-amber-400 font-semibold break-words mb-3"></p>
      <div class="flex flex-col gap-1">
        <div><%= t('views.admin.products.price_management.modal.current_price') %> <span id="modalOldPrice" class="text-green-400 break-words"></span></div>
        <div><%= t('views.admin.products.price_management.modal.new_price') %> <span id="modalNewPrice" class="text-amber-400 break-words"></span></div>
      </div>
    </div>
    <div class="flex flex-col xs:flex-row justify-end gap-2 sm:gap-3">
      <button onclick="closeConfirmModal()" class="px-3 py-2 sm:px-4 sm:py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition text-sm sm:text-base order-2 xs:order-1">
        <%= t('views.admin.products.price_management.modal.cancel_button') %>
      </button>
      <button onclick="confirmUpdate()" class="px-3 py-2 sm:px-4 sm:py-2 bg-amber-500 text-black rounded-lg hover:bg-amber-600 transition font-semibold text-sm sm:text-base order-1 xs:order-2">
        <%= t('views.admin.products.price_management.modal.confirm_button') %>
      </button>
    </div>
  </div>
</div>
