<%= render 'shared/payment_modal' %>

<div class="w-full mx-auto pb-8" data-user-id="<%= current_user.id %>" data-time-zone="<%= session[:time_zone] || 'UTC' %>">
    <div class="mb-8 px-4">
      <div class="flex flex-col">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-center mb-4">
          <%= t('views.admin.gallery.index.title') %>
        </h1>
        <div class="flex justify-center md:justify-end">
          <button
            class="btn bg-amber-400 text-black hover:bg-amber-300 border-none transition flex items-center"
            onclick="openAddGalleryModal()"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd"
                d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
                clip-rule="evenodd" />
            </svg>
            <%= t('views.admin.gallery.index.add_album') %>
          </button>
        </div>
      </div>
    </div>

    <!-- Панель управления -->
    <div class="flex flex-col gap-6 mb-6 md:mb-8 px-4">
        <!-- Первая строка элементов управления -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="form-control w-full md:w-auto">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-amber-400 font-semibold text-sm md:text-base"><%= t('views.admin.gallery.index.controls.per_page') %></span>
                    
                    <div class="dropdown dropdown-end">
                        <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                            <span class="text-xs md:text-sm" id="perPageLabel">25</span>
                            <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </label>
                        <ul class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-32 mt-1">
                            <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="25">25</a></li>
                            <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="50">50</a></li>
                            <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="75">75</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Вторая строка элементов управления -->
        <div class="grid grid-cols-1 md:flex md:flex-row gap-4 md:gap-6 justify-between">
            <div class="flex flex-col md:flex-row gap-4 md:gap-6 w-full md:w-auto">
                <div class="form-control w-full md:w-auto">
                    <div class="flex items-center gap-2">
                        <span class="text-amber-400 font-semibold text-sm md:text-base"><%= t('views.admin.gallery.index.controls.sort_direction') %></span>
                        
                        <div class="dropdown dropdown-end">
                            <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                                <span class="text-xs md:text-sm" id="sortOrderLabel"><%= t('views.admin.gallery.index.controls.desc') %></span>
                                <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </label>
                            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-44 md:w-52 mt-1">
                                <li><a href="#" class="sort-order-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="asc"><%= t('views.admin.gallery.index.controls.asc') %></a></li>
                                <li><a href="#" class="sort-order-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="desc"><%= t('views.admin.gallery.index.controls.desc') %></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <div class="form-control w-full md:w-auto">
                    <div class="flex items-center gap-2">
                        <span class="text-amber-400 font-semibold text-sm md:text-base"><%= t('views.admin.gallery.index.controls.sort_by') %></span>
                        <div class="dropdown dropdown-end">
                            <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                                <span class="text-xs md:text-sm truncate max-w-[100px] md:max-w-none" id="sortByLabel"><%= t('views.admin.gallery.index.controls.by_created_at') %></span>
                                <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </label>
                            <ul class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-44 md:w-52 mt-1">
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="title"><%= t('views.admin.gallery.index.controls.by_title') %></a></li>
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="created_at"><%= t('views.admin.gallery.index.controls.by_created_at') %></a></li>
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="photos_count"><%= t('views.admin.gallery.index.controls.by_photos_count') %></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="w-full md:w-auto">
                <input type="text" id="searchInput" placeholder="<%= t('views.admin.gallery.index.search') %>" class="input input-sm md:input-md w-full bg-[#2D2D2D] text-white placeholder-[#A0A0A0] border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition">
            </div>
        </div>
        
        <!-- Фильтры -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
            <div>
                <label class="block text-sm font-medium text-amber-400 mb-1"><%= t('views.admin.gallery.index.filters.status') %></label>
                <select id="publishedFilter" class="select select-sm md:select-md w-full bg-[#2D2D2D] text-white border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
                    <option value=""><%= t('views.admin.gallery.index.filters.all') %></option>
                    <option value="true"><%= t('views.admin.gallery.index.filters.published') %></option>
                    <option value="false"><%= t('views.admin.gallery.index.filters.unpublished') %></option>
                </select>
            </div>
        </div>
    </div>
    
    <!-- Таблица с данными (для десктопа) -->
    <div class="hidden md:block w-full overflow-x-auto rounded-box overflow-hidden">
        <table class="table w-full">
            <thead class="text-white" style="background-color: #2D2D2D">
                <tr>
                    <th class="py-3 px-2 md:px-4"><%= t('views.admin.gallery.index.table.title') %></th>
                    <th class="py-3 px-2 md:px-4"><%= t('views.admin.gallery.index.table.description') %></th>
                    <th class="py-3 px-2 md:px-4"><%= t('views.admin.gallery.index.table.published') %></th>
                    <th class="py-3 px-2 md:px-4"><%= t('views.admin.gallery.index.table.photos_count') %></th>
                    <th class="py-3 px-2 md:px-4"><%= t('views.admin.gallery.index.table.created_at') %></th>
                    <th class="py-3 px-2 md:px-4"><%= t('views.admin.gallery.index.table.actions') %></th>
                </tr>
            </thead>
            <tbody class="text-white" style="background-color: #383838">
                <!-- Данные будут загружены через JavaScript -->
            </tbody>
        </table>
    </div>
    
    <!-- Карточки для мобильных устройств -->
    <div id="cardsContainer" class="md:hidden grid grid-cols-1 gap-4 mt-4 px-4">
        <!-- Карточки будут загружены через JavaScript -->
    </div>
    
    <!-- Пагинация -->
    <div id="paginationContainer" class="flex justify-center items-center gap-2 mt-6 flex-wrap px-4 overflow-x-auto">
        <!-- Пагинация будет загружена через JavaScript -->
    </div>
</div>

<!-- Модальное окно для редактирования галереи -->
<dialog id="editGalleryModal" class="modal">
  <div class="modal-box w-full max-w-2xl bg-[#1A1A1A] border border-amber-400 p-8 rounded">
    <h3 class="text-2xl text-amber-400 font-bold mb-4"><%= t('views.admin.gallery.index.modals.edit_title') %></h3>
    <p class="text-white mb-4"><%= t('views.admin.gallery.index.modals.edit_desc') %> <span id="editGalleryId" class="font-bold"></span></p>
    <div class="modal-action">
      <button class="btn text-sm px-4 py-2 text-gray-300 bg-[#2D2D2D] hover:bg-[#3A3A3A] transition" onclick="closeEditGalleryModal()">
        <%= t('views.admin.gallery.index.actions.close') %>
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<!-- Модальное окно для подтверждения удаления -->
<dialog id="deleteConfirmModal" class="modal">
  <div class="modal-box w-full max-w-2xl bg-[#1A1A1A] border border-red-500 p-8 rounded">
    <h3 class="text-2xl text-red-500 font-bold mb-4"><%= t('views.admin.gallery.index.modals.delete_title') %></h3>
    <p class="text-white mb-6"><%= t('views.admin.gallery.index.modals.delete_message_part1') %> "<span id="deleteGalleryTitle" class="font-bold"></span>"<%= t('views.admin.gallery.index.modals.delete_message_part2') %></p>
    <div class="modal-action flex justify-end gap-3">
      <button class="btn text-sm px-4 py-2 text-gray-300 bg-[#2D2D2D] hover:bg-[#3A3A3A] transition" onclick="closeDeleteConfirmModal()">
        <%= t('views.admin.gallery.index.modals.cancel') %>
      </button>
      <button class="btn text-sm px-4 py-2 text-white bg-red-500 hover:bg-red-600 transition" onclick="confirmDeleteGallery()">
        <%= t('views.admin.gallery.index.modals.confirm_delete') %>
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<script>
    // Глобальные переменные для хранения параметров
    let currentPage = 1;
    let perPage = 25;
    let sortBy = 'created_at';
    let sortOrder = 'desc';
    let filters = {
        published: '',
        search: ''
    };
    let isLoading = false;
    let galleryToDelete = null;
    
    // Получаем ID пользователя и временную зону
    const actorId = document.querySelector('[data-user-id]')?.getAttribute('data-user-id') || '';
    const timeZone = document.querySelector('[data-time-zone]')?.getAttribute('data-time-zone') || 'UTC';
    
    // Инициализация обработчиков событий
    document.addEventListener('DOMContentLoaded', function() {
        // Загрузка данных при загрузке страницы
        loadGalleries();
        
        // Обработчики для выпадающих списков
        document.querySelectorAll('.per-page-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                perPage = parseInt(this.getAttribute('data-value')) || 25;
                const perPageLabel = document.getElementById('perPageLabel');
                if (perPageLabel) perPageLabel.textContent = perPage;
                currentPage = 1; // Сбрасываем на первую страницу
                loadGalleries();
            });
        });
        
        document.querySelectorAll('.sort-order-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                sortOrder = this.getAttribute('data-value') || 'desc';
                const sortOrderLabel = document.getElementById('sortOrderLabel');
                if (sortOrderLabel) {
                    sortOrderLabel.textContent = 
                        sortOrder === 'asc' ? "<%= j t('views.admin.gallery.index.controls.asc') %>" : "<%= j t('views.admin.gallery.index.controls.desc') %>";
                }
                loadGalleries();
            });
        });
        
        document.querySelectorAll('.sort-by-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                sortBy = this.getAttribute('data-value') || 'created_at';
                const sortByLabel = document.getElementById('sortByLabel');
                if (sortByLabel) sortByLabel.textContent = this.textContent;
                loadGalleries();
            });
        });
        
        // Обработчик для поиска
        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                filters.search = this.value || '';
                // Используем debounce для оптимизации
                clearTimeout(this.searchTimeout);
                this.searchTimeout = setTimeout(() => {
                    currentPage = 1;
                    loadGalleries();
                }, 500);
            });
        }
        
        // Обработчик для фильтра по статусу публикации
        const publishedFilter = document.getElementById('publishedFilter');
        if (publishedFilter) {
            publishedFilter.addEventListener('change', function() {
                filters.published = this.value || '';
                currentPage = 1;
                loadGalleries();
            });
        }
    });
    
    // Функции для управления индикатором загрузки
    function showGlobalLoading() {
        if (!document.getElementById('global-loading')) {
            const loadingDiv = document.createElement('div');
            loadingDiv.id = 'global-loading';
            loadingDiv.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
            loadingDiv.innerHTML = `
                <div class="flex flex-col items-center">
                    <div class="w-16 h-16 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
                    <span class="mt-4 text-amber-400 text-lg"><%= j t('views.admin.gallery.index.messages.loading') %></span>
                </div>
            `;
            document.body.appendChild(loadingDiv);
        }
    }
    
    function hideGlobalLoading() {
        const loadingDiv = document.getElementById('global-loading');
        if (loadingDiv) {
            loadingDiv.remove();
        }
    }
    
    // Функция для отображения индикатора загрузки в tbody
    function showLoading() {
        isLoading = true;
        
        // Для таблицы
        const tableBody = document.querySelector('tbody');
        if (tableBody) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center py-10">
                        <div class="flex flex-col items-center justify-center">
                            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-400 mx-auto"></div>
                            <span class="mt-4 text-white font-medium"><%= j t('views.admin.gallery.index.messages.loading') %></span>
                        </div>
                    </td>
                </tr>
            `;
        }
        
        // Для карточек
        const cardsContainer = document.getElementById('cardsContainer');
        if (cardsContainer) {
            cardsContainer.innerHTML = `
                <div class="flex flex-col items-center justify-center py-10 w-full">
                    <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-400 mx-auto"></div>
                    <span class="mt-4 text-white font-medium"><%= j t('views.admin.gallery.index.messages.loading') %></span>
                </div>
            `;
        }
    }
    
    // Функция для загрузки данных с API
    async function loadGalleries() {
        if (isLoading) return;
        
        try {
            showLoading();
            
            // Формируем URL с параметрами
            const params = new URLSearchParams();
            params.append('page', currentPage);
            params.append('per_page', perPage);
            params.append('sort', sortBy);
            params.append('order', sortOrder);
            
            // Добавляем фильтры
            if (filters.search) params.append('search', filters.search);
            if (filters.published) params.append('published', filters.published);
            
            const authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>";
            const url = `${authServiceUrl}/api/v1/galleries?${params.toString()}`;
            
            // Отправляем запрос
            const response = await fetch(url, {
                method: 'GET',
                credentials: 'include',
                headers: {
                    'X-User-ID': actorId
                }
            });
            
            if (!response.ok) {
                throw new Error(`Ошибка HTTP: ${response.status}`);
            }
            
            const data = await response.json();
            
            // Обновляем таблицу и карточки
            updateGalleriesTable(data.galleries || []);
            
            // Обновляем пагинацию
            updatePagination(data.total_count || 0);
            
        } catch (error) {
            showAlertNotification('<%= j t('views.admin.gallery.index.messages.error_loading') %>');
            
            // Показываем сообщение об ошибке в таблице
            const tableBody = document.querySelector('tbody');
            if (tableBody) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center py-6 text-red-400">
                            <%= j t('views.admin.gallery.index.messages.error_loading_table') %>
                        </td>
                    </tr>
                `;
            }
            
            // Показываем сообщение об ошибке в карточках
            const cardsContainer = document.getElementById('cardsContainer');
            if (cardsContainer) {
                cardsContainer.innerHTML = `
                    <div class="bg-[#383838] rounded-lg p-4 shadow-md text-red-400 text-center">
                        <%= j t('views.admin.gallery.index.messages.error_loading_table') %>
                    </div>
                `;
            }
        } finally {
            isLoading = false;
        }
    }
    
    // Функция для обновления таблицы и карточек
    function updateGalleriesTable(galleries) {
        // Обновляем таблицу (для десктопа)
        const tableBody = document.querySelector('tbody');
        
        if (!galleries || galleries.length === 0) {
            if (tableBody) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center py-6 text-gray-400">
                            <%= j t('views.admin.gallery.index.messages.no_data') %>
                        </td>
                    </tr>
                `;
            }
            
            // Обновляем карточки (для мобильных)
            const cardsContainer = document.getElementById('cardsContainer');
            if (cardsContainer) {
                cardsContainer.innerHTML = `
                    <div class="bg-[#383838] rounded-lg p-4 shadow-md text-center text-gray-400">
                        <%= j t('views.admin.gallery.index.messages.no_data') %>
                    </div>
                `;
            }
            
            return;
        }
        
        // Обновляем таблицу
        if (tableBody) {
            tableBody.innerHTML = galleries.map(gallery => {
                // Защита от undefined
                const galleryId = gallery.id || 'unknown';
                const title = gallery.title || "<%= j t('views.admin.gallery.index.messages.unnamed') %>";
                const description = gallery.description || "<%= j t('views.admin.gallery.index.messages.no_description') %>";
                const published = gallery.published || false;
                const photosCount = gallery.photos_count || 0;
                
                // Используем отформатированную дату с сервера или форматируем на клиенте
                let createdDate = gallery.created_at_formatted;
                if (!createdDate && gallery.created_at) {
                    // Если отформатированной даты нет, форматируем на клиенте
                    createdDate = formatDateWithTimeZone(gallery.created_at, timeZone);
                } else if (!createdDate) {
                    createdDate = "<%= j t('views.admin.gallery.index.messages.date_not_specified') %>";
                }
                
                // Определяем статус публикации
                const publishedStatus = published ? 
                    `<span class="px-2 py-1 rounded-full bg-green-500 text-black text-xs"><%= j t('views.admin.gallery.index.filters.published') %></span>` : 
                    `<span class="px-2 py-1 rounded-full bg-red-500 text-black text-xs"><%= j t('views.admin.gallery.index.filters.unpublished') %></span>`;
                
                return `
                    <tr data-gallery-id="${galleryId}">
                        <td class="py-3 px-2 md:px-4">${escapeHtml(title)}</td>
                        <td class="py-3 px-2 md:px-4">${escapeHtml(description)}</td>
                        <td class="py-3 px-2 md:px-4">${publishedStatus}</td>
                        <td class="py-3 px-2 md:px-4">${photosCount}</td>
                        <td class="py-3 px-2 md:px-4">${escapeHtml(createdDate)}</td>
                        <td class="py-3 px-2 md:px-4">
                            <div class="flex gap-2">
                                <button class="btn btn-xs md:btn-sm bg-amber-400 text-black hover:bg-amber-300 border-none transition edit-btn" data-id="${galleryId}">
                                    <%= j t('views.admin.gallery.index.actions.edit') %>
                                </button>
                                <button class="btn btn-xs md:btn-sm bg-red-500 text-white hover:bg-red-600 border-none transition delete-btn" data-id="${galleryId}" data-title="${escapeHtml(title)}">
                                    <%= j t('views.admin.gallery.index.actions.delete') %>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }
        
        // Обновляем карточки (для мобильных)
        const cardsContainer = document.getElementById('cardsContainer');
        if (cardsContainer) {
            cardsContainer.innerHTML = galleries.map(gallery => {
                // Защита от undefined
                const galleryId = gallery.id || 'unknown';
                const title = gallery.title || "<%= j t('views.admin.gallery.index.messages.unnamed') %>";
                const description = gallery.description || "<%= j t('views.admin.gallery.index.messages.no_description') %>";
                const published = gallery.published || false;
                const photosCount = gallery.photos_count || 0;
                
                // Используем отформатированную дату с сервера или форматируем на клиенте
                let createdDate = gallery.created_at_formatted;
                if (!createdDate && gallery.created_at) {
                    // Если отформатированной даты нет, форматируем на клиенте
                    createdDate = formatDateWithTimeZone(gallery.created_at, timeZone);
                } else if (!createdDate) {
                    createdDate = "<%= j t('views.admin.gallery.index.messages.date_not_specified') %>";
                }
                
                // Определяем статус публикации
                const publishedStatus = published ? 
                    `<span class="px-2 py-1 rounded-full bg-green-500 text-black text-xs"><%= j t('views.admin.gallery.index.filters.published') %></span>` : 
                    `<span class="px-2 py-1 rounded-full bg-red-500 text-black text-xs"><%= j t('views.admin.gallery.index.filters.unpublished') %></span>`;
                
                return `
                    <div class="bg-[#383838] rounded-lg p-4 shadow-md">
                        <div class="mb-4">
                            <h3 class="text-lg font-semibold text-white break-words">${escapeHtml(title)}</h3>
                            <p class="text-gray-400 mt-1">${escapeHtml(description)}</p>
                        </div>
                        <div class="grid grid-cols-2 gap-4 mb-4">
                            <div>
                                <p class="text-gray-400 text-sm"><%= j t('views.admin.gallery.index.card.status') %></p>
                                <p>${publishedStatus}</p>
                            </div>
                            <div>
                                <p class="text-gray-400 text-sm"><%= j t('views.admin.gallery.index.table.photos_count') %></p>
                                <p class="text-white">${photosCount}</p>
                            </div>
                        </div>
                        <div class="text-sm mb-4">
                            <p class="text-gray-400"><%= j t('views.admin.gallery.index.table.created_at') %></p>
                            <p class="text-white">${escapeHtml(createdDate)}</p>
                        </div>
                        <div class="mt-4 flex justify-end gap-2">
                            <button class="btn btn-xs bg-amber-400 text-black hover:bg-amber-300 border-none transition edit-btn" data-id="${galleryId}">
                                <%= j t('views.admin.gallery.index.actions.edit') %>
                            </button>
                            <button class="btn btn-xs bg-red-500 text-white hover:bg-red-600 border-none transition delete-btn" data-id="${galleryId}" data-title="${escapeHtml(title)}">
                                <%= j t('views.admin.gallery.index.actions.delete') %>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }
        
        // Добавляем обработчики событий для кнопок действий
        addGalleryActionListeners();
    }
    
  // Функция для добавления обработчиков событий для кнопок действий
  function addGalleryActionListeners() {
      // Кнопка "Редактировать" (и в таблице, и в карточках)
      document.querySelectorAll('.edit-btn').forEach(btn => {
          btn.addEventListener('click', function() {
              const galleryId = this.getAttribute('data-id');
              if (galleryId) {
                  // Вызываем правильную функцию из нижнего скрипта
                  openEditGalleryModal(galleryId);
              }
          });
      });
      
      // Кнопка "Удалить" (и в таблице, и в карточках)
      document.querySelectorAll('.delete-btn').forEach(btn => {
          btn.addEventListener('click', function() {
              const galleryId = this.getAttribute('data-id');
              const galleryTitle = this.getAttribute('data-title') || "<%= j t('views.admin.gallery.index.messages.unnamed') %>";
              if (galleryId) {
                  openDeleteConfirmModal(galleryId, galleryTitle);
              }
          });
      });
  }
    
    // Функция для редактирования галереи
    function editGallery(galleryId) {
        if (!galleryId) return;
        
        const editGalleryIdElement = document.getElementById('editGalleryId');
        if (editGalleryIdElement) {
            editGalleryIdElement.textContent = galleryId;
        }
        
        const modal = document.getElementById('editGalleryModal');
        if (modal) modal.showModal();
    }

    // Функция для закрытия модального окна добавления галереи
    function closeAddGalleryModal() {
        const modal = document.getElementById('addGalleryModal');
        if (modal) modal.close();
    }
    
    // Функция для открытия модального окна подтверждения удаления
    function openDeleteConfirmModal(galleryId, galleryTitle) {
        if (!galleryId) return;
        
        galleryToDelete = galleryId;
        const deleteGalleryTitleElement = document.getElementById('deleteGalleryTitle');
        if (deleteGalleryTitleElement) {
            deleteGalleryTitleElement.textContent = galleryTitle;
        }
        
        const modal = document.getElementById('deleteConfirmModal');
        if (modal) modal.showModal();
    }
    
    // Функция для закрытия модального окна подтверждения удаления
    function closeDeleteConfirmModal() {
        galleryToDelete = null;
        const modal = document.getElementById('deleteConfirmModal');
        if (modal) modal.close();
    }
    
    // Функция для подтверждения удаления галереи
    async function confirmDeleteGallery() {
        if (!galleryToDelete) return;
        
        try {
            showGlobalLoading();
            
            const authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>";
            const url = `${authServiceUrl}/api/v1/galleries/${galleryToDelete}`;
            
            // Отправляем DELETE-запрос
            const response = await fetch(url, {
                method: 'DELETE',
                credentials: 'include',
                headers: {
                    'X-User-ID': actorId
                }
            });
            
            if (!response.ok) {
                throw new Error(`Ошибка HTTP: ${response.status}`);
            }
            
            // Закрываем модальное окно
            closeDeleteConfirmModal();
            
            // Показываем уведомление об успешном удалении
            showNotification('<%= j t('views.admin.gallery.index.messages.delete_success') %>');
            
            // Перезагружаем данные
            loadGalleries();
            
        } catch (error) {
            showAlertNotification('<%= j t('views.admin.gallery.index.messages.delete_error') %>');
            console.error('Error deleting gallery:', error);
        } finally {
            hideGlobalLoading();
        }
    }
    
    // Функция для форматирования даты с учетом временной зоны
    function formatDateWithTimeZone(dateString, timeZone) {
        if (!dateString) return "<%= j t('views.admin.gallery.index.messages.date_not_specified') %>";
        
        const date = new Date(dateString);
        
        // Проверяем, является ли дата валидной
        if (isNaN(date.getTime())) {
            return "<%= j t('views.admin.gallery.index.messages.invalid_date') %>";
        }
        
        // Преобразуем временную зону в формат IANA, если необходимо
        let ianaTimeZone = timeZone;
        if (timeZone === 'Moscow') {
            ianaTimeZone = 'Europe/Moscow';
        } else if (timeZone === 'UTC') {
            ianaTimeZone = 'UTC';
        }
        
        try {
            const options = {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                timeZone: ianaTimeZone
            };
            
            return new Intl.DateTimeFormat('ru-RU', options).format(date);
        } catch (error) {
            console.error('Ошибка форматирования даты:', error);
            // Если временная зона недействительна, используем UTC
            const options = {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                timeZone: 'UTC'
            };
            
            return new Intl.DateTimeFormat('ru-RU', options).format(date);
        }
    }
    
    // Функция для обновления пагинации
    function updatePagination(totalCount) {
        const container = document.getElementById('paginationContainer');
        if (!container) return;
        
        const totalPages = Math.ceil(totalCount / perPage);
        
        if (totalPages <= 1) {
            container.innerHTML = '';
            return;
        }
        
        let paginationHTML = '';
        
        // Определяем диапазон страниц для отображения
        let pageRange = [];
        if (totalPages <= 7) {
            pageRange = Array.from({length: totalPages}, (_, i) => i + 1);
        } else {
            if (currentPage <= 4) {
                pageRange = [1, 2, 3, 4, 5, '...', totalPages];
            } else if (currentPage >= totalPages - 3) {
                pageRange = [1, '...', totalPages - 4, totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
            } else {
                pageRange = [1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages];
            }
        }
        
        // Кнопка "Предыдущая"
        if (currentPage > 1) {
            paginationHTML += `
                <button class="btn border-amber-400 bg-[#121212] text-white hover:bg-[#1a1a1a] transition btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${currentPage - 1}">
                    <%= j t('views.admin.gallery.index.pagination.previous') %>
                </button>
            `;
        }
        
        // Страницы
        pageRange.forEach(page => {
            if (page === '...') {
                paginationHTML += `<span class="text-white px-2 whitespace-nowrap">...</span>`;
            } else {
                const isActive = page === currentPage;
                paginationHTML += `
                    <button class="btn border-amber-400 transition ${isActive ? 'bg-amber-400 text-black font-semibold shadow-md' : 'bg-[#121212] text-white hover:bg-[#1a1a1a]'} btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${page}">
                        ${page}
                    </button>
                `;
            }
        });
        
        // Кнопка "Следующая"
        if (currentPage < totalPages) {
            paginationHTML += `
                <button class="btn border-amber-400 bg-[#121212] text-white hover:bg-[#1a1a1a] transition btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${currentPage + 1}">
                    <%= j t('views.admin.gallery.index.pagination.next') %>
                </button>
            `;
        }
        
        container.innerHTML = paginationHTML;
        
        // Добавляем обработчики событий для кнопок пагинации
        document.querySelectorAll('.page-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const page = parseInt(this.getAttribute('data-page'));
                if (!isNaN(page)) {
                    currentPage = page;
                    loadGalleries();
                }
            });
        });
    }
    
    // Функция для экранирования HTML
    function escapeHtml(unsafe) {
        if (unsafe === null || unsafe === undefined) {
            return '';
        }
        return unsafe
            .toString()
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }
</script>
