  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<!-- Подключаем Cropper.js и CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>

<script>
  // Локализация для JS
  const i18n = {
    modals: {
      edit: {
        form: {
          status_original: '<%= j t('views.admin.gallery.index.modals.edit.form.status_original') %>',
          status_edited: '<%= j t('views.admin.gallery.index.modals.edit.form.status_edited') %>'
        }
      },
      add: {
        form: {
          no_photos: '<%= j t('views.admin.gallery.index.modals.add.form.no_photos') %>',
          untitled: '<%= j t('views.admin.gallery.index.modals.add.form.untitled') %>'
        }
      }
    },
    js: {
      errors: {
        title_required: '<%= j t('views.admin.gallery.index.js.errors.title_required') %>',
        photos_required_for_publish: '<%= j t('views.admin.gallery.index.js.errors.photos_required_for_publish') %>',
        photos_processing_required: '<%= j t('views.admin.gallery.index.js.errors.photos_processing_required') %>',
        save_changes_failed: '<%= j t('views.admin.gallery.index.js.errors.save_changes_failed') %>',
        delete_photo_failed: '<%= j t('views.admin.gallery.index.js.errors.delete_photo_failed') %>'
      },
      success: {
        gallery_created: '<%= j t('views.admin.gallery.index.js.success.gallery_created') %>',
        photo_deleted: '<%= j t('views.admin.gallery.index.js.success.photo_deleted') %>',
        changes_saved: '<%= j t('views.admin.gallery.index.js.success.changes_saved') %>',
        changes_reset: '<%= j t('views.admin.gallery.index.js.success.changes_reset') %>'
      }
    }
  };

  // Глобальные переменные для добавления галереи
  let addGalleryPhotos = [];
  let currentEditingPhotoIndex = null;
  let galleryPhotoCropper = null;
  let currentRotation = 0;
  let currentScaleX = 1;
  let photoToDeleteIndex = null;

  // Функция для открытия модального окна добавления галереи
  function openAddGalleryModal() {
    const modal = document.getElementById('addGalleryModal');
    if (modal) {
      // Сбрасываем форму
      document.getElementById('galleryForm').reset();
      document.getElementById('titleCharCount').textContent = '0/255';
      document.getElementById('descCharCount').textContent = '0/4096';
      
      // Очищаем список фотографий
      addGalleryPhotos = [];
      updateAddGalleryPhotosList();
      
      modal.showModal();
    }
  }

  // Функция для закрытия модального окна добавления галереи
  function closeAddGalleryModal() {
    const modal = document.getElementById('addGalleryModal');
    if (modal) modal.close();
  }

  // Обновление счетчиков символов
  document.addEventListener('DOMContentLoaded', function() {
    const titleInput = document.getElementById('galleryTitle');
    const descTextarea = document.getElementById('galleryDescription');
    const editTitleInput = document.getElementById('PhotoTitle');
    const titleCharCount = document.getElementById('titleCharCount');
    const descCharCount = document.getElementById('descCharCount');
    const editTitleCharCount = document.getElementById('PhotoTitleCharCount');

    // Убедимся, что addGalleryPhotos инициализирована
    if (typeof addGalleryPhotos === 'undefined') {
      addGalleryPhotos = [];
    }

    if (titleInput) {
      titleInput.addEventListener('input', function() {
        const length = this.value.length;
        titleCharCount.textContent = `${length}/255`;
      });
    }

    if (descTextarea) {
      descTextarea.addEventListener('input', function() {
        const length = this.value.length;
        descCharCount.textContent = `${length}/4096`;
      });
    }

    if (editTitleInput) {
      editTitleInput.addEventListener('input', function() {
        const length = this.value.length;
        editTitleCharCount.textContent = `${length}/255`;
      });
    }

    // Обработка отправки формы галереи
    const galleryForm = document.getElementById('galleryForm');
    if (galleryForm) {
      galleryForm.addEventListener('submit', function(event) {
        event.preventDefault();
        submitAddGalleryForm();
      });
    }
  });

  // Обработчики drag-and-drop для фотографий галереи
  function handleAddGalleryPhotoDragOver(e) {
    e.preventDefault();
    e.stopPropagation();
    const dropArea = document.getElementById('galleryPhotoDropArea');
    if (dropArea) dropArea.classList.add('border-amber-400', 'bg-amber-900/30');
  }

  function handleAddGalleryPhotoDragLeave(e) {
    e.preventDefault();
    e.stopPropagation();
    const dropArea = document.getElementById('galleryPhotoDropArea');
    if (dropArea) dropArea.classList.remove('border-amber-400', 'bg-amber-900/30');
  }

  function handleAddGalleryPhotoDrop(e) {
    e.preventDefault();
    e.stopPropagation();
    const dropArea = document.getElementById('galleryPhotoDropArea');
    if (dropArea) dropArea.classList.remove('border-amber-400', 'bg-amber-900/30');
    
    const files = e.dataTransfer.files;
    if (files.length > 0) {
      handleAddGalleryPhotoFiles(files);
    }
  }

  // Функция для создания базового кропа 16:9
  function createBaseCrop(imageElement, file, callback) {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    
    const img = new Image();
    img.onload = function() {
      // Вычисляем размеры для кропа 16:9
      const sourceWidth = img.width;
      const sourceHeight = img.height;
      
      let sourceX = 0;
      let sourceY = 0;
      let cropWidth = sourceWidth;
      let cropHeight = sourceHeight;
      
      const targetRatio = 16 / 9;
      const sourceRatio = sourceWidth / sourceHeight;
      
      if (sourceRatio > targetRatio) {
        // Широкое изображение - обрезаем по бокам
        cropWidth = sourceHeight * targetRatio;
        sourceX = (sourceWidth - cropWidth) / 2;
      } else {
        // Высокое изображение - обрезаем сверху и снизу
        cropHeight = sourceWidth / targetRatio;
        sourceY = (sourceHeight - cropHeight) / 2;
      }
      
      // Устанавливаем размеры canvas
      canvas.width = 1920;
      canvas.height = 1080;
      
      // Рисуем обрезанное изображение
      ctx.drawImage(
        img,
        sourceX, sourceY, cropWidth, cropHeight, // source rectangle
        0, 0, 1920, 1080 // destination rectangle
      );
      
      // Конвертируем в blob
      canvas.toBlob(function(blob) {
        callback(blob);
      }, 'image/jpeg', 0.9);
    };
    img.src = imageElement ? imageElement.src : URL.createObjectURL(file);
  }

  // Обработка выбранных файлов фотографий
  function handleAddGalleryPhotoFiles(files) {
    Array.from(files).forEach(file => {
      if (file.type.match('image.*')) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const photo = {
            id: Date.now() + Math.random(), // Уникальный ID
            originalFile: file,
            croppedFile: null,
            previewUrl: e.target.result,
            originalPreviewUrl: e.target.result, // Сохраняем оригинал для возможности сброса
            title: file.name.split('.')[0], // Название без расширения
            rotation: 0,
            scaleX: 1,
            originalWidth: 0,
            originalHeight: 0,
            isEdited: false // Флаг, было ли фото отредактировано
          };
          
          // Получаем размеры изображения
          const img = new Image();
          img.onload = function() {
            photo.originalWidth = img.width;
            photo.originalHeight = img.height;
            
            // Создаем базовый кроп 16:9 сразу после загрузки
            createBaseCrop(img, file, function(blob) {
              if (blob) {
                const croppedFileName = file.name.replace(/\.[^/.]+$/, "") + '_cropped.jpg';
                photo.croppedFile = new File([blob], croppedFileName, { type: 'image/jpeg' });
                photo.previewUrl = URL.createObjectURL(blob);
                photo.baseCroppedFile = photo.croppedFile; // Сохраняем базовый кроп отдельно
                
                updateAddGalleryPhotosList();
              }
            });
          };
          img.src = e.target.result;
          
          addGalleryPhotos.push(photo);
          updateAddGalleryPhotosList();
        };
        reader.readAsDataURL(file);
      }
    });
  }

  // Обновление списка фотографий галереи
  function updateAddGalleryPhotosList() {
    const container = document.getElementById('galleryPhotosList');
    if (!container) return;
    
    if (addGalleryPhotos.length === 0) {
      container.innerHTML = `<p class="text-gray-400 col-span-full text-center py-4">${i18n.modals.add.form.no_photos}</p>`;
      return;
    }
    
    container.innerHTML = addGalleryPhotos.map((photo, index) => `
      <div class="relative group bg-[#2E2E2E] rounded-lg overflow-hidden border border-gray-700">
        <img src="${photo.previewUrl}" alt="${photo.title}" class="w-full h-48 object-cover">
        <div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
          <button 
            type="button" 
            class="btn btn-sm btn-warning mr-2"
            onclick="openAddGalleryEditPhotoModal(${index})"
          >
            <%= j t('views.admin.gallery.index.modals.add.actions.edit') %>
          </button>
          <button 
            type="button" 
            class="btn btn-sm btn-error"
            onclick="openAddGalleryDeletePhotoModal(${index})"
          >
            <%= j t('views.admin.gallery.index.modals.add.actions.delete') %>
          </button>
        </div>
        <div class="p-3">
          <div class="flex items-center justify-between mb-2">
            <span class="text-white text-sm font-medium truncate flex-1 mr-2">${photo.title || i18n.modals.add.form.untitled}</span>
            <div class="flex space-x-1">
              ${photo.croppedFile ? '<span class="badge badge-success badge-sm" title="Обрезано">✓</span>' : '<span class="badge badge-warning badge-sm" title="Требуется обрезка">!</span>'}
              ${photo.isEdited ? '<span class="badge badge-info badge-sm" title="Отредактировано">✎</span>' : ''}
            </div>
          </div>
          <div class="text-xs text-gray-400">
            ${Math.round(photo.originalWidth)}×${Math.round(photo.originalHeight)} • ${(photo.originalFile.size / 1024 / 1024).toFixed(1)}MB
            ${photo.isEdited ? ' • Edited' : ''}
          </div>
        </div>
      </div>
    `).join('');
  }

  // Открытие модального окна редактирования фото
  function openAddGalleryEditPhotoModal(index) {
    // Проверяем, что addGalleryPhotos определен
    if (typeof addGalleryPhotos === 'undefined') {
      console.error('addGalleryPhotos is not defined');
      addGalleryPhotos = [];
      return;
    }
    
    currentEditingPhotoIndex = index;
    const photo = addGalleryPhotos[index];
    
    if (!photo) {
      console.error('Photo not found at index:', index);
      return;
    }
    
    const modal = document.getElementById('PhotoModal');
    const titleInput = document.getElementById('PhotoTitle');
    const charCount = document.getElementById('PhotoTitleCharCount');
    const previewImg = document.getElementById('PhotoPreview');
    const sizeInfo = document.getElementById('PhotoSize');
    const formatInfo = document.getElementById('PhotoFormat');
    const rotationInfo = document.getElementById('PhotoRotation');
    const statusInfo = document.getElementById('PhotoStatus');
    
    if (!modal || !titleInput || !previewImg) return;
    
    // Заполняем данные
    titleInput.value = photo.title || '';
    charCount.textContent = `${(photo.title || '').length}/255`;
    
    // Используем оригинальное изображение для редактирования
    previewImg.src = photo.originalPreviewUrl;
    
    // Заполняем информацию о фото
    sizeInfo.textContent = `${Math.round(photo.originalWidth)}×${Math.round(photo.originalHeight)}`;
    formatInfo.textContent = photo.originalFile.type.split('/')[1].toUpperCase();
    rotationInfo.textContent = `${photo.rotation || 0}°`;
    statusInfo.textContent = photo.isEdited ? i18n.modals.edit.form.status_edited : i18n.modals.edit.form.status_original;
    statusInfo.className = photo.isEdited ? 'text-amber-400' : 'text-green-400';
    
    // Восстанавливаем трансформации
    currentRotation = photo.rotation || 0;
    currentScaleX = photo.scaleX || 1;
    
    modal.showModal();
    
    // Инициализация Cropper.js с оригинальным изображением
    setTimeout(() => {
      if (galleryPhotoCropper) {
        galleryPhotoCropper.destroy();
      }
      
      galleryPhotoCropper = new Cropper(previewImg, {
        aspectRatio: 16 / 9,
        viewMode: 1,
        autoCropArea: 0.8,
        responsive: true,
        checkCrossOrigin: false,
        background: false,
        guides: true,
        center: true,
        highlight: false,
        cropBoxMovable: true,
        cropBoxResizable: true,
        toggleDragModeOnDblclick: false,
        ready: function() {
          // Применяем сохраненные трансформации
          if (currentRotation !== 0) {
            galleryPhotoCropper.rotateTo(currentRotation);
          }
          if (currentScaleX === -1) {
            galleryPhotoCropper.scaleX(-1);
          }
        }
      });
    }, 100);
  }

  // Закрытие модального окна редактирования фото
  function closeEditPhotoModal() {
    const modal = document.getElementById('PhotoModal');
    
    if (galleryPhotoCropper) {
      galleryPhotoCropper.destroy();
      galleryPhotoCropper = null;
    }
    
    if (modal) modal.close();
    
    currentEditingPhotoIndex = null;
    currentRotation = 0;
    currentScaleX = 1;
  }

  // Сброс к оригинальному изображению
  function resetAddGalleryPhotoToOriginal() {
    if (currentEditingPhotoIndex === null) return;
    
    const photo = addGalleryPhotos[currentEditingPhotoIndex];
    if (!photo) return;
    
    // Сбрасываем все трансформации
    currentRotation = 0;
    currentScaleX = 1;
    
    // Восстанавливаем базовый кроп
    if (photo.baseCroppedFile) {
      photo.croppedFile = photo.baseCroppedFile;
      photo.previewUrl = URL.createObjectURL(photo.baseCroppedFile);
      photo.isEdited = false;
    } else {
      // Если базового кропа нет, создаем его заново
      createBaseCrop(null, photo.originalFile, function(blob) {
        if (blob) {
          const croppedFileName = photo.originalFile.name.replace(/\.[^/.]+$/, "") + '_cropped.jpg';
          photo.croppedFile = new File([blob], croppedFileName, { type: 'image/jpeg' });
          photo.previewUrl = URL.createObjectURL(blob);
          photo.baseCroppedFile = photo.croppedFile;
          photo.isEdited = false;
        }
      });
    }
    
    // Обновляем интерфейс
    document.getElementById('PhotoRotation').textContent = '0°';
    document.getElementById('PhotoStatus').textContent = i18n.modals.edit.form.status_original;
    document.getElementById('PhotoStatus').className = 'text-green-400';
    
    // Сбрасываем кроппер
    if (galleryPhotoCropper) {
      galleryPhotoCropper.reset();
    }
    
    showNotification(i18n.js.success.changes_reset);
  }

  // Поворот фотографии с отслеживанием общего угла
  function rotateAddGalleryPhoto(degrees) {
    if (!galleryPhotoCropper || currentEditingPhotoIndex === null) return;
    
    try {
      // Обновляем общий угол поворота
      currentRotation += degrees;
      currentRotation = currentRotation % 360;
      
      // Применяем абсолютный поворот
      galleryPhotoCropper.rotateTo(currentRotation);
      
      // Обновляем отображение угла
      document.getElementById('PhotoRotation').textContent = `${currentRotation}°`;
      document.getElementById('PhotoStatus').textContent = i18n.modals.edit.form.status_edited;
      document.getElementById('PhotoStatus').className = 'text-amber-400';
    } catch (error) {
      console.error('Ошибка при повороте фото:', error);
    }
  }

  // Отразить фотографию
  function flipAddGalleryPhoto() {
    if (!galleryPhotoCropper || currentEditingPhotoIndex === null) return;
    
    try {
      currentScaleX = -currentScaleX;
      galleryPhotoCropper.scaleX(currentScaleX);
      document.getElementById('PhotoStatus').textContent = i18n.modals.edit.form.status_edited;
      document.getElementById('PhotoStatus').className = 'text-amber-400';
    } catch (error) {
      console.error('Ошибка при отражении фото:', error);
    }
  }

  // Сброс обрезки и трансформаций
  function resetAddGalleryPhotoCrop() {
    if (!galleryPhotoCropper || currentEditingPhotoIndex === null) return;
    
    try {
      galleryPhotoCropper.reset();
      currentRotation = 0;
      currentScaleX = 1;
      document.getElementById('PhotoRotation').textContent = '0°';
      document.getElementById('PhotoStatus').textContent = i18n.modals.edit.form.status_edited;
      document.getElementById('PhotoStatus').className = 'text-amber-400';
    } catch (error) {
      console.error('Ошибка при сбросе фото:', error);
    }
  }

  // Сохранение изменений фото
  function saveAddGalleryPhotoEdit() {
    if (!galleryPhotoCropper || currentEditingPhotoIndex === null) return;
    
    const photo = addGalleryPhotos[currentEditingPhotoIndex];
    if (!photo) return;
    
    try {
      // Сохраняем название
      const titleInput = document.getElementById('PhotoTitle');
      photo.title = titleInput.value.trim() || photo.originalFile.name.split('.')[0];
      
      // Сохраняем трансформации
      photo.rotation = currentRotation;
      photo.scaleX = currentScaleX;
      
      // Применяем обрезку с текущими трансформациями
      const canvas = galleryPhotoCropper.getCroppedCanvas({
        width: 1920,
        height: 1080,
        minWidth: 320,
        minHeight: 180,
        maxWidth: 4096,
        maxHeight: 2304,
        fillColor: '#fff',
        imageSmoothingEnabled: true,
        imageSmoothingQuality: 'high',
      });
      
      if (canvas) {
        canvas.toBlob(function(blob) {
          if (blob) {
            const originalName = photo.originalFile ? photo.originalFile.name : "photo.jpg";
            const croppedFileName = originalName.replace(/\.[^/.]+$/, "") + '_cropped.jpg';
            
            photo.croppedFile = new File([blob], croppedFileName, { type: 'image/jpeg' });
            photo.previewUrl = URL.createObjectURL(blob);
            photo.isEdited = true; // Помечаем как отредактированное
            
            updateAddGalleryPhotosList();
            closeEditPhotoModal();
            
            showNotification(i18n.js.success.changes_saved);
          }
        }, 'image/jpeg', 0.9);
      }
    } catch (error) {
      console.error('Ошибка при сохранении фото:', error);
      showNotification(i18n.js.errors.save_changes_failed, 'error');
    }
  }

  // Открытие модального окна подтверждения удаления
  function openAddGalleryDeletePhotoModal(index) {
    photoToDeleteIndex = index;
    const modal = document.getElementById('AddDeletePhotoModal');
    if (modal) modal.showModal();
  }

  // Закрытие модального окна подтверждения удаления
  function closeAddGalleryDeletePhotoModal() {
    const modal = document.getElementById('AddDeletePhotoModal');
    if (modal) modal.close();
    photoToDeleteIndex = null;
  }

  // Подтверждение удаления фотографии
  function confirmAddGalleryDeletePhoto() {
    if (photoToDeleteIndex === null) return;
    
    addGalleryPhotos.splice(photoToDeleteIndex, 1);
    updateAddGalleryPhotosList();
    closeAddGalleryDeletePhotoModal();
    showNotification(i18n.js.success.photo_deleted);
    
    photoToDeleteIndex = null;
  }

  function submitAddGalleryForm() {
    const titleInput = document.getElementById('galleryTitle');
    const descriptionInput = document.getElementById('galleryDescription');
    const publishedInput = document.getElementById('galleryPublished');
    
    const title = titleInput ? titleInput.value.trim() : '';
    const description = descriptionInput ? descriptionInput.value.trim() : '';
    const published = publishedInput ? publishedInput.value : 'false';
    
    console.log('Submitting gallery form:', { title, description, published });
    
    if (!title) {
      showNotification(i18n.js.errors.title_required, 'error');
      titleInput?.focus();
      return;
    }
    
    // Если галерея публикуется, проверяем наличие фотографий
    if (published === 'true' && addGalleryPhotos.length === 0) {
      showNotification(i18n.js.errors.photos_required_for_publish, 'error');
      return;
    }
    
    // Проверяем обработку фотографий, если они есть
    if (addGalleryPhotos.length > 0) {
      const unprocessedPhotos = addGalleryPhotos.filter(photo => !photo.croppedFile);
      if (unprocessedPhotos.length > 0) {
        showNotification(i18n.js.errors.photos_processing_required, 'error');
        return;
      }
    }
    
    // Create FormData for submission
    const formData = new FormData();
    
    // Добавляем данные галереи с правильной структурой
    formData.append('gallery[title]', title);
    formData.append('gallery[description]', description);
    formData.append('gallery[published]', published);
    
    // Добавляем каждую фотографию с правильной структурой
    addGalleryPhotos.forEach((photo, index) => {
      formData.append(`gallery[photos_attributes][${index}][title]`, photo.title || '');
      formData.append(`gallery[photos_attributes][${index}][file]`, photo.croppedFile);
    });
    
    // Get user ID
    const actorId = document.querySelector('[data-user-id]')?.getAttribute('data-user-id');
    
    // Prepare API request
    const authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>";
    const url = `${authServiceUrl}/api/v1/galleries`;
    
    console.log('Sending request to:', url);
    console.log('Form data entries:', Array.from(formData.entries()));
    
    // Send request
    fetch(url, {
      method: 'POST',
      headers: {
        'X-User-ID': actorId || ''
      },
      body: formData,
      credentials: 'include'
    })
    .then(response => {
      console.log('Response status:', response.status);
      if (!response.ok) {
        return response.json().then(data => {
          console.error('Server error:', data);
          throw new Error(data.errors ? data.errors.join(', ') : 'Ошибка при создании галереи');
        });
      }
      return response.json();
    })
    .then(data => {
      console.log('Success response:', data);
      showNotification(i18n.js.success.gallery_created);
      closeAddGalleryModal();
      
      // Refresh galleries list if function exists
      if (typeof loadGalleries === 'function') {
        loadGalleries();
      }
    })
    .catch(error => {
      console.error('Submission error:', error);
      showAlertNotification(`Ошибка: ${error.message}`);
    });
  }

  // Добавляем анимацию для уведомлений
  const style = document.createElement('style');
  style.innerHTML = `
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
      animation: fadeIn 0.3s ease-out forwards;
    }
  `;
  document.head.appendChild(style);
</script>
