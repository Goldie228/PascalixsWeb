
<!-- Модальное окно для добавления галереи -->
<dialog id="addGalleryModal" class="modal">
  <div class="modal-box w-full max-w-4xl bg-[#1A1A1A] border border-amber-400 p-8 rounded">
    <h3 class="text-2xl text-amber-400 font-bold mb-6"><%= t('views.admin.gallery.index.modals.add.title') %></h3>
    
    <form id="galleryForm" class="space-y-6">
      <!-- Название галереи -->
      <div>
        <label for="galleryTitle" class="block text-white mb-2"><%= t('views.admin.gallery.index.modals.add.form.title_label') %></label>
        <input 
          type="text" 
          id="galleryTitle" 
          name="title" 
          maxlength="255" 
          class="input input-bordered w-full bg-[#262626] text-white" 
          placeholder="<%= t('views.admin.gallery.index.modals.add.form.title_placeholder') %>"
          required
        >
        <div class="text-right mt-1">
          <span id="titleCharCount" class="text-gray-400">0/255</span>
        </div>
      </div>
      
      <!-- Описание галереи -->
      <div>
        <label for="galleryDescription" class="block text-white mb-2"><%= t('views.admin.gallery.index.modals.add.form.description_label') %></label>
        <textarea 
          id="galleryDescription" 
          name="description" 
          maxlength="4096" 
          class="textarea textarea-bordered w-full min-h-[120px] bg-[#262626] text-white" 
          placeholder="<%= t('views.admin.gallery.index.modals.add.form.description_placeholder') %>"
        ></textarea>
        <div class="text-right mt-1">
          <span id="descCharCount" class="text-gray-400">0/4096</span>
        </div>
      </div>
      
      <!-- Статус публикации -->
      <div>
        <label for="galleryPublished" class="block text-white mb-2"><%= t('views.admin.gallery.index.modals.add.form.status_label') %></label>
        <select id="galleryPublished" name="published" class="select select-bordered w-full bg-[#262626] text-white">
          <option value="false"><%= t('views.admin.gallery.index.modals.add.form.status_draft') %></option>
          <option value="true"><%= t('views.admin.gallery.index.modals.add.form.status_published') %></option>
        </select>
      </div>
      
      <!-- Загрузка фотографий -->
      <div>
        <label class="block text-white mb-2"><%= t('views.admin.gallery.index.modals.add.form.photos_label') %></label>
        <div 
          id="galleryPhotoDropArea"
          class="border-2 border-dashed border-gray-600 rounded-xl p-8 text-center cursor-pointer hover:bg-[#1A1A1A] hover:border-amber-400 transition-all duration-300 mb-4"
          ondragover="handleAddGalleryPhotoDragOver(event)"
          ondragleave="handleAddGalleryPhotoDragLeave(event)"
          ondrop="handleAddGalleryPhotoDrop(event)"
        >
          <input
            type="file" 
            id="galleryPhotoInput" 
            class="hidden" 
            accept=".jpg,.jpeg,.png"
            multiple
            onchange="handleAddGalleryPhotoFiles(this.files)"
          >
          <div class="flex flex-col items-center justify-center">
            <div class="w-16 h-16 bg-amber-400/20 rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
            </div>
            <p class="text-gray-300 mb-3 text-lg"><%= t('views.admin.gallery.index.modals.add.form.drop_area_text') %></p>
            <button 
              type="button" 
              class="btn btn-warning"
              onclick="document.getElementById('galleryPhotoInput').click()"
            >
              <%= t('views.admin.gallery.index.modals.add.form.select_files_btn') %>
            </button>
            <p class="text-gray-400 text-sm mt-3">
              <%= t('views.admin.gallery.index.modals.add.form.supported_formats') %>
            </p>
          </div>
        </div>
        
        <!-- Список загруженных фотографий -->
        <div id="galleryPhotosList" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-4">
          <!-- Фотографии будут добавлены здесь через JavaScript -->
        </div>
      </div>
      
      <!-- Кнопки действий -->
      <div class="modal-action flex justify-end space-x-3 mt-6">
        <button 
          type="button" 
          class="btn btn-ghost text-gray-300 hover:bg-[#2E2E2E]"
          onclick="closeAddGalleryModal()"
        >
          <%= t('views.admin.gallery.index.modals.add.actions.cancel') %>
        </button>
        <button 
          type="submit" 
          class="btn btn-warning"
        >
          <%= t('views.admin.gallery.index.modals.add.actions.create') %>
        </button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<!-- Модальное окно для редактирования фото -->
<dialog id="PhotoModal" class="modal">
  <div class="modal-box w-full max-w-4xl bg-[#1A1A1A] border border-amber-400 p-8 rounded">
    <h3 class="text-2xl text-amber-400 font-bold mb-6"><%= t('views.admin.gallery.index.modals.edit.title') %></h3>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Левая колонка - настройки -->
      <div class="space-y-6">
        <!-- Название фотографии -->
        <div>
          <label for="PhotoTitle" class="block text-white mb-2"><%= t('views.admin.gallery.index.modals.edit.form.title_label') %></label>
          <input 
            type="text" 
            id="PhotoTitle" 
            maxlength="255" 
            class="input input-bordered w-full bg-[#262626] text-white" 
            placeholder="<%= t('views.admin.gallery.index.modals.edit.form.title_placeholder') %>"
          >
          <div class="text-right mt-1">
            <span id="PhotoTitleCharCount" class="text-gray-400">0/255</span>
          </div>
        </div>
        
        <!-- Инструменты редактирования -->
        <div class="bg-[#2E2E2E] rounded-lg p-4">
          <h4 class="text-amber-400 font-semibold mb-3"><%= t('views.admin.gallery.index.modals.edit.form.tools_title') %></h4>
          <div class="grid grid-cols-2 gap-3">
            <button type="button" class="btn btn-outline btn-sm text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="rotateAddGalleryPhoto(-90)">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <%= t('views.admin.gallery.index.modals.edit.form.rotate_left') %>
            </button>
            <button type="button" class="btn btn-outline btn-sm text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="rotateAddGalleryPhoto(90)">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
              <%= t('views.admin.gallery.index.modals.edit.form.rotate_right') %>
            </button>
            <button type="button" class="btn btn-outline btn-sm text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="resetAddGalleryPhotoCrop()">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
              </svg>
              <%= t('views.admin.gallery.index.modals.edit.form.reset_crop') %>
            </button>
            <button type="button" class="btn btn-outline btn-sm text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="flipAddGalleryPhoto()">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
              </svg>
              <%= t('views.admin.gallery.index.modals.edit.form.flip') %>
            </button>
          </div>
          <div class="mt-3">
            <button type="button" class="btn btn-outline btn-sm w-full text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="resetAddGalleryPhotoToOriginal()">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
              </svg>
              <%= t('views.admin.gallery.index.modals.edit.form.reset_to_original') %>
            </button>
          </div>
        </div>
        
        <!-- Информация о фото -->
        <div class="bg-[#2E2E2E] rounded-lg p-4">
          <h4 class="text-amber-400 font-semibold mb-3"><%= t('views.admin.gallery.index.modals.edit.form.info_title') %></h4>
          <div class="space-y-2 text-sm text-gray-300">
            <div class="flex justify-between">
              <span><%= t('views.admin.gallery.index.modals.edit.form.info_size') %>:</span>
              <span id="PhotoSize">-</span>
            </div>
            <div class="flex justify-between">
              <span><%= t('views.admin.gallery.index.modals.edit.form.info_format') %>:</span>
              <span id="PhotoFormat">-</span>
            </div>
            <div class="flex justify-between">
              <span><%= t('views.admin.gallery.index.modals.edit.form.info_rotation') %>:</span>
              <span id="PhotoRotation">0°</span>
            </div>
            <div class="flex justify-between">
              <span><%= t('views.admin.gallery.index.modals.edit.form.info_status') %>:</span>
              <span id="PhotoStatus" class="text-amber-400"><%= t('views.admin.gallery.index.modals.edit.form.status_original') %></span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Правая колонка - предпросмотр -->
      <div class="bg-[#2E2E2E] rounded-lg p-4">
        <h4 class="text-amber-400 font-semibold mb-3"><%= t('views.admin.gallery.index.modals.edit.form.preview_title') %></h4>
        <div class="relative w-full h-80 bg-gray-800 rounded-lg overflow-hidden">
          <img id="PhotoPreview" class="w-full h-full object-contain">
        </div>
        <div class="mt-3 text-center text-gray-400 text-sm">
          <%= t('views.admin.gallery.index.modals.edit.form.preview_info') %>
        </div>
      </div>
    </div>
    
    <!-- Кнопки действий -->
    <div class="modal-action flex justify-end space-x-3 mt-6">
      <button 
        type="button" 
        class="btn btn-ghost text-gray-300 hover:bg-[#2E2E2E]"
        onclick="closeEditPhotoModal()"
      >
        <%= t('views.admin.gallery.index.modals.edit.actions.cancel') %>
      </button>
      <button 
        type="button" 
        class="btn btn-warning"
        onclick="saveAddGalleryPhotoEdit()"
      >
        <%= t('views.admin.gallery.index.modals.edit.actions.save') %>
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<!-- Кастомное модальное окно подтверждения удаления -->
<dialog id="AddDeletePhotoModal" class="modal">
  <div class="modal-box bg-[#1A1A1A] border border-red-500 p-6 rounded max-w-md">
    <div class="flex items-center mb-4">
      <div class="w-12 h-12 bg-red-500/20 rounded-full flex items-center justify-center mr-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
