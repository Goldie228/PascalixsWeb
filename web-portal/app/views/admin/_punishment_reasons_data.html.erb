<div class="w-full mx-auto pb-8">
  <h1 class="text-4xl font-bold text-center mb-8"><%= t('views.admin.punishment_reasons.index.title') %></h1>
  
  <!-- Панель управления -->
  <div class="flex flex-col gap-6 mb-6 md:mb-8 px-4">
    <!-- Первая строка элементов управления -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div class="form-control w-full md:w-auto">
        <div class="flex items-center justify-between gap-2">
          <span class="text-amber-400 font-semibold text-sm md:text-base"><%= t('views.admin.punishment_reasons.index.records_per_page') %></span>
          
          <div class="dropdown dropdown-end">
            <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
              <span class="text-xs md:text-sm" id="perPageLabel">25</span>
              <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </label>
            <ul class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-32 mt-1">
              <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="10">10</a></li>
              <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="25">25</a></li>
              <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="50">50</a></li>
              <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="100">100</a></li>
            </ul>
          </div>
        </div>
      </div>
      
      <!-- Кнопка добавления нового правила -->
      <button id="addRuleBtn" class="btn btn-sm md:btn-md bg-amber-400 text-black hover:bg-amber-300 border-none transition flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
        </svg>
        <%= t('views.admin.punishment_reasons.index.add_rule') %>
      </button>
    </div>
    
    <!-- Вторая строка элементов управления -->
    <div class="grid grid-cols-1 md:flex md:flex-row gap-4 md:gap-6 justify-between">
      <div class="flex flex-col md:flex-row gap-4 md:gap-6 w-full md:w-auto">
        <div class="form-control w-full md:w-auto">
          <div class="flex items-center gap-2">
            <span class="text-amber-400 font-semibold text-sm md:text-base"><%= t('views.admin.punishment_reasons.index.sort_direction') %></span>
            
            <div class="dropdown dropdown-end">
              <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                <span class="text-xs md:text-sm" id="sortOrderLabel"><%= t('views.admin.punishment_reasons.index.ascending') %></span>
                <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </label>
              <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-44 md:w-52 mt-1">
                <li><a href="#" class="sort-order-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="asc"><%= t('views.admin.punishment_reasons.index.ascending') %></a></li>
                <li><a href="#" class="sort-order-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="desc"><%= t('views.admin.punishment_reasons.index.descending') %></a></li>
              </ul>
            </div>
          </div>
        </div>
        
        <div class="form-control w-full md:w-auto">
          <div class="flex items-center gap-2">
            <span class="text-amber-400 font-semibold text-sm md:text-base"><%= t('views.admin.punishment_reasons.index.sort_by') %></span>
            <div class="dropdown dropdown-end">
              <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                <span class="text-xs md:text-sm truncate max-w-[100px] md:max-w-none" id="sortByLabel"><%= t('views.admin.punishment_reasons.index.rule_number') %></span>
                <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </label>
              <ul class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-44 md:w-52 mt-1">
                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="rule_number"><%= t('views.admin.punishment_reasons.index.rule_number') %></a></li>
                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="description"><%= t('views.admin.punishment_reasons.index.description') %></a></li>
                <li><a href="#" class="sort-by-option text-white hover-bg-amber-400 hover:text-black text-sm md:text-base" data-value="price"><%= t('views.admin.punishment_reasons.index.price') %></a></li>
                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="punishment_type"><%= t('views.admin.punishment_reasons.index.punishment_type') %></a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      
      <div class="w-full md:w-auto">
        <input type="text" id="searchInput" placeholder="<%= t('views.admin.punishment_reasons.index.search_placeholder') %>" class="input input-sm md:input-md w-full bg-[#2D2D2D] text-white placeholder-[#A0A0A0] border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition">
      </div>
    </div>
    
    <!-- Фильтры -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
      <div>
        <label class="block text-sm font-medium text-amber-400 mb-1"><%= t('views.admin.punishment_reasons.index.filter_punishment_type') %></label>
        <select id="typeFilter" class="select select-sm md:select-md w-full bg-[#2D2D2D] text-white border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
          <option value=""><%= t('views.admin.punishment_reasons.index.all_types') %></option>
          <option value="ban"><%= t('views.admin.punishment_reasons.index.ban') %></option>
          <option value="mute"><%= t('views.admin.punishment_reasons.index.mute') %></option>
        </select>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-amber-400 mb-1"><%= t('views.admin.punishment_reasons.index.filter_rule_number') %></label>
        <input type="number" id="ruleNumberFilter" placeholder="<%= t('views.admin.punishment_reasons.index.rule_number_placeholder') %>" class="input input-sm md:input-md w-full bg-[#2D2D2D] text-white placeholder-[#A0A0A0] border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
      </div>
      
      <div>
        <label class="block text-sm font-medium text-amber-400 mb-1"><%= t('views.admin.punishment_reasons.index.price_range') %></label>
        <div class="flex gap-2">
          <input type="number" id="minPriceFilter" placeholder="<%= t('views.admin.punishment_reasons.index.min_price_placeholder') %>" class="input input-sm md:input-md w-full bg-[#2D2D2D] text-white placeholder-[#A0A0A0] border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
          <input type="number" id="maxPriceFilter" placeholder="<%= t('views.admin.punishment_reasons.index.max_price_placeholder') %>" class="input input-sm md:input-md w-full bg-[#2D2D2D] text-white placeholder-[#A0A0A0] border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
        </div>
      </div>
    </div>
  </div>
  
  <!-- Таблица с данными (для десктопа) -->
  <div class="hidden md:block w-full overflow-x-auto rounded-box overflow-hidden">
    <table class="table w-full">
      <thead class="text-white" style="background-color: #2D2D2D">
        <tr>
          <th class="py-3 px-2 md:px-4"><%= t('views.admin.punishment_reasons.index.table_rule_number') %></th>
          <th class="py-3 px-2 md:px-4"><%= t('views.admin.punishment_reasons.index.table_description') %></th>
          <th class="py-3 px-2 md:px-4"><%= t('views.admin.punishment_reasons.index.table_price') %></th>
          <th class="py-3 px-2 md:px-4"><%= t('views.admin.punishment_reasons.index.table_type') %></th>
          <th class="py-3 px-2 md:px-4"><%= t('views.admin.punishment_reasons.index.table_actions') %></th>
        </tr>
      </thead>
      <tbody class="text-white" style="background-color: #383838">
        <!-- Данные будут загружены через JavaScript -->
      </tbody>
    </table>
  </div>
  
  <!-- Карточки для мобильных устройств -->
  <div id="cardsContainer" class="md:hidden grid grid-cols-1 gap-4 mt-4 px-4">
    <!-- Карточки будут загружены через JavaScript -->
  </div>
  
  <!-- Пагинация -->
  <div id="paginationContainer" class="flex justify-center items-center gap-2 mt-6 flex-wrap px-4 overflow-x-auto">
    <!-- Пагинация будет загружена через JavaScript -->
  </div>
</div>
<!-- Модальное окно подтверждения удаления -->
