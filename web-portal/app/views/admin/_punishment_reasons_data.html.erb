        <%= t('views.admin.punishment_reasons.index.delete') %>
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<%# Передаем данные локализации в JavaScript %>
<script>
  window.I18nTranslations = {
    locale: "<%= I18n.locale %>",
    defaultLocale: "<%= I18n.default_locale %>",
    translations: <%= raw({
      views: {
        admin: {
          punishment_reasons: {
            index: {
              loading_data: t('views.admin.punishment_reasons.index.loading_data'),
              loading_error: t('views.admin.punishment_reasons.index.loading_error'),
              no_data: t('views.admin.punishment_reasons.index.no_data'),
              ban: t('views.admin.punishment_reasons.index.ban'),
              mute: t('views.admin.punishment_reasons.index.mute'),
              rule_prefix: t('views.admin.punishment_reasons.index.rule_prefix'),
              description: t('views.admin.punishment_reasons.index.description'),
              price: t('views.admin.punishment_reasons.index.price'),
              previous: t('views.admin.punishment_reasons.index.previous'),
              next: t('views.admin.punishment_reasons.index.next'),
              rule_deleted_successfully: t('views.admin.punishment_reasons.index.rule_deleted_successfully'),
              deletion_error: t('views.admin.punishment_reasons.index.deletion_error'),
              ascending: t('views.admin.punishment_reasons.index.ascending'),
              descending: t('views.admin.punishment_reasons.index.descending')
            }
          }
        }
      }
    }.to_json) %>
  };
  
  // Создаем упрощенную версию I18n.t для использования в JavaScript
  window.I18n = {
    t: function(key) {
      const keys = key.split('.');
      let value = window.I18nTranslations.translations;
      
      for (const k of keys) {
        if (value && typeof value === 'object' && k in value) {
          value = value[k];
        } else {
          return key; // Возвращаем ключ, если перевод не найден
        }
      }
      
      return value;
    },
    
    locale: window.I18nTranslations.locale,
    defaultLocale: window.I18nTranslations.defaultLocale
  };
</script>

<script>
  // Инициализация обработчиков событий
  document.addEventListener('DOMContentLoaded', function() {
    // Загрузка данных при загрузке страницы
    loadPunishmentReasons();
    
    // Обработчики для выпадающих списков
    document.querySelectorAll('.per-page-option').forEach(option => {
      option.addEventListener('click', function(e) {
        e.preventDefault();
        perPage = parseInt(this.getAttribute('data-value'));
        document.getElementById('perPageLabel').textContent = perPage;
        currentPage = 1; // Сбрасываем на первую страницу
        loadPunishmentReasons();
      });
    });
    
    document.querySelectorAll('.sort-order-option').forEach(option => {
      option.addEventListener('click', function(e) {
        e.preventDefault();
        sortOrder = this.getAttribute('data-value');
        document.getElementById('sortOrderLabel').textContent = 
          sortOrder === 'asc' ? I18n.t('views.admin.punishment_reasons.index.ascending') : I18n.t('views.admin.punishment_reasons.index.descending');
        loadPunishmentReasons();
      });
    });
    
    document.querySelectorAll('.sort-by-option').forEach(option => {
      option.addEventListener('click', function(e) {
        e.preventDefault();
        sortBy = this.getAttribute('data-value');
        document.getElementById('sortByLabel').textContent = this.textContent;
        loadPunishmentReasons();
      });
    });
    
    // Обработчик для поиска
    document.getElementById('searchInput').addEventListener('input', function() {
      filters.search = this.value;
      // Используем debounce для оптимизации
      clearTimeout(this.searchTimeout);
      this.searchTimeout = setTimeout(() => {
        currentPage = 1;
        loadPunishmentReasons();
      }, 500);
    });
    
    // Обработчики для фильтров
    document.getElementById('typeFilter').addEventListener('change', function() {
      filters.type = this.value;
      currentPage = 1;
      loadPunishmentReasons();
    });
    
    document.getElementById('ruleNumberFilter').addEventListener('input', function() {
      filters.rule_number = this.value;
      // Используем debounce для оптимизации
      clearTimeout(this.filterTimeout);
      this.filterTimeout = setTimeout(() => {
        currentPage = 1;
        loadPunishmentReasons();
      }, 500);
    });
    
    document.getElementById('minPriceFilter').addEventListener('input', function() {
      filters.min_price = this.value;
      // Используем debounce для оптимизации
      clearTimeout(this.filterTimeout);
      this.filterTimeout = setTimeout(() => {
        currentPage = 1;
        loadPunishmentReasons();
      }, 500);
    });
    
    document.getElementById('maxPriceFilter').addEventListener('input', function() {
      filters.max_price = this.value;
      // Используем debounce для оптимизации
      clearTimeout(this.filterTimeout);
      this.filterTimeout = setTimeout(() => {
        currentPage = 1;
        loadPunishmentReasons();
      }, 500);
    });
    
    // Обработчик для кнопки добавления нового правила
    document.getElementById('addRuleBtn').addEventListener('click', openCreateRuleModal);
  });
  
  // Глобальные переменные для хранения параметров
  let currentPage = 1;
  let perPage = 25;
  let sortBy = 'rule_number';
  let sortOrder = 'asc';
  let filters = {
    type: '',
    search: '',
    rule_number: '',
    min_price: '',
    max_price: ''
  };
  let isLoading = false; // Флаг для отслеживания состояния загрузки
  let ruleNumberToDelete = null; // Номер правила для удаления
  
  // Функция для отображения индикатора загрузки в tbody
  function showLoading() {
    isLoading = true;
    
    // Для таблицы
    const tableBody = document.querySelector('tbody');
    if (tableBody) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="5" class="text-center py-10">
            <div class="flex flex-col items-center justify-center">
              <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-400 mx-auto"></div>
              <span class="mt-4 text-white font-medium">${I18n.t('views.admin.punishment_reasons.index.loading_data')}</span>
            </div>
          </td>
        </tr>
      `;
    }
    
    // Для карточек
    const cardsContainer = document.getElementById('cardsContainer');
    if (cardsContainer) {
      cardsContainer.innerHTML = `
        <div class="flex flex-col items-center justify-center py-10 w-full">
          <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-400 mx-auto"></div>
          <span class="mt-4 text-white font-medium">${I18n.t('views.admin.punishment_reasons.index.loading_data')}</span>
        </div>
      `;
    }
  }
  
  // Функция для загрузки данных с API
  async function loadPunishmentReasons() {
    // Если уже идет загрузка, не выполняем новый запрос
    if (isLoading) return;
    
    try {
      // Показываем индикатор загрузки
      showLoading();
      
      // Формируем URL с параметрами
      const params = new URLSearchParams();
      params.append('page', currentPage);
      params.append('per_page', perPage);
      params.append('sort', sortBy);
      params.append('direction', sortOrder);
      
      // Добавляем фильтры
      Object.keys(filters).forEach(key => {
        if (filters[key]) {
          params.append(key, filters[key]);
        }
      });
      
      const authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>";
      const url = `${authServiceUrl}/api/v1/punishment_reasons/all?${params.toString()}`;
      
      // Отправляем запрос
      const response = await fetch(url, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'X-User-ID': '<%= current_user.id %>'
        }
      });
      
      if (!response.ok) {
        throw new Error(`Ошибка HTTP: ${response.status}`);
      }
      
      const data = await response.json();
      
      // Обновляем таблицу и карточки
      updatePunishmentReasonsTable(data.reasons);
      
      // Обновляем пагинацию
      updatePagination(data.pagination);
      
    } catch (error) {
      console.error('Ошибка при загрузке данных:', error);
      
      // Показываем сообщение об ошибке в таблице
      const tableBody = document.querySelector('tbody');
      if (tableBody) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="5" class="text-center py-6 text-red-400">
              ${I18n.t('views.admin.punishment_reasons.index.loading_error')}
            </td>
          </tr>
        `;
      }
      
      // Показываем сообщение об ошибке в карточках
      const cardsContainer = document.getElementById('cardsContainer');
      if (cardsContainer) {
        cardsContainer.innerHTML = `
          <div class="bg-[#383838] rounded-lg p-4 shadow-md text-red-400 text-center">
            ${I18n.t('views.admin.punishment_reasons.index.loading_error')}
          </div>
        `;
      }
    } finally {
      // Сбрасываем флаг загрузки
      isLoading = false;
    }
  }
  
  // Функция для обновления таблицы и карточек
  function updatePunishmentReasonsTable(reasons) {
    // Обновляем таблицу (для десктопа)
    const tableBody = document.querySelector('tbody');
    
    if (reasons.length === 0) {
      if (tableBody) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="5" class="text-center py-6 text-gray-400">
              ${I18n.t('views.admin.punishment_reasons.index.no_data')}
            </td>
          </tr>
        `;
      }
      
      // Обновляем карточки (для мобильных)
      const cardsContainer = document.getElementById('cardsContainer');
      if (cardsContainer) {
        cardsContainer.innerHTML = `
          <div class="bg-[#383838] rounded-lg p-4 shadow-md text-center text-gray-400">
            ${I18n.t('views.admin.punishment_reasons.index.no_data')}
          </div>
        `;
      }
      
      return;
    }
    
    // Обновляем таблицу
    if (tableBody) {
      tableBody.innerHTML = reasons.map(reason => {
        // Определяем текст для типа наказания
        const typeText = reason.punishment_type === 'ban' ? I18n.t('views.admin.punishment_reasons.index.ban') : I18n.t('views.admin.punishment_reasons.index.mute');
        return `
          <tr data-rule-number="${reason.rule_number}">
            <td class="py-3 px-2 md:px-4">${reason.rule_number}</td>
            <td class="py-3 px-2 md:px-4">${reason.description}</td>
            <td class="py-3 px-2 md:px-4">${reason.price}$</td>
            <td class="py-3 px-2 md:px-4">
              <span class="px-2 py-1 rounded-full ${reason.punishment_type === 'ban' ? 'bg-red-500' : 'bg-amber-400'} text-black text-xs">
                ${typeText}
              </span>
            </td>
            <td class="py-3 px-2 md:px-4">
              <div class="flex gap-2">
                <button class="btn btn-xs md:btn-sm bg-amber-400 text-black hover:bg-amber-300 border-none transition edit-btn" data-rule-number="${reason.rule_number}" onclick="openEditRuleModal(${reason.rule_number})">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                  </svg>
                </button>
                <button class="btn btn-xs md:btn-sm bg-red-500 text-white hover:bg-red-400 border-none transition delete-btn" data-rule-number="${reason.rule_number}">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }
    
    // Обновляем карточки (для мобильных)
    const cardsContainer = document.getElementById('cardsContainer');
    if (cardsContainer) {
      cardsContainer.innerHTML = reasons.map(reason => {
        // Определяем текст для типа наказания
        const typeText = reason.punishment_type === 'ban' ? I18n.t('views.admin.punishment_reasons.index.ban') : I18n.t('views.admin.punishment_reasons.index.mute');
        
        return `
          <div class="bg-[#383838] rounded-lg p-4 shadow-md">
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-lg font-semibold text-white">${I18n.t('views.admin.punishment_reasons.index.rule_prefix')}${reason.rule_number}</h3>
              <span class="px-2 py-1 rounded-full ${reason.punishment_type === 'ban' ? 'bg-red-500' : 'bg-amber-400'} text-black text-xs flex-shrink-0">
                ${typeText}
              </span>
            </div>
            <div class="grid grid-cols-2 gap-2 text-sm">
              <div class="col-span-2">
                <p class="text-gray-400">${I18n.t('views.admin.punishment_reasons.index.description')}</p>
                <p class="text-white">${reason.description}</p>
              </div>
              <div>
                <p class="text-gray-400">${I18n.t('views.admin.punishment_reasons.index.price')}</p>
                <p class="text-white">${reason.price}$</p>
              </div>
            </div>
            <div class="mt-4 flex justify-end gap-2">
              <button class="btn btn-xs bg-amber-400 text-black hover:bg-amber-300 border-none transition edit-btn" data-rule-number="${reason.rule_number}" onclick="openEditRuleModal(${reason.rule_number})">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                </svg>
              </button>
              <button class="btn btn-xs bg-red-500 text-white hover:bg-red-400 border-none transition delete-btn" data-rule-number="${reason.rule_number}">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
              </button>
            </div>
          </div>
        `;
      }).join('');
    }
    
    // Добавляем обработчики событий для кнопок действий
    addActionListeners();
  }
  
  // Функция для обновления пагинации
  function updatePagination(pagination) {
    const container = document.getElementById('paginationContainer');
    const totalPages = pagination.total_pages;
    
    if (totalPages <= 1) {
      container.innerHTML = '';
      return;
    }
    
    let paginationHTML = '';
    
    // Определяем диапазон страниц для отображения
    let pageRange = [];
    if (totalPages <= 7) {
      pageRange = Array.from({length: totalPages}, (_, i) => i + 1);
    } else {
      if (currentPage <= 4) {
        pageRange = [1, 2, 3, 4, 5, '...', totalPages];
      } else if (currentPage >= totalPages - 3) {
        pageRange = [1, '...', totalPages - 4, totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
      } else {
        pageRange = [1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages];
      }
    }
    
    // Кнопка "Предыдущая"
    if (currentPage > 1) {
      paginationHTML += `
        <button class="btn border-amber-400 bg-[#121212] text-white hover:bg-[#1a1a1a] transition btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${currentPage - 1}">
          ${I18n.t('views.admin.punishment_reasons.index.previous')}
        </button>
      `;
    }
    
    // Страницы
    pageRange.forEach(page => {
      if (page === '...') {
        paginationHTML += `<span class="text-white px-2 whitespace-nowrap">...</span>`;
      } else {
        const isActive = page === currentPage;
        paginationHTML += `
          <button class="btn border-amber-400 transition ${isActive ? 'bg-amber-400 text-black font-semibold shadow-md' : 'bg-[#121212] text-white hover:bg-[#1a1a1a]'} btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${page}">
            ${page}
          </button>
        `;
      }
    });
    
    // Кнопка "Следующая"
    if (currentPage < totalPages) {
      paginationHTML += `
        <button class="btn border-amber-400 bg-[#121212] text-white hover:bg-[#1a1a1a] transition btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${currentPage + 1}">
          ${I18n.t('views.admin.punishment_reasons.index.next')}
        </button>
      `;
    }
    
    container.innerHTML = paginationHTML;
    
    // Добавляем обработчики событий для кнопок пагинации
    document.querySelectorAll('.page-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        currentPage = parseInt(this.getAttribute('data-page'));
        loadPunishmentReasons();
      });
    });
  }
  
  // Функция для добавления обработчиков событий для кнопок действий
  function addActionListeners() {
    // Кнопка "Удалить"
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const ruleNumber = this.getAttribute('data-rule-number');
        openRuleDeletionModal(ruleNumber);
      });
    });
  }
  
  // Функция для открытия модального окна удаления правила
  function openRuleDeletionModal(ruleNumber) {
    ruleNumberToDelete = ruleNumber;
    document.getElementById('rule-number-to-delete').textContent = ruleNumber;
    const modal = document.getElementById('confirm_rule_deletion_modal');
    if (modal) modal.showModal();
  }
  
  // Функция для закрытия модального окна удаления правила
  function closeRuleDeletionModal() {
    const modal = document.getElementById('confirm_rule_deletion_modal');
    if (modal) modal.close();
    ruleNumberToDelete = null;
  }
  
  // Функция для подтверждения удаления правила
  function proceedRuleDeletion() {
    if (ruleNumberToDelete) {
      deletePunishmentReason(ruleNumberToDelete);
      closeRuleDeletionModal();
    }
  }
  
  // Функция для удаления правила
  async function deletePunishmentReason(ruleNumber) {
    try {
      const authServiceUrl = "<%= ENV['IDENTITY_SERVICE_URL'] %>";
      const response = await fetch(`${authServiceUrl}/api/v1/punishment_reasons/${ruleNumber}`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'X-User-ID': '<%= current_user.id %>'
        }
      });
      
      if (!response.ok) {
        throw new Error(`Ошибка HTTP: ${response.status}`);
      }
      
      // Обновляем данные после удаления
      loadPunishmentReasons();
      
      // Показываем уведомление об успешном удалении
      // Используем alert вместо showNotification
      alert(I18n.t('views.admin.punishment_reasons.index.rule_deleted_successfully'));
      
    } catch (error) {
      console.error('Ошибка при удалении правила:', error);
      // Используем alert вместо showAlertNotification
      alert(I18n.t('views.admin.punishment_reasons.index.deletion_error'));
    }
  }
</script>
