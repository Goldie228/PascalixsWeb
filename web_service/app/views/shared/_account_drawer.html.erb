<div id="account-drawer" class="fixed inset-x-0 sm:inset-x-auto sm:right-0 sm:mr-[5%] z-50 top-[72px] sm:top-[72px] md:top-[120px] hidden">
  <div class="rounded-b-lg mx-2 sm:mx-0 bg-[#0A0A0A] border-l-2 border-r-2 border-b-2 border-[#FFD700] overflow-y-auto max-h-[calc(100vh-72px)] md:max-h-[calc(100vh-120px)]">
    <div class="menu p-2 sm:p-4 w-full sm:w-80 text-white flex flex-col">
      <!-- Профиль -->
      <div class="flex flex-col items-center sm:flex-row sm:items-center sm:gap-4 p-4 bg-[#121212] rounded-lg">
        <%= link_to user_profile_path, class: "flex-shrink-0 justify-self-start", onclick: "toggleAccountDrawer()" do %>
          <div class="avatar">
            <div class="w-16 h-16 rounded-full flex items-center justify-center">
              <% if current_user&.discord_account&.avatar.present? %>
                <img src="<%= current_user.discord_account.avatar %>" class="object-cover rounded-full">
              <% else %>
                <div class="skeleton w-16 h-16 rounded-full"></div>
              <% end %>
            </div>
          </div>
        <% end %>
        <div class="flex flex-col overflow-hidden text-center sm:text-left">
          <% if current_user %>
            <% if current_user.minecraft_account&.present? %>
              <span class="text-xl font-bold text-[#FFD700] truncate"><%= current_user.minecraft_account.nickname %></span>
            <% elsif current_user.discord_account&.present? %>
              <span class="text-xl font-bold text-[#FFD700] truncate"><%= current_user.discord_account.username %></span>
            <% end %>
            <% if current_user %>
              <span class="text-sm text-gray-400">Balance: 25 m. / 5 pc.</span>
            <% else %>
              <div class="skeleton w-32 h-4 mt-2"></div>
            <% end %>
          <% else %>
            <div class="skeleton w-32 h-4 mt-2"></div>
          <% end %>
        </div>
      </div>

      <% if current_user && !current_user.minecraft_account.present? %>
        <div class="mt-4 p-4 w-full">
          <%= link_to t('account_drawer.register_minecraft'), register_minecraft_path, class: "btn btn-outline btn-warning w-full text-[#FFD700] p-3 rounded-lg hover:bg-yellow-600/20 transition-colors shadow-md" %>
        </div>
      <% end %>

      <% cache ["account_drawer_menu", I18n.locale] do %>
        <!-- Меню -->
        <div class="mt-4 flex-1 overflow-y-auto">
          <!-- Аккаунт -->
          <div class="pb-4 border-b border-[#333333]">
            <%= link_to user_profile_path, class: "flex items-center gap-2 sm:gap-4 p-2 sm:p-4 hover:bg-[#333333] rounded-lg transition-colors text-sm sm:text-base", onclick: "toggleAccountDrawer()" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6 text-[#FFD700]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span><%= t('account_drawer.profile') %></span>
            <% end %>
            <%= link_to "#", class: "flex items-center gap-2 sm:gap-4 p-2 sm:p-4 hover:bg-[#333333] rounded-lg transition-colors text-sm sm:text-base", onclick: "toggleAccountDrawer()" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6 text-[#FFD700]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="2" d="M10 19H5a1 1 0 0 1-1-1v-1a3 3 0 0 1 3-3h2m10 1a3 3 0 0 1-3 3m3-3a3 3 0 0 0-3-3m3 3h1m-4 3a3 3 0 0 1-3-3m3 3v1m-3-4a3 3 0 0 1 3-3m-3 3h-1m4-3v-1m-2.121 1.879-.707-.707m5.656 5.656-.707-.707m-4.242 0-.707.707m5.656-5.656-.707.707M12 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
              </svg>
              <span><%= t('account_drawer.account') %></span>
            <% end %>
          </div>

          <!-- Транзакции -->
          <div class="py-4 border-b border-[#333333]">
            <%= link_to "#", class: "flex items-center gap-2 sm:gap-4 p-2 sm:p-4 hover:bg-[#333333] rounded-lg transition-colors text-sm sm:text-base", onclick: "toggleAccountDrawer()" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6 text-[#FFD700]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span><%= t('account_drawer.purchases') %></span>
            <% end %>
            <%= link_to "#", class: "flex items-center gap-2 sm:gap-4 p-2 sm:p-4 hover:bg-[#333333] rounded-lg transition-colors text-sm sm:text-base", onclick: "toggleAccountDrawer()" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6 text-[#FFD700]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span><%= t('account_drawer.history') %></span>
            <% end %>
          </div>

          <!-- Выход -->
          <div class="pt-4">
            <%= button_to logout_path, method: :delete, class: "w-full flex items-center gap-2 sm:gap-4 p-2 sm:p-4 hover:bg-[#333333] rounded-lg transition-colors text-sm sm:text-base text-red-400", onclick: "toggleAccountDrawer()" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              <span><%= t('buttons.log_out') %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
