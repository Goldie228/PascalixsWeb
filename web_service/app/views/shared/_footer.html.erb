<%= render 'shared/notification'%>
<%= render "shared/cookie_toast" %>

<% cache ["footer", I18n.locale] do %>
	<footer class="bg-[#0A0A0A] shadow-lg mt-auto ">
		<div class="mx-auto px-6 md:px-12 py-4 md:py-6">
			<div class="flex items-center justify-between">
				<!-- Надпись слева -->
				<h3 class="font-bold text-xl text-amber-400 mb-5"><%= t('footer.our_links') %>:</h3>

				<!-- Иконки справа -->
				<div class="flex space-x-4 mb-5">
					<!-- Discord -->
					<%= link_to "https://discord.gg/VwwzQJQpkW", class: "text-amber-400 hover:text-[#FFC400] transition-colors duration-200", target: "_blank", rel: "noopener", aria: { label: "Discord" } do %>
