						</svg>
					<% end %>

					<!-- YouTube -->
					<%= link_to "https://www.youtube.com/@PascaLixs_mc", class: "text-amber-400 hover:text-[#FFC400] transition-colors duration-200", target: "_blank", rel: "noopener", aria: { label: "YouTube" } do %>
						<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
							<path d="M21.7 8.037a4.26 4.26 0 0 0-.789-1.964 2.84 2.84 0 0 0-1.984-.839c-2.767-.2-6.926-.2-6.926-.2s-4.157 0-6.928.2a2.836 2.836 0 0 0-1.983.839 4.225 4.225 0 0 0-.79 1.965 30.146 30.146 0 0 0-.2 3.206v1.5a30.12 30.12 0 0 0 .2 3.206c.094.712.364 1.39.784 1.972.604.536 1.38.837 2.187.848 1.583.151 6.731.2 6.731.2s4.161 0 6.928-.2a2.844 2.844 0 0 0 1.985-.84 4.27 4.27 0 0 0 .787-1.965 30.12 30.12 0 0 0 .2-3.206v-1.516a30.672 30.672 0 0 0-.202-3.206Zm-11.692 6.554v-5.62l5.4 2.819-5.4 2.801Z"></path>
						</svg>
					<% end %>
				</div>
			</div>
			
			<div class="h-1 bg-amber-400 mb-6"></div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 justify-center">
				<!-- Колонка: Pascalixs -->
				<div>
					<h3 class="font-bold text-xl mb-4 pb-2"><%= t('server_name') %></h3>
					<p class="text-gray-400 mb-2 text-lg">
						<%= t('server_description') %>
					</p>
				</div>
				<!-- Колонка: Важные ссылки -->
				<div>
					<h3 class="font-bold text-xl mb-4 pb-2"><%= t('footer.important_links') %></h3>
					<ul class="space-y-2 text-lg">
						<li>
							<%= link_to t('pages.info_page.rules.title'), '#', class: "text-gray-400 hover:text-[#FFD700] transition-colors duration-200" %>
						</li>
						<li>
							<%= link_to t('pages.community_page.events.title'), '#', class: "text-gray-400 hover:text-[#FFD700] transition-colors duration-200" %>
						</li>
						<li>
							<%= link_to t('pages.info_page.wiki.title'), '#', class: "text-gray-400 hover:text-[#FFD700] transition-colors duration-200" %>
						</li>
					</ul>
				</div>
				<!-- Колонка: Связь с администрацией -->
				<div>
					<h3 class="font-bold text-xl mb-4 pb-2"><%= t('footer.contact_the_administration') %></h3>
					<div class="flex flex-col space-y-4">
						<!-- Telegram -->
						<%= link_to '#', class: "flex items-center space-x-2 text-gray-400 hover:text-[#FFD700] transition-colors duration-200", target: "_blank", rel: "noopener", aria: { label: t('footer.telegram') } do %>
							<!-- Иконка Telegram -->
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
								<path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"></path>
							</svg>
							<!-- Подпись Telegram -->
							<span class="font-medium text-lg"><%= t('footer.telegram') %></span>
						<% end %>

						<!-- Discord -->
						<%= link_to '#', class: "flex items-center space-x-2 text-gray-400 hover:text-[#FFD700] transition-colors duration-200", target: "_blank", rel: "noopener", aria: { label: t('footer.discord') } do %>
							<!-- Иконка Discord -->
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
								<path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.0766 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"></path>
							</svg>
							<!-- Подпись Discord -->
							<span class="font-medium text-lg"><%= t('footer.discord') %></span>
						<% end %>
					</div>
				</div>
			</div>
			
			<!-- Секция копирайта -->
			<div class="mt-8 border-t border-gray-700 pt-4 text-center text-gray-400 text-sm relative overflow-hidden">
				© <%= Time.current.year %> Copyright: <strong><%= t('footer.pascalixs_team') %></strong>
			</div>
		</div>
	</footer>
<% end %>
