    // Функция для обновления отображения статуса
    function updateStatusDisplay(status) {
        const statusElement = document.getElementById('purchase-status');
        const statusContainer = statusElement.closest('div'); // Находим родительский контейнер
        
        if (!status || status.trim() === '') {
            // Если статус пустой, скрываем весь блок статуса
            statusContainer.style.display = 'none';
        } else {
            // Если статус есть, показываем блок и устанавливаем значение
            statusContainer.style.display = '';
            statusElement.textContent = getStatusName(status);
        }
    }
    
    // Функция для отправки чека на сервер
    async function submitReceipt() {
      // Проверяем, есть ли что отправлять
      if (!receiptFile && !existingReceipt && !removeExistingReceipt) {
        showNotification('Пожалуйста, загрузите чек', 'error');
        return;
      }
      
      const submitBtn = document.getElementById('submit-receipt-btn');
      const originalText = submitBtn.innerHTML;
      
      // Отображение индикатора загрузки
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <span class="loading loading-spinner loading-md"></span>
        <span class="ml-2">Отправка...</span>
      `;
      
      try {
        // Проверка CSRF-токена
        const csrfToken = getCsrfToken();
        
        // Создание FormData для отправки файла
        const formData = new FormData();
        
        // Если это новая покупка (нет ID)
        if (!purchaseData.id) {
          formData.append('purchase[purchase_type]', purchaseData.type);
          formData.append('purchase[amount]', purchaseData.amount);
          formData.append('purchase[currency]', purchaseData.currency);
          formData.append('purchase[purchaser_user_id]', getCurrentUserId()); // Добавляем ID текущего пользователя
        }
        
        // Добавляем чек, если он есть
        if (receiptFile) {
          formData.append('receipt', receiptFile);
        }
        
        // Если нужно удалить существующий чек, добавляем флаг
        if (removeExistingReceipt && existingReceipt) {
          formData.append('remove_receipt', 'true');
          formData.append('existing_receipt_id', existingReceipt.id);
        }
        
        // Определяем URL и метод в зависимости от того, создаем ли мы новую покупку или обновляем существующую
        let url, method;
        if (purchaseData.id) {
          url = `/purchases/${purchaseData.id}`;
          method = 'PATCH';
        } else {
          url = '/purchases';
          method = 'POST';
        }
        
        console.log(`Отправляю ${method} запрос на ${url}`);
        console.log('Данные для отправки:', {
          receiptFile: !!receiptFile,
          removeExistingReceipt,
          existingReceipt: existingReceipt ? existingReceipt.id : null
        });
        
        const response = await fetch(url, {
          method: method,
          body: formData,
          headers: {
            'X-CSRF-Token': csrfToken
          },
          credentials: 'same-origin'
        });
        
        const data = await response.json();
        console.log('Ответ сервера:', data);
        
        if (response.ok) {
          // Обновление статуса покупки
          purchaseData.status = 'pending';
          updateStatusDisplay(purchaseData.status);
          
          // Если это была новая покупка, обновляем ID
          if (!purchaseData.id && data.id) {
            purchaseData.id = data.id;
          }
          
          // Обновляем информацию о существующем чеке
          if (data.receipt && data.receipt.length > 0) {
            existingReceipt = data.receipt[0];
            displayReceipt(existingReceipt);
            document.getElementById('receipt-drop-area').style.display = 'none';
          } else if (removeExistingReceipt) {
            // Если чек был удален, скрываем превью и показываем область загрузки
            document.getElementById('receipt-preview-container').classList.add('hidden');
            document.getElementById('receipt-drop-area').style.display = 'block';
            existingReceipt = null;
          }
          
          // Сбрасываем флаг удаления чека
          removeExistingReceipt = false;
          
          // Закрытие модального окна
          closePurchaseModal();
          
          // Показ уведомления об успешной отправке
          if (removeExistingReceipt) {
            showNotification('Чек успешно удален', 'success');
          } else {
            showNotification('Чек успешно отправлен на проверку', 'success');
          }
        } else {
          // Показываем ошибки от сервера
          const errorMessage = data.errors ? data.errors.join(', ') : 'Ошибка при отправке чека';
          showNotification(errorMessage, 'error');
        }
      } catch (error) {
        console.error('Error submitting receipt:', error);
        showNotification('Ошибка при отправке чека. Попробуйте еще раз', 'error');
      } finally {
        // Восстановление кнопки
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    }
    
    // Функция для получения ID текущего пользователя
    function getCurrentUserId() {
      // Предполагаем, что ID пользователя хранится в мета-теге или в глобальной переменной
      const userIdMeta = document.querySelector('meta[name="current-user-id"]');
      if (userIdMeta) {
        return userIdMeta.getAttribute('content');
      }
      
      // Альтернативный вариант - если ID доступен через глобальную переменную
      if (typeof currentUserId !== 'undefined') {
        return currentUserId;
      }
      
      console.error('Не удалось определить ID текущего пользователя');
      return null;
    }

    function displayReceipt(receipt) {
      console.log('Отображаю чек:', receipt);
      console.log('URL чека:', receipt.url);
      
      const previewContainer = document.getElementById('receipt-preview-container');
      let previewImg = document.getElementById('receipt-preview');
      
      if (!previewImg) {
        previewImg = document.createElement('img');
        previewImg.id = 'receipt-preview';
        previewImg.className = 'w-full h-auto object-contain';
        previewImg.setAttribute('loading', 'lazy');
        previewContainer.appendChild(previewImg);
      }
      
      // Удаляем предыдущий обработчик
      const newPreviewImg = previewImg.cloneNode(true);
      previewImg.parentNode.replaceChild(newPreviewImg, previewImg);
      
      // Убираем параметры запроса из URL и добавляем временную метку
      const baseUrl = receipt.url.split('?')[0];
      const imageUrl = `${baseUrl}?t=${new Date().getTime()}`; // Добавляем timestamp для избежания кэширования
      console.log('URL с временной меткой:', imageUrl);
      
      // Устанавливаем изображение
      newPreviewImg.src = imageUrl;
      
      // Добавляем обработчики
      newPreviewImg.onload = function() {
        console.log('Изображение успешно загружено');
        previewContainer.classList.remove('hidden');
      };

      // Добавляем обработчик для просмотра в полном размере
      newPreviewImg.onclick = function() {
        openReceiptViewer(imageUrl);
      };
    }
    
    // Функция для обновления данных о покупке
    function updatePurchaseData(type, id) {
      console.log('Обновляю данные покупки. Тип:', type, 'ID:', id);
      purchaseData.type = type;
      purchaseData.id = id;
      
      // Обновление интерфейса
      document.getElementById('purchase-type').textContent = getPurchaseTypeName(type);
      
      // Установка суммы в зависимости от типа
      switch(type) {
        case 'pass_purchase':
          purchaseData.amount = '3.00';
          break;
        case 'pass_gift':
          purchaseData.amount = '3.00';
          break;
        case 'donation':
          purchaseData.amount = '5.00';
          break;
        case 'sponsor':
          purchaseData.amount = '10.00';
          break;
        case 'unban':
          purchaseData.amount = '5.00';
          break;
        case 'unmute':
          purchaseData.amount = '2.00';
          break;
        default:
          purchaseData.amount = '3.00';
      }
      
      purchaseData.currency = 'USD'; // Устанавливаем валюту по умолчанию
      document.getElementById('purchase-amount').textContent = `${purchaseData.amount} ${purchaseData.currency}`;
    }
    
    // Функция для получения названия статуса покупки
    function getStatusName(status) {
      const names = {
        'pending': 'Ожидает проверки',
        'approved': 'Подтверждена',
        'rejected': 'Отклонена',
        'refunded': 'Возвращена'
      };
      
      return names[status] || status;
    }
    
    // Функция для получения названия типа покупки
    function getPurchaseTypeName(type) {
      const names = {
        'pass_purchase': 'Донат на проходку',
        'pass_gift': 'Подарок проходки',
        'donation': 'Донат',
        'sponsor': 'Спонсорство',
        'unban': 'Разбан',
        'unmute': 'Размут'
      };
      
      return names[type] || 'Донат';
    }
    
    // Функция для форматирования размера файла
    function formatFileSize(bytes) {
      if (bytes === 0) return '0 Bytes';
      
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function closePurchaseModal() {
      console.log('Закрываю модальное окно покупки');
      const modal = document.getElementById('purchase_modal');
      if (!modal) return;

      try {
       // Удаляем кнопки
       document.getElementById('replace-receipt')?.remove();
       document.getElementById('revoke-receipt')?.remove();
       
       // Прячем зону дропа и превью
       const dropArea = document.getElementById('receipt-drop-area');
       if (dropArea) dropArea.style.display = 'none';
       
       const preview = document.getElementById('receipt-preview-container');
       if (preview) {
         // Убедимся, что контейнер скрыт
         preview.classList.add('hidden');
         const previewImg = document.getElementById('receipt-preview');
         if (previewImg) {
           previewImg.src = '';
         }
       }
       
       // Очищаем файл-инпут
       const fileInput = document.getElementById('receipt-input');
       if (fileInput) fileInput.value = '';
       
       // Сбрасываем кнопку отправки
       const submitBtn = document.getElementById('submit-receipt-btn');
       if (submitBtn) {
         submitBtn.disabled = false;
         submitBtn.innerHTML = `
           <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
             <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
           </svg>
           Отправить чек
         `;
       }
       
       // Сброс бизнес-состояния
       resetForNewPurchase();
       
       // Очищаем текстовые поля с информацией о покупке
       const typeEl = document.getElementById('purchase-type');
       const amountEl = document.getElementById('purchase-amount');
       const statusEl = document.getElementById('purchase-status');
       if (typeEl) typeEl.textContent = '';
       if (amountEl) amountEl.textContent = '';
       if (statusEl) statusEl.textContent = '';
      } finally {
       // Закрываем модалку
       modal.close();
      }
      updateStatusDisplay('');
    }
    
    // Обработчики drag-and-drop для чека
    function handleReceiptDragOver(e) {
      e.preventDefault();
      e.stopPropagation();
      document.getElementById('receipt-drop-area').classList.add('border-amber-400', 'bg-amber-900/30');
    }
    
    function handleReceiptDragLeave(e) {
      e.preventDefault();
      e.stopPropagation();
      document.getElementById('receipt-drop-area').classList.remove('border-amber-400', 'bg-amber-900/30');
    }
    
    function handleReceiptDrop(e) {
      e.preventDefault();
      e.stopPropagation();
      document.getElementById('receipt-drop-area').classList.remove('border-amber-400', 'bg-amber-900/30');
      
      const files = e.dataTransfer.files;
      if (files.length > 0) {
        handleReceiptFile(files);
      }
    }

    function recreatePreviewImage() {
      const previewContainer = document.getElementById('receipt-preview-container');
      const oldPreviewImg = document.getElementById('receipt-preview');
      
      // Удаляем старое изображение, если оно существует
      if (oldPreviewImg) {
        oldPreviewImg.remove();
      }
      
      // Создаем новое изображение
      const newPreviewImg = document.createElement('img');
      newPreviewImg.id = 'receipt-preview';
      newPreviewImg.className = 'w-full h-auto object-contain cursor-pointer';
      newPreviewImg.setAttribute('loading', 'lazy');
      
      // Добавляем новое изображение в контейнер
      const imageWrapper = previewContainer.querySelector('.relative');
      if (imageWrapper) {
        imageWrapper.appendChild(newPreviewImg);
      } else {
        previewContainer.appendChild(newPreviewImg);
      }
      
      return newPreviewImg;
    }
    
    // Обработка выбранного файла чека
    function handleReceiptFile(files) {
      if (files.length === 0) return;
      const file = files[0];
      
      // Проверка типа файла
      if (!ALLOWED_FILE_TYPES.includes(file.type)) {
        showNotification('Пожалуйста, выберите изображение (JPG или PNG)', 'error');
        return;
      }
      
      // Проверка размера файла
      if (file.size > MAX_FILE_SIZE) {
        showNotification(`Размер файла не должен превышать ${formatFileSize(MAX_FILE_SIZE)}`, 'error');
        return;
      }
      
      receiptFile = file;
      // Сбрасываем флаг удаления существующего чека при загрузке нового
      removeExistingReceipt = false;
      
      // Пересоздаем элемент изображения
      const previewImg = recreatePreviewImage();
      
      // Отображение предпросмотра
      const reader = new FileReader();
      reader.onload = function(e) {
        // Устанавливаем новое изображение
        previewImg.src = e.target.result;
        
        // Добавляем обработчик для просмотра чека в полном размере
        previewImg.onclick = function() {
          openReceiptViewer(e.target.result);
        };
        
        // Показываем контейнер предпросмотра
        document.getElementById('receipt-preview-container').classList.remove('hidden');
        
        // Показываем кнопку удаления чека
        const receiptBtn = document.getElementById('receipt-button');
        if (receiptBtn) {
          receiptBtn.classList.remove('hidden');
        }
        
        // Скрываем область загрузки
        document.getElementById('receipt-drop-area').style.display = 'none';
        
        // Активируем кнопку отправки только после загрузки нового чека
        document.getElementById('submit-receipt-btn').disabled = false;
      };
      reader.readAsDataURL(file);
    }
    
    // Удаление загруженного чека
    function removeReceipt() {
      // Проверяем, есть ли существующий чек на сервере
      if (existingReceipt) {
        // Если есть, устанавливаем флаг для его удаления
        removeExistingReceipt = true;
        console.log('Установлен флаг удаления существующего чека');
      } else {
        // Если нет, просто сбрасываем файл
        receiptFile = null;
      }
      
      // Сбрасываем интерфейс
      document.getElementById('receipt-input').value = '';
      document.getElementById('receipt-preview-container').classList.add('hidden');
      document.getElementById('receipt-drop-area').style.display = 'block';
      
      // Кнопка отправки должна быть неактивна, так как нет чека
      document.getElementById('submit-receipt-btn').disabled = true;
      document.getElementById('submit-receipt-btn').innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        Отправить чек
      `;
    }

    function openReceiptViewer(imageSource) {
      const modal = document.getElementById('receipt-viewer-modal');
      const container = document.getElementById('receipt-container');
      const loader = document.getElementById('receipt-loader');
      const downloadBtn = document.getElementById('download-receipt');
      
      // Отображение индикатора загрузки
      loader.style.display = 'flex';
      container.innerHTML = '';
      
      // Проверяем, является ли источник base64-строкой
      const isBase64 = imageSource.startsWith('data:image');
      
      // Если это base64, скрываем кнопку скачивания
      if (isBase64) {
        downloadBtn.style.display = 'none';
      } else {
        downloadBtn.style.display = '';
        // Сохраняем URL в data-атрибуте
        downloadBtn.setAttribute('data-receipt-url', imageSource);
      }
      
      console.log('URL изображения для просмотра:', imageSource);
      
      // Создание изображения для чека
      const img = document.createElement('img');
      img.src = imageSource;
      img.className = 'max-w-full max-h-[70vh] object-contain';
      img.alt = 'Просмотр чека доната';
      img.setAttribute('loading', 'lazy');
      
      // Устанавливаем crossOrigin для изображений с сервера
      if (!imageSource.startsWith('data:')) {
        img.crossOrigin = "use-credentials";
      }
      
      img.onload = function() {
        loader.style.display = 'none';
        
        // Обновление информации о файле
        document.getElementById('receipt-info').textContent = 'Чек доната';
      };
      
      img.onerror = function() {
        loader.style.display = 'none';
        container.innerHTML = `
          <div class="text-center p-8">
            <div class="text-amber-400 text-5xl mb-4">⚠️</div>
            <h3 class="text-xl font-bold text-white mb-2">Ошибка загрузки</h3>
            <p class="text-amber-400/70">Не удалось загрузить чек. Попробуйте позже.</p>
          </div>
        `;
      };
      
      container.appendChild(img);
      modal.showModal();
    }

    async function downloadFile(url, fallbackName = 'receipt') {
      const a = document.createElement('a');
      a.style.display = 'none';
      document.body.appendChild(a);

      try {
        const res = await fetch(url, { credentials: 'include' }); // если авторизация по кукам
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        // Пытаемся вытащить имя из заголовка, иначе fallback
        const cd = res.headers.get('Content-Disposition') || '';
        const nameMatch = cd.match(/filename\*?=(?:UTF-8''|")?([^\";]+)/i);
        const fileName = nameMatch ? decodeURIComponent(nameMatch[1]) : fallbackName;

        const blob = await res.blob();
        const objectUrl = URL.createObjectURL(blob);

        a.href = objectUrl;
        a.download = fileName;
        a.click();

        URL.revokeObjectURL(objectUrl);
      } finally {
        document.body.removeChild(a);
      }
    }
    
    // Закрытие модального окна просмотра чека
    function closeReceiptViewer() {
      document.getElementById('receipt-drop-area').style.display = 'none';
      const modal = document.getElementById('receipt-viewer-modal');
      const downloadBtn = document.getElementById('download-receipt');
      
      // Очищаем data-атрибут и показываем кнопку
      downloadBtn.removeAttribute('data-receipt-url');
      downloadBtn.style.display = '';
      
      modal.close();
    }

    // Инициализация при загрузке документа
    document.addEventListener('DOMContentLoaded', function() {
      console.log('Скрипт модального окна покупки загружен');

      // Добавляем один обработчик для кнопки скачивания
      const downloadBtn = document.getElementById('download-receipt');
      downloadBtn.addEventListener('click', function() {
        const receiptUrl = this.getAttribute('data-receipt-url');
        if (receiptUrl) {
          downloadFile(receiptUrl, 'receipt.png');
        }
      });
      
      // Добавление стилей для анимаций
      const style = document.createElement('style');
      style.innerHTML = `
        @keyframes fadeIn {
          from { opacity: 0; transform: translateY(-10px); }
          to { opacity: 1; transform: translateY(0); }
        }
        .animate-fadeIn {
          animation: fadeIn 0.3s ease-out forwards;
        }
      `;
      document.head.appendChild(style);
      
      // Проверка поддержки Dialog API
      if (!window.HTMLDialogElement) {
        console.warn('Dialog API не поддерживается, используется полифилл');
        // Простая реализация полифилла для Dialog API
        const dialogs = document.querySelectorAll('dialog');
        dialogs.forEach(dialog => {
          dialog.showModal = function() {
            this.style.display = 'block';
            this.setAttribute('open', '');
          };
          dialog.close = function() {
            this.style.display = 'none';
            this.removeAttribute('open');
          };
        });
      }
      
      // Добавляем обработчик закрытия модального окна
      const modal = document.getElementById('purchase_modal');
      modal.addEventListener('close', function() {
        resetForNewPurchase();
        
        // Удаляем кнопку замены чека
        const replaceButton = document.querySelector('#receipt-upload-section button[onclick*="Заменить чек"]');
        if (replaceButton) {
          replaceButton.remove();
        }
      });
      
      // Управление фокусом при открытии модального окна
      modal.addEventListener('open', function() {
        // Перемещаем фокус на первый интерактивный элемент
        const firstFocusable = modal.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        if (firstFocusable) {
          firstFocusable.focus();
        }
      });
      
      // При закрытии возвращаем фокус на элемент, который открыл модальное окно
      modal.addEventListener('close', function() {
        const opener = document.activeElement;
        if (opener && opener.tagName === 'BUTTON') {
          opener.focus();
        }
      });
      
      // Делаем функции доступными глобально (только те, которые используются извне)
      window.openPurchaseModal = openPurchaseModal;
      window.closePurchaseModal = closePurchaseModal;
      window.submitReceipt = submitReceipt;
      window.handleReceiptDragOver = handleReceiptDragOver;
      window.handleReceiptDragLeave = handleReceiptDragLeave;
      window.handleReceiptDrop = handleReceiptDrop;
      window.handleReceiptFile = handleReceiptFile;
      window.removeReceipt = removeReceipt;
      window.openReceiptViewer = openReceiptViewer;
      window.closeReceiptViewer = closeReceiptViewer;
      
      console.log('Функции сделаны доступными глобально');
    });
  })();
</script>
