                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                        Отправить чек
                      `;
                    } else {
                    const errorData = await response.json();
                    const errorMessage = errorData.errors ? errorData.errors.join(', ') : 'Ошибка при отзыве чека';
                    showNotification(errorMessage, 'error');
                  }
                } catch (error) {
                  console.error('Ошибка при отзыве чека:', error);
                  showNotification('Ошибка при отзыве чека. Попробуйте еще раз', 'error');
                } finally {
                  // Восстанавливаем кнопку
                  revokeButton.disabled = false;
                  revokeButton.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <span>Отозвать чек</span>
                  `;
                }
              };

              // Удаляем старые кнопки, если они есть
              const receiptUploadSection = document.getElementById('receipt-upload-section');
              receiptUploadSection.querySelector('.replace-receipt-btn')?.remove();
              receiptUploadSection.querySelector('.revoke-receipt-btn')?.remove();

              // Добавляем новые кнопки
              receiptUploadSection.appendChild(replaceButton);
              receiptUploadSection.appendChild(revokeButton);
            }
          } else {
            console.log('Создаю новую покупку типа:', purchaseType);
            // Обновление данных покупки в зависимости от типа
            updatePurchaseData(purchaseType, null);
            
            // Показываем область загрузки
            document.getElementById('receipt-drop-area').style.display = 'block';
            
            // Сброс для новой покупки
            resetForNewPurchase();
            
            // Убедимся, что кнопка отправки неактивна, так как нет чека
            document.getElementById('submit-receipt-btn').disabled = true;
          }
        } else {
          console.log('Создаю новую покупку типа:', purchaseType);
          // Обновление данных покупки в зависимости от типа
          updatePurchaseData(purchaseType, null);
          
          // Показываем область загрузки
          document.getElementById('receipt-drop-area').style.display = 'block';
          
          // Сброс для новой покупки
          resetForNewPurchase();
        }
        
        const replaceBtn = document.getElementById('replace-receipt');
        const receiptBtn = document.getElementById('receipt-button');
        if (receiptBtn) {
          receiptBtn.classList.toggle('hidden', !!replaceBtn);
        }
        
        console.log('Модальное окно отображено');
      } catch (error) {
        console.error('Ошибка при открытии модального окна:', error);
        showNotification('Ошибка при загрузке данных. Попробуйте еще раз', 'error');
