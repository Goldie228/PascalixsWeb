<!DOCTYPE html>
<html class="h-full" data-theme="dark">
  <head>
    <title><%= content_for(:title) || "Pascalixs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <%= tag(:link, rel: "icon", href: image_path("logo.png"), type: "image/png") %>
    <%= tag(:link, rel: "apple-touch-icon", href: image_path("logo.png")) %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body data-notice="<%= flash[:notice] %>" data-alert="<%= flash[:alert] %>" class="flex flex-col font-minecraftia min-h-screen" data-csrf-token="<%= form_authenticity_token %>">
    <%= yield %>
  </body>

  <script type="text/javascript">
    let scaleInObserver = null;

    function initScaleInAnimation() {
      if (scaleInObserver) {
        scaleInObserver.disconnect();
      }
      
      const scaleInElements = document.querySelectorAll('.scale-in');
      
      scaleInObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Ждем полной загрузки изображений внутри элемента
            const images = entry.target.querySelectorAll('img');
            let imagesLoaded = 0;
            
            if (images.length === 0) {
              // Если изображений нет, сразу запускаем анимацию
              setTimeout(() => {
                entry.target.classList.add('scale-in-active');
              }, 100);
            } else {
              // Ждем загрузки всех изображений
              images.forEach(img => {
                if (img.complete) {
                  imagesLoaded++;
                } else {
                  img.addEventListener('load', () => {
                    imagesLoaded++;
                    if (imagesLoaded === images.length) {
                      setTimeout(() => {
                        entry.target.classList.add('scale-in-active');
                      }, 100);
                    }
                  });
                  img.addEventListener('error', () => {
                    imagesLoaded++; // Продолжаем даже если изображение не загрузилось
                    if (imagesLoaded === images.length) {
                      setTimeout(() => {
                        entry.target.classList.add('scale-in-active');
                      }, 100);
                    }
                  });
                }
              });
              
              // Если все изображения уже загружены
              if (imagesLoaded === images.length) {
                setTimeout(() => {
                  entry.target.classList.add('scale-in-active');
                }, 100);
              }
            }
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });
      
      scaleInElements.forEach(element => {
        scaleInObserver.observe(element);
      });
    }

    // Ждем полной загрузки страницы включая изображения
    window.addEventListener('load', initScaleInAnimation);
    
    // Для Turbo только после полной загрузки
    document.addEventListener('turbo:load', () => {
      setTimeout(initScaleInAnimation, 100);
    });
  </script>
</html>
