<!DOCTYPE html>
<html class="h-full" data-theme="dark">
  <head>
    <title><%= content_for(:title) || "Pascalixs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <%= tag(:link, rel: "icon", href: image_path("logo.png"), type: "image/png") %>
    <%= tag(:link, rel: "apple-touch-icon", href: image_path("logo.png")) %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>
  <body data-notice="<%= flash[:notice] %>" data-alert="<%= flash[:alert] %>" class="flex flex-col min-h-screen" data-csrf-token="<%= form_authenticity_token %>">
    <%= yield %>
  </body>
  <script type="text/javascript">
    // Глобальная переменная для хранения observer
    let scaleInObserver = null;

    // Функция для инициализации анимации
    function initScaleInAnimation() {
      // Отключаем предыдущий observer, если он существует
      if (scaleInObserver) {
        scaleInObserver.disconnect();
      }
      
      const scaleInElements = document.querySelectorAll('.scale-in');
      
      // Создаем новый Intersection Observer
      scaleInObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Анимация появления с небольшой задержкой
            setTimeout(() => {
              entry.target.classList.add('scale-in-active');
            }, 100);
          }
        });
      }, {
        threshold: 0.1, // Срабатывает когда 10% элемента видно
        rootMargin: '0px 0px -50px 0px' // Срабатывает немного раньше достижения элемента
      });
      
      // Наблюдаем за всеми элементами
      scaleInElements.forEach(element => {
        scaleInObserver.observe(element);
      });
    }

    // Обработчики событий для разных случаев загрузки страницы
    document.addEventListener('DOMContentLoaded', () => {
      // Задержка для полной отрисовки страницы
      setTimeout(initScaleInAnimation, 1);
    });

    // Для приложений с Turbo (Rails)
    document.addEventListener('turbo:load', () => {
      setTimeout(initScaleInAnimation, 1);
    });

    // Для обычных страниц
    window.addEventListener('load', () => {
      setTimeout(initScaleInAnimation, 1);
    });
  </script>
</html>
