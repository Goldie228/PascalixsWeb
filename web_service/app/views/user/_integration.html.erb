<div class="mx-auto pb-2 mb-2 w-[90%] max-w-8xl">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between">
	  <div class="relative flex flex-col items-start justify-start">
	    <div>
	      <h1 class="text-white text-3xl pb-4"><b>Интеграции</b></h1>
	    </div>

	    <div>
			<button class="btn bg-[#1A1A1A] flex items-center justify-start w-85 h-24 mb-4 mr-2 font-normal"
			        onclick="activateYoutubeModal()">
			  <svg class="w-12 h-12 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
			       width="36" height="36" fill="currentColor" viewBox="0 0 24 24">
			    <path fill-rule="evenodd"
			          d="M21.7 8.037a4.26 4.26 0 0 0-.789-1.964 2.84 2.84 0 0 0-1.984-.839c-2.767-.2-6.926-.2-6.926-.2s-4.157 0-6.928.2a2.836 2.836 0 0 0-1.983.839 4.225 4.225 0 0 0-.79 1.965 30.146 30.146 0 0 0-.2 3.206v1.5a30.12 30.12 0 0 0 .2 3.206c.094.712.364 1.39.784 1.972.604.536 1.38.837 2.187.848 1.583.151 6.731.2 6.731.2s4.161 0 6.928-.2a2.844 2.844 0 0 0 1.985-.84 4.27 4.27 0 0 0 .787-1.965 30.12 30.12 0 0 0 .2-3.206v-1.516a30.672 30.672 0 0 0-.202-3.206Zm-11.692 6.554v-5.62l5.4 2.819-5.4 2.801Z"
			          clip-rule="evenodd" />
			  </svg>
			  <% unless current_user.youtube_channel_name.present? %>
			  	<div class="text-2xl text-white ml-2">Привязать YouTube</div>
			  <% else %>
			  	<div class="text-2xl text-white ml-2">
				  <%= truncate(current_user.youtube_channel_name, length: 19, omission: '…') %>
				</div>
			  <% end %>
			</button>

	      <button class="btn bg-[#1A1A1A] flex items-center justify-start w-85 h-24 mb-4 mr-2 font-normal" onclick="openTwitchBindModal()">
	        <svg class="w-11 h-11 text-white dark:text-white" xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" viewBox="0 0 24 24"><path d="M2.149 0l-1.612 4.119v16.836h5.731v3.045h3.224l3.045-3.045h4.657l6.269-6.269v-14.686h-21.314zm19.164 13.612l-3.582 3.582h-5.731l-3.045 3.045v-3.045h-4.836v-15.045h17.194v11.463zm-3.582-7.343v6.262h-2.149v-6.262h2.149zm-5.731 0v6.262h-2.149v-6.262h2.149z" fill-rule="evenodd" clip-rule="evenodd"/></svg>
	        <div class="text-white text-2xl flex ml-3">Привязать Twitch</div>
	      </button>

	      <button class="btn bg-[#1A1A1A] flex items-center justify-start w-85 h-24 mr-2 font-normal" onclick="openTiktokBindModal()">
	        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="w-12 h-12 text-gray-800 dark:text-white" viewBox="0 0 16 16">
			  <path d="M9 0h1.98c.144.715.54 1.617 1.235 2.512C12.895 3.389 13.797 4 15 4v2c-1.753 0-3.07-.814-4-1.829V11a5 5 0 1 1-5-5v2a3 3 0 1 0 3 3z"/>
			</svg>
	        <div class="text-white text-2xl flex ml-2">
	          <% if current_user.tiktok_url.present? %>
		          @<%= truncate(current_user.tiktok_channel_name, length: 19, omission: '…') %>
		      <% else %>
		        Привязать TikTok
		      <% end %>
	        </div>
	      </button>
	    </div>
	  </div>
	    <%= render "accommodation" %>
	</div>
  </div>
</div>
