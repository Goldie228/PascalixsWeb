<div class="scale-in">
  <div class="flex items-center justify-center min-h-screen bg-[#121212]">
    <div class="card bg-[#1A1A1A] shadow-xl rounded-lg w-[95%] max-w-[800px] mx-auto pl-6 md:p-10 py-10 md:py-14">
      <%= link_to :back, class: "absolute text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-2 rounded-full transition ease-in-out duration-200", aria: { label: t('account.back_button.aria_label') } do %>
        <svg class="w-8 h-8 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12l4-4m-4 4 4 4"/>
        </svg>
      <% end %>

      <h2 class="text-3xl font-bold text-center mb-8 mt-10 text-white">
        <%= t('account.change_email.title') %>
      </h2>

      <form id="change-email-form" class="space-y-4">
        <!-- Текущий email -->
        <div class="bg-[#2b2b2b] px-5 py-3 rounded-lg text-white">
          <div class="flex flex-col">
            <div class="text-sm tracking-wide text-amber-400/90"><%= t('account.change_email.current_email') %></div>
            <div class="mt-1 text-base md:text-lg font-medium text-white/85"><%= current_user.discord_account.email %></div>
          </div>
        </div>

        <!-- Новый email -->
        <div class="bg-[#2b2b2b] px-5 py-3 rounded-lg">
          <div class="flex flex-col">
            <label for="new_email" class="text-sm tracking-wide text-amber-400/90 mb-1"><%= t('account.change_email.new_email') %></label>
            <input 
              type="email" 
              id="new_email" 
              name="email" 
              required
              class="bg-transparent border-none text-white text-base md:text-lg font-medium focus:ring-0 focus:outline-none w-full p-0"
              placeholder="<%= t('account.change_email.new_email_placeholder') %>"
            >
          </div>
        </div>

        <!-- Пароль -->
        <div class="bg-[#2b2b2b] px-5 py-3 rounded-lg relative">
          <div class="flex flex-col">
            <label for="password" class="text-sm tracking-wide text-amber-400/90 mb-1"><%= t('account.change_email.password_label') %></label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              required
              class="bg-transparent border-none text-white text-base md:text-lg font-medium focus:ring-0 focus:outline-none w-full pr-10"
              placeholder="<%= t('account.change_email.password_placeholder') %>"
            >

            <!-- Глазик -->
            <button 
              type="button" 
              id="togglePassword" 
              class="absolute right-5 top-[20px] text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-2 rounded-full transition ease-in-out duration-200"
              aria-label="<%= t('account.change_email.toggle_password') %>"
            >
              <!-- SVG: закрытый глаз -->
              <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Кнопка отправки -->
        <button 
          type="submit" 
          class="w-full btn bg-amber-400 hover:bg-amber-300 border-none text-[#2d2d2d] font-bold py-3 rounded transition flex items-center justify-center"
          id="submit-btn"
        >
          <span id="submit-text"><%= t('account.change_email.submit_button') %></span>
          <svg id="spinner" class="hidden w-5 h-5 ml-2 text-[#2d2d2d] animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Функция для переключения видимости пароля
  function setupPasswordToggle(toggleId, passwordId) {
    var toggle = document.getElementById(toggleId);
    var password = document.getElementById(passwordId);
    if (toggle && password) {
      toggle.addEventListener("click", function () {
        var currentType = password.getAttribute("type");
        var newType = currentType === "password" ? "text" : "password";
        password.setAttribute("type", newType);
        
        if (newType === "text") {
          toggle.innerHTML =
            '<svg class="w-6 h-6 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" d="M21 12c0 1.2-4.03 6-9 6s-9-4.8-9-6c0-1.2 4.03-6 9-6s9 4.8 9 6Z"/><path stroke="currentColor" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>';
        } else {
          toggle.innerHTML =
            '<svg class="w-6 h-6 text-gray-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>';
        }
      });
    }
  }

  setupPasswordToggle("togglePassword", "password");

  const form = document.getElementById('change-email-form');
  const submitBtn = document.getElementById('submit-btn');
  const submitText = document.getElementById('submit-text');
  const spinner = document.getElementById('spinner');

  // Локализация для JavaScript
  const jsTranslations = {
    submitting: "<%= j t('account.change_email.submitting') %>",
    defaultButtonText: "<%= j t('account.change_email.submit_button') %>",
    networkError: "<%= j t('account.change_email.network_error') %>"
  };

  form.addEventListener('submit', function(e) {
    e.preventDefault();

    // Показать спиннер
    submitText.textContent = jsTranslations.submitting;
    submitBtn.disabled = true;
    spinner.classList.remove('hidden');

    // Собрать данные формы
    const formData = new FormData(form);
    const jsonData = {};
    formData.forEach((value, key) => jsonData[key] = value);

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    fetch("/account/change_email_process", {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify(jsonData)
    })
    .then(response => response.json())
    .then(data => {
      if (data.redirect_to) {
        window.location.href = data.redirect_to;
      }
      else {
        if (data.success) {
          showNotification(data.message || '<%= j t("account.change_email.success_message") %>');
          form.reset();
        } else {
          showAlertNotification(data.message || '<%= j t("account.change_email.generic_error") %>');
        }
      }
    })
    .catch(() => {
      showAlertNotification(jsTranslations.networkError);
    })
    .finally(() => {
      submitText.textContent = jsTranslations.defaultButtonText;
      submitBtn.disabled = false;
      spinner.classList.add('hidden');
    });
  });
});
</script>

<%= render 'shared/notification' %>
