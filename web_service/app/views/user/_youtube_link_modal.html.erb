<dialog id="youtube_bind_modal" class="modal">
  <div class="modal-box max-w-3xl w-11/12 bg-[#1A1A1A] border-2 border-amber-400 p-8">
    <!-- Заголовок -->
    <h3 class="text-3xl text-amber-400 font-bold mb-4">
      <% if @player.youtube_url.present? %>
        <%= t("integrations.bind_modal.youtube.title_linked") %>
        <span class="text-white font-semibold">
          <%= truncate(@player.youtube_channel_name, length: 19, omission: '…') %>
        </span>
      <% else %>
        <%= t("integrations.bind_modal.youtube.title_unlinked") %>
      <% end %>
    </h3>

    <!-- Описание -->
    <p class="text-gray-400 mb-8">
      <% if @player.youtube_url.present? %>
        <%= t("integrations.bind_modal.youtube.description_linked") %>
        <a href="<%= @player.youtube_url %>" class="text-amber-400 hover:underline" target="_blank" rel="noopener">
          <%= truncate(@player.youtube_url, length: 30, omission: '…') %>
        </a>
      <% else %>
        <%= t("integrations.bind_modal.youtube.description_unlinked") %>
      <% end %>
    </p>

    <!-- Действия -->
    <div class="modal-action flex flex-col sm:flex-row justify-end sm:space-x-4 space-y-3 sm:space-y-0 w-full">
      <% if @player.youtube_url.present? %>
        <button
          type="button"
          class="btn text-lg px-6 py-2 bg-[#2d2d2d] text-gray-100 hover:bg-[#3a3a3a] shadow transition duration-200 w-full sm:w-auto"
          onclick="openUnbindModal()"
        >
          <%= t("integrations.bind_modal.youtube.unlink_button") %>
        </button>
      <% end %>

      <%= button_to(
            @player.youtube_url.present? ? t("integrations.bind_modal.youtube.action_button_update") : t("integrations.bind_modal.youtube.action_button_link"),
            youtube_integration_path,
            method: :get,
            form: { class: "inline w-full sm:w-auto" },
            class: "btn btn-warning text-[#1A1A1A] text-lg px-6 py-2 hover:bg-[#FFC400] shadow-lg transition duration-200 w-full sm:w-auto"
          ) %>

      <button
        type="button"
        class="btn btn-outline btn-warning text-lg px-6 py-2 hover:text-[#1A1A1A] shadow-lg transition duration-200 w-full sm:w-auto"
        onclick="closeBindModal()"
      >
        <%= t("integrations.bind_modal.youtube.cancel_button") %>
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<script type="text/javascript">
  function activateYoutubeModal() {
    const m = document.getElementById('youtube_bind_modal');
    if (m) m.showModal();
  }

  // disable submit + «Пожалуйста, подождите…»
  const ytForm = document.getElementById('youtube_bind_form');
  const ytBtn  = document.getElementById('bind_submit_button');
  if (ytForm) {
    ytForm.addEventListener('submit', e => {
      e.preventDefault();
      ytBtn.disabled = true;
      ytBtn.textContent = 'Пожалуйста, подождите…';
      ytForm.submit();
    });
  }

  // Закрытие модального окна
  function closeYouTubeModal() {
    const modal = document.getElementById("youtube_bind_modal");
    if (modal) {
      modal.close();
    }
  }
</script>