<dialog id="youtube_unbind_confirm_modal" class="modal">
  <div class="modal-box max-w-lg w-11/12 bg-[#1A1A1A] border-2 border-amber-400 p-8 relative">
    <h3 class="text-2xl text-amber-400 font-bold mb-4">
      <%= t("integrations.modals.confirm_title") %>
    </h3>
    <p class="text-gray-300 mb-6">
      <%= t("integrations.modals.youtube_unbind_text") %>
    </p>

    <div class="modal-action flex justify-end space-x-4">
      <!-- Отмена возвращает к первой модалке -->
      <button
        type="button"
        class="btn btn-outline btn-warning text-lg px-6 py-2 hover:text-[#1A1A1A] shadow-lg transition duration-200"
        onclick="cancelUnbindModal()"
      >
        <%= t("integrations.modals.cancel_button") %>
      </button>

      <!-- Да, отвязать — реальный DELETE на контроллер -->
      <%= button_to(
            t("integrations.modals.confirm_button"),
            youtube_unbind_path,
            method: :delete,
            form:  { class: "inline" },
            class: "btn btn-warning text-[#1A1A1A] text-lg px-6 py-2 hover:bg-[#FFC400] shadow-lg transition duration-200"
          ) %>
    </div>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button type="button" onclick="cancelUnbindModal()"></button>
  </form>
</dialog>

