<div class="bg-[#1A1A1A] rounded-lg shadow-lg mx-auto mb-4 w-[90%] max-w-8xl overflow-hidden px-8 py-8">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4 md:mb-5">
    <h2 class="text-2xl text-amber-400 font-bold"><%= t('punishments_history.title') %></h2>
    <div class="mt-2 md:mt-0">
      <% if @punishments.present? && @punishments.any? { |p| p[:status] != t('punishments_history.status.expired') } %>
        <span class="px-2 py-0.5 md:px-3 md:py-1 rounded-full bg-red-500 text-white text-xs md:text-sm font-medium">
          <%= t('punishments_history.active_punishments') %>
        </span>
      <% else %>
        <span class="px-2 py-0.5 md:px-3 md:py-1 rounded-full bg-[#252525] text-white text-xs md:text-sm font-medium">
          <%= t('punishments_history.no_active_punishments') %>
        </span>
      <% end %>
    </div>
  </div>
  
  <div class="overflow-x-auto">
    <div class="min-w-[800px] rounded-lg overflow-hidden">
      <div class="grid grid-cols-12 gap-2 md:gap-3 px-3 md:px-6 py-2 md:py-4 bg-[#2D2D2D]">
        <div class="col-span-2 text-xs md:text-md font-medium"><%= t('punishments_history.table.type') %></div>
        <div class="col-span-3 text-xs md:text-md font-medium"><%= t('punishments_history.table.reason') %></div>
        <div class="col-span-2 text-xs md:text-md font-medium"><%= t('punishments_history.table.issued_at') %></div>
        <div class="col-span-2 text-xs md:text-md font-medium"><%= t('punishments_history.table.expires_at') %></div>
        <div class="col-span-1 text-xs md:text-md font-medium"><%= t('punishments_history.table.status') %></div>
        <div class="col-span-2 text-xs md:text-md font-medium"><%= t('punishments_history.table.action') %></div>
      </div>
      
      <div id="punishments-container" class="max-h-[300px] overflow-y-auto divide-y divide-[#333333]">
        <% if @punishments.present? %>
          <% @punishments.each_with_index do |p, i| %>
            <div class="grid grid-cols-12 gap-2 md:gap-3 px-3 md:px-6 py-3 md:py-4 <%= i.even? ? 'bg-[#1A1A1A]' : 'bg-[#1F1F1F]' %> hover:bg-[#252525]">
              <div class="col-span-2 text-white text-xs md:text-sm font-medium">
                <span class="inline-flex items-center">
                  <% case p[:type].downcase %>
                  <% when 'ban' %>
                    <span class="w-2 h-2 md:w-3 md:h-3 rounded-full bg-[#DC2626] mr-1 md:mr-2"></span>
                  <% when 'mute' %>
                    <span class="w-2 h-2 md:w-3 md:h-3 rounded-full bg-[#CA8A04] mr-1 md:mr-2"></span>
                  <% else %>
                    <span class="w-2 h-2 md:w-3 md:h-3 rounded-full bg-[#525252] mr-1 md:mr-2"></span>
                  <% end %>
                  <%= p[:type].capitalize %>
                </span>
              </div>
              
              <div class="col-span-3 text-gray-300 text-xs md:text-sm">
                <%= p[:reason].presence || '—' %>
              </div>
              
              <div class="col-span-2 text-gray-300 text-xs md:text-sm">
                <%= p[:issued_at] %>
              </div>
              
              <div class="col-span-2 text-gray-300 text-xs md:text-sm">
                <% if p[:expires_at].present? %>
                  <span class="punishment-date" data-expires-at="<%= p[:expires_at] %>"><%= p[:expires_at] %></span>
                <% else %>
                  <span class="text-[#A3A3A3]"><%= t('punishments_history.permanent') %></span>
                <% end %>
              </div>
              
              <div class="col-span-1">
                <% if p[:status] == t('punishments_history.status.expired') %>
                  <span class="px-1.5 py-0.5 md:px-2 md:py-1 rounded-full bg-[#404040] text-[#D4D4D4] text-[10px] md:text-xs">
                    <%= t('punishments_history.status.expired') %>
                  </span>
                <% else %>
                  <span class="px-1.5 py-0.5 md:px-2 md:py-1 rounded-full bg-[#DC2626] text-white text-[10px] md:text-xs">
                    <%= t('punishments_history.status.active') %>
                  </span>
                <% end %>
              </div>
              
              <div class="col-span-2 flex space-x-1 md:space-x-2">
                <% if (p[:type].downcase == 'ban' || p[:type].downcase == 'mute') && p[:status] != t('punishments_history.status.expired') %>
                  <%= link_to donate_path, class: "text-[10px] md:text-xs px-2 py-1 md:px-3 md:py-1.5 rounded bg-[#16A34A] hover:bg-[#15803D] text-white transition-colors whitespace-nowrap" do %>
                    <%= t('punishments_history.actions.buy_out') %>
                  <% end %>
                <% end %>
                
                <% if p[:status] != t('punishments_history.status.expired') %>
                  <button 
                    class="text-[10px] md:text-xs px-2 py-1 md:px-3 md:py-1.5 rounded bg-amber-500 hover:bg-amber-600 text-black transition-colors whitespace-nowrap"
                    onclick="loadAndOpenAppealModal('<%= p[:id] %>', {
                      type: '<%= p[:type].capitalize %>',
                      reason: '<%= p[:reason].presence || '—' %>',
                      status: '<%= p[:status] %>',
                      expires_at: '<%= p[:expires_at].presence || '—' %>'
                    })"
                  >
                    <%= t('punishments_history.actions.appeal') %>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  
  <% if @punishments.blank? %>
    <div class="text-center py-4 md:py-6">
      <p class="text-[#A3A3A3] text-sm md:text-base"><%= t('punishments_history.no_records') %></p>
    </div>
  <% end %>
</div>
<script type="text/javascript">
  // Функция для обработки дат и замены на "Перманентный" если срок > 50 лет
  function processPunishmentDates() {
    const permanentText = "<%= t('punishments_history.permanent') %>";
    const dateSpans = document.querySelectorAll('.punishment-date:not(.processed)');
    
    dateSpans.forEach(span => {
      const dateString = span.getAttribute('data-expires-at');
      if (!dateString) return;
      
      // Преобразуем дату из формата "DD.MM.YYYY HH:MM:SS" в формат, понятный для Date
      const dateParts = dateString.split(' ');
      if (dateParts.length !== 2) return;
      
      const dateComponent = dateParts[0].split('.');
      if (dateComponent.length !== 3) return;
      
      const timeComponent = dateParts[1].split(':');
      if (timeComponent.length !== 3) return;
      
      // Создаем дату в формате YYYY-MM-DDTHH:MM:SS
      const formattedDate = `${dateComponent[2]}-${dateComponent[1]}-${dateComponent[0]}T${timeComponent[0]}:${timeComponent[1]}:${timeComponent[2]}`;
      const expireDate = new Date(formattedDate);
      const now = new Date();
      
      if (isNaN(expireDate.getTime())) {
        console.error("Invalid date format:", dateString);
        return;
      }
      
      const diffYears = (expireDate - now) / (1000 * 60 * 60 * 24 * 365); // Разница в годах
      
      if (diffYears > 50) {
        span.textContent = permanentText;
        span.classList.add('text-[#A3A3A3]');
      }
      
      // Помечаем элемент как обработанный
      span.classList.add('processed');
    });
  }

  // Функция debounce для оптимизации вызовов
  function debounce(func, wait) {
    let timeout;
    return function() {
      const context = this;
      const args = arguments;
      clearTimeout(timeout);
      timeout = setTimeout(() => func.apply(context, args), wait);
    };
  }

  // Обработка при загрузке DOM
  document.addEventListener('DOMContentLoaded', processPunishmentDates);
  
  // Создаем оптимизированный обработчик с debounce
  const debouncedProcessDates = debounce(processPunishmentDates, 100);
  
  // Наблюдаем только за контейнером с наказаниями
  const punishmentsContainer = document.getElementById('punishments-container');
  if (punishmentsContainer) {
    const observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.addedNodes.length) {
          debouncedProcessDates();
        }
      });
    });
    
    // Начинаем наблюдение только за контейнером с наказаниями
    observer.observe(punishmentsContainer, { childList: true, subtree: true });
  }
  
  function loadAndOpenAppealModal(punishmentId, baseData) {
    const button = event.target;
    const originalText = button.textContent;
    button.disabled = true;
    button.textContent = '<%= t("punishments_history.loading") %>';
    
    fetch(`/load_punishment_appeal/${punishmentId}`, {
      method: 'GET',
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      }
    })
    .then(response => {
      if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
      return response.json();
    })
    .then(data => {
      const finalData = { ...baseData, id: punishmentId, appeal: data.appeal || {} };
      openAppealModal(finalData)
    })
    .catch(error => {
      showAlertNotification('<%= t("punishments_history.errors.load_appeal_data") %>');
    })
    .finally(() => {
      button.disabled = false;
      button.textContent = originalText;
    });
  }
</script>
