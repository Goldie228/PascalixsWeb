<div class="bg-[#1A1A1A] rounded-lg shadow-lg mx-auto my-6 w-[90%] max-w-8xl overflow-hidden px-6 py-6">
  <!-- Заголовок и статус активности -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-5">
    <h2 class="text-2xl text-amber-400 font-bold">История наказаний</h2>
    <div class="mt-3 md:mt-0">
      <% if @punishments.present? && @punishments.any? { |p| p[:status] != 'Истек' } %>
        <span class="px-3 py-1 rounded-full bg-red-500 text-white text-sm font-medium">
          Активные наказания
        </span>
      <% else %>
        <span class="px-3 py-1 rounded-full bg-[#252525] text-white text-sm font-medium">
          Нет активных наказаний
        </span>
      <% end %>
    </div>
  </div>

  <!-- Описание перед таблицей -->
  <div class="bg-[#2D2D2D] rounded-lg p-5 mb-5">
    <p class="text-white text-sm">
      Здесь отображаются все примененные к игроку наказания. Вы можете оспорить наказание, если считаете его несправедливым,
      или откупить бан, если это возможно.
    </p>
  </div>

  <div class="overflow-x-auto">
    <div class="min-w-full rounded-lg overflow-hidden">
      <!-- Заголовки -->
      <div class="grid grid-cols-12 gap-3 px-6 py-4 bg-[#2D2D2D]">
        <div class="col-span-2 text-amber-400 text-sm font-medium">Тип</div>
        <div class="col-span-3 text-amber-400 text-sm font-medium">Причина</div>
        <div class="col-span-2 text-amber-400 text-sm font-medium">Выдано</div>
        <div class="col-span-2 text-amber-400 text-sm font-medium">Истекает</div>
        <div class="col-span-1 text-amber-400 text-sm font-medium">Статус</div>
        <div class="col-span-2 text-amber-400 text-sm font-medium">Действие</div>
      </div>
      
      <!-- Строки -->
      <div class="divide-y divide-[#333333]">
        <% if @punishments.present? %>
          <% @punishments.each_with_index do |p, i| %>
            <div class="grid grid-cols-12 gap-3 px-6 py-4 <%= i.even? ? 'bg-[#1A1A1A]' : 'bg-[#1F1F1F]' %> hover:bg-[#252525]">
              <!-- Тип -->
              <div class="col-span-2 text-white text-sm font-medium">
                <span class="inline-flex items-center">
                  <% case p[:type].downcase %>
                  <% when 'ban' %>
                    <span class="w-3 h-3 rounded-full bg-[#DC2626] mr-2"></span>
                  <% when 'mute' %>
                    <span class="w-3 h-3 rounded-full bg-[#CA8A04] mr-2"></span>
                  <% else %>
                    <span class="w-3 h-3 rounded-full bg-[#525252] mr-2"></span>
                  <% end %>
                  <%= p[:type].capitalize %>
                </span>
              </div>
              
              <!-- Причина -->
              <div class="col-span-3 text-gray-300 text-sm">
                <%= p[:reason].presence || '—' %>
              </div>
              
              <!-- Выдано -->
              <div class="col-span-2 text-gray-300 text-sm">
                <%= p[:issued_at] %>
              </div>
              
              <!-- Истекает -->
              <div class="col-span-2 text-gray-300 text-sm">
                <% if p[:expires_at].present? %>
                  <%= p[:expires_at] %>
                <% else %>
                  <span class="text-[#A3A3A3]">Бессрочно</span>
                <% end %>
              </div>
              
              <!-- Статус -->
              <div class="col-span-1">
                <% if p[:status] == 'Истек' %>
                  <span class="px-2 py-1 rounded-full bg-[#404040] text-[#D4D4D4] text-xs">Истек</span>
                <% else %>
                  <span class="px-2 py-1 rounded-full bg-[#DC2626] text-white text-xs">Активно</span>
                <% end %>
              </div>
              
              <!-- Действие -->
              <div class="col-span-2 flex space-x-2">
                <% if p[:type].downcase == 'ban' && p[:status] != 'Истек' %>
                  <button class="text-xs px-3 py-1.5 rounded bg-[#16A34A] hover:bg-[#15803D] text-white transition-colors">
                    Откупить
                  </button>
                <% end %>
                
                <% if p[:status] != 'Истек' %>
                  <button class="text-xs px-3 py-1.5 rounded bg-amber-500 hover:bg-amber-600 text-black transition-colors">
                    Оспорить
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  
  <% if @punishments.blank? %>
    <div class="text-center py-6">
      <p class="text-[#A3A3A3]">Нет записей о наказаниях</p>
    </div>
  <% end %>
</div>
