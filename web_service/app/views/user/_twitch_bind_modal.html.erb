<dialog id="twitch_bind_modal" class="modal">
  <div class="modal-box max-w-3xl w-11/12 bg-[#1A1A1A] border-2 border-amber-400 p-8">
    <!-- Заголовок -->
    <h3 class="text-3xl text-amber-400 font-bold mb-4">
      <% if @player.twitch_url.present? %>
        <%= t("integrations.bind_modal.twitch.title_linked") %>
        <span class="text-white font-semibold">
          <%= truncate(@player.twitch_channel_name, length: 19, omission: '…') %>
        </span>
      <% else %>
        <%= t("integrations.bind_modal.twitch.title_unlinked") %>
      <% end %>
    </h3>

    <!-- Описание -->
    <p class="text-gray-400 mb-8">
      <% if @player.twitch_url.present? %>
        <%= t("integrations.bind_modal.twitch.description_linked") %>
        <a href="<%= @player.twitch_url %>" class="text-amber-400 hover:underline" target="_blank" rel="noopener">
          <%= truncate(@player.twitch_url, length: 30, omission: '…') %>
        </a>
      <% else %>
        <%= t("integrations.bind_modal.twitch.description_unlinked") %>
      <% end %>
    </p>

    <!-- Действия -->
    <div class="modal-action flex flex-col sm:flex-row justify-end sm:space-x-4 space-y-3 sm:space-y-0 w-full">
      <% if @player.twitch_url.present? %>
        <button
          type="button"
          class="btn text-lg px-6 py-2 bg-[#2d2d2d] text-gray-100 hover:bg-[#3a3a3a] shadow transition duration-200 w-full sm:w-auto"
          onclick="openTwitchUnbindModal()"
        >
          <%= t("integrations.bind_modal.twitch.unlink_button") %>
        </button>
      <% end %>

      <%= button_to(
            @player.twitch_url.present? ? t("integrations.bind_modal.twitch.action_button_update") : t("integrations.bind_modal.twitch.action_button_link"),
            twitch_integration_path,
            method: :get,
            form: { class: "inline w-full sm:w-auto" },
            class: "btn btn-warning text-[#1A1A1A] text-lg px-6 py-2 hover:bg-[#FFC400] shadow-lg transition duration-200 w-full sm:w-auto"
          ) %>

      <button
        type="button"
        class="btn btn-outline btn-warning text-lg px-6 py-2 hover:text-[#1A1A1A] shadow-lg transition duration-200 w-full sm:w-auto"
        onclick="closeTwitchBindModal()"
      >
        <%= t("integrations.bind_modal.twitch.cancel_button") %>
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<script type="text/javascript">
  function openTwitchBindModal() {
    document.getElementById('twitch_bind_modal').showModal();
  }
  function closeTwitchBindModal() {
    document.getElementById('twitch_bind_modal').close();
  }
  function openTwitchUnbindModal() {
    closeTwitchBindModal();
    document.getElementById('twitch_unbind_confirm_modal').showModal();
  }
  function cancelTwitchUnbind() {
    document.getElementById('twitch_unbind_confirm_modal').close();
    openTwitchBindModal();
  }
</script>