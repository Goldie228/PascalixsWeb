<div class="scale-in">
  <div class="flex items-center justify-center min-h-screen bg-[#121212]">
    <div class="card bg-[#1A1A1A] shadow-xl rounded-lg w-[95%] max-w-[800px] mx-auto pl-6 md:p-10 py-10 md:py-14 relative">
      
      <!-- Кнопка "Назад" -->
      <%= link_to :back, class: "absolute text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-2 rounded-full transition ease-in-out duration-200", aria: { label: t('change_password.back_button.aria_label') } do %>
        <svg class="w-8 h-8 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12l4-4m-4 4 4 4"/>
        </svg>
      <% end %>

      <h2 class="text-3xl font-bold text-center mb-8 mt-10 text-white">
        <%= t('change_password.title') %>
      </h2>

      <form id="change-password-form" class="space-y-6">
        <!-- Текущий пароль -->
        <div class="bg-[#2b2b2b] px-5 py-3 rounded-lg relative">
          <div class="flex flex-col">
            <label for="current_password" class="text-sm tracking-wide text-amber-400/90 mb-1">
              <%= t('change_password.current_password_label') %>
            </label>
            <input 
              type="password" 
              id="current_password" 
              name="current_password" 
              required
              class="bg-transparent border-none text-white text-base md:text-lg font-medium focus:ring-0 focus:outline-none w-full pr-10"
              placeholder="<%= t('change_password.current_password_placeholder') %>"
            >
            
            <!-- Глазик -->
            <button 
              type="button" 
              data-toggle="current_password"
              class="toggle-password absolute right-5 top-[20px] text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-5 rounded-full transition ease-in-out duration-200"
              aria-label="<%= t('change_password.show_hide_password') %>"
            >
              <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
              </svg>
            </button>
          </div>
          <div id="current_password_error" class="text-red-500 text-sm mt-1 min-h-[20px] pr-30"></div>
        </div>

        <!-- Новый пароль -->
        <div class="bg-[#2b2b2b] px-5 py-3 rounded-lg relative">
          <div class="flex flex-col">
            <label for="new_password" class="text-sm tracking-wide text-amber-400/90 mb-1">
              <%= t('change_password.new_password_label') %>
            </label>
            <input 
              type="password" 
              id="new_password" 
              name="new_password" 
              required
              class="bg-transparent border-none text-white text-base md:text-lg font-medium focus:ring-0 focus:outline-none w-full pr-10"
              placeholder="<%= t('change_password.new_password_placeholder') %>"
            >
            
            <!-- Глазик -->
            <button 
              type="button" 
              data-toggle="new_password"
              class="toggle-password absolute right-5 top-[20px] text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-5 rounded-full transition ease-in-out duration-200"
              aria-label="<%= t('change_password.show_hide_password') %>"
            >
              <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
              </svg>
            </button>
          </div>
          <div id="new_password_error" class="text-red-500 text-sm mt-1 min-h-[20px] pr-30"></div>
        </div>

        <!-- Подтверждение нового пароля -->
        <div class="bg-[#2b2b2b] px-5 py-3 rounded-lg relative">
          <div class="flex flex-col">
            <label for="password_confirmation" class="text-sm tracking-wide text-amber-400/90 mb-1">
              <%= t('change_password.password_confirmation_label') %>
            </label>
            <input 
              type="password" 
              id="password_confirmation" 
              name="password_confirmation" 
              required
              class="bg-transparent border-none text-white text-base md:text-lg font-medium focus:ring-0 focus:outline-none w-full pr-10"
              placeholder="<%= t('change_password.password_confirmation_placeholder') %>"
            >
            
            <!-- Глазик -->
            <button 
              type="button" 
              data-toggle="password_confirmation"
              class="toggle-password absolute right-5 top-[20px] text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-5 rounded-full transition ease-in-out duration-200"
              aria-label="<%= t('change_password.show_hide_password') %>"
            >
              <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
              </svg>
            </button>
          </div>
          <div id="password_confirmation_error" class="text-red-500 text-sm mt-1 min-h-[20px] pr-30"></div>
        </div>

        <!-- Кнопка отправки -->
        <button 
          type="submit" 
          class="w-full btn bg-amber-400 hover:bg-amber-300 border-none text-[#2d2d2d] font-bold py-3 rounded transition flex items-center justify-center mt-6"
          id="submit-btn"
        >
          <span id="submit-text"><%= t('change_password.submit_button') %></span>
          <svg id="spinner" class="hidden w-5 h-5 ml-2 text-[#2d2d2d] animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>

<%= render 'shared/notification' %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Функция для переключения видимости пароля
  function setupPasswordToggle() {
    const toggles = document.querySelectorAll('.toggle-password');
    if (!toggles.length) return;
    
    toggles.forEach(toggle => {
      const passwordId = toggle.getAttribute('data-toggle');
      const password = document.getElementById(passwordId);
      
      if (password) {
        toggle.addEventListener('click', function() {
          const currentType = password.getAttribute('type');
          const newType = currentType === 'password' ? 'text' : 'password';
          password.setAttribute('type', newType);
          
          // Изменение иконки
          if (newType === 'text') {
            toggle.innerHTML = `
              <svg class="w-6 h-6 text-amber-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-width="2" d="M21 12c0 1.2-4.03 6-9 6s-9-4.8-9-6c0-1.2 4.03-6 9-6s9 4.8 9 6Z"/>
                <path stroke="currentColor" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
              </svg>
            `;
          } else {
            toggle.innerHTML = `
              <svg class="w-6 h-6 text-gray-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
              </svg>
            `;
          }
        });
      }
    });
  }

  // Проверка совпадения паролей
  function setupPasswordConfirmationCheck() {
    const confirmInput = document.getElementById('password_confirmation');
    const newPasswordInput = document.getElementById('new_password');
    const errorEl = document.getElementById('password_confirmation_error');

    if (!confirmInput || !newPasswordInput || !errorEl) return;

    confirmInput.addEventListener('input', function() {
      const password = newPasswordInput.value;
      const confirm = this.value;
      
      if (confirm && password !== confirm) {
        errorEl.textContent = '<%= j t("change_password.errors.passwords_do_not_match") %>';
      } else {
        errorEl.textContent = '';
      }
    });
  }

  // Обработка отправки формы
  function setupFormSubmission() {
    const form = document.getElementById('change-password-form');
    const submitBtn = document.getElementById('submit-btn');
    const submitText = document.getElementById('submit-text');
    const spinner = document.getElementById('spinner');
    
    if (!form || !submitBtn || !submitText || !spinner) return;

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      // Сбросить предыдущие ошибки
      const errorElements = document.querySelectorAll('[id$="_error"]');
      errorElements.forEach(el => {
        if (el) el.textContent = '';
      });
      
      // Показать спиннер
      submitText.textContent = '<%= j t("change_password.updating") %>';
      submitBtn.disabled = true;
      spinner.classList.remove('hidden');

      try {
        // Собрать данные формы
        const formData = new FormData(form);
        const jsonData = Object.fromEntries(formData.entries());

        // Получить CSRF токен
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
        const locale = "<%= I18n.locale %>"

        // Отправить запрос
        const response = await fetch("/validate_new_password", {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
            'X-Locale': locale
          },
          body: JSON.stringify(jsonData)
        });

        const data = await response.json();

        if (!response.ok) throw data;

        form.reset();
        window.location.href = "/";
      } catch (error) {
        // Обработка ошибок валидации
        if (error.errors) {
          Object.entries(error.errors).forEach(([field, message]) => {
            const errorEl = document.getElementById(`${field}_error`);
            if (errorEl) errorEl.textContent = Array.isArray(message) ? message[0] : message;
          });
        } else {
          // Используем вашу существующую реализацию уведомлений
          showAlertNotification(error.message || '<%= j t("change_password.general_error") %>');
        }
      } finally {
        submitText.textContent = '<%= j t("change_password.submit_button") %>';
        submitBtn.disabled = false;
        spinner.classList.add('hidden');
      }
    });
  }

  // Инициализация всех функций
  setupPasswordToggle();
  setupPasswordConfirmationCheck();
  setupFormSubmission();
});
</script>
