<div class="bg-[#1A1A1A] rounded-lg shadow-lg pt-4 pl-4 pr-0 mt-0 mb-0 mx-auto px-4 w-[90%] max-w-8xl">
  <div class="pt-4 pl-4 flex items-center space-x-4">
    <h1 class="text-2xl text-amber-400">
      <b><%= t('player_info.title') %></b>
    </h1>

    <% if @edit %>
      <%= link_to "", onclick: "activateModal(); return false;", class: "cursor-pointer transition hover:text-gray-400 text-amber-400 flex items-center justify-center" do %>
        <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M5 8a4 4 0 1 1 7.796 1.263l-2.533 2.534A4 4 0 0 1 5 8Zm4.06 5H7a4 4 0 0 0-4 4v1a2 2 0 0 0 2 2h2.172a2.999 2.999 0 0 1-.114-1.588l.674-3.372a3 3 0 0 1 .82-1.533L9.06 13Zm9.032-5a2.907 2.907 0 0 0-2.056.852L9.967 14.92a1 1 0 0 0-.273.51l-.675 3.373a1 1 0 0 0 1.177 1.177l3.372-.675a1 1 0 0 0 .511-.273l6.07-6.07a2.91 2.91 0 0 0-.944-4.742A2.907 2.907 0 0 0 18.092 8Z" clip-rule="evenodd"/>
        </svg>
      <% end %>
    <% end %>
  </div>

  <div class="text-lg mt-4 mb-0 mr-6 pl-4 pb-8 text-gray-400 break-all">
     <%= @player.about_me.present? ? @player.about_me : t('player_info.default_description') %>
  </div>
</div>
