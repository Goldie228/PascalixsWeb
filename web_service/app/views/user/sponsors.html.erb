<%= render 'shared/navbar' %>

<div class="min-h-screen bg-gradient-to-br from-[#0D0D0D] to-[#1A1A1A] text-white overflow-x-hidden">
  <!-- Анимированный фон -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
    <div class="absolute top-1/4 -right-20 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl animate-pulse sponsors-bg-1"></div>
    <div class="absolute bottom-1/4 -left-20 w-96 h-96 bg-amber-500/5 rounded-full blur-3xl animate-pulse sponsors-bg-2"></div>
  </div>

  <!-- Контент -->
  <div class="relative z-10">
    <!-- Hero секция -->
    <section class="py-20 px-4 text-center">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-amber-300 to-amber-500 sponsors-title">
          <%= t('views.sponsors.index.title') %>
        </h1>
        <p class="text-xl text-gray-300 mb-10 sponsors-subtitle">
          <%= t('views.sponsors.index.welcome_message') %>
        </p>
        
        <% unless current_user&.is_sponsor %>
          <div class="mb-12 sponsors-cta">
            <%= link_to donate_path, class: "group inline-flex items-center px-8 py-4 rounded-2xl text-lg font-bold bg-gradient-to-r from-amber-500 to-amber-600 text-[#1A1A1A] hover:from-amber-400 hover:to-amber-500 transition-all duration-500 shadow-lg hover:shadow-xl hover:shadow-amber-500/30 transform hover:scale-105" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2 transition-transform group-hover:rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
              </svg>
              <%= t('views.sponsors.index.donate_button') %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
    
    <!-- Поиск спонсоров -->
    <section class="container mx-auto px-4 mb-12 sponsors-search">
      <div class="max-w-2xl mx-auto">
        <%= form_with url: sponsors_path, method: :get, local: true, class: "relative" do %>
          <div class="relative">
            <input
              type="text"
              name="search"
              value="<%= params[:search] %>"
              placeholder="<%= t('views.sponsors.index.search_placeholder') %>"
              class="w-full px-6 py-4 bg-black/30 backdrop-blur-md border border-amber-500/20 rounded-2xl focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500/30 placeholder-gray-500 text-white transition-all duration-300"
            >
            <button type="submit" class="absolute right-3 top-1/2 transform -translate-y-1/2 p-2 text-amber-500 hover:text-amber-400 transition-colors duration-300 hover:scale-110">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
          </div>
        <% end %>
      </div>
    </section>
    
    <!-- Сетка спонсоров -->
    <section class="container mx-auto px-4 mb-20 sponsors-grid">
      <% if @sponsors.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          <% @sponsors.each_with_index do |sponsor, index| %>
            <%= link_to "/players/#{sponsor['minecraft_nickname']}", class: "block sponsors-card group", data: { index: index } do %>
              <div class="h-full bg-black/20 backdrop-blur-md border border-amber-500/10 rounded-2xl p-5 text-center transition-all duration-500 group-hover:border-amber-500/30 group-hover:bg-black/30 group-hover:shadow-2xl group-hover:shadow-amber-500/10 transform group-hover:-translate-y-2">
                <div class="mb-5 relative">
                  <div class="relative w-24 h-24 mx-auto">
                    <div class="absolute inset-0 bg-gradient-to-br from-amber-500 to-amber-600 rounded-full opacity-0 group-hover:opacity-100 blur-md transition-opacity duration-500"></div>
                    <div class="relative w-24 h-24 rounded-full border-2 border-amber-500/30 overflow-hidden transition-all duration-500 group-hover:border-amber-500 group-hover:scale-105">
                      <img src="<%= sponsor['discord_avatar_url'] %>" 
                           alt="<%= sponsor['minecraft_nickname'] %>" 
                           class="w-full h-full object-cover"
                           onerror="this.onerror=null;this.src='<%= asset_path('steve.webp') %>';">
                    </div>
                  </div>
                  <div class="absolute -bottom-2 left-1/2 transform -translate-x-1/2 bg-gradient-to-r from-amber-500 to-amber-600 text-xs text-white font-bold px-3 py-1 rounded-full shadow-lg transition-transform duration-300 group-hover:scale-110">
                    SPONSOR
                  </div>
                </div>
                
                <div class="p-2 text-center">
                  <h3 class="text-lg font-bold mb-1 text-white group-hover:text-amber-300 transition-colors duration-300"><%= sponsor['minecraft_nickname'] %></h3>
                  <p class="text-amber-400/80 text-sm mb-4 transition-all duration-300 group-hover:text-amber-300 group-hover:opacity-100">@<%= sponsor['discord_username'] %></p>
                  
                  <div class="inline-flex items-center px-3 py-2 rounded-full bg-amber-500/10 text-amber-400 text-xs transition-all duration-300 group-hover:bg-amber-500/20 group-hover:scale-105">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <%= t('views.sponsors.index.sponsor_badge') %>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-12 sponsors-empty">
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-amber-500/10 to-amber-600/10 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-3 text-white"><%= t('views.sponsors.index.no_sponsors_title') %></h3>
          <p class="text-gray-400 mb-6 max-w-md mx-auto"><%= t('views.sponsors.index.no_sponsors_message') %></p>
          <% if params[:search].present? %>
            <%= link_to t('views.sponsors.index.reset_search'), sponsors_path, class: "px-5 py-2.5 rounded-xl bg-black/30 border border-amber-500/20 hover:border-amber-500/40 text-white transition-all duration-300 hover:shadow-lg hover:shadow-amber-500/10" %>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</div>

<%= render 'shared/footer' %>

<style>
  /* Изолированные стили только для страницы спонсоров */
  .sponsors-page-styles {
    /* Анимации */
    --sponsors-animation-duration: 0.8s;
  }

  .sponsors-title {
    animation: sponsors-fade-in 1s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  .sponsors-subtitle {
    animation: sponsors-fade-in-up var(--sponsors-animation-duration) ease-out 0.15s forwards;
    opacity: 0;
    transform: translateY(40px);
  }

  .sponsors-cta {
    animation: sponsors-fade-in-up var(--sponsors-animation-duration) ease-out 0.3s forwards;
    opacity: 0;
    transform: translateY(40px);
  }

  .sponsors-search {
    animation: sponsors-fade-in-up var(--sponsors-animation-duration) ease-out 0.45s forwards;
    opacity: 0;
    transform: translateY(40px);
  }

  .sponsors-grid {
    animation: sponsors-fade-in 0.6s ease-out 0.6s forwards;
    opacity: 0;
  }

  .sponsors-card {
    animation: sponsors-card-stagger 0.6s ease-out forwards;
    opacity: 0;
    transform: translateY(30px) scale(0.95);
  }

  .sponsors-empty {
    animation: sponsors-fade-in 0.8s ease-out forwards;
    opacity: 0;
  }

  /* Анимированный фон */
  .sponsors-bg-1 {
    animation: sponsors-pulse-1 4s ease-in-out infinite;
  }

  .sponsors-bg-2 {
    animation: sponsors-pulse-2 6s ease-in-out infinite;
  }

  /* Keyframes */
  @keyframes sponsors-fade-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes sponsors-fade-in-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes sponsors-card-stagger {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes sponsors-pulse-1 {
    0%, 100% {
      opacity: 0.1;
      transform: scale(1);
    }
    50% {
      opacity: 0.15;
      transform: scale(1.05);
    }
  }

  @keyframes sponsors-pulse-2 {
    0%, 100% {
      opacity: 0.05;
      transform: scale(1);
    }
    50% {
      opacity: 0.1;
      transform: scale(1.08);
    }
  }

  /* Динамическая задержка для карточек */
  <%
    @sponsors.each_with_index do |_, index|
      delay = index * 0.1
  %>
    .sponsors-card[data-index="<%= index %>"] {
      animation-delay: <%= 0.6 + delay %>s;
    }
  <%
    end
  %>
</style>
