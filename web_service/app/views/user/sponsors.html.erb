
<%= render 'shared/navbar' %>

<div class="min-h-screen bg-[#0D0D0D] text-white">
  <div class="container mx-auto px-4 py-12">
    
    <!-- Заголовок -->
    <header class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-amber-400 mb-4">
        <%= t('views.sponsors.index.title') %>
      </h1>
      <p class="text-gray-400 max-w-2xl mx-auto">
        <%= t('views.sponsors.index.welcome_message') %>
      </p>
    </header>

    <!-- Кнопка доната -->
    <% unless current_user&.is_sponsor %>
      <div class="text-center mb-12">
        <%= link_to donate_path, class: "inline-block px-6 py-3 bg-amber-500 text-[#1A1A1A] font-semibold rounded-lg hover:bg-amber-400 transition" do %>
          <%= t('views.sponsors.index.donate_button') %>
        <% end %>
      </div>
    <% end %>

    <!-- Поиск -->
    <section class="max-w-2xl mx-auto mb-12">
      <%= form_with url: sponsors_path, method: :get, local: true do %>
        <div class="relative">
          <input
            type="text"
            name="search"
            value="<%= params[:search] %>"
            placeholder="<%= t('views.sponsors.index.search_placeholder') %>"
            class="w-full px-4 py-3 bg-[#1A1A1A] border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-amber-500"
          >
          <button type="submit" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-amber-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
        </div>
      <% end %>
    </section>

    <!-- Список спонсоров -->
    <section>
      <% if @sponsors.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          <% @sponsors.each do |sponsor| %>
            <%= link_to "/players/#{sponsor['minecraft_nickname']}", class: "block bg-[#1A1A1A] border border-gray-700 rounded-lg p-5 hover:border-amber-500 transition" do %>
              <div class="flex items-center space-x-4">
                <div class="flex-shrink-0">
                  <img src="<%= sponsor['discord_avatar_url'] %>" 
                       alt="<%= sponsor['minecraft_nickname'] %>" 
                       class="w-12 h-12 rounded-full object-cover"
                       onerror="this.onerror=null;this.src='<%= asset_path('steve.webp') %>';">
                </div>
                <div>
                  <h3 class="font-semibold text-white"><%= sponsor['minecraft_nickname'] %></h3>
                  <p class="text-sm text-amber-400/80">@<%= sponsor['discord_username'] %></p>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-12">
          <p class="text-gray-500 mb-4"><%= t('views.sponsors.index.no_sponsors_message') %></p>
          <% if params[:search].present? %>
            <%= link_to t('views.sponsors.index.reset_search'), sponsors_path, class: "text-amber-500 hover:underline" %>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</div>

<%= render 'shared/footer' %>
