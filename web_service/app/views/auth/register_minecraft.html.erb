<div class="flex items-center justify-center min-h-screen bg-[#121212]">
  <div class="card bg-[#1A1A1A] shadow-xl rounded-lg w-[95%] max-w-[800px] mx-auto p-10 py-14">
		<%= link_to localized_root_path, class: "absolute text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-2 rounded-full transition ease-in-out duration-200" do %>
			<svg class="w-8 h-8 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
				<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12l4-4m-4 4 4 4"/>
			</svg>
		<% end %>

    <h2 class="text-3xl font-bold text-center mb-8 mt-16 text-gray-300"><%= t('pages.minecraft_registration.title') %></h2>

    <p class="text-base text-gray-400 mb-10 text-center">
      <%= t('pages.minecraft_registration.description') %>
    </p>

    <%= form_with model: @minecraft_account, 
              url: register_minecraft_path, 
              method: :post do |form| %>
      
      <div class="space-y-10">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        
        <div class="form-control">
          <%= form.label :nickname, t('pages.minecraft_registration.form.nickname_label'), class: "label-text text-xl text-gray-300 mb-4" %>
          <%= form.text_field :nickname, 
                            name: "minecraft_account[nickname]",
                            class: "input input-bordered w-full bg-[#2E2E2E] text-gray-300 px-5 py-6 text-lg",
                            placeholder: t('pages.minecraft_registration.form.nickname_placeholder') %>
          <div class="error-message text-error text-sm mt-2 hidden"></div>
        </div>

        <div class="form-control">
          <%= form.label :password, t('pages.minecraft_registration.form.password_label'), class: "label-text text-xl text-gray-300 mb-4" %>
          <div class="relative">
            <%= form.password_field :password,
                                  name: "minecraft_account[password]",
                                  class: "input input-bordered w-full bg-[#2E2E2E] text-gray-300 px-5 py-6 text-lg pr-16",
                                  placeholder: t('pages.minecraft_registration.form.password_placeholder'),
                                  id: "password" %>
            <button 
              type="button" 
              id="togglePassword" 
              class="absolute password-toggle text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-2 rounded-full transition ease-in-out duration-200"
              aria-label="<%= t('pages.minecraft_registration.buttons.show_password') %>"
            >
              <svg 
                class="w-6 h-6" 
                aria-hidden="true" 
                xmlns="http://www.w3.org/2000/svg" 
                width="24" 
                height="24" 
                fill="none" 
                viewBox="0 0 24 24"
              >
                <path 
                  stroke="currentColor" 
                  stroke-linecap="round" 
                  stroke-linejoin="round" 
                  stroke-width="2" 
                  d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                />
              </svg>
            </button>
          </div>
          <div class="error-message text-error text-sm mt-2 hidden"></div>
        </div>

        <div class="form-control">
          <%= form.label :password_confirmation, t('pages.minecraft_registration.form.password_confirmation_label'), class: "label-text text-xl text-gray-300 mb-4" %>
          <div class="relative">
            <%= form.password_field :password_confirmation,
                                  name: "minecraft_account[password_confirmation]",
                                  class: "input input-bordered w-full bg-[#2E2E2E] text-gray-300 px-5 py-6 text-lg pr-16",
                                  placeholder: t('pages.minecraft_registration.form.password_confirmation_placeholder'),
                                  id: "passwordConfirmation" %>
            <button 
              type="button" 
              id="togglePasswordConfirmation" 
              class="absolute password-toggle text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-2 rounded-full transition ease-in-out duration-200"
              aria-label="<%= t('pages.minecraft_registration.buttons.show_password') %>"
            >
              <svg 
                class="w-6 h-6" 
                aria-hidden="true" 
                xmlns="http://www.w3.org/2000/svg" 
                width="24" 
                height="24" 
                fill="none" 
                viewBox="0 0 24 24"
              >
                <path 
                  stroke="currentColor" 
                  stroke-linecap="round" 
                  stroke-linejoin="round" 
                  stroke-width="2" 
                  d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                />
              </svg>
            </button>
          </div>
          <div class="error-message text-error text-sm mt-2 hidden"></div>
        </div>
      </div>

      <%= form.submit t('pages.minecraft_registration.form.submit'), 
                     class: "btn btn-warning text-[#1A1A1A] w-full py-3 mt-14 text-lg flex items-center justify-center h-auto min-h-[3rem]" %>
    <% end %>
  </div>
</div>

<%= render 'shared/notification' %>

<script type="module">
  window.currentUserId = <%= raw session[:user_id].to_json %>;
</script>
<script type="module" src="/assets/channels/registration_channel.js"></script>

<script type="module">
  document.addEventListener("DOMContentLoaded", function () {
    var form = document.querySelector("form");
    if (!form) {
      return;
    }

    // Флаг предотвращения повторной отправки формы
    var isSubmitting = false;

    // Подписка на обновление регистрации через Action Cable
    window.addEventListener("registration:update", function (event) {
      var update = event.detail.response || event.detail;
      var status = update.status;
      var message = update.message;
      var redirectTo = update.redirectTo;
      var errors = update.errors;

      if (status === "success") {
        showNotification(message || "<%= j t('sessions.login_success') %>");
        setTimeout(function () {
          window.location.href = redirectTo || "/";
        }, 1500);
      } else {
        showAlertNotification(message || "<%= j t('sessions.login_failure') %>");
        if (errors) {
          showFormErrors(errors);
        }
        var submitButton = form.querySelector('input[type="submit"]');
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.value = "<%= j t('sessions.form.submit') %>";
        }
        isSubmitting = false;
      }
    });

    // Функция очистки ошибок в форме
    function clearErrors() {
      var errorMessages = form.querySelectorAll('.error-message');
      var inputs = form.querySelectorAll('input[type="text"], input[type="password"]');
      errorMessages.forEach(function (msg) {
        msg.classList.add("hidden");
        msg.textContent = "";
      });
      inputs.forEach(function (input) {
        input.classList.remove("input-error");
      });
    }

    // Функция преобразования camelCase в snake_case
    function camelToSnake(str) {
      return str.replace(/([A-Z])/g, '_$1').toLowerCase();
    }

    // Функция отображения ошибок под соответствующими полями формы
    function showFormErrors(errors) {
      clearErrors();
      for (var field in errors) {
        if (errors.hasOwnProperty(field)) {
          var messages = errors[field];
          var inputField = form.querySelector('input[name="minecraft_account[' + field + ']"]');
          if (!inputField) {
            var snakeField = camelToSnake(field);
            inputField = form.querySelector('input[name="minecraft_account[' + snakeField + ']"]');
          }
          if (inputField) {
            var errorContainer = inputField.closest(".form-control").querySelector(".error-message");
            if (errorContainer) {
              errorContainer.textContent = Array.isArray(messages)
                ? messages.join(", ")
                : messages;
              errorContainer.classList.remove("hidden");
              inputField.classList.add("input-error");
            }
          }
        }
      }
      showAlertNotification("<%= j t('sessions.login_failure') %>");
    }

    // Функция для переключения видимости пароля
    function setupPasswordToggle(toggleId, passwordId) {
      var toggle = document.getElementById(toggleId);
      var password = document.getElementById(passwordId);
      if (toggle && password) {
        toggle.addEventListener("click", function () {
          var currentType = password.getAttribute("type");
          var newType = currentType === "password" ? "text" : "password";
          password.setAttribute("type", newType);
          
          if (newType === "text") {
            toggle.innerHTML =
              '<svg class="w-6 h-6 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" d="M21 12c0 1.2-4.03 6-9 6s-9-4.8-9-6c0-1.2 4.03-6 9-6s9 4.8 9 6Z"/><path stroke="currentColor" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>';
          } else {
            toggle.innerHTML =
              '<svg class="w-6 h-6 text-gray-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>';
          }
        });
      }
    }

    setupPasswordToggle("togglePassword", "password");
    setupPasswordToggle("togglePasswordConfirmation", "passwordConfirmation");

    // Обработчик отправки формы через AJAX
    form.addEventListener("submit", function (event) {
      event.preventDefault();
      if (isSubmitting) {
        return;
      }
      isSubmitting = true;
      var submitButton = form.querySelector('input[type="submit"]');
      submitButton.disabled = true;
      submitButton.value = "<%= j t('sessions.form.submitting') %>";

      var nicknameInput = form.querySelector('input[name="minecraft_account[nickname]"]');
      var passwordInput = form.querySelector('input[name="minecraft_account[password]"]');
      var passwordConfirmationInput = form.querySelector('input[name="minecraft_account[password_confirmation]"]');

      var nickname = nicknameInput ? nicknameInput.value : "";
      var password = passwordInput ? passwordInput.value : "";
      var passwordConfirmation = passwordConfirmationInput ? passwordConfirmationInput.value : "";

      var payload = {
        minecraft_account: {
          nickname: nickname,
          password: password,
          password_confirmation: passwordConfirmation
        }
      };

      fetch(form.action, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('[name="csrf-token"]').content,
          "Accept": "application/json"
        },
        body: JSON.stringify(payload)
      })
        .then(function (response) {
          return response.json().then(function (data) {
            return { status: response.status, data: data };
          });
        })
        .then(function (responseObj) {
          var statusCode = responseObj.status;
          var data = responseObj.data;
          if ((statusCode === 200 || statusCode === 202) && data.status === "pending") {
            // Финальный результат придёт через Action Cable
          } else {
            showFormErrors(data.errors || {});
            submitButton.disabled = false;
            submitButton.value = "<%= j t('sessions.form.submit') %>";
            isSubmitting = false;
          }
        })
        .catch(function (error) {
          showAlertNotification(error.message);
          submitButton.disabled = false;
          submitButton.value = "<%= j t('sessions.form.submit') %>";
          isSubmitting = false;
        });
    });

    var sessionErrors = <%= raw(session[:errors].to_json) %>;
    if (sessionErrors) {
      showFormErrors(sessionErrors);
    }
  });
</script>
