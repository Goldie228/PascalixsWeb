<div class="flex items-center justify-center min-h-screen bg-[#121212]">
  <div class="card bg-[#1A1A1A] shadow-xl rounded-lg w-[95%] max-w-[800px] mx-auto p-10 py-14">
    <h2 class="text-3xl font-bold text-center text-amber-400 mb-6"><%= t('devise.two_factor_authentication.title') %></h2>
    
    <!-- Форма для ввода кода -->
    <div class="form-control mb-6">
      <p class="text-center text-gray-300 mb-4"><%= raw(t('devise.two_factor_authentication.enter_code_prompt', email: @user.email)) %></p>
      <%= form_tag verify_two_factor_authentication_path, method: :post do %>
        <div class="flex justify-center space-x-2 mb-4">
          <% 6.times do |i| %>
            <input type="text" name="otp_digit_<%= i %>" id="otp-digit-<%= i %>" maxlength="1" class="input input-bordered w-14 h-16 bg-[#2E2E2E] text-gray-300 text-center text-lg rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-400" autocomplete="off" />
          <% end %>
        </div>
        <%= hidden_field_tag :otp_attempt, nil, id: "otp-attempt" %>

        <!-- Время действия кода -->
        <div class="text-center text-amber-400 mb-6" id="timer-container">
          <span id="otp-timer">0:00</span>
          <%= hidden_field_tag :otp_valid_until, @otp_valid_until.to_i * 1000, id: "otp-valid-until" %>
        </div>
        
        <div class="mt-4">
          <%= submit_tag t('devise.two_factor_authentication.verify_button'), class: "btn btn-warning text-[#1A1A1A] w-full py-3 text-lg flex items-center justify-center h-auto min-h-[3rem]" %>
        </div>
      <% end %>
    </div>

    <div class="flex w-full flex-col mt-2 mb-6">
      <div class="divider text-[#4A4A4A] before:bg-current after:bg-current"><%= t('sessions.divider_text') %></div>
    </div>

    <!-- Настройка 2FA с QR-кодом -->
    <div class="bg-[#2E2E2E] rounded-lg p-4 form-control mb-6">
      <p class="text-gray-300 mb-4 text-center"><%= raw(t('devise.two_factor_authentication.authenticator_prompt')) %></p>
      <div class="flex justify-center bg-white rounded-lg p-4 mx-auto qr-code-container">
        <%= raw @qr_code_url %>
      </div>
      <div class="pt-4 pb-2 rounded-lg flex items-center justify-center">
        <img src="https://play-lh.googleusercontent.com/NntMALIH4odanPPYSqUOXsX8zy_giiK2olJiqkcxwFIOOspVrhMi9Miv6LYdRnKIg-3R=w240-h480" alt="Google Authenticator" class="h-8 w-8 mr-2 skeleton">
        <p class="text-gray-300 mtext-center">
          <a href="https://support.google.com/accounts/answer/1066447?hl=ru&ref_topic=2954345&sjid=17517162980025931434-EU" target="_blank" rel="noopener noreferrer" class="underline"><%= raw(t('devise.two_factor_authentication.instruction_link')) %></a>
        </p>
      </div>
    </div>
    
    <!-- Кнопка повторной отправки кода -->
    <div class="text-center mb-6 text-gray-400 hidden" id="resend-button-container">
      <%= form_with url: resend_two_factor_code_path, method: :post, local: true do %>
        <%= submit_tag t('devise.two_factor_authentication.resend_code'), class: "link link-hover text-amber-400 hover:text-amber-500" %>
      <% end %>
    </div>
  </div>
</div>

<%= render 'shared/notification' %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const otpTimer = document.getElementById('otp-timer');
    const otpValidUntilInput = document.getElementById('otp-valid-until');
    const resendButtonContainer = document.getElementById('resend-button-container');
    
    if (otpTimer && otpValidUntilInput && resendButtonContainer) {
      let endTime = parseInt(otpValidUntilInput.value);
      const storedEndTime = localStorage.getItem('otpEndTime');
      const previousEndTime = localStorage.getItem('previousOtpEndTime');
      
      if (storedEndTime) {
        const storedTime = parseInt(storedEndTime);
        if (endTime > storedTime) {
          localStorage.setItem('otpEndTime', endTime);
          localStorage.setItem('previousOtpEndTime', endTime);
        } else {
          endTime = storedTime;
        }
      } else {
        localStorage.setItem('otpEndTime', endTime);
        localStorage.setItem('previousOtpEndTime', endTime);
      }

      const updateTimer = () => {
        const now = Date.now();
        const diff = endTime - now;
        if (diff <= 0) {
          otpTimer.textContent = '0:00';
          otpTimer.style.display = 'none';
          resendButtonContainer.classList.remove('hidden');
          localStorage.removeItem('otpEndTime');
          return;
        }
        const minutes = Math.floor(diff / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        otpTimer.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
        otpTimer.classList.remove('hidden');
      };
      
      updateTimer();
      setInterval(updateTimer, 1000);
    }

    const inputs = document.querySelectorAll("input[name^='otp_digit_']");
    const hiddenInput = document.getElementById('otp-attempt');
    
    if (inputs.length > 0 && hiddenInput) {
      inputs.forEach((input, index) => {
        input.addEventListener('input', (e) => {
          const value = e.target.value;
          if (!/^[\d]*$/.test(value)) {
            e.target.value = value.replace(/\D/g, '');
          }
          if (e.target.value.length === 1 && index < inputs.length - 1) {
            inputs[index + 1].focus();
          }
          updateHiddenInput();
        });
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && e.target.value === '' && index > 0) {
            inputs[index - 1].focus();
          }
          updateHiddenInput();
        });
        input.addEventListener('paste', (e) => {
          const pastedData = e.clipboardData.getData('text/plain').replace(/\s/g, '');
          if (pastedData.length === inputs.length) {
            pastedData.split('').forEach((char, i) => {
              if (inputs[i]) inputs[i].value = char;
            });
            if (inputs[inputs.length - 1]) inputs[inputs.length - 1].focus();
            updateHiddenInput();
          }
          e.preventDefault();
        });
      });

      function updateHiddenInput() {
        if (hiddenInput) {
          const code = Array.from(inputs).map(input => input.value).join('');
          hiddenInput.value = code;
        }
      }
    }

    inputs.forEach((input, index) => {
      input.addEventListener('keydown', (e) => {
        if (e.keyCode === 37 && index > 0) {  // Левая стрелка
          const prevInput = inputs[index - 1];
          prevInput.focus();
          requestAnimationFrame(() => {
            if (prevInput.value.length > 0) {
              prevInput.setSelectionRange(prevInput.value.length, prevInput.value.length);
            } else {
              prevInput.setSelectionRange(0, 0);
            }
          });
        } else if (e.keyCode === 39 && index < inputs.length - 1) {  // Правая стрелка
          const nextInput = inputs[index + 1];
          nextInput.focus();
          requestAnimationFrame(() => {
            nextInput.setSelectionRange(nextInput.value.length, nextInput.value.length);
          });
        }
      });
    });
  });
</script>
