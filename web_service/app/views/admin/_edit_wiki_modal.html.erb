<!--
  _edit_wiki_modal.html.erb
  Модальное окно для редактирования существующей Wiki страницы.
  Загружает данные страницы по slug и позволяет изменить все поля.
-->
<dialog id="editWikiPageModal" class="modal"
        data-service-url="<%= ENV['AUTH_SERVICE_URL'] %>" 
        data-api-key="<%= ENV['INTER_SERVICE_API_KEY'] %>"
        data-user-id="<%= current_user.id %>">
  <div class="modal-box w-full max-w-7xl bg-[#1A1A1A] border border-amber-400 p-0 rounded overflow-hidden flex flex-col max-h-[90vh] shadow-2xl transition-all duration-300 ease-in-out">
       
    <!-- Шапка -->
    <div class="p-6 border-b border-gray-700 flex justify-between items-center bg-[#1A1A1A] shrink-0">
      <h3 class="text-2xl text-amber-400 font-bold">Редактировать Wiki страницу</h3>
      <button type="button" class="text-gray-400 hover:text-white transition" onclick="closeEditWikiPageModal()">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Скроллируемая область контента -->
    <div class="flex-1 overflow-y-auto p-6 bg-[#1A1A1A] relative">
      <!-- Индикатор загрузки -->
      <div id="editPageLoading" class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center z-20 hidden">
        <div class="flex flex-col items-center">
          <div class="w-16 h-16 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
          <span class="mt-4 text-amber-400 text-lg">Загрузка данных страницы...</span>
        </div>
      </div>
      
      <form id="editWikiPageForm" class="space-y-6 flex flex-col h-full">
        <!-- Скрытый input для ID страницы -->
        <input type="hidden" id="wikiPageId" name="id" value="">
        <div id="editPageContainer">
          <%= render 'wiki_editor', mode: 'edit' %>
        </div>
      </form>
    </div>

    <!-- Футер -->
    <div class="p-6 border-t border-gray-700 bg-[#1A1A1A] flex justify-end space-x-3 shrink-0">
      <button type="button" class="px-6 py-2 text-gray-300 bg-[#262626] border border-gray-600 rounded-lg hover:bg-[#2E2E2E] hover:text-white transition" onclick="closeEditWikiPageModal()">
        Отмена
      </button>
      <button type="button" id="updatePageBtn" class="px-6 py-2 text-black bg-amber-400 border border-amber-400 rounded-lg hover:bg-amber-300 hover:border-amber-300 font-medium transition min-w-[120px]" onclick="submitWikiPageForm('edit')">
        Сохранить изменения
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<script>
// Флаг для предотвращения повторного открытия
let editModalOpening = false;

// Открытие модального окна редактирования
async function openEditWikiPageModal(slug) {
  if (!slug || editModalOpening) return;
  
  const modal = document.getElementById('editWikiPageModal');
  const loadingIndicator = document.getElementById('editPageLoading');
  
  if (!modal) {
    console.error('[EditWikiModal] Модальное окно editWikiPageModal не найдено');
    return;
  }
  
  editModalOpening = true;
  
  try {
    // Уничтожаем существующий экземпляр редактора
    if (window.wikiEditorInstances && window.wikiEditorInstances['editWikiPageModal']) {
      window.wikiEditorInstances['editWikiPageModal'].toTextArea();
      delete window.wikiEditorInstances['editWikiPageModal'];
    }
    
    // Сброс состояния позиций
    if (window.WikiEditorPosition && typeof WikiEditorPosition.reset === 'function') {
      WikiEditorPosition.reset();
    }
    
    // Показываем модальное окно СНАЧАЛА
    modal.showModal();
    
    // Показываем индикатор загрузки
    if (loadingIndicator) loadingIndicator.classList.remove('hidden');
    
    // Ждём рендеринга
    await new Promise(resolve => requestAnimationFrame(resolve));
    await new Promise(resolve => setTimeout(resolve, 100));
    
    // Сбрасываем форму
    const form = document.getElementById('editWikiPageForm');
    if (form) form.reset();
    
    // Сбрасываем флаг валидации slug
    window.isSlugValid = true;
    
    // Загружаем данные страницы
    await loadWikiPageData(slug);
    
    // Загружаем категории (это также загружает превью позиций)
    if (window.WikiEditorCategory && typeof WikiEditorCategory.loadCategories === 'function') {
      await WikiEditorCategory.loadCategories('editWikiPageModal');
    }
    
    // Инициализируем редактор
    if (window.WikiEditorContent && typeof WikiEditorContent.initEditor === 'function') {
      WikiEditorContent.initEditor('editWikiPageModal', 'edit');
      
      // Привязываем кнопки предпросмотра для editWikiPageModal
      const editModal = document.getElementById('editWikiPageModal');
      const previewModeBtn = editModal?.querySelector('#previewModeBtn');
      const editModeBtn = editModal?.querySelector('#editModeBtn');
      
      if (previewModeBtn && !previewModeBtn.dataset.bound) {
        previewModeBtn.dataset.bound = "true";
        previewModeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          WikiEditorContent.togglePreviewMode('editWikiPageModal');
        });
      }
      
      if (editModeBtn && !editModeBtn.dataset.bound) {
        editModeBtn.dataset.bound = "true";
        editModeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          WikiEditorContent.togglePreviewMode('editWikiPageModal');
        });
      }
    }
    
  } catch (error) {
    console.error('[EditWikiModal] Error:', error);
    if (typeof showAlertNotification === 'function') {
      showAlertNotification('Ошибка при загрузке данных страницы');
    }
    modal.close();
  } finally {
    if (loadingIndicator) loadingIndicator.classList.add('hidden');
    editModalOpening = false;
  }
}

// Загрузка данных страницы
async function loadWikiPageData(slug) {
  const config = typeof getWikiAuthConfig === 'function' 
    ? getWikiAuthConfig('editWikiPageModal')
    : { serviceUrl: '', apiKey: '', userId: '' };
  
  if (!config.serviceUrl || !config.apiKey || !config.userId) {
    throw new Error('Отсутствуют параметры конфигурации');
  }
  
  const baseUrl = config.serviceUrl.replace(/\/$/, '');
  const url = `${baseUrl}/api/v1/wiki/pages/${encodeURIComponent(slug)}`;
  
  console.log('[loadWikiPageData] Загрузка:', url);
  
  const response = await fetch(url, {
    method: 'GET',
    headers: {
      'X-User-ID': config.userId,
      'Authorization': `Bearer ${config.apiKey}`
    },
    credentials: 'include'
  });

  if (!response.ok) {
    throw new Error(`HTTP ${response.status}`);
  }

  const pageData = await response.json();
  console.log('[loadWikiPageData] Данные:', pageData);
  
  // Получаем модальное окно
  const editModal = document.getElementById('editWikiPageModal');
  
  // Вспомогательная функция
  const setVal = (id, val, prop = 'value') => {
    const el = editModal?.querySelector('#' + id) || document.getElementById(id);
    if (el) {
      if (prop === 'checked') el.checked = Boolean(val);
      else el[prop] = val;
      return true;
    }
    return false;
  };
  
  // Заполняем форму
  setVal('wikiPageTitle', pageData.title || '');
  setVal('wikiPageSlug', pageData.slug || '');
  
  // Сохраняем оригинальный slug
  const slugInput = editModal?.querySelector('#wikiPageSlug');
  if (slugInput) {
    slugInput.dataset.originalSlug = pageData.slug || '';
  }
  
  setVal('wikiPageContent', pageData.content || '');
  setVal('wikiPagePosition', pageData.position || 0);
  setVal('wikiPagePublished', pageData.published || false, 'checked');
  
  // ID страницы - ВАЖНО: устанавливаем ДО загрузки категорий
  setVal('wikiPageId', pageData.id);
  
  // Сохраняем ID страницы и заголовок для превью позиций
  if (window.WikiEditorPosition) {
    WikiEditorPosition.currentPageId = pageData.id;
    WikiEditorPosition.currentTitle = pageData.title || '';
    console.log('[loadWikiPageData] Set WikiEditorPosition.currentPageId:', pageData.id);
  }
  
  // Категория
  const catSelect = editModal?.querySelector('#wikiPageCategory');
  if (catSelect && pageData.wiki_category_id) {
    catSelect.value = pageData.wiki_category_id;
    if (window.WikiEditorCategory?.updateCategoryPath) {
      WikiEditorCategory.updateCategoryPath(pageData.wiki_category_id);
    }
  }
  
  // ID страницы (не критично если отсутствует - берём из pageData)
  setVal('wikiPageId', pageData.id);
  
  // Изображения
  if (pageData.images?.length > 0) {
    const tempIdsEl = editModal?.querySelector('#wikiPageTempImageIds');
    if (tempIdsEl) {
      tempIdsEl.value = JSON.stringify(pageData.images.map(img => img.signed_id));
    }
  }
  
  // Slug валиден при редактировании
  window.isSlugValid = true;
  
  // Галочка валидации
  const slugValidation = editModal?.querySelector('#slugValidation');
  if (slugValidation) {
    slugValidation.innerHTML = '<svg class="h-4 w-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
  }
  
  // Включаем кнопку сохранения
  const updateBtn = document.getElementById('updatePageBtn');
  if (updateBtn) updateBtn.disabled = false;
  
  console.log('[loadWikiPageData] Готово');
}

function closeEditWikiPageModal() {
  const modal = document.getElementById('editWikiPageModal');
  if (modal) {
    if (window.wikiEditorInstances?.['editWikiPageModal']) {
      window.wikiEditorInstances['editWikiPageModal'].toTextArea();
      delete window.wikiEditorInstances['editWikiPageModal'];
    }
    modal.close();
  }
}
</script>
