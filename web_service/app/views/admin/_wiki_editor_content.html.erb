      { name: "upload-action", action: (ed) => container.querySelector('#wikiPageFileInput').click(), className: "fa fa-upload", title: "Загрузить файл/картинку" }
    ],
    imageUploadFunction: (file, onSuccess, onError) => {
      WikiEditorContent.uploadCustomFile(file, onSuccess, onError, containerId);
    }
  });
  
  window.wikiEditorInstances[containerId] = easyMDEInstance;
  
  // Обработчик выбора файла
  const fileInput = container.querySelector('#wikiPageFileInput');
  if (fileInput) {
    fileInput.addEventListener('change', function(e) {
      if (this.files && this.files.length > 0) {
        WikiEditorContent.uploadCustomFile(this.files[0], null, null, containerId);
        this.value = ''; 
      }
    });
  }
  
  // Обработчик F11
  container.addEventListener('keydown', function(e) {
    if (e.key === 'F11') {
      e.preventDefault();
      WikiEditorContent.toggleModalFullscreen(containerId);
      return false;
    }
  });
  
  return easyMDEInstance;
};

/**
 * Переключение между режимами редактирования и предпросмотра
 * @param {string} containerId - ID контейнера редактора
 * @returns {Promise<void>}
 */
WikiEditorContent.togglePreviewMode = async function(containerId) {
  const container = document.getElementById(containerId);
  if (!container) return;

  const editorInstance = window.wikiEditorInstances[containerId];
  if (!editorInstance) return;

  const editorWrapper = container.querySelector('#editorWrapper');
  const cmWrapper = editorInstance.codemirror.getWrapperElement();
  const toolbar = editorWrapper.querySelector('.editor-toolbar');
  const previewPaneContainer = container.querySelector('#previewPaneContainer');
  const previewPane = container.querySelector('#previewPane');
  const previewModeBtn = container.querySelector('#previewModeBtn');
  const editModeBtn = container.querySelector('#editModeBtn');
  const previewFullscreenBtn = container.querySelector('#previewFullscreenBtn');

  const isPreviewMode = editorWrapper.classList.contains('preview-mode');
  const statusbar = editorWrapper.querySelector('.editor-statusbar');
  const editorWrapperInner = editorWrapper.querySelector('.editor-wrapper');

  if (isPreviewMode) {
    editorWrapper.classList.remove('preview-mode');
    if (cmWrapper) cmWrapper.style.display = '';
    if (toolbar) toolbar.style.display = '';
    if (statusbar) statusbar.style.display = '';
    if (previewPaneContainer) {
      previewPaneContainer.style.display = 'none';
    }
    if (previewPane) {
      previewPane.classList.remove('visible');
    }
    // Возвращаем статус-бар обратно в editor-wrapper
    if (statusbar && editorWrapperInner) {
      editorWrapperInner.appendChild(statusbar);
    }
    if (previewModeBtn) previewModeBtn.style.display = '';
    if (editModeBtn) editModeBtn.style.display = 'none';
  } else {
    editorWrapper.classList.add('preview-mode');
    if (cmWrapper) cmWrapper.style.display = 'none';
    if (toolbar) toolbar.style.display = 'none';
    if (statusbar) statusbar.style.display = 'block';
    
    const content = editorInstance.value();
    const rendered = await WikiEditorContent.renderMarkdown(content);
    
    if (previewPane) {
      previewPane.innerHTML = rendered;
      previewPane.classList.add('visible');
      WikiEditorContent.initTabs(previewPane);
    }
    if (previewPaneContainer) {
      previewPaneContainer.style.display = 'block';
    }
    
    // Перемещаем статус-бар в конец editorWrapper (после previewPaneContainer)
    if (statusbar && editorWrapper) {
      editorWrapper.appendChild(statusbar);
    }
    
    if (previewModeBtn) previewModeBtn.style.display = 'none';
    if (editModeBtn) editModeBtn.style.display = '';
  }

  setTimeout(() => editorInstance.codemirror.refresh(), 100);
};

/**
 * Инициализация обработчиков вкладок в предпросмотре
 * @param {HTMLElement} container - Контейнер с вкладками
 */
WikiEditorContent.initTabs = function(container) {
  if (!container) return;
  
  const tabContainers = container.querySelectorAll('.wiki-tabs-container');
  tabContainers.forEach(tabContainer => {
    const tabButtons = tabContainer.querySelectorAll('.wiki-tab-button');
    
    tabButtons.forEach(button => {
      const newButton = button.cloneNode(true);
      button.parentNode.replaceChild(newButton, button);
      
      newButton.addEventListener('click', function(e) {
        e.preventDefault();
        const tabIndex = this.getAttribute('data-tab-index');
        
        tabContainer.querySelectorAll('.wiki-tab-button').forEach(btn => {
          btn.classList.remove('wiki-tab-active');
          btn.setAttribute('aria-selected', 'false');
        });
        tabContainer.querySelectorAll('.wiki-tab-content').forEach(content => {
          content.classList.remove('wiki-tab-active');
          content.style.display = 'none';
        });
        
        this.classList.add('wiki-tab-active');
        this.setAttribute('aria-selected', 'true');
        
        const activeContent = tabContainer.querySelector(`.wiki-tab-content[data-content-index="${tabIndex}"]`);
        if (activeContent) {
          activeContent.classList.add('wiki-tab-active');
          activeContent.style.display = 'block';
        }
      });
    });
  });
};

/**
 * Переключение полноэкранного режима модального окна
 * @param {string} containerId - ID контейнера или модального окна
 */
WikiEditorContent.toggleModalFullscreen = function(containerId) {
  const container = document.getElementById(containerId);
  if (!container) return;

  // container может быть как самим диалогом, так и элементом внутри него
  const modalDialog = container.tagName === 'DIALOG' ? container : (container.closest('dialog') || container.closest('.modal'));
  if (!modalDialog) return;

  const isFullscreen = modalDialog.classList.contains('modal-fullscreen');
  
  const fullscreenBtn = modalDialog.querySelector('#fullscreenBtn');
  
  if (isFullscreen) {
    modalDialog.classList.remove('modal-fullscreen');
    // Обновляем кнопку полного экрана
    if (fullscreenBtn) {
      const icon = fullscreenBtn.querySelector('i');
      if (icon) {
        icon.classList.remove('fa-compress');
        icon.classList.add('fa-expand');
      }
      fullscreenBtn.title = 'Полный экран (F11)';
    }
  } else {
    modalDialog.classList.add('modal-fullscreen');
    // Обновляем кнопку полного экрана
    if (fullscreenBtn) {
      const icon = fullscreenBtn.querySelector('i');
      if (icon) {
        icon.classList.remove('fa-expand');
        icon.classList.add('fa-compress');
      }
      fullscreenBtn.title = 'Выйти из полноэкранного режима';
    }
    
    const escapeHandler = (e) => {
      if (e.key === 'Escape') {
        WikiEditorContent.toggleModalFullscreen(containerId);
        document.removeEventListener('keydown', escapeHandler);
      }
    };
    document.addEventListener('keydown', escapeHandler);
  }

  setTimeout(() => window.wikiEditorInstances[containerId]?.codemirror.refresh(), 300);
};

/**
 * Обёртывает выделенный текст префиксом и суффиксом
 * @param {Object} editor - Экземпляр EasyMDE редактора
 * @param {string} prefix - Текст перед выделением
 * @param {string} suffix - Текст после выделения
 */
WikiEditorContent.wrapSelection = function(editor, prefix, suffix) {
  const cm = editor.codemirror;
  const text = cm.getSelection() || "";
  cm.replaceSelection(prefix + text + suffix);
  if (text === "") {
    const curPos = cm.getCursor();
    cm.setCursor(curPos.line, curPos.ch - suffix.length);
  }
  cm.focus();
};

/**
 * Вставляет блок уведомления (alert) в редактор
 * @param {Object} editor - Экземпляр EasyMDE редактора
 * @param {string} type - Тип уведомления: 'info', 'warning', 'danger', 'success'
 */
WikiEditorContent.insertAlertBlock = function(editor, type) {
  const cm = editor.codemirror;
  const text = cm.getSelection() || "";
  const template = `:::${type}\n${text || 'Текст уведомления'}\n:::`;
  cm.replaceSelection(template);
  cm.focus();
};

/**
 * Вставляет шаблон Mermaid-диаграммы в редактор
 * @param {Object} editor - Экземпляр EasyMDE редактора
 */
WikiEditorContent.insertDiagram = function(editor) {
  const cm = editor.codemirror;
  const template = "```mermaid\ngraph TD\n    A[Start] --> B{Is it working?}\n    B -- Yes --> C[Great!]\n    B -- No --> D[Fix it]\n```";
  cm.replaceSelection(template);
  cm.focus();
};

/**
 * Вставляет маркер оглавления [[toc]] в редактор
 * @param {Object} editor - Экземпляр EasyMDE редактора
 */
WikiEditorContent.insertTOC = function(editor) {
  editor.codemirror.replaceSelection("[[toc]]");
  editor.codemirror.focus();
};

/**
 * Вставляет шаблон вкладок в редактор
 * @param {Object} editor - Экземпляр EasyMDE редактора
 */
WikiEditorContent.insertTabs = function(editor) {
  const cm = editor.codemirror;
  const template = `::: tabs\n==Tab 1==\nContent of first tab\n==Tab 2==\nContent of second tab\n:::`;
  cm.replaceSelection(template);
  cm.focus();
};

/**
 * Вставляет шаблон спойлера (details/summary) в редактор
 * @param {Object} editor - Экземпляр EasyMDE редактора
 */
WikiEditorContent.insertSpoiler = function(editor) {
  const cm = editor.codemirror;
  const template = `<details>\n<summary>Spoiler title</summary>\n\nHidden content here\n\n</details>`;
  cm.replaceSelection(template);
  cm.focus();
};

/**
 * Вставляет заголовок указанного уровня в редактор
 * @param {Object} editor - Экземпляр EasyMDE редактора
 * @param {number} level - Уровень заголовка (1-6)
 */
WikiEditorContent.insertHeading = function(editor, level) {
  const cm = editor.codemirror;
  const selection = cm.getSelection();
  const prefix = '#'.repeat(level) + ' ';
  
  if (selection) {
    // Если есть выделение, заменяем его
    cm.replaceSelection(prefix + selection);
  } else {
    // Если выделения нет, вставляем в начало текущей строки
    const cursor = cm.getCursor();
    const lineContent = cm.getLine(cursor.line);
    const trimmedLine = lineContent.trim();
    
    // Проверяем, есть ли уже заголовок на этой строке
    const headingMatch = trimmedLine.match(/^(#{1,6})\s+(.*)$/);
    
    if (headingMatch) {
      // Заменяем существующий заголовок
      const newContent = prefix + headingMatch[2];
      cm.replaceRange(newContent, { line: cursor.line, ch: 0 }, { line: cursor.line, ch: lineContent.length });
    } else if (trimmedLine === '') {
      // Пустая строка - вставляем шаблон
      cm.replaceRange(prefix + 'Заголовок ' + level + ' уровня', { line: cursor.line, ch: 0 });
      cm.setCursor({ line: cursor.line, ch: (prefix + 'Заголовок ' + level + ' уровня').length });
    } else {
      // Есть текст - превращаем в заголовок
      cm.replaceRange(prefix + lineContent, { line: cursor.line, ch: 0 }, { line: cursor.line, ch: lineContent.length });
    }
  }
  cm.focus();
};


/**
 * Вставляет горизонтальную линию (---) в редактор
 * @param {Object} editor - Экземпляр EasyMDE редактора
 */
WikiEditorContent.insertHorizontalRule = function(editor) {
  const cm = editor.codemirror;
  const cursor = cm.getCursor();
  const lineContent = cm.getLine(cursor.line);
  
  // Если строка пустая, заменяем её на разделитель
  if (lineContent.trim() === '') {
    cm.replaceRange('\n---\n', { line: cursor.line, ch: 0 }, { line: cursor.line, ch: lineContent.length });
  } else {
    // Иначе вставляем на новой строке
    cm.replaceRange('\n\n---\n', cursor);
  }
  cm.focus();
};

/**
 * Загрузка файла на сервер
 * @param {File} file - Файл для загрузки
 * @param {Function} [onSuccess] - Callback при успешной загрузке, получает URL файла
 * @param {Function} [onError] - Callback при ошибке, получает сообщение об ошибке
 * @param {string} [containerId] - ID контейнера редактора для определения конфигурации
 * @returns {Promise<void>}
 */
WikiEditorContent.uploadCustomFile = async function(file, onSuccess, onError, containerId) {
  // Определяем containerId если не передан
  if (!containerId) {
    const activeEditor = document.querySelector('.wiki-editor-container:focus-within');
    if (activeEditor) {
      containerId = activeEditor.id || 
        (activeEditor.querySelector('#wikiPageId') ? 'editWikiPageModal' : 'addWikiPageModal');
    } else {
      containerId = document.getElementById('wikiPageId') ? 'editWikiPageModal' : 'addWikiPageModal';
    }
  }
  
  // ИСПРАВЛЕНО: Получаем конфигурацию через унифицированную функцию
  const config = typeof getWikiAuthConfig === 'function' 
    ? getWikiAuthConfig(containerId)
    : { serviceUrl: '', apiKey: '', userId: '' };

  const authServiceUrl = config.serviceUrl;
  const apiKey = config.apiKey;
  const userId = config.userId;

  // Проверка обязательных параметров
  if (!authServiceUrl) {
    const errorMsg = 'URL сервиса авторизации не настроен (AUTH_SERVICE_URL)';
    console.error('[Upload]', errorMsg);
    if (onError) onError(errorMsg);
    else WikiEditorContent.showNotification(errorMsg, 'error');
    return;
  }

  if (!apiKey) {
    const errorMsg = 'API ключ не настроен (INTER_SERVICE_API_KEY)';
    console.error('[Upload]', errorMsg);
    if (onError) onError(errorMsg);
    else WikiEditorContent.showNotification(errorMsg, 'error');
    return;
  }

  if (!userId) {
    const errorMsg = 'ID пользователя не определён';
    console.error('[Upload]', errorMsg);
    if (onError) onError(errorMsg);
    else WikiEditorContent.showNotification(errorMsg, 'error');
    return;
  }

  console.log('[Upload] Начало загрузки файла:', {
    fileName: file.name,
    fileSize: file.size,
    fileType: file.type,
    serviceUrl: authServiceUrl,
    userId: userId
  });

  const formData = new FormData();
  formData.append('file', file);

  WikiEditorContent.showNotification('Загрузка файла...', 'info');
  
  // Формирование URL с проверкой слешей
  const baseUrl = authServiceUrl.endsWith('/') ? authServiceUrl.slice(0, -1) : authServiceUrl;
  const url = `${baseUrl}/api/v1/wiki/pages/upload_temporary_image`;
  
  console.log('[Upload] URL:', url);

  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: { 
        'X-User-ID': userId, 
        'Authorization': `Bearer ${apiKey}` 
      },
      body: formData
    });

    console.log('[Upload] Response status:', response.status);

    if (!response.ok) {
      let errorMessage = `Ошибка сервера: ${response.status}`;
      
      try {
        const errData = await response.json();
        console.error('[Upload] Error response:', errData);
        
        if (errData.error) {
          errorMessage = errData.error;
        } else if (errData.message) {
          errorMessage = errData.message;
        } else if (errData.errors) {
          if (Array.isArray(errData.errors)) {
            errorMessage = errData.errors.join(', ');
          } else if (typeof errData.errors === 'object') {
            errorMessage = Object.values(errData.errors).flat().join(', ');
          }
        }
      } catch (parseError) {
        const textResponse = await response.text().catch(() => '');
        console.error('[Upload] Non-JSON error response:', textResponse);
        
        if (response.status === 401) {
          errorMessage = 'Ошибка авторизации. Проверьте API ключ.';
        } else if (response.status === 403) {
          errorMessage = 'Доступ запрещён. Проверьте права пользователя.';
        } else if (response.status === 404) {
          errorMessage = 'Endpoint не найден. Проверьте URL сервиса.';
        } else if (response.status === 413) {
          errorMessage = 'Файл слишком большой.';
        } else if (response.status >= 500) {
          errorMessage = `Ошибка сервера (${response.status}). Попробуйте позже.`;
        } else if (textResponse) {
          errorMessage = textResponse.substring(0, 200);
        }
      }
      
      throw new Error(errorMessage);
    }

    const data = await response.json();
    console.log('[Upload] Success response:', data);

    // Сохраняем signed_id
    const container = document.getElementById(containerId);
    if (data.signed_id && container) {
      const tempImageIdsElement = container.querySelector('#wikiPageTempImageIds');
      if (tempImageIdsElement) {
        let ids = JSON.parse(tempImageIdsElement.value || '[]');
        ids.push(data.signed_id);
        tempImageIdsElement.value = JSON.stringify(ids);
      }
    }

    // Вставляем ссылку в редактор
    const editorInstance = window.wikiEditorInstances[containerId];
    if (data.url) {
      if (onSuccess) onSuccess(data.url);
      else if (editorInstance) {
        const cm = editorInstance.codemirror;
        const insertText = data.type === 'image' 
          ? `![${data.filename || file.name}](${data.url})\n` 
          : `<div class="file-download-block"><div class="file-info"><div class="file-icon">${(data.filename || file.name).split('.').pop().toUpperCase()}</div><div class="file-details"><div class="file-name">${data.filename || file.name}</div></div></div><a href="${data.url}" class="download-button" download="${data.filename || file.name}"><i class="fa fa-download"></i> Скачать</a></div>\n`;
        cm.replaceRange(insertText, cm.getCursor());
        cm.focus();
      }
    }
    
    WikiEditorContent.showNotification('Файл успешно загружен', 'success');
    
  } catch (error) {
    console.error('[Upload] Error:', error);
    
    let errorMessage = 'Ошибка загрузки';
    
    if (error.name === 'TypeError' && error.message.includes('fetch')) {
      errorMessage = 'Сетевая ошибка. Проверьте подключение и CORS настройки.';
    } else if (error.message) {
      errorMessage = error.message;
    }
    
    if (onError) onError(errorMessage);
    else WikiEditorContent.showNotification('Ошибка загрузки: ' + errorMessage, 'error');
  }
};

/**
 * Инициализация редактора при загрузке страницы
 * Создаёт экземпляр редактора для модального окна добавления новой страницы
 * @param {number} [attempts=0] - Счётчик попыток инициализации (для повторных попыток)
 */
WikiEditorContent.setup = function(attempts = 0) {
  // Предотвращаем повторный вызов setup
  if (WikiEditorContent.setupCalled) return;
  
  // Инициализируем только модальное окно добавления
  const addModal = document.getElementById('addWikiPageModal');
  if (!addModal) {
    if (attempts < 10) setTimeout(() => WikiEditorContent.setup(attempts + 1), 100);
    return;
  }

  const editorContainer = addModal.querySelector('.wiki-editor-container');
  if (!editorContainer) {
    if (attempts < 10) setTimeout(() => WikiEditorContent.setup(attempts + 1), 100);
    return;
  }

  // Помечаем что setup был вызван
  WikiEditorContent.setupCalled = true;
  
  const mode = editorContainer.getAttribute('data-mode');
  
  // Инициализируем только для режима create (модальное окно добавления)
  if (mode === 'create' && !window.wikiEditorInstances['addWikiPageModal']) {
    WikiEditorContent.initEditor('addWikiPageModal', 'create');
  }

  const previewModeBtn = addModal.querySelector('#previewModeBtn');
  const editModeBtn = addModal.querySelector('#editModeBtn');
  
  if (previewModeBtn && !previewModeBtn.dataset.bound) {
    previewModeBtn.dataset.bound = "true";
    previewModeBtn.addEventListener('click', (e) => { e.preventDefault(); WikiEditorContent.togglePreviewMode('addWikiPageModal'); });
  }
  
  if (editModeBtn && !editModeBtn.dataset.bound) {
    editModeBtn.dataset.bound = "true";
    editModeBtn.addEventListener('click', (e) => { e.preventDefault(); WikiEditorContent.togglePreviewMode('addWikiPageModal'); });
  }
};

// Вызываем setup только один раз при загрузке
WikiEditorContent.setup();

// Делегирование событий для вкладок на document
document.addEventListener('click', function(e) {
  const tabButton = e.target.closest('.wiki-tab-button');
  if (!tabButton) return;
  
  e.preventDefault();
  e.stopPropagation();
  
  const tabContainer = tabButton.closest('.wiki-tabs-container');
  if (!tabContainer) return;
  
  const tabIndex = tabButton.getAttribute('data-tab-index');
  if (tabIndex === null) return;
  
  tabContainer.querySelectorAll('.wiki-tab-button').forEach(btn => {
    btn.classList.remove('wiki-tab-active');
    btn.setAttribute('aria-selected', 'false');
  });
  tabContainer.querySelectorAll('.wiki-tab-content').forEach(content => {
    content.classList.remove('wiki-tab-active');
    content.style.display = 'none';
  });

  tabButton.classList.add('wiki-tab-active');
  tabButton.setAttribute('aria-selected', 'true');
  
  const activeContent = tabContainer.querySelector(`.wiki-tab-content[data-content-index="${tabIndex}"]`);
  if (activeContent) { 
    activeContent.classList.add('wiki-tab-active'); 
    activeContent.style.display = 'block'; 
  }
}, true);

// Debounce и resize listener
if (!window.wikiEditorResizeHandler) {
  function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  window.wikiEditorResizeHandler = debounce(() => {
    Object.values(window.wikiEditorInstances).forEach(inst => inst?.codemirror.refresh());
  }, 150);

  window.addEventListener('resize', window.wikiEditorResizeHandler);
}

})();

</script>

