<!-- _wiki_editor_content.html.erb -->
<!-- Компонент для редактора Markdown с тулбаром, автосохранением и загрузкой файлов -->
<div class="flex-1 flex flex-col min-h-[400px] wiki-editor-container" data-mode="<%= local_assigns[:page_id] ? 'edit' : 'create' %>" data-service-url="<%= ENV['AUTH_SERVICE_URL'] %>" data-api-key="<%= ENV['INTER_SERVICE_API_KEY'] %>" data-user-id="<%= current_user.id %>">
  <div class="flex justify-between items-center mb-2 shrink-0">
    <label class="block text-white font-medium">Содержание (Markdown) <span class="text-red-500">*</span></label>
    <span id="autosaveStatus" class="text-xs text-gray-400">Автосохранение включено</span>
  </div>
  
  <!-- Контейнер редактора с кнопками управления -->
  <div class="flex-1 flex flex-col">
    <!-- Кнопки управления режимом -->
    <div class="flex justify-end mb-2 gap-2">
      <button id="previewModeBtn" type="button" class="btn btn-sm btn-outline btn-warning">
        <i class="fa fa-eye"></i>
        Предпросмотр
      </button>
      <button id="editModeBtn" type="button" class="btn btn-sm btn-warning" style="display: none;">
        <i class="fa fa-edit"></i>
        Редактировать
      </button>
    </div>
    
    <!-- Обертка для редактора -->
    <div id="editorWrapper" class="border-2 border-gray-600 rounded-lg overflow-hidden bg-[#262626] shadow-inner flex-1 flex flex-col relative">
      <!-- Скрытый инпут для кастомной кнопки -->
      <input type="file" id="wikiPageFileInput" class="hidden" accept="image/*,.zip,.rar,.7z,.jar,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.md">
      
      <!-- EasyMDE Textarea -->
      <textarea id="wikiPageContent" name="content" class="flex-1 min-h-[300px]"><%= local_assigns[:content] || '' %></textarea>
      
      <!-- Панель предпросмотра (изначально скрыта) -->
      <div id="previewPane" class="editor-preview-side editor-preview-custom" style="display: none;">
        <!-- Содержимое предпросмотра будет вставляться сюда -->
      </div>
    </div>
  </div>
  
  <!-- Исправленный текст инструкции -->
  <p class="text-gray-400 text-xs mt-2 shrink-0">
    Для загрузки файлов и картинок нажмите на кнопку со стрелкой вверх в меню редактора.
  </p>
  
  <!-- Компонент для статуса публикации (Интегрирован из _wiki_editor_footer.html.erb) -->
  <div class="wiki-editor-footer-wrapper flex items-center gap-3 pt-4 mt-4 border-t border-gray-700 shrink-0">
    <div class="form-control">
      <label class="label cursor-pointer justify-start gap-3 p-0 mt-2 mb-2">
        <input type="checkbox" id="wikiPagePublished" name="published" class="checkbox checkbox-warning bg-gray-700 border-gray-600 checked:bg-amber-400 checked:border-amber-400 rounded" <%= 'checked' if local_assigns[:published] %> />
        <span class="label-text text-white">Опубликовать сразу</span>
      </label>
    </div>
  </div>
  
  <!-- Скрытое поле для ID загруженных картинок -->
  <input type="hidden" id="wikiPageTempImageIds" name="temp_image_ids" value="<%= local_assigns[:temp_image_ids] || '[]' %>">
  
  <!-- Скрытое поле для ID страницы (для редактирования) -->
  <% if local_assigns[:page_id] %>
    <input type="hidden" id="wikiPageId" name="id" value="<%= local_assigns[:page_id] %>">
  <% end %>
</div>

<!-- Подключаем библиотеку marked.js для рендеринга Markdown на клиенте -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
// Пространство имен для функций редактора
window.WikiEditorContent = window.WikiEditorContent || {};

// Объект для хранения экземпляров редактора
window.wikiEditorInstances = window.wikiEditorInstances || {};

// Функция генерации оглавления на клиенте
WikiEditorContent.generateTOC = function(text) {
  // Проверка на undefined или null
  if (!text || typeof text !== 'string') {
    return {
      toc: '',
      processedText: text || ''
    };
  }

  // Извлекаем все заголовки из текста
  const headings = [];
  const lines = text.split('\n');
  
  lines.forEach((line, index) => {
    const match = line.match(/^(#{1,6})\s+(.+)$/);
    if (match) {
      const level = match[1].length;
      const title = match[2].trim();
      const id = title.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');
      headings.push({
        level,
        title,
        id,
        line: index + 1
      });
    }
  });
  
  if (headings.length === 0) {
    return {
      toc: '',
      processedText: text
    };
  }
  
  // Генерируем HTML для оглавления
  let tocHtml = '<div class="toc-container"><h4>Содержание</h4><ul class="toc-list">';
  
  headings.forEach(heading => {
    const indent = 'margin-left: ' + ((heading.level - 1) * 20) + 'px;';
    tocHtml += `<li style="${indent}"><a href="#${heading.id}">${heading.title}</a></li>`;
  });
  
  tocHtml += '</ul></div>';
  
  // Добавляем якоря к заголовкам в тексте
  let processedText = text;
  headings.forEach(heading => {
    const headingRegex = new RegExp(`^(#{${heading.level}})\\s+${heading.title.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}$`, 'gm');
    processedText = processedText.replace(headingRegex, `$1 <span id="${heading.id}">${heading.title}</span>`);
  });
  
  return {
    toc: tocHtml,
    processedText: processedText
  };
};

// Функция рендеринга Markdown на клиенте
WikiEditorContent.renderMarkdown = function(text) {
  // Проверка на undefined или null
  if (!text || typeof text !== 'string') {
    return text || '';
  }

  // Обработка оглавления
  const tocResult = WikiEditorContent.generateTOC(text);
  text = tocResult.processedText;
  
  // Обработка блоков alert
  text = text.replace(/:::info\s*\n([\s\S]*?)\n:::/g, '<div class="alert alert-info">$1</div>');
  text = text.replace(/:::warning\s*\n([\s\S]*?)\n:::/g, '<div class="alert alert-warning">$1</div>');
  text = text.replace(/:::danger\s*\n([\s\S]*?)\n:::/g, '<div class="alert alert-danger">$1</div>');
  text = text.replace(/:::success\s*\n([\s\S]*?)\n:::/g, '<div class="alert alert-success">$1</div>');

  // Обработка вкладок
  text = text.replace(/::: tabs\s*\n([\s\S]*?)\n:::/g, function(match, content) {
    const tabRegex = /==([^=]+)==\s*\n([\s\S]*?)(?=\n==|\n:::|$)/g;
    let tabMatch;
    let tabsHtml = '<div class="tabs-container"><div class="tabs-nav">';
    let contentHtml = '';
    let isFirst = true;

    while ((tabMatch = tabRegex.exec(content)) !== null) {
      const tabTitle = tabMatch[1];
      const tabContent = tabMatch[2];

      tabsHtml += `<button class="tab-button ${isFirst ? 'active' : ''}">${tabTitle}</button>`;
      contentHtml += `<div class="tab-content" style="${isFirst ? '' : 'display:none;'}">${tabContent}</div>`;
      isFirst = false;
    }

    tabsHtml += '</div>' + contentHtml + '</div>';
    return tabsHtml;
  });

  // Заменяем [[toc]] на сгенерированное оглавление
  text = text.replace(/\[\[toc\]\]/g, tocResult.toc);

  // Если доступна библиотека marked, используем ее для рендеринга Markdown
  if (typeof marked !== 'undefined') {
    // Настройка marked для правильной обработки списков и переносов строк
    marked.setOptions({
      breaks: true, // Включаем переносы строк
      gfm: true, // Включаем GitHub Flavored Markdown
      headerIds: false, // Отключаем автоматическую генерацию ID для заголовков, так как мы делаем это сами
      headerPrefix: '', // Пустой префикс для заголовков
    });
    
    return marked.parse(text);
  } else {
    // Иначе используем базовую обработку Markdown (заглушка)
    return text.replace(/\n/g, '<br>');
  }
};

// Функция инициализации редактора для конкретного контейнера
WikiEditorContent.initEditor = function(containerId, mode = 'create') {
  const container = document.getElementById(containerId);
  if (!container) return;

  // Если уже существует экземпляр для этого контейнера, уничтожаем его
  if (window.wikiEditorInstances[containerId]) {
    window.wikiEditorInstances[containerId].toTextArea();
    delete window.wikiEditorInstances[containerId];
  }
  
  // Получаем настройки из data-атрибутов контейнера
  const authServiceUrl = container.dataset.serviceUrl || "<%= ENV['AUTH_SERVICE_URL'] %>";
  const apiKey = container.dataset.apiKey || "<%= ENV['INTER_SERVICE_API_KEY'] %>";
  const userId = container.dataset.userId || "<%= current_user.id %>";
  
  // Определяем ID для автосохранения в зависимости от режима
  const autosaveId = mode === 'edit' 
    ? `wiki_edit_page_${container.querySelector('#wikiPageId')?.value || 'new'}_draft`
    : 'wiki_new_page_draft';
    
  // Создаем экземпляр редактора
  const easyMDEInstance = new EasyMDE({
    element: container.querySelector('#wikiPageContent'),
    spellChecker: false,
    autosave: {
      enabled: true,
      uniqueId: autosaveId,
      delay: 1000,
      submit_delay: 5000,
      timeFormat: {
        locale: 'ru',
        format: {
          year: 'numeric',
          month: 'short',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
        },
      },
      text: "Автосохранено в: "
    },
    status: ["autosave", "lines", "words", "cursor"],
    placeholder: "Напишите здесь содержимое страницы...",
    previewClass: "editor-preview-custom",
    sideBySideFullscreen: false,
    // Включаем обработку переносов строк
    renderingConfig: {
      singleLineBreaks: true,
      codeSyntaxHighlighting: true,
    },
    toolbar: [
      "bold", "italic", "heading", "|", 
      "quote", "unordered-list", "ordered-list", "|", 
      "link", "code", "table", "|", 
      // --- Кнопки выравнивания ---
      {
        name: "align-left",
        action: function(editor){
            WikiEditorContent.wrapSelection(editor, '<p style="text-align: left;">', '</p>');
        },
        className: "fa fa-align-left", 
        title: "По левому краю"
      },
      {
        name: "align-center",
        action: function(editor){
            WikiEditorContent.wrapSelection(editor, '<p style="text-align: center;">', '</p>');
        },
        className: "fa fa-align-center", 
        title: "По центру"
      },
      {
        name: "align-right",
        action: function(editor){
            WikiEditorContent.wrapSelection(editor, '<p style="text-align: right;">', '</p>');
        },
        className: "fa fa-align-right", 
        title: "По правому краю"
      },
      {
        name: "align-justify",
        action: function(editor){
            WikiEditorContent.wrapSelection(editor, '<p style="text-align: justify;">', '</p>');
        },
        className: "fa fa-align-justify", 
        title: "По ширине"
      },
      // -------------------------
      "|",
      // --- Кастомные блоки ---
      {
        name: "alert-info",
        action: function(editor) {
          WikiEditorContent.insertAlertBlock(editor, 'info');
        },
        className: "fa fa-info-circle",
        title: "Информационный блок"
      },
      {
        name: "alert-warning",
        action: function(editor) {
          WikiEditorContent.insertAlertBlock(editor, 'warning');
        },
        className: "fa fa-exclamation-triangle",
        title: "Блок предупреждения"
      },
      {
        name: "alert-danger",
        action: function(editor) {
          WikiEditorContent.insertAlertBlock(editor, 'danger');
        },
        className: "fa fa-times-circle",
        title: "Блок ошибки"
      },
      {
        name: "alert-success",
        action: function(editor) {
          WikiEditorContent.insertAlertBlock(editor, 'success');
        },
        className: "fa fa-check-circle",
        title: "Блок успеха"
      },
      // -------------------------
      "|",
      // --- Дополнительные элементы ---
      {
        name: "toc",
        action: function(editor) {
          WikiEditorContent.insertTOC(editor);
        },
        className: "fa fa-list",
        title: "Вставить оглавление"
      },
      {
        name: "tabs",
        action: function(editor) {
          WikiEditorContent.insertTabs(editor);
        },
        className: "fa fa-folder-open",
        title: "Вставить вкладки"
      },
      {
        name: "spoiler",
        action: function(editor) {
          WikiEditorContent.insertSpoiler(editor);
        },
        className: "fa fa-eye-slash",
        title: "Вставить спойлер"
      },
      // -------------------------
      "|",
      // Кастомная кнопка загрузки
      {
        name: "upload-action", 
        action: function(editor){
            container.querySelector('#wikiPageFileInput').click();
        },
        className: "fa fa-upload", 
        title: "Загрузить файл/картинку"
      },
      "|",
      // Кастомная кнопка Fullscreen
      {
        name: "modal-fullscreen",
        action: function(editor) {
            WikiEditorContent.toggleModalFullscreen(containerId);
        },
        className: "fa fa-expand",
        title: "Полный экран модального окна"
      }
    ],
    imageUploadFunction: function(file, onSuccess, onError) {
      WikiEditorContent.uploadCustomFile(file, onSuccess, onError, containerId);
    },
    // Добавляем обработчик для обновления статуса автосохранения
    callbacks: {
      onAutosave: function() {
        const statusElement = container.querySelector('#autosaveStatus');
        if (statusElement) {
          statusElement.textContent = 'Сохранено в ' + new Date().toLocaleTimeString();
          statusElement.classList.add('text-green-400');
          
          setTimeout(() => {
            statusElement.textContent = mode === 'edit' 
              ? 'Автосохранение включено (редактирование)' 
              : 'Автосохранение включено (создание)';
            statusElement.classList.remove('text-green-400');
          }, 2000);
        }
      }
    }
  });
  
  // Сохраняем экземпляр в глобальном объекте
  window.wikiEditorInstances[containerId] = easyMDEInstance;
  
  // Подписываемся на выбор файла
  container.querySelector('#wikiPageFileInput').addEventListener('change', function(e) {
    if (this.files && this.files.length > 0) {
      WikiEditorContent.uploadCustomFile(this.files[0], null, null, containerId);
      this.value = ''; 
    }
  });
  
  // Возвращаем экземпляр для возможного использования
  return easyMDEInstance;
};

// Функция переключения между режимами редактирования и предпросмотра
WikiEditorContent.togglePreviewMode = function(containerId) {
  const container = document.getElementById(containerId);
  if (!container) return;

  const editorInstance = window.wikiEditorInstances[containerId];
  if (!editorInstance) return;

  const editorWrapper = container.querySelector('#editorWrapper');
  const cmWrapper = editorInstance.codemirror.getWrapperElement();
  const toolbar = editorWrapper.querySelector('.editor-toolbar');
  const previewPane = container.querySelector('#previewPane');
  const previewModeBtn = container.querySelector('#previewModeBtn');
  const editModeBtn = container.querySelector('#editModeBtn');

  // Проверяем, активен ли уже режим предпросмотра
  const isPreviewMode = editorWrapper.classList.contains('preview-mode');

  if (isPreviewMode) {
    // Возвращаем режим редактирования
    editorWrapper.classList.remove('preview-mode');
    if (cmWrapper) cmWrapper.style.display = '';
    if (toolbar) toolbar.style.display = '';
    if (previewPane) previewPane.style.display = 'none';
    
    // Показываем кнопку предпросмотра, скрываем кнопку редактирования
    if (previewModeBtn) previewModeBtn.style.display = '';
    if (editModeBtn) editModeBtn.style.display = 'none';
  } else {
    // Включаем режим предпросмотра
    editorWrapper.classList.add('preview-mode');
    if (cmWrapper) cmWrapper.style.display = 'none';
    if (toolbar) toolbar.style.display = 'none';
    
    // Рендерим предпросмотр
    const content = editorInstance.value();
    
    // Используем наш собственный рендеринг Markdown
    const rendered = WikiEditorContent.renderMarkdown(content);
    
    if (previewPane) {
      previewPane.innerHTML = rendered;
      previewPane.style.display = 'block';
    }
    
    // Скрываем кнопку предпросмотра, показываем кнопку редактирования
    if (previewModeBtn) previewModeBtn.style.display = 'none';
    if (editModeBtn) editModeBtn.style.display = '';
  }

  // Обновляем размер редактора с задержкой для анимации
  setTimeout(() => {
    if (editorInstance) {
      editorInstance.codemirror.refresh();
    }
  }, 100);
};

// Функция переключения полного экрана для модального окна
WikiEditorContent.toggleModalFullscreen = function(containerId) {
  const container = document.getElementById(containerId);
  if (!container) return;

  // Ищем родительский диалог (dialog или модальное окно)
  const modalDialog = container.closest('dialog') || container.closest('.modal');
  
  if (!modalDialog) {
    console.error('Не найдено родительское модальное окно');
    return;
  }

  // Проверяем, находится ли модальное окно в полноэкранном режиме
  const isFullscreen = modalDialog.classList.contains('modal-fullscreen');
  
  // Переключаем класс полноэкранного режима
  if (isFullscreen) {
    modalDialog.classList.remove('modal-fullscreen');
    
    // Обновляем иконку кнопки
    const btn = container.querySelector('.editor-toolbar .fa-compress');
    if (btn) {
      btn.classList.remove('fa-compress');
      btn.classList.add('fa-expand');
      btn.title = 'Полный экран модального окна';
    }
  } else {
    modalDialog.classList.add('modal-fullscreen');
    
    // Обновляем иконку кнопки
    const btn = container.querySelector('.editor-toolbar .fa-expand');
    if (btn) {
      btn.classList.remove('fa-expand');
      btn.classList.add('fa-compress');
      btn.title = 'Выйти из полноэкранного режима';
    }
    
    // Добавляем обработчик клавиши Escape для выхода из полноэкранного режима
    const escapeHandler = function(e) {
      if (e.key === 'Escape') {
        WikiEditorContent.toggleModalFullscreen(containerId);
        document.removeEventListener('keydown', escapeHandler);
      }
    };
    document.addEventListener('keydown', escapeHandler);
  }

  // Обновляем размеры редактора с задержкой для анимации
  setTimeout(() => {
    const editorInstance = window.wikiEditorInstances[containerId];
    if (editorInstance) {
      editorInstance.codemirror.refresh();
    }
  }, 300);
};

// Вспомогательные функции
WikiEditorContent.wrapSelection = function(editor, prefix, suffix) {
  const cm = editor.codemirror;
  const text = cm.getSelection() || "";
  cm.replaceSelection(prefix + text + suffix);

  // Если ничего не было выделено, ставим курсор между тегами
  if (text === "") {
    var curPos = cm.getCursor();
    cm.setCursor(curPos.line, curPos.ch - suffix.length);
  }
  cm.focus();
};

// Функции для вставки кастомных блоков
WikiEditorContent.insertAlertBlock = function(editor, type) {
  const cm = editor.codemirror;
  const text = cm.getSelection() || "";
  let blockText = "";

  switch(type) {
    case 'info':
      blockText = `:::info\n${text || 'Информация'}\n:::`;
      break;
    case 'warning':
      blockText = `:::warning\n${text || 'Предупреждение'}\n:::`;
      break;
    case 'danger':
      blockText = `:::danger\n${text || 'Ошибка'}\n:::`;
      break;
    case 'success':
      blockText = `:::success\n${text || 'Успех'}\n:::`;
      break;
  }

  cm.replaceSelection(blockText);

  // Если ничего не было выделено, ставим курсор внутрь блока
  if (text === "") {
    const cursorPos = cm.getCursor();
    cm.setCursor(cursorPos.line - 2, 0);
  }
  cm.focus();
};

// Функция для вставки оглавления
WikiEditorContent.insertTOC = function(editor) {
  const cm = editor.codemirror;
  cm.replaceSelection("[[toc]]");
  cm.focus();
};

// Функция для вставки вкладок
WikiEditorContent.insertTabs = function(editor) {
  const cm = editor.codemirror;
  const text = cm.getSelection() || "";

  const tabsTemplate = `::: tabs
==Tab 1==
 ${text || 'Содержимое первой вкладки'}
==Tab 2==
Содержимое второй вкладки
:::`;

  cm.replaceSelection(tabsTemplate);

  // Если ничего не было выделено, ставим курсор в содержимое первой вкладки
  if (text === "") {
    const cursorPos = cm.getCursor();
    cm.setCursor(cursorPos.line - 3, 0);
  }
  cm.focus();
};

// Функция для вставки спойлера
WikiEditorContent.insertSpoiler = function(editor) {
  const cm = editor.codemirror;
  const text = cm.getSelection() || "";

  const spoilerTemplate = `<details>
<summary>Заголовок спойлера</summary>

 ${text || 'Скрытое содержимое'}

</details>`;

  cm.replaceSelection(spoilerTemplate);

  // Если ничего не было выделено, ставим курсор в содержимое спойлера
  if (text === "") {
    const cursorPos = cm.getCursor();
    cm.setCursor(cursorPos.line - 2, 0);
  }
  cm.focus();
};

// Загрузка файлов
WikiEditorContent.uploadCustomFile = async function(file, onSuccess, onError, containerId) {
  // Получаем ID контейнера, если не передан
  if (!containerId) {
    containerId = document.getElementById('wikiPageId') ? 'editWikiPageModal' : 'addWikiPageModal';
  }

  const container = document.getElementById(containerId);
  if (!container) return;

  // Получаем настройки из data-атрибутов контейнера
  const authServiceUrl = container.dataset.serviceUrl || "<%= ENV['AUTH_SERVICE_URL'] %>";
  const apiKey = container.dataset.apiKey || "<%= ENV['INTER_SERVICE_API_KEY'] %>";
  const userId = container.dataset.userId || "<%= current_user.id %>";

  const formData = new FormData();
  formData.append('file', file);

  // Сохраняем черновик перед загрузкой
  const editorInstance = window.wikiEditorInstances[containerId];
  if (editorInstance) {
    const currentContent = editorInstance.value();
    const mode = container.querySelector('.wiki-editor-container').getAttribute('data-mode');
    const autosaveId = mode === 'edit' 
      ? `wiki_edit_page_${container.querySelector('#wikiPageId')?.value || 'new'}_draft`
      : 'wiki_new_page_draft';
    localStorage.setItem(`${autosaveId}_safety`, currentContent);
  }

  showNotification('Загрузка файла...', 'info');

  const url = `${authServiceUrl}/api/v1/wiki/pages/upload_temporary_image`; 

  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'X-User-ID': userId,
        'Authorization': `Bearer ${apiKey}`
      },
      body: formData,
      credentials: 'include'
    });

    if (!response.ok) {
      const errData = await response.json().catch(() => ({}));
      throw new Error(errData.error || 'Ошибка загрузки');
    }

    const data = await response.json();

    // Сохраняем signed_id
    if (data.signed_id) {
      const tempImageIdsElement = container.querySelector('#wikiPageTempImageIds');
      if (tempImageIdsElement) {
        let uploadedTempImageIds = JSON.parse(tempImageIdsElement.value || '[]');
        uploadedTempImageIds.push(data.signed_id);
        tempImageIdsElement.value = JSON.stringify(uploadedTempImageIds);
      }
    }

    // Вставка в редактор
    if (onSuccess && data.url) {
      onSuccess(data.url);
    } else if (data.url) {
      const cm = editorInstance.codemirror;
      const cursorPos = cm.getCursor();

      let insertText = '';
      if (data.type === 'image') {
        insertText = `
![${data.filename}](${data.url})
`;
      } else {
        // Для не-изображений создаем специальный блок с кнопкой скачивания
        const fileExtension = data.filename.split('.').pop().toUpperCase();
        const fileSize = data.size ? `(${(data.size / 1024).toFixed(2)} KB)` : '';
        
        insertText = `
<div class="file-download-block">
  <div class="file-info">
    <div class="file-icon">${fileExtension}</div>
    <div class="file-details">
      <div class="file-name">${data.filename}</div>
      <div class="file-size">${fileSize}</div>
    </div>
  </div>
  <a href="${data.url}" class="download-button" download="${data.filename}">
    <i class="fa fa-download"></i> Скачать
  </a>
</div>
`;
      }

      cm.replaceRange(insertText, cursorPos);
      cm.focus();
    } else {
       throw new Error('URL не получен');
    }

    showNotification('Файл загружен');

  } catch (error) {
    console.error('Upload error:', error);
    if (onError) onError('Ошибка загрузки: ' + error.message);
    else showAlertNotification('Ошибка загрузки: ' + error.message);
  }
};

// НОВАЯ ФУНКЦИЯ ИНИЦИАЛИЗАЦИИ
// Эта функция будет пытаться инициализировать редактор, как только он появится в DOM.
WikiEditorContent.setup = function(attempts = 0) {
  // Ищем главный контейнер редактора
  const editorContainer = document.querySelector('.wiki-editor-container');
  
  // Если контейнер не найден, пробуем еще раз через 100мс (максимум 50 раз)
  if (!editorContainer) {
    if (attempts < 50) {
      setTimeout(() => WikiEditorContent.setup(attempts + 1), 100);
    } else {
      console.error('Не удалось найти контейнер .wiki-editor-container после 5 секунд ожидания.');
    }
    return;
  }

  // Определяем режим работы (create/edit)
  const mode = editorContainer.getAttribute('data-mode');
  if (!mode) {
    console.error('Не удалось определить режим редактора (data-mode).');
    return;
  }

  // Определяем ID контейнера в зависимости от режима
  const containerId = mode === 'edit' ? 'editWikiPageModal' : 'addWikiPageModal';
  const container = document.getElementById(containerId);

  if (!container) {
    console.error(`Не найден основной контейнер с ID: ${containerId}`);
    return;
  }

  // Инициализируем редактор, если он еще не инициализирован
  if (!window.wikiEditorInstances[containerId]) {
    WikiEditorContent.initEditor(containerId, mode);
  } else {
    // Если редактор уже существует, обновляем его содержимое
    const contentElement = document.getElementById('wikiPageContent');
    if (contentElement) {
      window.wikiEditorInstances[containerId].value(contentElement.value);
    }
  }

  // Обновляем статус автосохранения в зависимости от режима
  const autosaveStatus = container.querySelector('#autosaveStatus');
  if (autosaveStatus) {
    autosaveStatus.textContent = mode === 'edit' 
      ? 'Автосохранение включено (редактирование)' 
      : 'Автосохранение включено (создание)';
  }
  
  // Добавляем обработчики для кнопок предпросмотра/редактирования
  const previewModeBtn = container.querySelector('#previewModeBtn');
  const editModeBtn = container.querySelector('#editModeBtn');
  
  if (previewModeBtn) {
    // Удаляем старый обработчик, если он есть, чтобы избежать дублирования
    previewModeBtn.replaceWith(previewModeBtn.cloneNode(true));
    container.querySelector('#previewModeBtn').addEventListener('click', function(e) {
      e.preventDefault();
      WikiEditorContent.togglePreviewMode(containerId);
    });
  }
  
  if (editModeBtn) {
    // Удаляем старый обработчик, если он есть
    editModeBtn.replaceWith(editModeBtn.cloneNode(true));
    container.querySelector('#editModeBtn').addEventListener('click', function(e) {
      e.preventDefault();
      WikiEditorContent.togglePreviewMode(containerId);
    });
  }
};

// Запускаем инициализацию
WikiEditorContent.setup();

// Добавляем обработчик для переключения вкладок (глобальный, так как вкладки могут появиться в предпросмотре)
document.addEventListener('click', function(e) {
  if (e.target.classList.contains('tab-button')) {
    const tabContainer = e.target.closest('.tabs-container');
    if (!tabContainer) return;

    // Убираем активный класс у всех кнопок и скрываем все контенты
    const tabButtons = tabContainer.querySelectorAll('.tab-button');
    const tabContents = tabContainer.querySelectorAll('.tab-content');

    tabButtons.forEach(btn => btn.classList.remove('active'));
    tabContents.forEach(content => content.style.display = 'none');

    // Добавляем активный класс к нажатой кнопке и показываем соответствующий контент
    e.target.classList.add('active');
    const tabIndex = Array.from(tabButtons).indexOf(e.target);
    if (tabContents[tabIndex]) {
      tabContents[tabIndex].style.display = 'block';
    }
  }
});

// Добавляем обработчик для изменения размера окна
window.addEventListener('resize', function() {
  // Обновляем все экземпляры редактора при изменении размера окна
  Object.keys(window.wikiEditorInstances).forEach(containerId => {
    const editorInstance = window.wikiEditorInstances[containerId];
    if (editorInstance) {
      editorInstance.codemirror.refresh();
    }
  });
});
</script>

