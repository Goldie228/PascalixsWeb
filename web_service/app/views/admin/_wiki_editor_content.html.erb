.editor-preview code, #previewPane code,
.editor-preview pre code, #previewPane pre code,
.hljs {
  background-color: var(--wiki-border-dark) !important; 
  color: #e5e7eb !important;
  padding: 2px 6px; 
  border-radius: 4px; 
  font-family: monospace; 
  font-size: 0.9em; 
}
.editor-preview pre, #previewPane pre { 
  background-color: #111827 !important; 
  padding: 16px; 
  overflow-x: auto; 
  border-radius: 8px; 
  border: 1px solid var(--wiki-border-dark); 
  margin-bottom: 16px; 
}
.editor-preview pre code, #previewPane pre code,
.hljs.code, .hljs.pre {
  background-color: transparent !important; 
  padding: 0;
}
.hljs-comment, .hljs-quote { color: #6b7280 !important; }
.hljs-keyword, .hljs-selector-tag, .hljs-addition { color: #9ca3af !important; }
.hljs-number, .hljs-string, .hljs-meta .hljs-meta-string, .hljs-literal, .hljs-doctag, .hljs-regexp { color: #d1d5db !important; }
.hljs-title, .hljs-section, .hljs-name, .hljs-selector-id, .hljs-selector-class { color: #e5e7eb !important; }
.hljs-attribute, .hljs-attr, .hljs-variable, .hljs-template-variable, .hljs-class .hljs-title, .hljs-type { color: #9ca3af !important; }
.hljs-symbol, .hljs-bullet, .hljs-subst, .hljs-meta, .hljs-meta .hljs-keyword, .hljs-selector-attr, .hljs-selector-pseudo, .hljs-link { color: #d1d5db !important; }
.hljs-built-in, .hljs-deletion { color: #9ca3af !important; }
.hljs-formula { background: #374151 !important; }
.hljs-emphasis { font-style: italic; }
.hljs-strong { font-weight: bold; }

/* Цитаты */
.wiki-blockquote, .editor-preview blockquote, #previewPane blockquote {
  background-color: var(--wiki-bg-dark);
  border-left: 4px solid var(--wiki-primary);
  padding: 12px 16px;
  margin: 16px 0;
  border-radius: 0 8px 8px 0;
  color: var(--wiki-text-muted);
  font-style: italic;
}
.wiki-blockquote p, .editor-preview blockquote p, #previewPane blockquote p {
  margin-bottom: 8px;
}
.wiki-blockquote p:last-child, .editor-preview blockquote p:last-child, #previewPane blockquote p:last-child {
  margin-bottom: 0;
}
/* Жирный и курсив внутри цитат */
.editor-preview blockquote strong, #previewPane blockquote strong,
.editor-preview blockquote b, #previewPane blockquote b {
  font-weight: bold;
  color: var(--wiki-text);
}
.editor-preview blockquote em, #previewPane blockquote em,
.editor-preview blockquote i, #previewPane blockquote i {
  font-style: italic;
}
/* Списки внутри цитат */
.editor-preview blockquote ul, #previewPane blockquote ul,
.editor-preview blockquote ol, #previewPane blockquote ol {
  margin: 8px 0;
  padding-left: 2em;
  font-style: normal;
}
.editor-preview blockquote li, #previewPane blockquote li {
  margin: 4px 0;
}
/* Код внутри цитат */
.editor-preview blockquote pre, #previewPane blockquote pre,
.editor-preview blockquote code, #previewPane blockquote code {
  font-style: normal;
  background-color: rgba(0, 0, 0, 0.3) !important;
}
.editor-preview blockquote pre, #previewPane blockquote pre {
  margin: 12px 0;
  padding: 12px;
  border-radius: 6px;
  font-style: normal;
}
.editor-preview blockquote code, #previewPane blockquote code {
  padding: 2px 6px;
  border-radius: 4px;
}
/* Вложенные цитаты */
.editor-preview blockquote blockquote, #previewPane blockquote blockquote {
  margin: 8px 0;
  padding-left: 12px;
  border-left-color: var(--wiki-info);
}
.editor-preview blockquote blockquote blockquote, #previewPane blockquote blockquote blockquote {
  border-left-color: var(--wiki-warning);
}

/* ===== MERMAID DIAGRAMS ===== */
/* Используется встроенная тёмная тема Mermaid (theme: 'dark') */
.mermaid-diagram {
  margin: 1.5rem auto;
  text-align: center;
  overflow-x: auto;
}

.mermaid-diagram svg {
  display: block;
  margin: 0 auto;
  max-width: 100%;
}

/* Блок с исходным кодом диаграммы */
.mermaid-source {
  background-color: #111827;
  border: 1px dashed #6b7280;
  border-radius: 0.5rem;
  padding: 1rem;
  margin: 1rem 0;
  overflow-x: auto;
  font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  font-size: 13px;
}

.mermaid-source code {
  color: #e5e7eb;
  background: transparent;
}

/* Ошибки Mermaid */
.mermaid-error {
  background-color: rgba(127, 29, 29, 0.3);
  border: 1px solid #ef4444;
  border-radius: 0.5rem;
  padding: 1rem;
  margin: 1rem 0;
}

.mermaid-error .error-header {
  color: #f87171;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.mermaid-error .error-details {
  margin-top: 0.75rem;
  padding: 0.75rem;
  background-color: rgba(0, 0, 0, 0.4);
  border-radius: 0.25rem;
  font-family: monospace;
  font-size: 0.85em;
  color: #fca5a5;
  overflow-x: auto;
}

.mermaid-error pre {
  margin-top: 0.5rem;
  background-color: #1f2937;
  padding: 0.75rem;
  border-radius: 0.25rem;
  overflow-x: auto;
  font-size: 12px;
  border: 1px solid #374151;
}

/* ===== 9. ТАБЛИЦЫ ===== */
.editor-preview table, #previewPane table { border-collapse: collapse; width: 100%; margin-bottom: 16px; display: block; overflow-x: auto; }
.editor-preview th, #previewPane th { background-color: var(--wiki-bg-dark); color: var(--wiki-primary); font-weight: bold; }
.editor-preview th, .editor-preview td, #previewPane th, #previewPane td { border: 1px solid var(--wiki-border); padding: 8px 12px; text-align: left; }

/* ===== 10. СПИСКИ ===== */
/* Важно: используем !important для перекрытия стилей EasyMDE, DaisyUI и Tailwind */
.editor-preview ul, #previewPane ul,
.editor-preview .wiki-list, #previewPane .wiki-list { 
  padding-left: 2em !important; 
  color: var(--wiki-text-muted); 
  margin-bottom: 16px; 
  margin-top: 0 !important;
  list-style-type: disc !important;
  list-style-position: outside !important;
  display: block !important;
  margin-left: 0 !important;
}
.editor-preview ol, #previewPane ol { 
  padding-left: 2em !important; 
  color: var(--wiki-text-muted); 
  margin-bottom: 16px; 
  margin-top: 0 !important;
  list-style-type: decimal !important;
  list-style-position: outside !important;
  display: block !important;
  margin-left: 0 !important;
}
.editor-preview li, #previewPane li { 
  margin-bottom: 4px; 
  line-height: 1.5; 
  display: list-item !important;
}

/* Вложенные списки с разными маркерами */
/* Уровень 1 (первая вложенность) - circle */
.editor-preview ul ul, #previewPane ul ul,
.editor-preview .wiki-list-depth-1, #previewPane .wiki-list-depth-1 { 
  list-style-type: circle !important; 
  margin-top: 4px !important;
  margin-bottom: 4px !important;
  padding-left: 1.5em !important;
}

/* Уровень 2 (вторая вложенность) - square */
.editor-preview ul ul ul, #previewPane ul ul ul,
.editor-preview .wiki-list-depth-2, #previewPane .wiki-list-depth-2 { 
  list-style-type: square !important;
  margin-top: 4px !important;
  margin-bottom: 4px !important;
  padding-left: 1.5em !important;
}

/* Уровень 3+ - возвращаемся к disc */
.editor-preview ul ul ul ul, #previewPane ul ul ul ul,
.editor-preview .wiki-list-depth-3, #previewPane .wiki-list-depth-3 { 
  list-style-type: disc !important;
  margin-top: 4px !important;
  margin-bottom: 4px !important;
  padding-left: 1.5em !important;
}

/* Нумерованные списки */
.editor-preview ol ol, #previewPane ol ol { 
  list-style-type: lower-alpha !important; 
  margin-top: 4px !important;
}
.editor-preview ol ol ol, #previewPane ol ol ol { 
  list-style-type: lower-roman !important; 
  margin-top: 4px !important;
}
.editor-preview ol ol ol ol, #previewPane ol ol ol ol { 
  list-style-type: decimal !important; 
  margin-top: 4px !important;
}

/* Task Lists */
.editor-preview .task-list-item, #previewPane .task-list-item { list-style: none !important; margin-left: -1.5em; }
.editor-preview ul input[type="checkbox"], #previewPane ul input[type="checkbox"] {
  appearance: none; -webkit-appearance: none; width: 16px; height: 16px;
  border: 2px solid var(--wiki-border); border-radius: 4px; margin-right: 8px;
  vertical-align: middle; cursor: default; background-color: #1f2937;
  position: relative;
}
.editor-preview ul input[type="checkbox"]:checked, #previewPane ul input[type="checkbox"]:checked {
  background-color: var(--wiki-primary); border-color: var(--wiki-primary);
}
.editor-preview ul input[type="checkbox"]:checked::after, #previewPane ul input[type="checkbox"]:checked::after {
  content: '✔'; color: #262626; font-size: 12px; position: absolute; top: -1px; left: 2px;
}

/* ===== 11. АЛЕРТЫ (только внутри предпросмотра) ===== */
/* Стили alert ограничены областью редактора для избежания конфликтов с глобальными уведомлениями */
.editor-preview .alert, #previewPane .alert {
  padding: 16px; margin: 16px 0; border-radius: 8px; display: flex; align-items: flex-start;
  border-left: 5px solid; background-color: rgba(0, 0, 0, 0.2);
  text-align: left;
  gap: 8px;
}
.editor-preview .alert-icon, #previewPane .alert-icon { 
  font-size: 18px; 
  opacity: 0.8; 
  flex-shrink: 0; 
  width: 18px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}
.editor-preview .alert-content, #previewPane .alert-content { flex: 1; text-align: left; min-width: 0; }
.editor-preview .alert-content strong, #previewPane .alert-content strong { display: block; margin-bottom: 5px; font-size: 1.1em; }
.editor-preview .alert-text, #previewPane .alert-text { font-size: 0.95em; opacity: 0.9; text-align: left; }
/* Код внутри алертов */
.editor-preview .alert pre, #previewPane .alert pre,
.editor-preview .alert code, #previewPane .alert code {
  text-align: left;
  background-color: rgba(0, 0, 0, 0.3) !important;
}
.editor-preview .alert pre, #previewPane .alert pre {
  margin: 10px 0;
  padding: 12px;
  border-radius: 6px;
  overflow-x: auto;
}

.editor-preview .alert-info, #previewPane .alert-info { border-left-color: var(--wiki-info); background-color: var(--wiki-info-bg); }
.editor-preview .alert-info .alert-icon, #previewPane .alert-info .alert-icon,
.editor-preview .alert-info strong, #previewPane .alert-info strong { color: var(--wiki-info-border); }
.editor-preview .alert-info .alert-text, #previewPane .alert-info .alert-text { color: var(--wiki-text-muted); }

.editor-preview .alert-warning, #previewPane .alert-warning { border-left-color: var(--wiki-warning); background-color: var(--wiki-warning-bg); }
.editor-preview .alert-warning .alert-icon, #previewPane .alert-warning .alert-icon,
.editor-preview .alert-warning strong, #previewPane .alert-warning strong { color: var(--wiki-primary-light); }
.editor-preview .alert-warning .alert-text, #previewPane .alert-warning .alert-text { color: var(--wiki-text-muted); }

.editor-preview .alert-danger, #previewPane .alert-danger { border-left-color: var(--wiki-error); background-color: var(--wiki-error-bg); }
.editor-preview .alert-danger .alert-icon, #previewPane .alert-danger .alert-icon,
.editor-preview .alert-danger strong, #previewPane .alert-danger strong { color: #fca5a5; }
.editor-preview .alert-danger .alert-text, #previewPane .alert-danger .alert-text { color: var(--wiki-text-muted); }

.editor-preview .alert-success, #previewPane .alert-success { border-left-color: var(--wiki-success); background-color: var(--wiki-success-bg); }
.editor-preview .alert-success .alert-icon, #previewPane .alert-success .alert-icon,
.editor-preview .alert-success strong, #previewPane .alert-success strong { color: var(--wiki-success-border); }
.editor-preview .alert-success .alert-text, #previewPane .alert-success .alert-text { color: var(--wiki-text-muted); }

/* ===== 12. СПОЙЛЕРЫ ===== */
.editor-preview details, #previewPane details { 
  background-color: var(--wiki-bg-dark); 
  border: 1px solid var(--wiki-border); 
  border-radius: 8px; 
  margin: 16px 0; 
  padding: 0; 
  overflow: hidden;
  text-align: left;
}
.editor-preview summary, #previewPane summary { 
  background-color: #1f2937; 
  padding: 12px 16px; 
  cursor: pointer; 
  font-weight: bold; 
  color: var(--wiki-info);
  border-radius: 8px; 
  transition: background-color 0.2s ease;
  display: flex;
  align-items: center;
  gap: 8px;
}
.editor-preview summary:hover, #previewPane summary:hover { 
  background-color: #2d3748; 
  color: var(--wiki-info-border);
}
.editor-preview summary::before, #previewPane summary::before {
  content: '▶';
  font-size: 0.8em;
  transition: transform 0.2s ease;
  color: var(--wiki-info);
}
.editor-preview details[open] > summary, #previewPane details[open] > summary { 
  border-bottom: 1px solid var(--wiki-border); 
  border-radius: 8px 8px 0 0; 
}
.editor-preview details[open] > summary::before, #previewPane details[open] > summary::before {
  transform: rotate(90deg);
}
/* Контент внутри спойлера - исправленные отступы */
.editor-preview details[open], #previewPane details[open] {
  padding-bottom: 16px;
}
.editor-preview details[open] > p, 
.editor-preview details[open] > ul, 
.editor-preview details[open] > ol,
.editor-preview details[open] > div,
.editor-preview details[open] > table,
#previewPane details[open] > p, 
#previewPane details[open] > ul, 
#previewPane details[open] > ol,
#previewPane details[open] > div,
#previewPane details[open] > table {
  padding: 0 16px;
  margin-left: 0;
  margin-right: 0;
}
.editor-preview details[open] > p:first-of-type, 
#previewPane details[open] > p:first-of-type {
  padding-top: 16px;
}
.editor-preview details a, #previewPane details a { color: var(--wiki-primary); }
.editor-preview details pre, #previewPane details pre {
  margin: 8px 16px;
  padding: 16px;
  white-space: pre-wrap;
  tab-size: 4;
  overflow-x: auto;
  background-color: #111827 !important;
  border-radius: 8px;
  border: 1px solid var(--wiki-border-dark);
}
.editor-preview details pre code, #previewPane details pre code {
  background-color: transparent !important;
  padding: 0;
}
.editor-preview details ul, .editor-preview details ol, 
#previewPane details ul, #previewPane details ol {
  margin-bottom: 8px;
  padding-left: 3em;
}
/* Цитаты внутри спойлера */
.editor-preview details blockquote, #previewPane details blockquote {
  margin: 8px 16px;
  border-left: 4px solid var(--wiki-border);
  padding: 8px 16px;
  background-color: rgba(0, 0, 0, 0.2);
  border-radius: 0 4px 4px 0;
}

/* ===== 13. ВКЛАДКИ ===== */
.wiki-tabs-container { margin: 16px 0; border: 1px solid #2D2D2D; border-radius: 8px; overflow: hidden; background-color: var(--wiki-bg-dark); }
.wiki-tabs-nav { display: flex; background-color: #1A1A1A; border-bottom: 1px solid #2D2D2D; flex-wrap: wrap; }
.wiki-tab-button { 
  padding: 10px 16px; 
  cursor: pointer; 
  background-color: transparent; 
  border: none; 
  color: var(--wiki-text-dim); 
  font-weight: bold; 
  white-space: nowrap; 
  transition: all 0.2s ease; 
  outline: none; 
  font-size: 14px;
}
.wiki-tab-button:hover { background-color: #2D2D2D; color: var(--wiki-text-muted); }
.wiki-tab-button.wiki-tab-active { 
  background-color: var(--wiki-bg-dark); 
  color: var(--wiki-primary); 
  border-bottom: 2px solid var(--wiki-primary); 
}
.wiki-tab-content { 
  padding: 16px; 
  background-color: var(--wiki-bg-dark); 
  display: none; 
  opacity: 0; 
  transition: opacity 0.3s ease; 
}
.wiki-tab-content.wiki-tab-active { 
  display: block !important; 
  opacity: 1; 
  animation: fadeIn 0.3s ease; 
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-5px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 14. ОГЛАВЛЕНИЕ ===== */
.toc-container { background-color: var(--wiki-bg-dark); border: 1px solid var(--wiki-border); border-radius: 8px; padding: 16px; margin: 16px 0; }
.toc-container h4 { margin-top: 0; margin-bottom: 12px; color: var(--wiki-primary); font-size: 1.2em; border-bottom: 1px solid var(--wiki-border); padding-bottom: 8px; }
.toc-list { list-style-type: none; padding-left: 0; margin: 0; }
.toc-list li { margin-bottom: 4px; line-height: 1.5; }
.toc-list a { color: var(--wiki-text-muted); text-decoration: none; transition: color 0.2s ease; }
.toc-list a:hover { text-decoration: underline; color: var(--wiki-primary); }

/* ===== 15. ФАЙЛЫ ===== */
.file-download-block { display: flex; align-items: center; justify-content: space-between; background-color: var(--wiki-bg-dark); border: 1px solid var(--wiki-border); border-radius: 8px; padding: 12px 16px; margin: 16px 0; }
.file-info { display: flex; align-items: center; }
.file-icon { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; background-color: var(--wiki-border-dark); color: var(--wiki-primary); font-weight: bold; font-size: 12px; border-radius: 4px; margin-right: 12px; }
.file-details { display: flex; flex-direction: column; }
.file-name { font-weight: bold; color: var(--wiki-text); }
.download-button { display: flex; align-items: center; padding: 8px 12px; background-color: var(--wiki-border-dark); color: var(--wiki-primary); border: 1px solid var(--wiki-border); border-radius: 4px; text-decoration: none; font-size: 14px; transition: all 0.2s ease; }
.download-button:hover { background-color: var(--wiki-border); color: var(--wiki-primary); }
.download-button .fa { font-style: normal; }

/* ===== 16. ФУТЕР ===== */
.wiki-editor-footer-wrapper { display: flex; align-items: center; padding-top: 1rem; margin-top: 1rem; border-top: 1px solid var(--wiki-border-dark); flex-shrink: 0; }
.wiki-editor-footer-wrapper .checkbox { appearance: none; width: 20px; height: 20px; border: 2px solid var(--wiki-border); border-radius: 4px; margin-right: 8px; position: relative; cursor: pointer; transition: all 0.2s ease; flex-shrink: 0; }
.wiki-editor-footer-wrapper .checkbox:checked { background-color: var(--wiki-primary); border-color: var(--wiki-primary); }
.wiki-editor-footer-wrapper .checkbox:checked::after { content: '✓'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #000; font-weight: bold; }

/* ===== 17. ПОЛНОЭКРАННЫЙ РЕЖИМ ===== */
.modal-fullscreen { 
  max-width: 100vw !important; 
  max-height: 100vh !important; 
  width: 100vw !important; 
  height: 100vh !important; 
  margin: 0 !important; 
  padding: 0 !important; 
  border-radius: 0 !important; 
}
.modal-fullscreen .modal-box, dialog.modal-fullscreen .modal-box { 
  max-width: 100vw; 
  max-height: 100vh; 
  width: 100vw; 
  height: 100vh; 
  margin: 0; 
  padding: 0 !important; 
  border-radius: 0; 
  display: flex; 
  flex-direction: column; 
  overflow: hidden; 
}
/* Шапка модального окна в полноэкранном режиме */
.modal-fullscreen .modal-box > .p-6:first-child {
  padding: 1rem 1.5rem !important;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
/* Скроллируемая область контента */
.modal-fullscreen .modal-box > .flex-1.overflow-y-auto {
  padding: 0 1.5rem !important;
  padding-bottom: 80px !important;
  flex: 1;
  overflow-y: auto;
  position: relative;
  z-index: 0;
}
/* Футер модального окна - кнопки Отмена/Сохранить */
.modal-fullscreen .modal-box > .p-6:last-child {
  padding: 1rem 1.5rem !important;
  flex-shrink: 0;
  position: relative;
  z-index: auto;
  background-color: #1A1A1A;
}
/* Отступы для заголовка и URL в полноэкранном режиме */
.modal-fullscreen .grid.grid-cols-1.md\:grid-cols-3 {
  margin-top: 1.5rem !important;
  margin-bottom: 1rem !important;
}
/* Отступ для текста инструкции в полноэкранном режиме */
.modal-fullscreen .text-gray-400.text-xs.mt-2 {
  margin-top: 1rem !important;
  margin-bottom: 0.5rem !important;
}
.modal-fullscreen .CodeMirror { height: calc(100vh - 200px) !important; }
.modal-fullscreen #editorWrapper { height: calc(100vh - 150px) !important; overflow: hidden !important; }

/* Полноэкранный режим + предпросмотр */
.modal-fullscreen #editorWrapper.preview-mode .CodeMirror,
.modal-fullscreen #editorWrapper.preview-mode .editor-toolbar { display: none !important; }
.modal-fullscreen #editorWrapper.preview-mode .editor-statusbar {
  order: 2 !important;
  flex-shrink: 0 !important;
  display: block !important;
  padding: 8px 16px !important;
}
.modal-fullscreen #editorWrapper.preview-mode #previewPaneContainer { 
  order: 1 !important;
  height: auto !important; 
  min-height: calc(100vh - 200px) !important;
  flex: 1 !important;
  display: block !important;
}
.modal-fullscreen #editorWrapper.preview-mode #previewPane { 
  height: auto !important; 
  min-height: calc(100vh - 200px) !important;
  overflow-y: auto !important; 
  padding: 1.5rem !important;
}
.modal-fullscreen .editor-preview { height: auto !important; min-height: calc(100vh - 200px) !important; overflow-y: auto !important; padding: 1.5rem !important; }
.modal-fullscreen #previewPane img, .modal-fullscreen .editor-preview img { max-width: 100%; height: auto; }
/* Скрываем лишние элементы в полноэкранном режиме при предпросмотре */
.modal-fullscreen .preview-mode #previewPaneContainer { 
  height: auto !important; 
  min-height: calc(100vh - 150px) !important;
  max-height: none !important;
  position: relative !important;
  display: block !important;
}
.modal-fullscreen .preview-mode #previewPane { 
  height: auto !important; 
  min-height: calc(100vh - 150px) !important;
  max-height: none !important;
  overflow-y: auto !important; 
  padding-bottom: 100px !important; 
  position: relative !important;
  display: block !important;
}
.modal-fullscreen #previewPaneContainer { 
  height: auto !important; 
  min-height: calc(100vh - 200px) !important;
  max-height: none !important;
  position: relative !important;
}
.modal-fullscreen #previewPane { 
