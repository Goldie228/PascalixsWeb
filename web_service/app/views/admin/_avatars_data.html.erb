<%= render 'shared/payment_modal' %>

<div class="w-full mx-auto pb-8" data-user-id="<%= current_user.id %>" data-time-zone="<%= session[:time_zone] || 'UTC' %>">
    <h1 class="text-4xl font-bold text-center mb-8"><%= t('views.admin.avatars.index.title') %></h1>
    
    <!-- Панель управления -->
    <div class="flex flex-col gap-6 mb-6 md:mb-8 px-4">
        <!-- Первая строка элементов управления -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="form-control w-full md:w-auto">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-amber-400 font-semibold text-sm md:text-base"><%= t('views.admin.avatars.index.records_per_page') %></span>
                    
                    <div class="dropdown dropdown-end">
                        <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                            <span class="text-xs md:text-sm" id="perPageLabel">50</span>
                            <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </label>
                        <ul class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-32 mt-1">
                            <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="25">25</a></li>
                            <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="50">50</a></li>
                            <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="75">75</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Вторая строка элементов управления -->
        <div class="grid grid-cols-1 md:flex md:flex-row gap-4 md:gap-6 justify-between">
            <div class="flex flex-col md:flex-row gap-4 md:gap-6 w-full md:w-auto">
                <div class="form-control w-full md:w-auto">
                    <div class="flex items-center gap-2">
                        <span class="text-amber-400 font-semibold text-sm md:text-base"><%= t('views.admin.avatars.index.sort_direction') %></span>
                        
                        <div class="dropdown dropdown-end">
                            <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                                <span class="text-xs md:text-sm" id="sortOrderLabel"><%= t('views.admin.avatars.index.sort_descending') %></span>
                                <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </label>
                            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-44 md:w-52 mt-1">
                                <li><a href="#" class="sort-order-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="asc"><%= t('views.admin.avatars.index.sort_ascending') %></a></li>
                                <li><a href="#" class="sort-order-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="desc"><%= t('views.admin.avatars.index.sort_descending') %></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <div class="form-control w-full md:w-auto">
                    <div class="flex items-center gap-2">
                        <span class="text-amber-400 font-semibold text-sm md:text-base"><%= t('views.admin.avatars.index.sort_by') %></span>
                        <div class="dropdown dropdown-end">
                            <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                                <span class="text-xs md:text-sm truncate max-w-[100px] md:max-w-none" id="sortByLabel"><%= t('views.admin.avatars.index.creation_date') %></span>
                                <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </label>
                            <ul class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-44 md:w-52 mt-1">
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="status"><%= t('views.admin.avatars.index.status') %></a></li>
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="created_at"><%= t('views.admin.avatars.index.creation_date') %></a></li>
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="user_name"><%= t('views.admin.avatars.index.username') %></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="w-full md:w-auto">
                <input type="text" id="searchInput" placeholder="<%= t('views.admin.avatars.index.search_by_username') %>" class="input input-sm md:input-md w-full bg-[#2D2D2D] text-white placeholder-[#A0A0A0] border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition">
            </div>
        </div>
        
        <!-- Фильтры -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
            <div>
                <label class="block text-sm font-medium text-amber-400 mb-1"><%= t('views.admin.avatars.index.avatar_status') %></label>
                <select id="statusFilter" class="select select-sm md:select-md w-full bg-[#2D2D2D] text-white border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
                    <option value=""><%= t('views.admin.avatars.index.all_statuses') %></option>
                    <option value="pending"><%= t('views.admin.avatars.index.pending') %></option>
                    <option value="approved"><%= t('views.admin.avatars.index.approved') %></option>
                    <option value="rejected"><%= t('views.admin.avatars.index.rejected') %></option>
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-amber-400 mb-1"><%= t('views.admin.avatars.index.date_from') %></label>
                <input type="date" id="dateFromFilter" class="input input-sm md:input-md w-full bg-[#2D2D2D] text-white border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-amber-400 mb-1"><%= t('views.admin.avatars.index.date_to') %></label>
                <input type="date" id="dateToFilter" class="input input-sm md:input-md w-full bg-[#2D2D2D] text-white border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
            </div>
        </div>
    </div>
    
    <!-- Таблица с данными (для десктопа) -->
    <div class="hidden md:block w-full overflow-x-auto rounded-box overflow-hidden">
        <table class="table w-full">
            <thead class="text-white" style="background-color: #2D2D2D">
                <tr>
                    <th class="py-3 px-2 md:px-4"><%= t('views.admin.avatars.index.table_headers.user') %></th>
                    <th class="py-3 px-2 md:px-4"><%= t('views.admin.avatars.index.table_headers.avatar') %></th>
                    <th class="py-3 px-2 md:px-4"><%= t('views.admin.avatars.index.table_headers.status') %></th>
                    <th class="py-3 px-2 md:px-4"><%= t('views.admin.avatars.index.table_headers.creation_date') %></th>
                    <th class="py-3 px-2 md:px-4"><%= t('views.admin.avatars.index.table_headers.actions') %></th>
                </tr>
            </thead>
            <tbody class="text-white" style="background-color: #383838">
                <!-- Данные будут загружены через JavaScript -->
            </tbody>
        </table>
    </div>
    
    <!-- Карточки для мобильных устройств -->
    <div id="cardsContainer" class="md:hidden grid grid-cols-1 gap-4 mt-4 px-4">
        <!-- Карточки будут загружены через JavaScript -->
    </div>
    
    <!-- Пагинация -->
    <div id="paginationContainer" class="flex justify-center items-center gap-2 mt-6 flex-wrap px-4 overflow-x-auto">
        <!-- Пагинация будет загружена через JavaScript -->
    </div>
</div>

<!-- Модальное окно для просмотра аватара -->
<dialog id="avatarPreviewModal" class="modal">
  <div class="modal-box w-full max-w-2xl bg-[#1A1A1A] border border-amber-400 p-8 rounded">
    <h3 class="text-2xl text-amber-400 font-bold mb-4 break-words hyphens-auto">
      <%= t('views.admin.avatars.index.modal.title') %>
    </h3>
    <div class="flex flex-col items-center">
        <div id="avatarPreviewImage" class="w-48 h-48 rounded-full bg-gray-700 flex items-center justify-center mb-4 overflow-hidden">
            <span class="text-gray-400"><%= t('views.admin.avatars.index.modal.loading_image') %></span>
        </div>
        <div class="text-center mb-6">
            <p class="text-lg font-semibold text-white mb-2" id="avatarPreviewUsername"><%= t('views.admin.avatars.index.modal.username') %></p>
            <p class="text-sm text-gray-400 mb-1"><%= t('views.admin.avatars.index.modal.status') %>: <span id="avatarPreviewStatus" class="font-medium"><%= t('views.admin.avatars.index.js.loading_data') %></span></p>
            <p class="text-sm text-gray-400"><%= t('views.admin.avatars.index.modal.id') %>: <span id="avatarPreviewId" class="font-medium">-</span></p>
        </div>
    </div>
    <div class="modal-action flex flex-wrap justify-center gap-3">
      <button id="approveAvatarBtn" class="btn bg-green-600 hover:bg-green-700 text-white">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <%= t('views.admin.avatars.index.modal.approve') %>
      </button>
      <button id="rejectAvatarBtn" class="btn bg-red-600 hover:bg-red-700 text-white">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
        <%= t('views.admin.avatars.index.modal.reject') %>
      </button>
      <button type="button" class="btn text-sm px-4 py-2 text-gray-300 bg-[#2D2D2D] hover:bg-[#3A3A3A] transition" onclick="closeAvatarPreviewModal()">
        <%= t('views.admin.avatars.index.modal.close') %>
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<script>
    // Создаем объект с переводами
    const translations = {
        loading_data: "<%= t('views.admin.avatars.index.js.loading_data') %>",
        error_loading_data: "<%= t('views.admin.avatars.index.js.error_loading_data') %>",
        error_loading_data_table: "<%= t('views.admin.avatars.index.js.error_loading_data_table') %>",
        no_data: "<%= t('views.admin.avatars.index.js.no_data') %>",
        view_button: "<%= t('views.admin.avatars.index.js.view_button') %>",
        previous_page: "<%= t('views.admin.avatars.index.js.previous_page') %>",
        next_page: "<%= t('views.admin.avatars.index.js.next_page') %>",
        sort_ascending: "<%= t('views.admin.avatars.index.js.sort_ascending') %>",
        sort_descending: "<%= t('views.admin.avatars.index.js.sort_descending') %>",
        pending: "<%= t('views.admin.avatars.index.js.pending') %>",
        approved: "<%= t('views.admin.avatars.index.js.approved') %>",
        rejected: "<%= t('views.admin.avatars.index.js.rejected') %>",
        unknown_user: "<%= t('views.admin.avatars.index.js.unknown_user') %>",
        no_image: "<%= t('views.admin.avatars.index.js.no_image') %>",
        avatar_approved_success: "<%= t('views.admin.avatars.index.js.avatar_approved_success') %>",
        avatar_approved_error: "<%= t('views.admin.avatars.index.js.avatar_approved_error') %>",
        avatar_rejected_success: "<%= t('views.admin.avatars.index.js.avatar_rejected_success') %>",
        avatar_rejected_error: "<%= t('views.admin.avatars.index.js.avatar_rejected_error') %>",
        table_headers: {
            user: "<%= t('views.admin.avatars.index.table_headers.user') %>",
            avatar: "<%= t('views.admin.avatars.index.table_headers.avatar') %>",
            status: "<%= t('views.admin.avatars.index.table_headers.status') %>",
            creation_date: "<%= t('views.admin.avatars.index.table_headers.creation_date') %>",
            actions: "<%= t('views.admin.avatars.index.table_headers.actions') %>"
        }
    };
    
    // Получаем текущую локаль
    const currentLocale = "<%= I18n.locale %>";
    
    // Функция для получения перевода
    function t(key) {
        const keys = key.split('.');
        let result = translations;
        
        for (const k of keys) {
            if (result[k] === undefined) {
                return key;
            }
            result = result[k];
        }
        
        return result;
    }
    
    // Инициализация обработчиков событий
    document.addEventListener('DOMContentLoaded', function() {
        // Загрузка данных при загрузке страницы
        loadAvatars();
        
        // Обработчики для выпадающих списков
        document.querySelectorAll('.per-page-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                perPage = parseInt(this.getAttribute('data-value'));
                document.getElementById('perPageLabel').textContent = perPage;
                currentPage = 1; // Сбрасываем на первую страницу
                loadAvatars();
            });
        });
        
        document.querySelectorAll('.sort-order-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                sortOrder = this.getAttribute('data-value');
                document.getElementById('sortOrderLabel').textContent = 
                    sortOrder === 'asc' ? t('sort_ascending') : t('sort_descending');
                loadAvatars();
            });
        });
        
        document.querySelectorAll('.sort-by-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                sortBy = this.getAttribute('data-value');
                document.getElementById('sortByLabel').textContent = this.textContent;
                loadAvatars();
            });
        });
        
        // Обработчик для поиска
        document.getElementById('searchInput').addEventListener('input', function() {
            filters.user_name = this.value;
            // Используем debounce для оптимизации
            clearTimeout(this.searchTimeout);
            this.searchTimeout = setTimeout(() => {
                currentPage = 1;
                loadAvatars();
            }, 500);
        });
        
        // Обработчики для фильтров
        document.getElementById('statusFilter').addEventListener('change', function() {
            filters.status = this.value;
            currentPage = 1;
            loadAvatars();
        });
        
        document.getElementById('dateFromFilter').addEventListener('change', function() {
            filters.from = this.value;
            currentPage = 1;
            loadAvatars();
        });
        
        document.getElementById('dateToFilter').addEventListener('change', function() {
            filters.to = this.value;
            currentPage = 1;
            loadAvatars();
        });
    });
    
    // Глобальные переменные для хранения параметров
    let currentPage = 1;
    let perPage = 50;
    let sortBy = 'created_at';
    let sortOrder = 'desc';
    let filters = {
        status: '',
        from: '',
        to: '',
        user_name: ''
    };
    let isLoading = false;
    
    // Получаем ID пользователя и временную зону
    const actorId = document.querySelector('[data-user-id]').getAttribute('data-user-id');
    const timeZone = document.querySelector('[data-time-zone]').getAttribute('data-time-zone');
    
    // Функции для управления индикатором загрузки
    function showGlobalLoading() {
        if (!document.getElementById('global-loading')) {
            const loadingDiv = document.createElement('div');
            loadingDiv.id = 'global-loading';
            loadingDiv.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
            loadingDiv.innerHTML = `
                <div class="flex flex-col items-center">
                    <div class="w-16 h-16 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
                    <span class="mt-4 text-amber-400 text-lg">${t('loading_data')}</span>
                </div>
            `;
            document.body.appendChild(loadingDiv);
        }
    }
    
    function hideGlobalLoading() {
        const loadingDiv = document.getElementById('global-loading');
        if (loadingDiv) {
            loadingDiv.remove();
        }
    }
    
    // Функция для отображения индикатора загрузки в tbody
    function showLoading() {
        isLoading = true;
        
        // Для таблицы
        const tableBody = document.querySelector('tbody');
        if (tableBody) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="5" class="text-center py-10">
                        <div class="flex flex-col items-center justify-center">
                            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-400 mx-auto"></div>
                            <span class="mt-4 text-white font-medium">${t('loading_data')}</span>
                        </div>
                    </td>
                </tr>
            `;
        }
        
        // Для карточек
        const cardsContainer = document.getElementById('cardsContainer');
        if (cardsContainer) {
            cardsContainer.innerHTML = `
                <div class="flex flex-col items-center justify-center py-10 w-full">
                    <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-400 mx-auto"></div>
                    <span class="mt-4 text-white font-medium">${t('loading_data')}</span>
                </div>
            `;
        }
    }
    
    // Функция для загрузки данных с API
    async function loadAvatars() {
        if (isLoading) return;
        
        try {
            showLoading();
            
            // Формируем URL с параметрами
            const params = new URLSearchParams();
            params.append('page', currentPage);
            params.append('per', perPage);
            params.append('sort_by', sortBy);
            params.append('sort_order', sortOrder);
            
            // Добавляем фильтры
            Object.keys(filters).forEach(key => {
                if (filters[key]) {
                    params.append(key, filters[key]);
                }
            });
            
            const authServiceUrl = "<%= ENV['AUTH_SERVICE_URL'] %>";
            const url = `${authServiceUrl}/api/v1/discord_avatars/admin_index?${params.toString()}`;
            
            // Отправляем запрос
            const response = await fetch(url, {
                method: 'GET',
                credentials: 'include',
                headers: {
                    'X-User-ID': actorId
                }
            });
            
            if (!response.ok) {
                throw new Error(`Ошибка HTTP: ${response.status}`);
            }
            
            const data = await response.json();
            
            // Обновляем таблицу и карточки
            updateAvatarsTable(data.avatars || data);
            
            // Обновляем пагинацию
            if (data.pagination) {
                updatePagination(data.pagination);
            }
            
        } catch (error) {
            showAlertNotification(t('error_loading_data'));
            
            // Показываем сообщение об ошибке в таблице
            const tableBody = document.querySelector('tbody');
            if (tableBody) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center py-6 text-red-400">
                            ${t('error_loading_data_table')}
                        </td>
                    </tr>
                `;
            }
            
            // Показываем сообщение об ошибке в карточках
            const cardsContainer = document.getElementById('cardsContainer');
            if (cardsContainer) {
                cardsContainer.innerHTML = `
                    <div class="bg-[#383838] rounded-lg p-4 shadow-md text-red-400 text-center">
                        ${t('error_loading_data_table')}
                    </div>
                `;
            }
        } finally {
            isLoading = false;
        }
    }
    
    // Функция для получения названия статуса аватара
    function getStatusName(status) {
        const names = {
            'pending': t('pending'),
            'approved': t('approved'),
            'rejected': t('rejected')
        };
    
        return names[status] || status;
    }
    
    // Функция для обновления таблицы и карточек
    function updateAvatarsTable(avatars) {
        // Обновляем таблицу (для десктопа)
        const tableBody = document.querySelector('tbody');
        
        if (!avatars || avatars.length === 0) {
            if (tableBody) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center py-6 text-gray-400">
                            ${t('no_data')}
                        </td>
                    </tr>
                `;
            }
            
            // Обновляем карточки (для мобильных)
            const cardsContainer = document.getElementById('cardsContainer');
            if (cardsContainer) {
                cardsContainer.innerHTML = `
                    <div class="bg-[#383838] rounded-lg p-4 shadow-md text-center text-gray-400">
                        ${t('no_data')}
                    </div>
                `;
            }
            
            return;
        }
        
        // Обновляем таблицу
        if (tableBody) {
            tableBody.innerHTML = avatars.map(avatar => {
                // Форматируем дату
                const createdDate = formatDateWithTimeZone(avatar.created_at, timeZone);
                
                // Получаем статус
                const statusText = getStatusName(avatar.status);
                
                // Определяем класс для статуса
                let statusClass = '';
                switch (avatar.status) {
                    case 'pending':
                        statusClass = 'bg-amber-400 text-black';
                        break;
                    case 'approved':
                        statusClass = 'bg-green-500 text-black';
                        break;
                    case 'rejected':
                        statusClass = 'bg-red-500 text-black';
                        break;
                    default:
                        statusClass = 'bg-[#525252] text-white';
                        break;
                }
                
                // Получаем имя пользователя из нового формата ответа API
                const userName = avatar.user?.username || t('unknown_user');
                
                return `
                    <tr data-avatar-id="${avatar.id}" data-username="${userName}">
                        <td class="py-3 px-2 md:px-4">${userName}</td>
                        <td class="py-3 px-2 md:px-4">
                            <div class="w-12 h-12 rounded-full bg-gray-700 flex items-center justify-center overflow-hidden">
                                ${avatar.url ? 
                                    `<img src="${avatar.url}" alt="Аватар" class="w-full h-full object-cover">` : 
                                    `<span class="text-gray-400 text-xs">${t('no_image')}</span>`
                                }
                            </div>
                        </td>
                        <td class="py-3 px-2 md:px-4">
                            <span class="px-2 py-1 rounded-full ${statusClass} text-xs">${statusText}</span>
                        </td>
                        <td class="py-3 px-2 md:px-4">${createdDate}</td>
                        <td class="py-3 px-2 md:px-4">
                            <div class="flex gap-2">
                                <button class="btn btn-xs md:btn-sm bg-amber-400 text-black hover:bg-amber-300 border-none transition view-btn" 
                                    data-id="${avatar.id}" 
                                    data-username="${userName}"
                                    data-avatar-url="${avatar.url || ''}"
                                    data-avatar-status="${avatar.status}">
                                    ${t('view_button')}
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }
        
        // Обновляем карточки (для мобильных)
        const cardsContainer = document.getElementById('cardsContainer');
        if (cardsContainer) {
            cardsContainer.innerHTML = avatars.map(avatar => {
                // Форматируем дату
                const createdDate = formatDateWithTimeZone(avatar.created_at, timeZone);
                
                // Получаем статус
                const statusText = getStatusName(avatar.status);
                
                // Определяем класс для статуса
                let statusClass = '';
                switch (avatar.status) {
                    case 'pending':
                        statusClass = 'bg-amber-400 text-black';
                        break;
                    case 'approved':
                        statusClass = 'bg-green-500 text-black';
                        break;
                    case 'rejected':
                        statusClass = 'bg-red-500 text-black';
                        break;
                    default:
                        statusClass = 'bg-[#525252] text-white';
                        break;
                }
                
                // Получаем имя пользователя из нового формата ответа API
                const userName = avatar.user?.username || t('unknown_user');
                
                return `
                    <div class="bg-[#383838] rounded-lg p-4 shadow-md">
                        <div class="flex items-center mb-4">
                            <div class="w-16 h-16 rounded-full bg-gray-700 flex items-center justify-center overflow-hidden mr-4">
                                ${avatar.url ? 
                                    `<img src="${avatar.url}" alt="Аватар" class="w-full h-full object-cover">` : 
                                    `<span class="text-gray-400 text-xs">${t('no_image')}</span>`
                                }
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-white break-words">${userName}</h3>
                                <span class="px-2 py-1 rounded-full ${statusClass} text-xs mt-1 inline-block">${statusText}</span>
                            </div>
                        </div>
                        <div class="text-sm">
                            <p class="text-gray-400 mb-1">${t('table_headers.creation_date')}</p>
                            <p class="text-white mb-3">${createdDate}</p>
                        </div>
                        <div class="mt-4 flex justify-end gap-2">
                            <button class="btn btn-xs bg-amber-400 text-black hover:bg-amber-300 border-none transition view-btn" 
                                data-id="${avatar.id}" 
                                data-username="${userName}"
                                data-avatar-url="${avatar.url || ''}"
                                data-avatar-status="${avatar.status}">
                                ${t('view_button')}
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }
        
        // Добавляем обработчики событий для кнопок действий
        addAvatarActionListeners();
    }
    
    // Функция для форматирования даты с учетом временной зоны
    function formatDateWithTimeZone(dateString, timeZoneName) {
        const date = new Date(dateString);
        
        // Преобразование временной зоны в формат IANA
        const timeZoneNameMap = {
          'Moscow': 'Europe/Moscow',
          'Kaliningrad': 'Europe/Kaliningrad',
          'Samara': 'Europe/Samara',
          'Yekaterinburg': 'Asia/Yekaterinburg',
          'Omsk': 'Asia/Omsk',
          'Krasnoyarsk': 'Asia/Krasnoyarsk',
          'Irkutsk': 'Asia/Irkutsk',
          'Yakutsk': 'Asia/Yakutsk',
          'Vladivostok': 'Asia/Vladivostok',
          'Magadan': 'Asia/Magadan',
          'Kamchatka': 'Asia/Kamchatka'
        };
        
        // Получаем правильный формат временной зоны или используем переданную
        const ianaTimeZone = timeZoneNameMap[timeZoneName] || timeZoneName;
        
        try {
          // Форматируем дату отдельно
          const datePart = new Intl.DateTimeFormat('ru-RU', {
            timeZone: ianaTimeZone,
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
          }).format(date);
          
          // Форматируем время отдельно
          const timePart = new Intl.DateTimeFormat('ru-RU', {
            timeZone: ianaTimeZone,
            hour: '2-digit',
            minute: '2-digit'
          }).format(date);
          
          // Объединяем дату и время без запятой и без временной зоны
          return `${datePart} ${timePart}`;
        } catch (error) {
          console.error('Ошибка с временной зоной ' + ianaTimeZone + ':', error);
          
          // В случае ошибки используем UTC
          const datePart = new Intl.DateTimeFormat('ru-RU', {
            timeZone: 'UTC',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
          }).format(date);
          
          const timePart = new Intl.DateTimeFormat('ru-RU', {
            timeZone: 'UTC',
            hour: '2-digit',
            minute: '2-digit'
          }).format(date);
          
          return `${datePart} ${timePart}`;
        }
    }
    
    // Функция для обновления пагинации
    function updatePagination(pagination) {
        const container = document.getElementById('paginationContainer');
        const totalPages = Math.ceil(pagination.total / pagination.per);
        
        if (totalPages <= 1) {
            container.innerHTML = '';
            return;
        }
        
        let paginationHTML = '';
        
        // Определяем диапазон страниц для отображения
        let pageRange = [];
        if (totalPages <= 7) {
            pageRange = Array.from({length: totalPages}, (_, i) => i + 1);
        } else {
            if (currentPage <= 4) {
                pageRange = [1, 2, 3, 4, 5, '...', totalPages];
            } else if (currentPage >= totalPages - 3) {
                pageRange = [1, '...', totalPages - 4, totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
            } else {
                pageRange = [1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages];
            }
        }
        
        // Кнопка "Предыдущая"
        if (currentPage > 1) {
            paginationHTML += `
                <button class="btn border-amber-400 bg-[#121212] text-white hover:bg-[#1a1a1a] transition btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${currentPage - 1}">
                    ${t('previous_page')}
                </button>
            `;
        }
        
        // Страницы
        pageRange.forEach(page => {
            if (page === '...') {
                paginationHTML += `<span class="text-white px-2 whitespace-nowrap">...</span>`;
            } else {
                const isActive = page === currentPage;
                paginationHTML += `
                    <button class="btn border-amber-400 transition ${isActive ? 'bg-amber-400 text-black font-semibold shadow-md' : 'bg-[#121212] text-white hover:bg-[#1a1a1a]'} btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${page}">
                        ${page}
                    </button>
                `;
            }
        });
        
        // Кнопка "Следующая"
        if (currentPage < totalPages) {
            paginationHTML += `
                <button class="btn border-amber-400 bg-[#121212] text-white hover:bg-[#1a1a1a] transition btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${currentPage + 1}">
                    ${t('next_page')}
                </button>
            `;
        }
        
        container.innerHTML = paginationHTML;
        
        // Добавляем обработчики событий для кнопок пагинации
        document.querySelectorAll('.page-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                currentPage = parseInt(this.getAttribute('data-page'));
                loadAvatars();
            });
        });
    }
    
    // Функция для добавления обработчиков событий для кнопок действий
    function addAvatarActionListeners() {
        // Кнопка "Просмотр" (и в таблице, и в карточках)
        document.querySelectorAll('.view-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const avatarId = this.getAttribute('data-id');
                const userName = this.getAttribute('data-username');
                const avatarUrl = this.getAttribute('data-avatar-url');
                const avatarStatus = this.getAttribute('data-avatar-status');
                
                // Открываем модальное окно предварительного просмотра
                openAvatarPreviewModal(avatarId, userName, avatarUrl, avatarStatus);
            });
        });
    }
    
    // Функция для открытия модального окна предварительного просмотра аватара
    function openAvatarPreviewModal(avatarId, userName, avatarUrl, avatarStatus) {
        // Устанавливаем базовую информацию
        document.getElementById('avatarPreviewUsername').textContent = userName;
        document.getElementById('avatarPreviewId').textContent = avatarId;
        
        // Устанавливаем изображение
        const avatarImageContainer = document.getElementById('avatarPreviewImage');
        if (avatarUrl) {
            avatarImageContainer.innerHTML = `<img src="${avatarUrl}" alt="Аватар" class="w-full h-full object-cover">`;
        } else {
            avatarImageContainer.innerHTML = `<span class="text-gray-400">${t('no_image')}</span>`;
        }
        
        // Устанавливаем статус
        const statusElement = document.getElementById('avatarPreviewStatus');
        statusElement.textContent = getStatusName(avatarStatus);
        
        // Добавляем класс для цвета статуса
        statusElement.className = 'font-medium';
        switch (avatarStatus) {
            case 'pending':
                statusElement.classList.add('text-amber-400');
                break;
            case 'approved':
                statusElement.classList.add('text-green-500');
                break;
            case 'rejected':
                statusElement.classList.add('text-red-500');
                break;
            default:
                statusElement.classList.add('text-gray-400');
                break;
        }
        
        // Открываем модальное окно
        const modal = document.getElementById('avatarPreviewModal');
        if (modal) modal.showModal();
        
        // Добавляем обработчики событий для кнопок действий
        document.getElementById('approveAvatarBtn').onclick = function() {
            approveAvatar(avatarId);
        };
        
        document.getElementById('rejectAvatarBtn').onclick = function() {
            rejectAvatar(avatarId);
        };
    }
    
    // Функция для одобрения аватара
    async function approveAvatar(avatarId) {
        try {
            const authServiceUrl = "<%= ENV['AUTH_SERVICE_URL'] %>";
            const url = `${authServiceUrl}/api/v1/discord_avatars/${avatarId}/approve`;
            
            const response = await fetch(url, {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-ID': actorId
                },
                credentials: 'include'
            });
            
            if (!response.ok) {
                throw new Error(`Ошибка HTTP: ${response.status}`);
            }
            
            const data = await response.json();
            showNotification(t('avatar_approved_success'));
            
            // Обновляем данные в таблице
            loadAvatars();
            
            // Закрываем модальное окно
            closeAvatarPreviewModal();
        } catch (error) {
            console.error('Ошибка при одобрении аватара:', error);
            showAlertNotification(t('avatar_approved_error'));
        }
    }
    
    // Функция для отклонения аватара
    async function rejectAvatar(avatarId) {
        try {
            const authServiceUrl = "<%= ENV['AUTH_SERVICE_URL'] %>";
            const url = `${authServiceUrl}/api/v1/discord_avatars/${avatarId}/reject`;
            
            const response = await fetch(url, {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-ID': actorId
                },
                credentials: 'include'
            });
            
            if (!response.ok) {
                throw new Error(`Ошибка HTTP: ${response.status}`);
            }
            
            const data = await response.json();
            showNotification(t('avatar_rejected_success'));
            
            // Обновляем данные в таблице
            loadAvatars();
            
            // Закрываем модальное окно
            closeAvatarPreviewModal();
        } catch (error) {
            console.error('Ошибка при отклонении аватара:', error);
            showAlertNotification(t('avatar_rejected_error'));
        }
    }
    
    // Функция для закрытия модального окна предварительного просмотра
    function closeAvatarPreviewModal() {
        const modal = document.getElementById('avatarPreviewModal');
        if (modal) modal.close();
    }
</script>
