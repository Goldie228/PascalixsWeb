<div class="relative h-full min-h-screen overflow-hidden">
  <div class="flex h-full min-h-screen relative">
    <!-- Контейнер шторки -->
    <div id="drawer-container"
      class="w-[260px] transition-all duration-300 ease-in-out z-20 h-full min-h-screen absolute left-0 flex"
    >
      <!-- Вся левая панель -->
      <div class="shadow-md flex flex-col bg-[#2D2D2D] p-4 space-y-3 w-[258px] h-full min-h-screen">
        <h2 class="text-xl font-bold text-white mb-4"><%= t("admin.sidebar.title") %></h2>

        <%= link_to t("admin.sidebar.players"),
          admin_players_path,
          class: "btn btn-block border-none transition #{current_page?(admin_players_path) ? 'bg-amber-400 text-black' : 'bg-[#333333] text-white'}" %>

        <%= link_to t("admin.sidebar.removed_players"),
          admin_removed_players_path,
          class: "btn btn-block border-none transition #{current_page?(admin_removed_players_path) ? 'bg-amber-400 text-black' : 'bg-[#333333] text-white'}" %>

        <%= link_to t("admin.sidebar.appeals"),
          admin_punishment_appeals_path,
          class: "btn btn-block border-none transition #{current_page?(admin_punishment_appeals_path) ? 'bg-amber-400 text-black' : 'bg-[#333333] text-white'}" %>

        <%= link_to t("admin.sidebar.complaints"),
          admin_complaints_path,
          class: "btn btn-block border-none transition #{current_page?(admin_complaints_path) ? 'bg-amber-400 text-black' : 'bg-[#333333] text-white'}" %>

        <%= link_to t("admin.sidebar.donations"),
          admin_purchases_path,
          class: "btn btn-block border-none transition #{current_page?(admin_purchases_path) ? 'bg-amber-400 text-black' : 'bg-[#333333] text-white'}" %>

        <%= link_to t("admin.sidebar.rules"),
          admin_punishment_reasons_path,
          class: "btn btn-block border-none transition #{current_page?(admin_punishment_reasons_path) ? 'bg-amber-400 text-black' : 'bg-[#333333] text-white'}" %>

        <%= link_to t("admin.sidebar.prices"),
          admin_products_path,
          class: "btn btn-block border-none transition #{current_page?(admin_products_path) ? 'bg-amber-400 text-black' : 'bg-[#333333] text-white'}" %>

        <%= link_to t("admin.sidebar.avatars"),
          admin_avatars_path,
          class: "btn btn-block border-none transition #{current_page?(admin_avatars_path) ? 'bg-amber-400 text-black' : 'bg-[#333333] text-white'}" %>

        <%= link_to "Фотогалерея",
          admin_galery_path,
          class: "btn btn-block border-none transition #{current_page?(admin_galery_path) ? 'bg-amber-400 text-black' : 'bg-[#333333] text-white'}" %>
      </div>

      <!-- Линия -->
      <div class="w-[2px] bg-amber-400 h-full min-h-screen rounded-tr-xl rounded-br-xl"></div>
    </div>

    <!-- Основной контент -->
    <div id="main-content" class="flex-1 h-full p-8 transition-all duration-300 ml-[260px] overflow-x-auto whitespace-nowrap">
      <% case active_section %>
      <% when 'players' %>
          <%= render partial: 'players_data' %>
      <% when 'removed_players' %>
          <%= render partial: 'removed_players_data' %>
      <% when 'punishment_appeals' %>
          <%= render partial: 'punishment_appeals_data' %>
      <% when 'complaints' %>
          <%= render partial: 'complaints_data' %>
      <% when 'purchases' %>
          <%= render partial: 'purchases_data' %>
      <% when 'punishment_reasons' %>
          <%= render partial: 'punishment_reasons_data' %>
      <% when 'products' %>
          <%= render partial: 'products_data' %>
      <% when 'avatars' %>
          <%= render partial: 'avatars_data' %>
      <% when 'galery' %>
          <%= render partial: 'galery_data' %>
      <% end %>
    </div>
  </div>

  <!-- Кнопка -->
  <button onclick="toggleDrawer()"
    id="drawer-toggle-btn"
    class="absolute top-10 w-10 h-10 rounded-full bg-[#121212] border-2 border-amber-400 text-amber-400 font-bold text-lg flex items-center justify-center hover:bg-[#1a1a1a] transition-all duration-300"
    style="box-shadow: 0 0 4px rgba(0,0,0,0.3); left: 290px;"
  >
    &lt;
  </button>
</div>

<script>
function adjustButtonPosition() {
  const nav = document.querySelector('.navbar');
  const button = document.getElementById('drawer-toggle-btn');
  if (nav && button) {
    const navHeight = nav.offsetHeight;
    button.style.top = `${navHeight / 2 - 20}px`;
  }
}

function applyDrawerState(open) {
  const drawer = document.getElementById('drawer-container');
  const button = document.getElementById('drawer-toggle-btn');
  const content = document.getElementById('main-content');

  if (open) {
    drawer.classList.remove('-translate-x-full');
    content.classList.add('ml-[260px]');
    button.style.left = '290px';
    button.innerHTML = '&lt;';
  } else {
    drawer.classList.add('-translate-x-full');
    content.classList.remove('ml-[260px]');
    button.style.left = '30px';
    button.innerHTML = '&gt;';
  }
}

function toggleDrawer() {
  const currentState = localStorage.getItem('drawerOpen') === 'true';
  const newState = !currentState;
  localStorage.setItem('drawerOpen', newState.toString());
  applyDrawerState(newState);
}

window.addEventListener('resize', adjustButtonPosition);
window.addEventListener('DOMContentLoaded', () => {
  adjustButtonPosition();

  const savedState = localStorage.getItem('drawerOpen');
  const isOpen = savedState === null ? true : savedState === 'true';
  applyDrawerState(isOpen);
});
</script>
