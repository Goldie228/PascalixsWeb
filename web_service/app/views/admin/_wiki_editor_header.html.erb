<!--
  _wiki_editor_header.html.erb
  Компонент для ввода заголовка и URL (slug) Wiki страницы.
  Включает автоматическую генерацию slug из заголовка и валидацию уникальности.
-->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 shrink-0 w-full">
  <div class="md:col-span-2 w-full min-w-0">
    <label for="wikiPageTitle" class="block text-white mb-2 font-medium">Заголовок страницы <span class="text-red-500">*</span></label>
    <input 
      type="text" 
      id="wikiPageTitle" 
      name="title" 
      maxlength="255" 
      class="w-full bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 outline-none rounded-lg px-3 py-2 transition-colors placeholder-gray-500 text-sm md:text-base" 
      placeholder="Например: Правила сервера"
      value="<%= local_assigns[:title] || '' %>"
      required
      oninput="WikiEditorHeader.onTitleInput(this.value)"
    >
  </div>

  <div class="w-full min-w-0 mt-4 md:mt-0">
    <label for="wikiPageSlug" class="block text-white mb-2 font-medium">URL (Slug)</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-bold text-sm">/</span>
      <input 
        type="text" 
        id="wikiPageSlug" 
        name="slug" 
        class="w-full bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 outline-none rounded-lg px-3 py-2 pl-7 transition-colors placeholder-gray-500 text-sm md:text-base" 
        placeholder="pravila-servera"
        value="<%= local_assigns[:slug] || '' %>"
        data-original-slug="<%= local_assigns[:slug] || '' %>"
        required
        oninput="WikiEditorHeader.onSlugInput(this.value)"
      >
      <div id="slugValidation" class="absolute right-3 top-1/2 -translate-y-1/2"></div>
    </div>
    <div id="slugError" class="text-xs text-red-400 mt-2 hidden"></div>
  </div>
</div>

<script>
window.WikiEditorHeader = window.WikiEditorHeader || {};

// Таймер для debounce
WikiEditorHeader.debounceTimer = null;

/**
 * Обработка ввода заголовка
 */
WikiEditorHeader.onTitleInput = function(title) {
  // Определяем режим (edit или create)
  const pageIdEl = document.getElementById('wikiPageId');
  const isEditMode = pageIdEl && pageIdEl.value;
  
  const slugInput = document.getElementById('wikiPageSlug');
  if (!slugInput) return;
  
  // При редактировании не меняем slug автоматически если он уже заполнен
  if (isEditMode && slugInput.value && slugInput.dataset.originalSlug) {
    return;
  }
  
  // Не меняем если пользователь сам редактирует slug
  if (document.activeElement === slugInput) return;
  
  // Генерируем slug
  WikiEditorHeader.generateSlugFromTitle(title);
};

/**
 * Генерация slug из заголовка
 */
WikiEditorHeader.generateSlugFromTitle = function(title) {
  const slugInput = document.getElementById('wikiPageSlug');
  if (!slugInput || document.activeElement === slugInput) return;
  
  const ru = "А-а-Б-б-В-в-Г-г-Д-д-Е-е-Ё-ё-Ж-ж-З-з-И-и-Й-й-К-к-Л-л-М-м-Н-н-О-о-П-п-Р-р-С-с-Т-т-У-у-Ф-ф-Х-х-Ц-ц-Ч-ч-Ш-ш-Щ-щ-Ъ-ъ-Ы-ы-Ь-ь-Э-э-Ю-ю-Я-я".split("-");
  const en = "A-a-B-b-V-v-G-g-D-d-E-e-E-e-ZH-zh-Z-z-I-i-J-j-K-k-L-l-M-m-N-n-O-o-P-p-R-r-S-s-T-t-U-u-F-f-H-h-TS-ts-CH-ch-SH-sh-SCH-shch-'-'-Y-y-'-'-E-e-YU-yu-YA-ya".split("-");

  let slug = title.split('').map(char => {
    const idx = ru.indexOf(char);
    return idx !== -1 ? en[idx] : char;
  }).join('');

  slug = slug.toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .trim();

  slugInput.value = slug;
  WikiEditorHeader.validateSlug(slug);
};

/**
 * Нормализация slug (удаление дефисов в начале/конце, схлопывание множественных дефисов)
 */
WikiEditorHeader.normalizeSlug = function(slug) {
  return slug
    .toLowerCase()
    .replace(/[^a-z0-9-]/g, '-')    // Заменяем невалидные символы на дефис
    .replace(/-+/g, '-')            // Схлопываем множественные дефисы
    .replace(/^-+|-+$/g, '');       // Удаляем дефисы в начале и конце
};

/**
 * Обработка ввода slug
 */
WikiEditorHeader.onSlugInput = function(slug) {
  // Сбрасываем таймер
  if (WikiEditorHeader.debounceTimer) {
    clearTimeout(WikiEditorHeader.debounceTimer);
  }
  
  // Мягкая нормализация в реальном времени
  const normalized = WikiEditorHeader.normalizeSlug(slug);
  const slugInput = document.getElementById('wikiPageSlug');
  
  // Если slug был изменён нормализацией - обновляем поле (только если пользователь не в процессе ввода)
  if (normalized !== slug && normalized !== '') {
    const cursorPos = slugInput.selectionStart;
    slugInput.value = normalized;
    // Пытаемся сохранить позицию курсора
    const newCursorPos = Math.min(cursorPos, normalized.length);
    slugInput.setSelectionRange(newCursorPos, newCursorPos);
    slug = normalized;
  }
  
  // Debounce валидации
  WikiEditorHeader.debounceTimer = setTimeout(() => {
    WikiEditorHeader.validateSlug(slug);
  }, 500);
};

/**
 * Валидация Slug'а
 */
WikiEditorHeader.validateSlug = async function(slug) {
  const validationDiv = document.getElementById('slugValidation');
  const errorDiv = document.getElementById('slugError');
  const createBtn = document.getElementById('createPageBtn');
  const updateBtn = document.getElementById('updatePageBtn');

  if (!validationDiv) return;

  // Если slug пустой или слишком короткий
  if (!slug || slug.length < 3) {
    validationDiv.innerHTML = '';
    if (errorDiv) errorDiv.classList.add('hidden');
    window.isSlugValid = false;
    if (createBtn) createBtn.disabled = true;
    if (updateBtn) updateBtn.disabled = true;
    return;
  }

  // Показываем индикатор загрузки
  validationDiv.innerHTML = '<svg class="animate-spin h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';

  // Определяем ID контейнера
  const pageIdEl = document.getElementById('wikiPageId');
  const containerId = (pageIdEl && pageIdEl.value) ? 'editWikiPageModal' : 'addWikiPageModal';

  // Получаем настройки
  const config = typeof getWikiAuthConfig === 'function' 
    ? getWikiAuthConfig(containerId)
    : { serviceUrl: '', apiKey: '', userId: '' };

  if (!config.serviceUrl || !config.apiKey || !config.userId) {
    validationDiv.innerHTML = '<svg class="h-4 w-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>';
    window.isSlugValid = false;
    return;
  }

  try {
    const slugInput = document.getElementById('wikiPageSlug');
    const originalSlug = slugInput?.dataset.originalSlug || '';
    const pageId = pageIdEl?.value || null;

    // Формируем URL
    const baseUrl = config.serviceUrl.replace(/\/$/, '');
    const url = `${baseUrl}/api/v1/wiki/pages/check_slug?slug=${encodeURIComponent(slug)}`;

    console.log('[WikiEditorHeader] Проверка slug:', { slug, pageId, originalSlug });

    const response = await fetch(url, {
      method: 'GET',
      headers: {
        'X-User-ID': config.userId,
        'Authorization': `Bearer ${config.apiKey}`
      }
    });

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }

    const data = await response.json();
    console.log('[WikiEditorHeader] Ответ:', data);

    const isAvailable = data.available;

    if (slug.length < 3) {
      validationDiv.innerHTML = '<svg class="h-4 w-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>';
      if (errorDiv) {
        errorDiv.textContent = 'Минимум 3 символа';
        errorDiv.classList.remove('hidden');
      }
      window.isSlugValid = false;
    } else if (isAvailable === true) {
      // Slug свободен
      validationDiv.innerHTML = '<svg class="h-4 w-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
      if (errorDiv) errorDiv.classList.add('hidden');
      window.isSlugValid = true;
    } else if (isAvailable === false) {
      // Slug занят - проверяем режим редактирования
      if (pageId && originalSlug && slug === originalSlug) {
        // Редактируем свою страницу - slug не изменился
        validationDiv.innerHTML = '<svg class="h-4 w-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
        if (errorDiv) errorDiv.classList.add('hidden');
        window.isSlugValid = true;
      } else {
        // Slug занят другой страницей
        validationDiv.innerHTML = '<svg class="h-4 w-4 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>';
        if (errorDiv) {
          errorDiv.textContent = 'URL уже используется';
          errorDiv.classList.remove('hidden');
        }
        window.isSlugValid = false;
      }
    } else {
      // Неожиданный ответ - разрешаем
      validationDiv.innerHTML = '<svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';
      if (errorDiv) errorDiv.classList.add('hidden');
      window.isSlugValid = true;
    }
  } catch (error) {
    console.error('[WikiEditorHeader] Ошибка:', error);
    validationDiv.innerHTML = '<svg class="h-4 w-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>';
    window.isSlugValid = false;
  }

  // Блокируем/разблокируем кнопки
  if (createBtn) createBtn.disabled = !window.isSlugValid;
  if (updateBtn) updateBtn.disabled = !window.isSlugValid;
};

/**
 * Инициализация при загрузке
 */
WikiEditorHeader.init = function() {
  const slugInput = document.getElementById('wikiPageSlug');
  if (slugInput && slugInput.value) {
    const pageId = document.getElementById('wikiPageId');
    if (pageId && pageId.value) {
      window.isSlugValid = true;
    }
  }
};

document.addEventListener('DOMContentLoaded', WikiEditorHeader.init);
</script>

<style>
#slugValidation svg {
  display: inline-block;
  vertical-align: middle;
}
#slugError {
  word-break: break-word;
}

/* Адаптивные стили для мобильных устройств */
@media (max-width: 768px) {
  .grid-cols-1.md\:grid-cols-3 > div {
    margin-bottom: 0.75rem;
  }
  .grid-cols-1.md\:grid-cols-3 > div:last-child {
    margin-bottom: 0;
  }
}
</style>
