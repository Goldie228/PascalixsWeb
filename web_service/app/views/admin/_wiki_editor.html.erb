<!-- _wiki_editor.html.erb -->
<!-- Основной контейнер, который собирает все компоненты вместе -->
<!-- Версия 2.7-fixed -->
<div class="wiki-editor-container" 
     data-mode="<%= local_assigns[:mode] || 'create' %>"
     data-service-url="<%= h(ENV['AUTH_SERVICE_URL'] || '') %>" 
     data-api-key="<%= h(ENV['INTER_SERVICE_API_KEY'] || '') %>"
     data-user-id="<%= h(current_user&.id || '') %>">
  <!-- Подключаем компонент заголовка и slug -->
  <%= render 'wiki_editor_header', 
      title: local_assigns[:title], 
      slug: local_assigns[:slug],
      page_id: local_assigns[:page_id] %>
  
  <!-- Подключаем компонент категории и позиции -->
  <%= render 'wiki_editor_category_position', 
      categories: local_assigns[:categories], 
      category_id: local_assigns[:category_id], 
      position: local_assigns[:position] %>
  
  <!-- Подключаем компонент редактора контента -->
  <%= render 'wiki_editor_content', 
      content: local_assigns[:content], 
      temp_image_ids: local_assigns[:temp_image_ids], 
      page_id: local_assigns[:page_id] %>
</div>

<script>
window.WikiEditor = window.WikiEditor || {};

/**
 * Инициализация редактора для модального окна
 */
WikiEditor.initWikiEditor = function(containerId, mode = 'create') {
  const config = typeof getWikiAuthConfig === 'function' ? getWikiAuthConfig(containerId) : null;
  if (!config || !config.serviceUrl || !config.apiKey || !config.userId) {
    console.error('[WikiEditor] Нет конфигурации для:', containerId);
    return;
  }
  
  // Инициализируем редактор контента
  if (window.WikiEditorContent?.initEditor) {
    WikiEditorContent.initEditor(containerId, mode);
  }
  
  // Загружаем категории (только для addWikiPageModal при первом открытии)
  if (mode === 'create' && window.WikiEditorCategory?.loadCategories) {
    WikiEditorCategory.loadCategories(containerId);
  }
};
</script>

<style>
.wiki-editor-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
}
</style>
