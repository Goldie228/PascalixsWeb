<!-- _wiki_editor.html.erb -->
<div class="wiki-editor-container" data-mode="<%= local_assigns[:mode] || 'create' %>">
  <!-- Основная информация -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 shrink-0">
    <div class="md:col-span-2">
      <label for="wikiPageTitle" class="block text-white mb-2 font-medium">Заголовок страницы <span class="text-red-500">*</span></label>
      <input 
        type="text" 
        id="wikiPageTitle" 
        name="title" 
        maxlength="255" 
        class="w-full bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 outline-none rounded-lg px-4 py-2 transition-colors placeholder-gray-500" 
        placeholder="Например: Правила сервера"
        value="<%= local_assigns[:title] || '' %>"
        required
        oninput="generateSlugFromTitle(this.value)"
      >
    </div>

    <div>
      <label for="wikiPageSlug" class="block text-white mb-2 font-medium">URL (Slug)</label>
      <div class="relative">
        <span class="absolute left-3 top-3 text-gray-400 font-bold">/</span>
        <input 
          type="text" 
          id="wikiPageSlug" 
          name="slug" 
          class="w-full bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 outline-none rounded-lg px-4 py-2 pl-8 transition-colors placeholder-gray-500" 
          placeholder="pravila-servera"
          value="<%= local_assigns[:slug] || '' %>"
          required
          oninput="validateSlug(this.value)"
        >
        <div id="slugValidation" class="absolute right-3 top-3"></div>
      </div>
      <div id="slugError" class="text-xs text-red-400 mt-1 hidden"></div>
    </div>
  </div>

  <!-- Категория и Позиция -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 shrink-0">
    <div>
      <label for="wikiPageCategory" class="block text-white mb-2 font-medium">Категория</label>
      <div class="flex gap-2">
        <select id="wikiPageCategory" name="wiki_category_id" class="flex-1 bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 outline-none rounded-lg px-4 py-2 transition-colors cursor-pointer">
          <option value="" disabled>Выберите категорию...</option>
          <% if local_assigns[:categories] %>
            <% local_assigns[:categories].each do |category| %>
              <option value="<%= category.id %>" <%= 'selected' if local_assigns[:category_id] && category.id == local_assigns[:category_id].to_i %>><%= category.name %></option>
            <% end %>
          <% end %>
        </select>
        <button type="button" class="btn btn-square border-2 border-gray-600 text-amber-400 hover:bg-amber-900/20 hover:border-amber-400 transition flex items-center justify-center bg-[#262626]" title="Добавить категорию" onclick="openAddCategoryModal()">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
      <div id="categoryPath" class="text-xs text-gray-400 mt-1"></div>
    </div>

    <div>
      <label for="wikiPagePosition" class="block text-white mb-2 font-medium">Позиция</label>
      <input 
        type="number" 
        id="wikiPagePosition" 
        name="position" 
        value="<%= local_assigns[:position] || 0 %>"
        class="w-full bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 outline-none rounded-lg px-4 py-2 transition-colors placeholder-gray-500" 
      >
    </div>
  </div>

  <!-- Редактор Markdown -->
  <div class="flex-1 flex flex-col min-h-[400px]">
    <div class="flex justify-between items-center mb-2 shrink-0">
      <label class="block text-white font-medium">Содержание (Markdown) <span class="text-red-500">*</span></label>
      <span id="autosaveStatus" class="text-xs text-gray-400">Автосохранение включено</span>
    </div>
    
    <div class="border-2 border-gray-600 rounded-lg overflow-hidden bg-[#262626] shadow-inner flex-1 flex flex-col">
      <!-- Скрытый инпут для кастомной кнопки -->
      <input type="file" id="wikiPageFileInput" class="hidden" accept="image/*,.zip,.rar,.7z,.jar">
      
      <!-- EasyMDE Textarea -->
      <textarea id="wikiPageContent" name="content" class="flex-1 min-h-[300px]"><%= local_assigns[:content] || '' %></textarea>
    </div>
    
    <!-- Исправленный текст инструкции -->
    <p class="text-gray-400 text-xs mt-2 shrink-0">
      Для загрузки файлов и картинок нажмите на кнопку со стрелкой вверх в меню редактора.
    </p>
    
    <!-- Скрытое поле для ID загруженных картинок -->
    <input type="hidden" id="wikiPageTempImageIds" name="temp_image_ids" value="<%= local_assigns[:temp_image_ids] || '[]' %>">
    
    <!-- Скрытое поле для ID страницы (для редактирования) -->
    <% if local_assigns[:page_id] %>
      <input type="hidden" id="wikiPageId" name="id" value="<%= local_assigns[:page_id] %>">
    <% end %>
  </div>

  <!-- Статус публикации -->
  <div class="flex items-center gap-3 pt-4 border-t border-gray-700 shrink-0">
    <div class="form-control">
      <label class="label cursor-pointer justify-start gap-3 p-0">
        <input type="checkbox" id="wikiPagePublished" name="published" class="checkbox checkbox-warning bg-gray-700 border-gray-600 checked:bg-amber-400 checked:border-amber-400 rounded" <%= 'checked' if local_assigns[:published] %> />
        <span class="label-text text-white">Опубликовать сразу</span>
      </label>
    </div>
  </div>
</div>

<script>
// Объект для хранения экземпляров редактора
window.wikiEditorInstances = window.wikiEditorInstances || {};

// Функция инициализации редактора для конкретного контейнера
function initWikiEditor(containerId, mode = 'create') {
  const container = document.getElementById(containerId);
  if (!container) return;

  // Если уже существует экземпляр для этого контейнера, уничтожаем его
  if (window.wikiEditorInstances[containerId]) {
    window.wikiEditorInstances[containerId].toTextArea();
    delete window.wikiEditorInstances[containerId];
  }
  
  // Получаем настройки из data-атрибутов контейнера
  const authServiceUrl = container.dataset.serviceUrl || "<%= ENV['AUTH_SERVICE_URL'] %>";
  const apiKey = container.dataset.apiKey || "<%= ENV['INTER_SERVICE_API_KEY'] %>";
  const userId = container.dataset.userId || "<%= current_user.id %>";
  
  // Определяем ID для автосохранения в зависимости от режима
  const autosaveId = mode === 'edit' 
    ? `wiki_edit_page_${container.querySelector('#wikiPageId')?.value || 'new'}_draft`
    : 'wiki_new_page_draft';
    
  // Создаем экземпляр редактора
  const easyMDEInstance = new EasyMDE({
    element: container.querySelector('#wikiPageContent'),
    spellChecker: false,
    autosave: {
      enabled: true,
      uniqueId: autosaveId,
      delay: 1000,
      submit_delay: 5000,
      timeFormat: {
        locale: 'ru',
        format: {
          year: 'numeric',
          month: 'short',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
        },
      },
      text: "Автосохранено в: "
    },
    status: ["autosave", "lines", "words", "cursor"],
    placeholder: "Напишите здесь содержимое страницы...",
    previewClass: "editor-preview-custom",
    sideBySideFullscreen: false,
    toolbar: [
      "bold", "italic", "heading", "|", 
      "quote", "unordered-list", "ordered-list", "|", 
      "link", "code", "table", "|", 
      // --- Кнопки выравнивания ---
      {
        name: "align-left",
        action: function(editor){
            wrapSelection(editor, '<p style="text-align: left;">', '</p>');
        },
        className: "fa fa-align-left", 
        title: "По левому краю"
      },
      {
        name: "align-center",
        action: function(editor){
            wrapSelection(editor, '<p style="text-align: center;">', '</p>');
        },
        className: "fa fa-align-center", 
        title: "По центру"
      },
      {
        name: "align-right",
        action: function(editor){
            wrapSelection(editor, '<p style="text-align: right;">', '</p>');
        },
        className: "fa fa-align-right", 
        title: "По правому краю"
      },
      {
        name: "align-justify",
        action: function(editor){
            wrapSelection(editor, '<p style="text-align: justify;">', '</p>');
        },
        className: "fa fa-align-justify", 
        title: "По ширине"
      },
      // -------------------------
      "|",
      // --- Кастомные блоки ---
      {
        name: "alert-info",
        action: function(editor) {
          insertAlertBlock(editor, 'info');
        },
        className: "fa fa-info-circle",
        title: "Информационный блок"
      },
      {
        name: "alert-warning",
        action: function(editor) {
          insertAlertBlock(editor, 'warning');
        },
        className: "fa fa-exclamation-triangle",
        title: "Блок предупреждения"
      },
      {
        name: "alert-danger",
        action: function(editor) {
          insertAlertBlock(editor, 'danger');
        },
        className: "fa fa-times-circle",
        title: "Блок ошибки"
      },
      {
        name: "alert-success",
        action: function(editor) {
          insertAlertBlock(editor, 'success');
        },
        className: "fa fa-check-circle",
        title: "Блок успеха"
      },
      // -------------------------
      "|",
      // --- Дополнительные элементы ---
      {
        name: "toc",
        action: function(editor) {
          insertTOC(editor);
        },
        className: "fa fa-list",
        title: "Вставить оглавление"
      },
      {
        name: "tabs",
        action: function(editor) {
          insertTabs(editor);
        },
        className: "fa fa-folder-open",
        title: "Вставить вкладки"
      },
      {
        name: "spoiler",
        action: function(editor) {
          insertSpoiler(editor);
        },
        className: "fa fa-eye-slash",
        title: "Вставить спойлер"
      },
      // -------------------------
      "|",
      // Кастомная кнопка загрузки
      {
        name: "upload-action", 
        action: function(editor){
            container.querySelector('#wikiPageFileInput').click();
        },
        className: "fa fa-upload", 
        title: "Загрузить файл/картинку"
      },
      "|",
      // Кнопка режима предпросмотра (замена side-by-side)
      {
        name: "preview-only",
        action: function(editor) {
          togglePreviewOnly(containerId);
        },
        className: "fa fa-eye",
        title: "Режим предпросмотра"
      },
      // Кастомная кнопка Fullscreen
      {
        name: "modal-fullscreen",
        action: function(editor) {
            toggleModalFullscreen(containerId);
        },
        className: "fa fa-expand",
        title: "Полный экран модального окна"
      }
    ],
    imageUploadFunction: function(file, onSuccess, onError) {
      uploadCustomFile(file, onSuccess, onError, containerId);
    },
    // Обновляем статус автосохранения
    renderingConfig: {
      singleLineBreaks: false,
      codeSyntaxHighlighting: true,
    },
    // Добавляем обработчик для обновления статуса автосохранения
    callbacks: {
      onAutosave: function() {
        const statusElement = container.querySelector('#autosaveStatus');
        if (statusElement) {
          statusElement.textContent = 'Сохранено в ' + new Date().toLocaleTimeString();
          statusElement.classList.add('text-green-400');
          
          setTimeout(() => {
            statusElement.textContent = mode === 'edit' 
              ? 'Автосохранение включено (редактирование)' 
              : 'Автосохранение включено (создание)';
            statusElement.classList.remove('text-green-400');
          }, 2000);
        }
      }
    }
  });
  
  // Сохраняем экземпляр в глобальном объекте
  window.wikiEditorInstances[containerId] = easyMDEInstance;
  
  // Подписываемся на выбор файла
  container.querySelector('#wikiPageFileInput').addEventListener('change', function(e) {
    if (this.files && this.files.length > 0) {
      uploadCustomFile(this.files[0], null, null, containerId);
      this.value = ''; 
    }
  });
  
  // Возвращаем экземпляр для возможного использования
  return easyMDEInstance;
}

// Функция переключения режима только предпросмотра
function togglePreviewOnly(containerId) {
  const container = document.getElementById(containerId);
  if (!container) return;

  const editorInstance = window.wikiEditorInstances[containerId];
  if (!editorInstance) return;

  // Находим контейнер редактора
  const editorWrapper = container.querySelector('.border-2.border-gray-600.rounded-lg');
  if (!editorWrapper) return;

  const cmWrapper = editorInstance.codemirror.getWrapperElement();
  const toolbar = container.querySelector('.editor-toolbar');
  let preview = container.querySelector('.editor-preview-side');

  // Если preview не существует, создаем его
  if (!preview) {
    preview = document.createElement('div');
    preview.className = 'editor-preview-side editor-preview-custom';
    editorWrapper.appendChild(preview);
  }

  // Проверяем, активен ли уже режим предпросмотра
  const isPreviewOnly = container.classList.contains('preview-only-mode');

  // Находим кнопку preview-only
  const btn = container.querySelector('.editor-toolbar .fa-eye') || container.querySelector('.editor-toolbar .fa-eye-slash');

  if (isPreviewOnly) {
    // Возвращаем обычный режим
    container.classList.remove('preview-only-mode');
    if (cmWrapper) cmWrapper.style.display = '';
    if (toolbar) toolbar.style.display = '';

    if (preview) {
      preview.style.display = 'none';
    }

    if (btn) {
      btn.classList.remove('fa-eye-slash');
      btn.classList.add('fa-eye');
      btn.title = 'Режим предпросмотра';
    }
  } else {
    // Включаем режим только предпросмотра
    container.classList.add('preview-only-mode');
    if (cmWrapper) cmWrapper.style.display = 'none';
    if (toolbar) toolbar.style.display = 'none';

    if (btn) {
      btn.classList.remove('fa-eye');
      btn.classList.add('fa-eye-slash');
      btn.title = 'Обычный режим';
    }

    // Рендерим предпросмотр
    const content = editorInstance.value();
    const rendered = editorInstance.options.previewRender(content);
    if (preview) {
      preview.innerHTML = rendered;
      preview.style.display = 'block';
      preview.style.width = '100%';
      preview.style.height = '100%';
      preview.style.position = 'relative';
      preview.style.borderLeft = 'none';
      preview.style.overflowY = 'auto';
    }
  }

  // Обновляем размер редактора с задержкой для анимации
  setTimeout(() => {
    if (editorInstance) {
      editorInstance.codemirror.refresh();
    }
  }, 100);
}

// Функция переключения полного экрана для Модального окна
function toggleModalFullscreen(containerId) {
  const container = document.getElementById(containerId);
  if (!container) return;

  const modalBox = container.closest('.modal-box');
  if (!modalBox) return;

  const editorWrapper = container.querySelector('.border-2.border-gray-600.rounded-lg');
  const btn = container.querySelector('.editor-toolbar .fa-expand') || container.querySelector('.editor-toolbar .fa-compress');

  const isModalFullscreen = modalBox.classList.contains('is-fullscreen');

  if (isModalFullscreen) {
    modalBox.classList.remove('is-fullscreen');
    if (btn) {
      btn.classList.remove('fa-compress');
      btn.classList.add('fa-expand');
      btn.title = 'Полноэкранный режим модального окна';
    }
  } else {
    modalBox.classList.add('is_fullscreen');
    if (btn) {
      btn.classList.remove('fa-expand');
      btn.classList.add('fa-compress');
      btn.title = 'Выйти из полноэкранного режима';
    }
  }

  // Обновляем размеры редактора с задержкой для анимации
  setTimeout(() => {
    const editorInstance = window.wikiEditorInstances[containerId];
    if (editorInstance) {
      editorInstance.codemirror.refresh();

      // Если активен режим side-by-side, обновляем его размеры
      if (editorWrapper && editorWrapper.classList.contains('editor-preview-active-side')) {
        updateSideBySideLayout(containerId);
      }
    }
  }, 350);
}

// Функция для обновления layout в режиме side-by-side
function updateSideBySideLayout(containerId) {
  const container = document.getElementById(containerId);
  if (!container) return;

  const editorWrapper = container.querySelector('.border-2.border-gray-600.rounded-lg');
  const editor = container.querySelector('.CodeMirror');
  const preview = container.querySelector('.editor-preview-side');

  if (!editorWrapper || !editor || !preview) return;

  // Для десктопных устройств
  if (window.innerWidth > 768) {
    editor.style.width = '50%';
    preview.style.width = '50%';
    preview.style.position = 'absolute';
    preview.style.top = '0';
    preview.style.right = '0';
    preview.style.height = '100%';
    preview.style.bottom = 'auto';
  } 
  // Для мобильных устройств
  else {
    editor.style.width = '100%';
    editor.style.height = '50%';
    preview.style.width = '100%';
    preview.style.position = 'absolute';
    preview.style.top = 'auto';
    preview.style.bottom = '0';
    preview.style.height = '50%';
  }

  // Обновляем размер редактора
  Object.values(window.wikiEditorInstances).forEach(instance => {
    if (instance) {
      instance.codemirror.refresh();
    }
  });
}

// Логика Slug
function generateSlugFromTitle(title) {
  const slugInput = document.getElementById('wikiPageSlug');
  if (!slugInput || document.activeElement === slugInput) return;
  const ru = "А-а-Б-б-В-в-Г-г-Д-д-Е-е-Ё-ё-Ж-ж-З-з-И-и-Й-й-К-к-Л-л-М-м-Н-н-О-о-П-п-Р-р-С-с-Т-т-У-у-Ф-ф-Х-х-Ц-ц-Ч-ч-Ш-ш-Щ-щ-Ъ-ъ-Ы-ы-Ь-ь-Э-э-Ю-ю-Я-я".split("-");
  const en = "A-a-B-b-V-v-G-g-D-d-E-e-E-e-ZH-zh-Z-z-I-i-J-j-K-k-L-l-M-m-N-n-O-o-P-p-R-r-S-s-T-t-U-u-F-f-H-h-TS-ts-CH-ch-SH-sh-SCH-shch-'-'-Y-y-'-'-E-e-YU-yu-YA-ya".split("-");

  let slug = title.split('').map(char => {
    const idx = ru.indexOf(char);
    return idx !== -1 ? en[idx] : char;
  }).join('');

  slug = slug.toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .trim();

  slugInput.value = slug;
  validateSlug(slug);
}

// Валидация Slug'а
function validateSlug(slug) {
  const validationDiv = document.getElementById('slugValidation');
  const errorDiv = document.getElementById('slugError');
  const createBtn = document.getElementById('createPageBtn');
  const updateBtn = document.getElementById('updatePageBtn');

  if (!validationDiv) return;

  // Очищаем предыдущий таймаут
  if (window.slugValidationTimeout) clearTimeout(window.slugValidationTimeout);

  // Показываем индикатор загрузки
  validationDiv.innerHTML = '<svg class="animate-spin h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';

  // Устанавливаем задержку перед отправкой запроса
  window.slugValidationTimeout = setTimeout(async () => {
    try {
      // Получаем ID контейнера (может быть addWikiPageModal или editWikiPageModal)
      const containerId = document.getElementById('wikiPageId') ? 'editWikiPageModal' : 'addWikiPageModal';
      const container = document.getElementById(containerId);

      // Получаем настройки из data-атрибутов контейнера
      const authServiceUrl = container.dataset.serviceUrl || "<%= ENV['AUTH_SERVICE_URL'] %>";
      const apiKey = container.dataset.apiKey || "<%= ENV['INTER_SERVICE_API_KEY'] %>";
      const userId = container.dataset.userId || "<%= current_user.id %>";

      // Проверяем уникальность slug'а через API
      const pageId = document.getElementById('wikiPageId')?.value;
      const url = pageId 
        ? `${authServiceUrl}/api/v1/wiki/pages/check_slug?slug=${encodeURIComponent(slug)}&exclude_id=${pageId}`
        : `${authServiceUrl}/api/v1/wiki/pages/check_slug?slug=${encodeURIComponent(slug)}`;

      const response = await fetch(url, {
        method: 'GET',
        headers: {
          'X-User-ID': userId,
          'Authorization': `Bearer ${apiKey}`
        }
      });

      if (!response.ok) {
        throw new Error('Ошибка проверки slug');
      }

      const data = await response.json();
      const isUnique = data.unique;

      if (slug.length < 3) {
        validationDiv.innerHTML = '<svg class="h-4 w-4 text-red-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>';
        errorDiv.textContent = 'Slug должен содержать минимум 3 символа';
        errorDiv.classList.remove('hidden');
        window.isSlugValid = false;
      } else if (isUnique) {
        validationDiv.innerHTML = '<svg class="h-4 w-4 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
        errorDiv.classList.add('hidden');
        window.isSlugValid = true;
      } else {
        validationDiv.innerHTML = '<svg class="h-4 w-4 text-yellow-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>';
        errorDiv.textContent = 'Этот URL уже используется';
        errorDiv.classList.remove('hidden');
        window.isSlugValid = false;
      }
    } catch (error) {
      console.error('Error validating slug:', error);
      validationDiv.innerHTML = '<svg class="h-4 w-4 text-red-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>';
      errorDiv.textContent = 'Ошибка проверки URL';
      errorDiv.classList.remove('hidden');
      window.isSlugValid = false;
    }

    // Блокируем или разблокируем кнопку создания/обновления страницы
    if (createBtn) createBtn.disabled = !window.isSlugValid;
    if (updateBtn) updateBtn.disabled = !window.isSlugValid;
  }, 500);
}

// Вспомогательные функции (без изменений)
function wrapSelection(editor, prefix, suffix) {
  const cm = editor.codemirror;
  const text = cm.getSelection() || "";
  cm.replaceSelection(prefix + text + suffix);

  // Если ничего не было выделено, ставим курсор между тегами
  if (text === "") {
    var curPos = cm.getCursor();
    cm.setCursor(curPos.line, curPos.ch - suffix.length);
  }
  cm.focus();
}

// Функции для вставки кастомных блоков
function insertAlertBlock(editor, type) {
  const cm = editor.codemirror;
  const text = cm.getSelection() || "";
  let blockText = "";

  switch(type) {
    case 'info':
      blockText = `:::info\n${text || 'Информация'}\n:::`;
      break;
    case 'warning':
      blockText = `:::warning\n${text || 'Предупреждение'}\n:::`;
      break;
    case 'danger':
      blockText = `:::danger\n${text || 'Ошибка'}\n:::`;
      break;
    case 'success':
      blockText = `:::success\n${text || 'Успех'}\n:::`;
      break;
  }

  cm.replaceSelection(blockText);

  // Если ничего не было выделено, ставим курсор внутрь блока
  if (text === "") {
    const cursorPos = cm.getCursor();
    cm.setCursor(cursorPos.line - 2, 0);
  }
  cm.focus();
}

// Функция для вставки оглавления
function insertTOC(editor) {
  const cm = editor.codemirror;
  cm.replaceSelection("[[toc]]");
  cm.focus();
}

// Функция для вставки вкладок
function insertTabs(editor) {
  const cm = editor.codemirror;
  const text = cm.getSelection() || "";

  const tabsTemplate = `::: tabs
==Tab 1==
 ${text || 'Содержимое первой вкладки'}
==Tab 2==
Содержимое второй вкладки
:::`;

  cm.replaceSelection(tabsTemplate);

  // Если ничего не было выделено, ставим курсор в содержимое первой вкладки
  if (text === "") {
    const cursorPos = cm.getCursor();
    cm.setCursor(cursorPos.line - 3, 0);
  }
  cm.focus();
}

// Функция для вставки спойлера
function insertSpoiler(editor) {
  const cm = editor.codemirror;
  const text = cm.getSelection() || "";

  const spoilerTemplate = `<details>
<summary>Заголовок спойлера</summary>

 ${text || 'Скрытое содержимое'}

</details>`;

  cm.replaceSelection(spoilerTemplate);

  // Если ничего не было выделено, ставим курсор в содержимое спойлера
  if (text === "") {
    const cursorPos = cm.getCursor();
    cm.setCursor(cursorPos.line - 2, 0);
  }
  cm.focus();
}

// Загрузка картинок
async function uploadCustomFile(file, onSuccess, onError, containerId) {
  // Получаем ID контейнера, если не передан
  if (!containerId) {
    containerId = document.getElementById('wikiPageId') ? 'editWikiPageModal' : 'addWikiPageModal';
  }

  const container = document.getElementById(containerId);
  if (!container) return;

  // Получаем настройки из data-атрибутов контейнера
  const authServiceUrl = container.dataset.serviceUrl || "<%= ENV['AUTH_SERVICE_URL'] %>";
  const apiKey = container.dataset.apiKey || "<%= ENV['INTER_SERVICE_API_KEY'] %>";
  const userId = container.dataset.userId || "<%= current_user.id %>";

  const formData = new FormData();
  formData.append('file', file);

  // Сохраняем черновик перед загрузкой
  const editorInstance = window.wikiEditorInstances[containerId];
  if (editorInstance) {
    const currentContent = editorInstance.value();
    const mode = container.querySelector('.wiki-editor-container').getAttribute('data-mode');
    const autosaveId = mode === 'edit' 
      ? `wiki_edit_page_${container.querySelector('#wikiPageId')?.value || 'new'}_draft`
      : 'wiki_new_page_draft';
    localStorage.setItem(`${autosaveId}_safety`, currentContent);
  }

  showNotification('Загрузка файла...', 'info');

  const url = `${authServiceUrl}/api/v1/wiki/pages/upload_temporary_image`; 

  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'X-User-ID': userId,
        'Authorization': `Bearer ${apiKey}`
      },
      body: formData,
      credentials: 'include'
    });

    if (!response.ok) {
      const errData = await response.json().catch(() => ({}));
      throw new Error(errData.error || 'Ошибка загрузки');
    }

    const data = await response.json();

    // Сохраняем signed_id
    if (data.signed_id) {
      const tempImageIdsElement = container.querySelector('#wikiPageTempImageIds');
      if (tempImageIdsElement) {
        let uploadedTempImageIds = JSON.parse(tempImageIdsElement.value || '[]');
        uploadedTempImageIds.push(data.signed_id);
        tempImageIdsElement.value = JSON.stringify(uploadedTempImageIds);
      }
    }

    // Вставка в редактор
    if (onSuccess && data.url) {
      onSuccess(data.url);
    } else if (data.url) {
      const cm = editorInstance.codemirror;
      const cursorPos = cm.getCursor();

      let insertText = '';
      if (data.type === 'image') {
        insertText = `
![${data.filename}](${data.url})
`;
      } else {
        insertText = `[Скачать ${data.filename}](${data.url})`;
      }

      cm.replaceRange(insertText, cursorPos);
      cm.focus();
    } else {
       throw new Error('URL не получен');
    }

    showNotification('Файл загружен');

  } catch (error) {
    console.error('Upload error:', error);
    if (onError) onError('Ошибка загрузки: ' + error.message);
    else showAlertNotification('Ошибка загрузки: ' + error.message);
  }
}

// Загрузка категорий
async function loadWikiCategories() {
  const select = document.getElementById('wikiPageCategory');
  if (!select) return;

  select.innerHTML = '<option value="" disabled selected>Загрузка...</option>';

  // Получаем ID контейнера (может быть addWikiPageModal или editWikiPageModal)
  const containerId = document.getElementById('wikiPageId') ? 'editWikiPageModal' : 'addWikiPageModal';
  const container = document.getElementById(containerId);

  // Получаем настройки из data-атрибутов контейнера
  const authServiceUrl = container.dataset.serviceUrl || "<%= ENV['AUTH_SERVICE_URL'] %>";
  const apiKey = container.dataset.apiKey || "<%= ENV['INTER_SERVICE_API_KEY'] %>";
  const userId = container.dataset.userId || "<%= current_user.id %>";

  try {
    const url = `${authServiceUrl}/api/v1/wiki/categories`;

    const response = await fetch(url, {
      method: 'GET',
      headers: {
        'X-User-ID': userId,
        'Authorization': `Bearer ${apiKey}`
      }
    });

    if (!response.ok) throw new Error('Ошибка загрузки категорий');

    const data = await response.json();
    window.categoriesData = Array.isArray(data) ? data : (data.categories || []);
    const flatCats = flattenCategories(window.categoriesData);

    select.innerHTML = '<option value="">Без категории</option>';
    flatCats.forEach(cat => {
      const option = document.createElement('option');
      option.value = cat.id;
      option.textContent = cat.name;
      select.appendChild(option);
    });

    // Добавляем обработчик для отображения пути категории
    select.addEventListener('change', function() {
      updateCategoryPath(this.value);
    });

  } catch (error) {
    console.error('Error loading cats:', error);
    select.innerHTML = '<option value="" selected>Не удалось загрузить</option>';
  }
}

// Обновление пути категории
function updateCategoryPath(categoryId) {
  const pathElement = document.getElementById('categoryPath');
  if (!pathElement || !categoryId) {
    pathElement.textContent = '';
    return;
  }

  const path = getCategoryPath(window.categoriesData, categoryId);
  pathElement.textContent = path;
}

// Рекурсивная функция для получения пути категории
function getCategoryPath(categories, categoryId, path = '') {
  for (const cat of categories) {
    if (cat.id == categoryId) {
      return path ? `${path} → ${cat.name}` : cat.name;
    }

    if (cat.children && cat.children.length > 0) {
      const childPath = getCategoryPath(cat.children, categoryId, path ? `${path} → ${cat.name}` : cat.name);
      if (childPath) return childPath;
    }
  }
  return '';
}

// Рекурсивная распаковка категорий
function flattenCategories(cats, level = 0) {
  let res = [];
  cats.forEach(c => {
    c.name = "—".repeat(level) + " " + c.name;
    res.push(c);
    if (c.children && c.children.length > 0) {
      res = res.concat(flattenCategories(c.children, level + 1));
    }
  });
  return res;
}

// Инициализация при загрузке partial
document.addEventListener('DOMContentLoaded', function() {
  // Определяем режим работы (create/edit)
  const mode = document.querySelector('.wiki-editor-container').getAttribute('data-mode');

  // Определяем ID контейнера в зависимости от режима
  const containerId = mode === 'edit' ? 'editWikiPageModal' : 'addWikiPageModal';

  // Инициализируем редактор, если он еще не инициализирован
  if (!window.wikiEditorInstances[containerId]) {
    initWikiEditor(containerId, mode);
  } else {
    // Если редактор уже существует, обновляем его содержимое
    const contentElement = document.getElementById('wikiPageContent');
    if (contentElement) {
      window.wikiEditorInstances[containerId].value(contentElement.value);
    }

    // Обновляем статус автосохранения в зависимости от режима
    const autosaveStatus = document.getElementById('autosaveStatus');
    if (autosaveStatus) {
      if (mode === 'edit') {
        autosaveStatus.textContent = 'Автосохранение включено (редактирование)';
      } else {
        autosaveStatus.textContent = 'Автосохранение включено (создание)';
      }
    }
  }

  // Загружаем категории, если они не были переданы
  if (!<%= local_assigns[:categories].present? %>) {
    loadWikiCategories();
  }

  // Обновляем путь категории, если она выбрана
  const categorySelect = document.getElementById('wikiPageCategory');
  if (categorySelect && categorySelect.value) {
    updateCategoryPath(categorySelect.value);
  }
});
</script>

