<!-- _wiki_editor.html.erb -->
<!-- Основной контейнер, который собирает все компоненты вместе -->
<div class="wiki-editor-container" data-mode="<%= local_assigns[:mode] || 'create' %>">
  <!-- Подключаем компонент заголовка и slug -->
  <%= render 'wiki_editor_header', title: local_assigns[:title], slug: local_assigns[:slug] %>
  
  <!-- Подключаем компонент категории и позиции -->
  <%= render 'wiki_editor_category_position', 
      categories: local_assigns[:categories], 
      category_id: local_assigns[:category_id], 
      position: local_assigns[:position] %>
  
  <!-- Подключаем компонент редактора контента -->
  <%= render 'wiki_editor_content', 
      content: local_assigns[:content], 
      temp_image_ids: local_assigns[:temp_image_ids], 
      page_id: local_assigns[:page_id] %>
</div>

<script>
// Пространство имен для общих функций редактора
window.WikiEditor = window.WikiEditor || {};

// Функция инициализации редактора для конкретного контейнера
WikiEditor.initWikiEditor = function(containerId, mode = 'create') {
  // Инициализируем компонент редактора контента
  WikiEditorContent.initEditor(containerId, mode);
  
  // Загружаем категории, если они не были переданы
  if (!<%= local_assigns[:categories].present? %>) {
    WikiEditorCategory.loadCategories();
  }
  
  // Обновляем путь категории, если она выбрана
  const categorySelect = document.getElementById('wikiPageCategory');
  if (categorySelect && categorySelect.value) {
    WikiEditorCategory.updateCategoryPath(categorySelect.value);
  }
};

// Инициализация при загрузке partial
document.addEventListener('DOMContentLoaded', function() {
  // Определяем режим работы (create/edit)
  const mode = document.querySelector('.wiki-editor-container').getAttribute('data-mode');

  // Определяем ID контейнера в зависимости от режима
  const containerId = mode === 'edit' ? 'editWikiPageModal' : 'addWikiPageModal';

  // Инициализируем редактор
  WikiEditor.initWikiEditor(containerId, mode);
});
</script>

<style>
/* Общие стили для контейнера редактора */
.wiki-editor-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
}
</style>
