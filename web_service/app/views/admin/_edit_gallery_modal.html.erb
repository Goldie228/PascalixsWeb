<!-- Модальное окно для редактирования галереи -->
<dialog id="editGalleryModalE" class="modal">
  <div class="modal-box w-full max-w-4xl bg-[#1A1A1A] border border-amber-400 p-8 rounded">
    <h3 class="text-2xl text-amber-400 font-bold mb-6">Редактирование альбома</h3>
    
    <form id="editGalleryFormE" class="space-y-6">
      <!-- ID галереи (скрытое поле) -->
      <input type="hidden" id="editGalleryIdE" name="id">
      
      <!-- Название галереи -->
      <div>
        <label for="editGalleryTitleE" class="block text-white mb-2">Название альбома</label>
        <input 
          type="text" 
          id="editGalleryTitleE" 
          name="title" 
          maxlength="255" 
          class="input input-bordered w-full bg-[#262626] text-white" 
          placeholder="Введите название галереи"
          required
        >
        <div class="text-right mt-1">
          <span id="editTitleCharCountE" class="text-gray-400">0/255</span>
        </div>
      </div>
      
      <!-- Описание галереи -->
      <div>
        <label for="editGalleryDescriptionE" class="block text-white mb-2">Описание альбома</label>
        <textarea 
          id="editGalleryDescriptionE" 
          name="description" 
          maxlength="4096" 
          class="textarea textarea-bordered w-full min-h-[120px] bg-[#262626] text-white" 
          placeholder="Введите описание галереи"
        ></textarea>
        <div class="text-right mt-1">
          <span id="editDescCharCountE" class="text-gray-400">0/4096</span>
        </div>
      </div>
      
      <!-- Статус публикации -->
      <div>
        <label for="editGalleryPublishedE" class="block text-white mb-2">Статус публикации</label>
        <select id="editGalleryPublishedE" name="published" class="select select-bordered w-full bg-[#262626] text-white">
          <option value="false">Черновик</option>
          <option value="true">Опубликовано</option>
        </select>
      </div>
      
      <!-- Существующие фотографии -->
      <div>
        <label class="block text-white mb-2">Фотографии в альбоме</label>
        <div id="editGalleryPhotosEListE" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-4">
          <!-- Фотографии будут добавлены здесь через JavaScript -->
        </div>
      </div>
      
      <!-- Загрузка новых фотографий -->
      <div>
        <label class="block text-white mb-2">Добавить новые фотографии</label>
        <div 
          id="editGalleryPhotoDropAreaE"
          class="border-2 border-dashed border-gray-600 rounded-xl p-8 text-center cursor-pointer hover:bg-[#1A1A1A] hover:border-amber-400 transition-all duration-300 mb-4"
          ondragover="handleEditGalleryPhotoDragOverE(event)"
          ondragleave="handleEditGalleryPhotoDragLeaveE(event)"
          ondrop="handleEditGalleryPhotoDropE(event)"
        >
          <input
            type="file" 
            id="editGalleryPhotoInputE" 
            class="hidden" 
            accept=".jpg,.jpeg,.png"
            multiple
            onchange="handleEditGalleryPhotoFilesE(this.files)"
          >
          <div class="flex flex-col items-center justify-center">
            <div class="w-16 h-16 bg-amber-400/20 rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
            </div>
            <p class="text-gray-300 mb-3 text-lg">Перетащите фотографии сюда</p>
            <button 
              type="button" 
              class="btn btn-warning"
              onclick="document.getElementById('editGalleryPhotoInputE').click()"
            >
              Выбрать файлы
            </button>
            <p class="text-gray-400 text-sm mt-3">
              Поддерживаются форматы JPG, PNG. Каждое фото будет обрезано в формате 16:9.
            </p>
          </div>
        </div>
        
        <!-- Список новых загруженных фотографий -->
        <div id="editGalleryNewPhotosListE" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-4">
          <!-- Новые фотографии будут добавлены здесь через JavaScript -->
        </div>
      </div>
      
      <!-- Кнопки действий -->
      <div class="modal-action flex justify-end space-x-3 mt-6">
        <button 
          type="button" 
          class="btn btn-ghost text-gray-300 hover:bg-[#2E2E2E]"
          onclick="closeEditGalleryModalE()"
        >
          Отмена
        </button>
        <button 
          type="submit" 
          class="btn btn-warning"
        >
          Сохранить изменения
        </button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<!-- Модальное окно для редактирования фото -->
<dialog id="editPhotoModalE" class="modal">
  <div class="modal-box w-full max-w-4xl bg-[#1A1A1A] border border-amber-400 p-8 rounded">
    <h3 class="text-2xl text-amber-400 font-bold mb-6">Редактирование фотографии</h3>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Левая колонка - настройки -->
      <div class="space-y-6">
        <!-- Название фотографии -->
        <div>
          <label for="editPhotoTitleE" class="block text-white mb-2">Название фотографии</label>
          <input 
            type="text" 
            id="editPhotoTitleE" 
            maxlength="255" 
            class="input input-bordered w-full bg-[#262626] text-white" 
            placeholder="Введите название фото"
          >
          <div class="text-right mt-1">
            <span id="editPhotoTitleECharCountE" class="text-gray-400">0/255</span>
          </div>
        </div>
        
        <!-- Инструменты редактирования -->
        <div class="bg-[#2E2E2E] rounded-lg p-4">
          <h4 class="text-amber-400 font-semibold mb-3">Инструменты редактирования</h4>
          <div class="grid grid-cols-2 gap-3">
            <button type="button" class="btn btn-outline btn-sm text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="rotateEditPhotoE(-90)">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Повернуть влево
            </button>
            <button type="button" class="btn btn-outline btn-sm text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="rotateEditPhotoE(90)">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
              Повернуть вправо
            </button>
            <button type="button" class="btn btn-outline btn-sm text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="resetEditPhotoCropE()">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
              </svg>
              Сбросить
            </button>
            <button type="button" class="btn btn-outline btn-sm text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="flipEditPhotoE()">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
              </svg>
              Отразить
            </button>
          </div>
          <div class="mt-3">
            <button type="button" class="btn btn-outline btn-sm w-full text-amber-400 border-amber-400 hover:bg-amber-400 hover:text-black" onclick="resetEditPhotoToOriginalE()">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
              </svg>
              Сбросить к оригиналу
            </button>
          </div>
        </div>
        
        <!-- Информация о фото -->
        <div class="bg-[#2E2E2E] rounded-lg p-4">
          <h4 class="text-amber-400 font-semibold mb-3">Информация о фото</h4>
          <div class="space-y-2 text-sm text-gray-300">
            <div class="flex justify-between">
              <span>Размер:</span>
              <span id="editPhotoSizeE">-</span>
            </div>
            <div class="flex justify-between">
              <span>Формат:</span>
              <span id="editPhotoFormatE">-</span>
            </div>
            <div class="flex justify-between">
              <span>Поворот:</span>
              <span id="editPhotoRotationE">0°</span>
            </div>
            <div class="flex justify-between">
              <span>Статус:</span>
              <span id="editPhotoStatusE" class="text-amber-400">Оригинал</span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Правая колонка - предпросмотр -->
      <div class="bg-[#2E2E2E] rounded-lg p-4">
        <h4 class="text-amber-400 font-semibold mb-3">Предпросмотр</h4>
        <div class="relative w-full h-80 bg-gray-800 rounded-lg overflow-hidden">
          <img id="editPhotoPreviewE" class="w-full h-full object-contain">
        </div>
        <div class="mt-3 text-center text-gray-400 text-sm">
          Формат 16:9 • Рекомендуемый размер 1920×1080
        </div>
      </div>
    </div>
    
    <!-- Кнопки действий -->
    <div class="modal-action flex justify-end space-x-3 mt-6">
      <button 
        type="button" 
        class="btn btn-ghost text-gray-300 hover:bg-[#2E2E2E]"
        onclick="closeEditPhotoModalE()"
      >
        Отмена
      </button>
      <button 
        type="button" 
        class="btn btn-warning"
        onclick="saveEditPhotoE()"
      >
        Сохранить изменения
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<!-- Кастомное модальное окно подтверждения удаления -->
<dialog id="deletePhotoModalE" class="modal">
  <div class="modal-box bg-[#1A1A1A] border border-red-500 p-6 rounded max-w-md">
    <div class="flex items-center mb-4">
      <div class="w-12 h-12 bg-red-500/20 rounded-full flex items-center justify-center mr-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>
      <div>
        <h3 class="text-xl font-bold text-white">Удаление фотографии</h3>
        <p class="text-gray-300 text-sm mt-1">Это действие нельзя отменить</p>
      </div>
    </div>
    
    <p class="text-gray-300 mb-6">Вы уверены, что хотите удалить эту фотографию? Все изменения будут потеряны.</p>
    
    <div class="modal-action flex justify-end space-x-3">
      <button 
        type="button" 
        class="btn btn-ghost text-gray-300 hover:bg-[#2E2E2E]"
        onclick="closeDeletePhotoModalE()"
      >
        Отмена
      </button>
      <button 
        type="button" 
        class="btn btn-error"
        onclick="confirmDeletePhotoE()"
      >
        Удалить
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<!-- Подключаем Cropper.js и CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>

<script>
  // Глобальные переменные для редактирования галереи
  let editGalleryPhotosE = [];
  let newGalleryPhotosE = [];
  let photosToDeleteE = [];
  let currentEditingPhotoIndexE = null;
  let currentEditingPhotoTypeE = null;
  let editPhotoCropperE = null;
  let currentRotationE = 0;
  let currentScaleXE = 1;
  let photoToDeleteIndexE = null;
  let photoToDeleteTypeE = null;

  // Функция для открытия модального окна редактирования галереи
  function openEditGalleryModal(galleryId) {
    const modal = document.getElementById('editGalleryModalE');
    if (!modal) return;
    
    // Сбрасываем массивы
    editGalleryPhotosE = [];
    newGalleryPhotosE = [];
    photosToDeleteE = [];
    
    // Получаем данные галереи
    const authServiceUrl = "<%= ENV['AUTH_SERVICE_URL'] %>";
    const url = `${authServiceUrl}/api/v1/galleries/${galleryId}`;
    
    fetch(url, {
      method: 'GET',
      headers: {
        'Accept': 'application/json'
      },
      credentials: 'include'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Ошибка при загрузке данных галереи');
      }
      return response.json();
    })
    .then(data => {
      // Заполняем форму данными
      document.getElementById('editGalleryIdE').value = data.id;
      document.getElementById('editGalleryTitleE').value = data.title || '';
      document.getElementById('editGalleryDescriptionE').value = data.description || '';
      document.getElementById('editGalleryPublishedE').value = data.published ? 'true' : 'false';
      
      // Обновляем счетчики символов
      document.getElementById('editTitleCharCountE').textContent = `${(data.title || '').length}/255`;
      document.getElementById('editDescCharCountE').textContent = `${(data.description || '').length}/4096`;
      
      // Заполняем существующие фотографии
      if (data.photos && data.photos.length > 0) {
        editGalleryPhotosE = data.photos.map(photo => ({
          id: photo.id,
          title: photo.title,
          file_url: photo.file_url,
          position: photo.position || 0,
          isExisting: true,
          isEdited: false,
          rotation: 0,
          scaleX: 1,
          cropData: null,
          originalFile: null,
          croppedFile: null,
          previewUrl: photo.file_url,
          originalPreviewUrl: photo.file_url
        }));
        
        updateEditGalleryPhotosListE();
      }
      
      // Очищаем список новых фотографий
      updateEditGalleryNewPhotosListE();
      
      // Открываем модальное окно
      modal.showModal();
    })
    .catch(error => {
      console.error('Error loading gallery data:', error);
      showNotification('Ошибка при загрузке данных галереи: ' + error.message, 'error');
    });
  }

  // Функция для закрытия модального окна редактирования галереи
  function closeEditGalleryModalE() {
    const modal = document.getElementById('editGalleryModalE');
    if (modal) modal.close();
    
    // Сбрасываем форму
    document.getElementById('editGalleryFormE').reset();
    editGalleryPhotosE = [];
    newGalleryPhotosE = [];
    photosToDeleteE = [];
  }

  // Обновление списка существующих фотографий в редактировании
  function updateEditGalleryPhotosListE() {
    const container = document.getElementById('editGalleryPhotosEListE');
    if (!container) return;
    
    if (editGalleryPhotosE.length === 0) {
      container.innerHTML = '<p class="text-gray-400 col-span-full text-center py-4">В галерее нет фотографий</p>';
      return;
    }
    
    container.innerHTML = editGalleryPhotosE.map((photo, index) => `
      <div class="relative group bg-[#2E2E2E] rounded-lg overflow-hidden border border-gray-700" data-photo-id="${photo.id}">
        <img src="${photo.previewUrl || photo.file_url}" alt="${photo.title}" class="w-full h-48 object-cover">
        <div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
          <button 
            type="button" 
            class="btn btn-sm btn-warning mr-2"
            onclick="openEditExistingPhotoModalE(${index})"
          >
            Редактировать
          </button>
          <button 
            type="button" 
            class="btn btn-sm btn-error"
            onclick="openDeletePhotoModalE(${index}, 'existing')"
          >
            Удалить
          </button>
        </div>
        <div class="p-3">
          <div class="flex items-center justify-between mb-2">
            <span class="text-white text-sm font-medium truncate flex-1 mr-2">${photo.title || 'Без названия'}</span>
            <div class="flex space-x-1">
              <span class="badge badge-success badge-sm" title="Загружено">✓</span>
              ${photo.isEdited ? '<span class="badge badge-info badge-sm" title="Отредактировано">✎</span>' : ''}
            </div>
          </div>
          ${photo.isEdited ? '<div class="text-xs text-amber-400">Изменения сохранены</div>' : ''}
        </div>
      </div>
    `).join('');
  }

  // Обновление списка новых фотографий в редактировании
  function updateEditGalleryNewPhotosListE() {
    const container = document.getElementById('editGalleryNewPhotosListE');
    if (!container) return;
    
    if (newGalleryPhotosE.length === 0) {
      container.innerHTML = '';
      return;
    }
    
    container.innerHTML = newGalleryPhotosE.map((photo, index) => `
      <div class="relative group bg-[#2E2E2E] rounded-lg overflow-hidden border border-gray-700">
        <img src="${photo.previewUrl}" alt="${photo.title}" class="w-full h-48 object-cover">
        <div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
          <button 
            type="button" 
            class="btn btn-sm btn-warning mr-2"
            onclick="openEditNewPhotoModalE(${index})"
          >
            Редактировать
          </button>
          <button 
            type="button" 
            class="btn btn-sm btn-error"
            onclick="openDeletePhotoModalE(${index}, 'new')"
          >
            Удалить
          </button>
        </div>
        <div class="p-3">
          <div class="flex items-center justify-between mb-2">
            <span class="text-white text-sm font-medium truncate flex-1 mr-2">${photo.title || 'Без названия'}</span>
            <div class="flex space-x-1">
              ${photo.croppedFile ? '<span class="badge badge-success badge-sm" title="Обрезано">✓</span>' : '<span class="badge badge-warning badge-sm" title="Требуется обрезка">!</span>'}
              ${photo.isEdited ? '<span class="badge badge-info badge-sm" title="Отредактировано">✎</span>' : ''}
            </div>
          </div>
          <div class="text-xs text-gray-400">
            ${Math.round(photo.originalWidth)}×${Math.round(photo.originalHeight)} • ${(photo.originalFile.size / 1024 / 1024).toFixed(1)}MB
            ${photo.isEdited ? ' • Edited' : ''}
          </div>
        </div>
      </div>
    `).join('');
  }

  // Обработчики drag-and-drop для новых фотографий в редактировании
  function handleEditGalleryPhotoDragOverE(e) {
    e.preventDefault();
    e.stopPropagation();
    const dropArea = document.getElementById('editGalleryPhotoDropAreaE');
    if (dropArea) dropArea.classList.add('border-amber-400', 'bg-amber-900/30');
  }

  function handleEditGalleryPhotoDragLeaveE(e) {
    e.preventDefault();
    e.stopPropagation();
    const dropArea = document.getElementById('editGalleryPhotoDropAreaE');
    if (dropArea) dropArea.classList.remove('border-amber-400', 'bg-amber-900/30');
  }

  function handleEditGalleryPhotoDropE(e) {
    e.preventDefault();
    e.stopPropagation();
    const dropArea = document.getElementById('editGalleryPhotoDropAreaE');
    if (dropArea) dropArea.classList.remove('border-amber-400', 'bg-amber-900/30');
    
    const files = e.dataTransfer.files;
    if (files.length > 0) {
      handleEditGalleryPhotoFilesE(files);
    }
  }

  // Функция для создания базового кропа 16:9
  function createBaseCropE(imageElement, file, callback) {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    
    const img = new Image();
    img.onload = function() {
      // Вычисляем размеры для кропа 16:9
      const sourceWidth = img.width;
      const sourceHeight = img.height;
      
      let sourceX = 0;
      let sourceY = 0;
      let cropWidth = sourceWidth;
      let cropHeight = sourceHeight;
      
      const targetRatio = 16 / 9;
      const sourceRatio = sourceWidth / sourceHeight;
      
      if (sourceRatio > targetRatio) {
        // Широкое изображение - обрезаем по бокам
        cropWidth = sourceHeight * targetRatio;
        sourceX = (sourceWidth - cropWidth) / 2;
      } else {
        // Высокое изображение - обрезаем сверху и снизу
        cropHeight = sourceWidth / targetRatio;
        sourceY = (sourceHeight - cropHeight) / 2;
      }
      
      // Устанавливаем размеры canvas
      canvas.width = 1920;
      canvas.height = 1080;
      
      // Рисуем обрезанное изображение
      ctx.drawImage(
        img,
        sourceX, sourceY, cropWidth, cropHeight, // source rectangle
        0, 0, 1920, 1080 // destination rectangle
      );
      
      // Конвертируем в blob
      canvas.toBlob(function(blob) {
        callback(blob);
      }, 'image/jpeg', 0.9);
    };
    img.src = imageElement ? imageElement.src : URL.createObjectURL(file);
  }

  // Обработка выбранных файлов новых фотографий
  function handleEditGalleryPhotoFilesE(files) {
    Array.from(files).forEach(file => {
      if (file.type.match('image.*')) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const photo = {
            id: Date.now() + Math.random(), // Уникальный ID
            originalFile: file,
            croppedFile: null,
            previewUrl: e.target.result,
            originalPreviewUrl: e.target.result, // Сохраняем оригинал для возможности сброса
            title: file.name.split('.')[0], // Название без расширения
            rotation: 0,
            scaleX: 1,
            originalWidth: 0,
            originalHeight: 0,
            isEdited: false, // Флаг, было ли фото отредактировано
            isNew: true
          };
          
          // Получаем размеры изображения
          const img = new Image();
          img.onload = function() {
            photo.originalWidth = img.width;
            photo.originalHeight = img.height;
            
            // Создаем базовый кроп 16:9 сразу после загрузки
            createBaseCropE(img, file, function(blob) {
              if (blob) {
                const croppedFileName = file.name.replace(/\.[^/.]+$/, "") + '_cropped.jpg';
                photo.croppedFile = new File([blob], croppedFileName, { type: 'image/jpeg' });
                photo.previewUrl = URL.createObjectURL(blob);
                photo.baseCroppedFile = photo.croppedFile; // Сохраняем базовый кроп отдельно
                
                updateEditGalleryNewPhotosListE();
              }
            });
          };
          img.src = e.target.result;
          
          newGalleryPhotosE.push(photo);
          updateEditGalleryNewPhotosListE();
        };
        reader.readAsDataURL(file);
      }
    });
  }

  // Открыть модальное окно для редактирования новой фотографии
  function openEditNewPhotoModalE(index) {
    currentEditingPhotoIndexE = index;
    currentEditingPhotoTypeE = 'new';
    
    const photo = newGalleryPhotosE[index];
    if (!photo) return;
    
    openEditPhotoModalE(photo);
  }

  // Открыть модальное окно для редактирования существующей фотографии
  function openEditExistingPhotoModalE(index) {
    currentEditingPhotoIndexE = index;
    currentEditingPhotoTypeE = 'existing';
    
    const photo = editGalleryPhotosE[index];
    if (!photo) return;
    
    openEditPhotoModalE(photo);
  }

  // Открытие модального окна редактирования фото (общая функция)
  function openEditPhotoModalE(photo) {
    const modal = document.getElementById('editPhotoModalE');
    const titleInput = document.getElementById('editPhotoTitleE');
    const charCount = document.getElementById('editPhotoTitleECharCountE');
    const previewImg = document.getElementById('editPhotoPreviewE');
    const sizeInfo = document.getElementById('editPhotoSizeE');
    const formatInfo = document.getElementById('editPhotoFormatE');
    const rotationInfo = document.getElementById('editPhotoRotationE');
    const statusInfo = document.getElementById('editPhotoStatusE');
    
    if (!modal || !titleInput || !previewImg) return;
    
    // Заполняем данные
    titleInput.value = photo.title || '';
    charCount.textContent = `${(photo.title || '').length}/255`;
    
    // Используем оригинальное изображение для редактирования
    previewImg.src = photo.originalPreviewUrl;
    
    // Заполняем информацию о фото
    if (currentEditingPhotoTypeE === 'new') {
      sizeInfo.textContent = `${Math.round(photo.originalWidth)}×${Math.round(photo.originalHeight)}`;
      formatInfo.textContent = photo.originalFile.type.split('/')[1].toUpperCase();
    } else {
      sizeInfo.textContent = 'Загружено';
      formatInfo.textContent = 'Изображение';
    }
    
    rotationInfo.textContent = `${photo.rotation || 0}°`;
    statusInfo.textContent = photo.isEdited ? 'Отредактировано' : 'Оригинал';
    statusInfo.className = photo.isEdited ? 'text-amber-400' : 'text-green-400';
    
    // Восстанавливаем трансформации
    currentRotationE = photo.rotation || 0;
    currentScaleXE = photo.scaleX || 1;
    
    modal.showModal();
    
    // Инициализация Cropper.js с оригинальным изображением
    setTimeout(() => {
      if (editPhotoCropperE) {
        editPhotoCropperE.destroy();
      }
      
      // Добавляем атрибут crossOrigin для существующих фотографий
      if (currentEditingPhotoTypeE === 'existing' && photo.file_url) {
        previewImg.crossOrigin = 'anonymous';
      }
      
      editPhotoCropperE = new Cropper(previewImg, {
        aspectRatio: 16 / 9,
        viewMode: 1,
        autoCropArea: 0.8,
        responsive: true,
        checkCrossOrigin: false,
        background: false,
        guides: true,
        center: true,
        highlight: false,
        cropBoxMovable: true,
        cropBoxResizable: true,
        toggleDragModeOnDblclick: false,
        ready: function() {
          // Применяем сохраненные трансформации
          if (currentRotationE !== 0) {
            editPhotoCropperE.rotateTo(currentRotationE);
          }
          if (currentScaleXE === -1) {
            editPhotoCropperE.scaleX(-1);
          }
        }
      });
    }, 100);
  }

  // Закрытие модального окна редактирования фото
  function closeEditPhotoModalE() {
    const modal = document.getElementById('editPhotoModalE');
    
    if (editPhotoCropperE) {
      editPhotoCropperE.destroy();
      editPhotoCropperE = null;
    }
    
    if (modal) modal.close();
    
    currentEditingPhotoIndexE = null;
    currentEditingPhotoTypeE = null;
    currentRotationE = 0;
    currentScaleXE = 1;
  }

  // Сброс к оригинальному изображению
  function resetEditPhotoToOriginalE() {
    if (currentEditingPhotoIndexE === null || currentEditingPhotoTypeE !== 'new') return;
    
    const photo = newGalleryPhotosE[currentEditingPhotoIndexE];
    if (!photo) return;
    
    // Сбрасываем все трансформации
    currentRotationE = 0;
    currentScaleXE = 1;
    
    // Восстанавливаем базовый кроп
    if (photo.baseCroppedFile) {
      photo.croppedFile = photo.baseCroppedFile;
      photo.previewUrl = URL.createObjectURL(photo.baseCroppedFile);
      photo.isEdited = false;
    } else {
      // Если базового кропа нет, создаем его заново
      createBaseCropE(null, photo.originalFile, function(blob) {
        if (blob) {
          const croppedFileName = photo.originalFile.name.replace(/\.[^/.]+$/, "") + '_cropped.jpg';
          photo.croppedFile = new File([blob], croppedFileName, { type: 'image/jpeg' });
          photo.previewUrl = URL.createObjectURL(blob);
          photo.baseCroppedFile = photo.croppedFile;
          photo.isEdited = false;
        }
      });
    }
    
    // Обновляем интерфейс
    document.getElementById('editPhotoRotationE').textContent = '0°';
    document.getElementById('editPhotoStatusE').textContent = 'Оригинал';
    document.getElementById('editPhotoStatusE').className = 'text-green-400';
    
    // Сбрасываем кроппер
    if (editPhotoCropperE) {
      editPhotoCropperE.reset();
    }
    
    showNotification('Изменения сброшены к оригиналу');
  }

  // Поворот фотографии с отслеживанием общего угла
  function rotateEditPhotoE(degrees) {
    if (!editPhotoCropperE || currentEditingPhotoIndexE === null) return;
    
    try {
      // Обновляем общий угол поворота
      currentRotationE += degrees;
      currentRotationE = currentRotationE % 360;
      
      // Применяем абсолютный поворот
      editPhotoCropperE.rotateTo(currentRotationE);
      
      // Обновляем отображение угла
      document.getElementById('editPhotoRotationE').textContent = `${currentRotationE}°`;
      document.getElementById('editPhotoStatusE').textContent = 'Изменено';
      document.getElementById('editPhotoStatusE').className = 'text-amber-400';
    } catch (error) {
      console.error('Ошибка при повороте фото:', error);
    }
  }

  // Отразить фотографию
  function flipEditPhotoE() {
    if (!editPhotoCropperE || currentEditingPhotoIndexE === null) return;
    
    try {
      currentScaleXE = -currentScaleXE;
      editPhotoCropperE.scaleX(currentScaleXE);
      document.getElementById('editPhotoStatusE').textContent = 'Изменено';
      document.getElementById('editPhotoStatusE').className = 'text-amber-400';
    } catch (error) {
      console.error('Ошибка при отражении фото:', error);
    }
  }

  // Сброс обрезки и трансформаций
  function resetEditPhotoCropE() {
    if (!editPhotoCropperE || currentEditingPhotoIndexE === null) return;
    
    try {
      editPhotoCropperE.reset();
      currentRotationE = 0;
      currentScaleXE = 1;
      document.getElementById('editPhotoRotationE').textContent = '0°';
      document.getElementById('editPhotoStatusE').textContent = 'Изменено';
      document.getElementById('editPhotoStatusE').className = 'text-amber-400';
    } catch (error) {
      console.error('Ошибка при сбросе фото:', error);
    }
  }

  // Сохранение изменений фото
  function saveEditPhotoE() {
    if (!editPhotoCropperE || currentEditingPhotoIndexE === null) return;
    
    let photo;
    if (currentEditingPhotoTypeE === 'new') {
      photo = newGalleryPhotosE[currentEditingPhotoIndexE];
    } else {
      photo = editGalleryPhotosE[currentEditingPhotoIndexE];
    }
    
    if (!photo) return;
    
    try {
      // Сохраняем название
      const titleInput = document.getElementById('editPhotoTitleE');
      photo.title = titleInput.value.trim() || (photo.originalFile ? photo.originalFile.name.split('.')[0] : 'Без названия');
      
      // Сохраняем трансформации
      photo.rotation = currentRotationE;
      photo.scaleX = currentScaleXE;
      
      // Применяем обрезку с текущими трансформациями
      const canvas = editPhotoCropperE.getCroppedCanvas({
        width: 1920,
        height: 1080,
        minWidth: 320,
        minHeight: 180,
        maxWidth: 4096,
        maxHeight: 2304,
        fillColor: '#fff',
        imageSmoothingEnabled: true,
        imageSmoothingQuality: 'high',
      });
      
      if (canvas) {
        canvas.toBlob(function(blob) {
          if (blob) {
            let fileName;
            if (currentEditingPhotoTypeE === 'new') {
              fileName = photo.originalFile ? photo.originalFile.name : "photo.jpg";
            } else {
              fileName = `edited_${photo.id}_${Date.now()}.jpg`;
            }
            
            const croppedFileName = fileName.replace(/\.[^/.]+$/, "") + '_cropped.jpg';
            
            photo.croppedFile = new File([blob], croppedFileName, { type: 'image/jpeg' });
            
            // Освобождаем старый URL, если он был
            if (photo.previewUrl && photo.previewUrl.startsWith('blob:')) {
              URL.revokeObjectURL(photo.previewUrl);
            }
            
            photo.previewUrl = URL.createObjectURL(blob);
            photo.isEdited = true; // Помечаем как отредактированное
            
            // Обновляем соответствующий список
            if (currentEditingPhotoTypeE === 'new') {
              updateEditGalleryNewPhotosListE();
            } else {
              updateEditGalleryPhotosListE();
            }
            
            closeEditPhotoModalE();
            showNotification('Изменения сохранены');
          }
        }, 'image/jpeg', 0.9);
      }
    } catch (error) {
      console.error('Ошибка при сохранении фото:', error);
      showNotification('Ошибка при сохранении изменений', 'error');
    }
  }

  // Открытие модального окна подтверждения удаления
  function openDeletePhotoModalE(index, type) {
    photoToDeleteIndexE = index;
    photoToDeleteTypeE = type;
    const modal = document.getElementById('deletePhotoModalE');
    if (modal) modal.showModal();
  }

  // Закрытие модального окна подтверждения удаления
  function closeDeletePhotoModalE() {
    const modal = document.getElementById('deletePhotoModalE');
    if (modal) modal.close();
    photoToDeleteIndexE = null;
    photoToDeleteTypeE = null;
  }

  // Подтверждение удаления фотографии
  function confirmDeletePhotoE() {
    if (photoToDeleteIndexE === null || photoToDeleteTypeE === null) return;
    
    if (photoToDeleteTypeE === 'new') {
      newGalleryPhotosE.splice(photoToDeleteIndexE, 1);
      updateEditGalleryNewPhotosListE();
    } else {
      const photo = editGalleryPhotosE[photoToDeleteIndexE];
      if (photo) {
        photosToDeleteE.push(photo.id);
        editGalleryPhotosE.splice(photoToDeleteIndexE, 1);
        updateEditGalleryPhotosListE();
      }
    }
    
    closeDeletePhotoModalE();
    showNotification('Фотография удалена');
    
    photoToDeleteIndexE = null;
    photoToDeleteTypeE = null;
  }

  // Обновление счетчиков символов
  document.addEventListener('DOMContentLoaded', function() {
    const editTitleInput = document.getElementById('editGalleryTitleE');
    const editDescTextarea = document.getElementById('editGalleryDescriptionE');
    const editPhotoTitleEInput = document.getElementById('editPhotoTitleE');
    const editTitleCharCount = document.getElementById('editTitleCharCountE');
    const editDescCharCount = document.getElementById('editDescCharCountE');
    const editPhotoTitleECharCountE = document.getElementById('editPhotoTitleECharCountE');

    if (editTitleInput) {
      editTitleInput.addEventListener('input', function() {
        const length = this.value.length;
        editTitleCharCount.textContent = `${length}/255`;
      });
    }

    if (editDescTextarea) {
      editDescTextarea.addEventListener('input', function() {
        const length = this.value.length;
        editDescCharCount.textContent = `${length}/4096`;
      });
    }

    if (editPhotoTitleEInput) {
      editPhotoTitleEInput.addEventListener('input', function() {
        const length = this.value.length;
        editPhotoTitleECharCountE.textContent = `${length}/255`;
      });
    }

    // Обработка отправки формы галереи
    const editGalleryForm = document.getElementById('editGalleryFormE');
    if (editGalleryForm) {
      editGalleryForm.addEventListener('submit', function(event) {
        event.preventDefault();
        submitEditGalleryFormE();
      });
    }
  });

  function submitEditGalleryFormE() {
    const galleryId = document.getElementById('editGalleryIdE').value;
    const titleInput = document.getElementById('editGalleryTitleE');
    const descriptionInput = document.getElementById('editGalleryDescriptionE');
    const publishedInput = document.getElementById('editGalleryPublishedE');
  
    const title = titleInput ? titleInput.value.trim() : '';
    const description = descriptionInput ? descriptionInput.value.trim() : '';
    const published = publishedInput ? publishedInput.value : 'false';
  
    if (!title) {
      showNotification('Название галереи обязательно для заполнения', 'error');
      titleInput?.focus();
      return;
    }
  
    if (published === 'true' && editGalleryPhotosE.length === 0 && newGalleryPhotosE.length === 0) {
      showNotification('Для публикации галереи добавьте хотя бы одну фотографию', 'error');
      return;
    }
  
    // Проверяем, что все новые фотографии обработаны (обрезаны)
    const unprocessedNewPhotos = newGalleryPhotosE.filter(photo => !photo.croppedFile);
    if (unprocessedNewPhotos.length > 0) {
      showNotification('Обрежьте все новые фотографии перед сохранением', 'error');
      return;
    }
  
    const formData = new FormData();
  
    // 1. Основные данные галереи
    formData.append('gallery[title]', title);
    formData.append('gallery[description]', description);
    formData.append('gallery[published]', published);
  
    // 2. Формируем единый массив photos_attributes
    // Нам нужны уникальные индексы для каждого элемента массива, чтобы Rails их распознал
    
    let photoIndex = 0;

    // А) Существующие фото, которые редактируем или оставляем как есть
    editGalleryPhotosE.forEach((photo) => {
      formData.append(`gallery[photos_attributes][${photoIndex}][id]`, photo.id);
      formData.append(`gallery[photos_attributes][${photoIndex}][title]`, photo.title || '');
      formData.append(`gallery[photos_attributes][${photoIndex}][position]`, photoIndex);
      
      // Если файл был изменен (отредактирован или повернут), отправляем его
      if (photo.isEdited && photo.croppedFile) {
        formData.append(`gallery[photos_attributes][${photoIndex}][file]`, photo.croppedFile);
      }
      
      photoIndex++;
    });

    // Б) Новые фото (не имеющие ID)
    newGalleryPhotosE.forEach((photo) => {
      // Не отправляем ID, чтобы Rails понял, что это CREATE
      formData.append(`gallery[photos_attributes][${photoIndex}][title]`, photo.title || '');
      formData.append(`gallery[photos_attributes][${photoIndex}][file]`, photo.croppedFile);
      formData.append(`gallery[photos_attributes][${photoIndex}][position]`, photoIndex);
      
      photoIndex++;
    });

    // В) Фото на удаление (отправляем ID и флаг _destroy)
    photosToDeleteE.forEach((photoId) => {
      formData.append(`gallery[photos_attributes][${photoIndex}][id]`, photoId);
      formData.append(`gallery[photos_attributes][${photoIndex}][_destroy]`, '1');
      
      photoIndex++;
    });
  
    // Отправка запроса
    const actorId = document.querySelector('[data-user-id]')?.getAttribute('data-user-id');
    const authServiceUrl = "<%= ENV['AUTH_SERVICE_URL'] %>";
    const url = `${authServiceUrl}/api/v1/galleries/${galleryId}`;
  
    // Добавим индикатор загрузки (можно переиспользовать существующий или добавить новый)
    showGlobalLoading();
  
    fetch(url, {
      method: 'PUT', // Или POST, если роут настроен на POST для обновления, но у тебя PUT
      headers: {
        'X-User-ID': actorId || ''
        // Не выставляй Content-Type вручную для FormData, браузер сделает это сам с правильным boundary
      },
      body: formData,
      credentials: 'include'
    })
    .then(response => {
      if (!response.ok) {
        return response.json().then(data => {
          throw new Error(data.errors ? data.errors.join(', ') : 'Ошибка при обновлении галереи');
        });
      }
      return response.json();
    })
    .then(data => {
      showNotification('Галерея успешно обновлена', 'success');
      closeEditGalleryModalE();
    
      if (typeof loadGalleries === 'function') {
        loadGalleries();
      }
    })
    .catch(error => {
      console.error('Submission error:', error);
      showNotification(`Ошибка: ${error.message}`, 'error');
    })
    .finally(() => {
      hideGlobalLoading();
    });
  }
</script>
