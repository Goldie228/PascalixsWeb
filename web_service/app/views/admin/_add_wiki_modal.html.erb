<!-- Подключение библиотек EasyMDE -->
<script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css">

<!-- Модальное окно для добавления Wiki страницы -->
<dialog id="addWikiPageModal" class="modal">
  <!-- Добавляем данные в data-атрибуты, чтобы избежать конфликтов глобальных переменных JS -->
  <div class="modal-box w-full max-w-6xl bg-[#1A1A1A] border border-amber-400 p-0 rounded overflow-hidden flex flex-col max-h-[90vh] shadow-2xl"
       data-service-url="<%= ENV['AUTH_SERVICE_URL'] %>" 
       data-api-key="<%= ENV['INTER_SERVICE_API_KEY'] %>"
       data-user-id="<%= current_user.id %>">
       
    <!-- Шапка -->
    <div class="p-6 border-b border-gray-700 flex justify-between items-center bg-[#1A1A1A] z-10">
      <h3 class="text-2xl text-amber-400 font-bold">Добавить Wiki страницу</h3>
      <button type="button" class="text-gray-400 hover:text-white transition" onclick="closeAddWikiPageModal()">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Скроллируемая область контента -->
    <div class="flex-1 overflow-y-auto p-6 bg-[#1A1A1A]">
      <form id="wikiPageForm" class="space-y-6">
        
        <!-- Основная информация -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="md:col-span-2">
            <label for="wikiPageTitle" class="block text-white mb-2 font-medium">Заголовок страницы <span class="text-red-500">*</span></label>
            <input 
              type="text" 
              id="wikiPageTitle" 
              name="title" 
              maxlength="255" 
              class="w-full bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 outline-none rounded-lg px-4 py-2 transition-colors placeholder-gray-500" 
              placeholder="Например: Правила сервера"
              required
              oninput="generateSlugFromTitle(this.value)"
            >
          </div>

          <div>
            <label for="wikiPageSlug" class="block text-white mb-2 font-medium">URL (Slug)</label>
            <div class="relative">
              <span class="absolute left-3 top-3 text-gray-400 font-bold">/</span>
              <input 
                type="text" 
                id="wikiPageSlug" 
                name="slug" 
                class="w-full bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 outline-none rounded-lg px-4 py-2 pl-8 transition-colors placeholder-gray-500" 
                placeholder="pravila-servera"
                required
              >
            </div>
          </div>
        </div>

        <!-- Категория и Позиция -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="wikiPageCategory" class="block text-white mb-2 font-medium">Категория</label>
            <div class="flex gap-2">
              <select id="wikiPageCategory" name="wiki_category_id" class="flex-1 bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 outline-none rounded-lg px-4 py-2 transition-colors cursor-pointer">
                <option value="" disabled selected>Выберите категорию...</option>
              </select>
              <button type="button" class="btn btn-square border-2 border-gray-600 text-amber-400 hover:bg-amber-900/20 hover:border-amber-400 transition flex items-center justify-center bg-[#262626]" title="Добавить категорию" onclick="openAddCategoryModal()">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
              </button>
            </div>
          </div>

          <div>
            <label for="wikiPagePosition" class="block text-white mb-2 font-medium">Позиция</label>
            <input 
              type="number" 
              id="wikiPagePosition" 
              name="position" 
              value="0"
              class="w-full bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 outline-none rounded-lg px-4 py-2 transition-colors placeholder-gray-500" 
            >
          </div>
        </div>

        <!-- Редактор Markdown -->
        <div>
          <div class="flex justify-between items-center mb-2">
            <label class="block text-white font-medium">Содержание (Markdown) <span class="text-red-500">*</span></label>
            <span class="text-xs text-gray-400">Автосохранение включено</span>
          </div>
          
          <div class="border-2 border-gray-600 rounded-lg overflow-hidden bg-[#262626] shadow-inner">
            <!-- Скрытый инпут для кастомной кнопки -->
            <input type="file" id="wikiPageFileInput" class="hidden" accept="image/*,.zip,.rar,.7z,.jar">
            
            <textarea id="wikiPageContent" name="content"></textarea>
          </div>
          <p class="text-gray-400 text-xs mt-2">
            Используйте кнопку 📎 в меню редактора для загрузки файлов и картинок.
          </p>
          <!-- Скрытое поле для ID загруженных картинок -->
          <input type="hidden" id="wikiPageTempImageIds" name="temp_image_ids" value="[]">
        </div>

        <!-- Статус публикации -->
        <div class="flex items-center gap-3 pt-4 border-t border-gray-700">
          <div class="form-control">
            <label class="label cursor-pointer justify-start gap-3 p-0">
              <input type="checkbox" id="wikiPagePublished" name="published" class="checkbox checkbox-warning bg-gray-700 border-gray-600 checked:bg-amber-400 checked:border-amber-400 rounded" />
              <span class="label-text text-white">Опубликовать сразу</span>
            </label>
          </div>
        </div>
      </form>
    </div>

    <!-- Футер -->
    <div class="p-6 border-t border-gray-700 bg-[#1A1A1A] flex justify-end space-x-3">
      <button type="button" class="px-6 py-2 text-gray-300 bg-[#262626] border border-gray-600 rounded-lg hover:bg-[#2E2E2E] hover:text-white transition" onclick="closeAddWikiPageModal()">
        Отмена
      </button>
      <button type="button" class="px-6 py-2 text-black bg-amber-400 border border-amber-400 rounded-lg hover:bg-amber-300 hover:border-amber-300 font-medium transition min-w-[120px]" onclick="submitWikiPageForm()">
        Создать страницу
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<!-- Модальное окно для добавления категории -->
<dialog id="addCategoryModal" class="modal">
  <div class="modal-box w-full max-w-lg bg-[#1A1A1A] border border-amber-400 rounded-lg">
    <h3 class="text-xl text-amber-400 font-bold mb-6">Добавить категорию</h3>
    <form id="categoryForm" class="space-y-4">
      <div>
        <label class="block text-white mb-2">Название</label>
        <input type="text" id="catName" class="w-full bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 outline-none rounded-lg px-4 py-2" oninput="generateCatSlug(this.value)">
      </div>
      <div>
        <label class="block text-white mb-2">Slug</label>
        <input type="text" id="catSlug" class="w-full bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 outline-none rounded-lg px-4 py-2">
      </div>
      <div>
        <label class="block text-white mb-2">Родительская категория</label>
        <select id="catParent" class="w-full bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 outline-none rounded-lg px-4 py-2">
          <option value="">Нет (Корневая)</option>
        </select>
      </div>
    </form>
    <div class="modal-action mt-6">
      <button class="px-4 py-2 text-gray-300 bg-[#262626] border border-gray-600 rounded-lg hover:bg-[#2E2E2E]" onclick="document.getElementById('addCategoryModal').close()">Отмена</button>
      <button class="px-4 py-2 text-black bg-amber-400 border border-amber-400 rounded-lg hover:bg-amber-300" onclick="submitCategory()">Создать</button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<script>
    let easyMDEInstance;
    let uploadedTempImageIds = [];
    
    // Получаем настройки прямо из DOM элемента, чтобы не дублировать const
    const modal = document.getElementById('addWikiPageModal');
    const authServiceUrl = "<%= ENV['AUTH_SERVICE_URL'] %>";
    const interServiceApiKey = "<%= ENV['INTER_SERVICE_API_KEY'] %>";
    const actorId = document.querySelector('[data-user-id]')?.getAttribute('data-user-id') || '';

    // Открытие модального окна страницы
    function openAddWikiPageModal() {
      if (!modal) return;
      
      document.getElementById('wikiPageForm').reset();
      document.getElementById('wikiPagePosition').value = 0;
      uploadedTempImageIds = []; 
      document.getElementById('wikiPageTempImageIds').value = JSON.stringify([]);
      
      if (!easyMDEInstance) {
        initEasyMDE();
      } else {
        const savedContent = localStorage.getItem('wiki_new_page_draft');
        if (savedContent && confirm('Найден сохраненный черновик. Восстановить?')) {
          easyMDEInstance.value(savedContent);
        } else {
          easyMDEInstance.value('');
        }
      }

      loadWikiCategories();
      modal.showModal();
    }

    function closeAddWikiPageModal() {
      if (modal) modal.close();
    }

    // Логика Slug
    function generateSlugFromTitle(title) {
      const slugInput = document.getElementById('wikiPageSlug');
      if (!slugInput || document.activeElement === slugInput) return;
      const ru = "А-а-Б-б-В-в-Г-г-Д-д-Е-е-Ё-ё-Ж-ж-З-з-И-и-Й-й-К-к-Л-л-М-м-Н-н-О-о-П-п-Р-р-С-с-Т-т-У-у-Ф-ф-Х-х-Ц-ц-Ч-ч-Ш-ш-Щ-щ-Ъ-ъ-Ы-ы-Ь-ь-Э-э-Ю-ю-Я-я".split("-");
      const en = "A-a-B-b-V-v-G-g-D-d-E-e-E-e-ZH-zh-Z-z-I-i-J-j-K-k-L-l-M-m-N-n-O-o-P-p-R-r-S-s-T-t-U-u-F-f-H-h-TS-ts-CH-ch-SH-sh-SCH-shch-'-'-Y-y-'-'-E-e-YU-yu-YA-ya".split("-");
      
      let slug = title.split('').map(char => {
        const idx = ru.indexOf(char);
        return idx !== -1 ? en[idx] : char;
      }).join('');

      slug = slug.toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .trim();

      slugInput.value = slug;
    }

    // Инициализация EasyMDE
    function initEasyMDE() {
      // SVG иконка для загрузки
      const uploadIconSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>';
      
      easyMDEInstance = new EasyMDE({
        element: document.getElementById('wikiPageContent'),
        spellChecker: false,
        autosave: {
          enabled: true,
          uniqueId: "wiki_new_page_draft",
          delay: 1000
        },
        status: false,
        placeholder: "Напишите здесь содержимое страницы...",
        toolbar: [
          "bold", "italic", "heading", "|", 
          "quote", "unordered-list", "ordered-list", "|", 
          "link", "code", "table", "|", // Убрали "image" по требованию
          // Кастомная кнопка загрузки
          {
            name: uploadIconSvg, 
            action: function(editor){
                document.getElementById('wikiPageFileInput').click();
            },
            className: "fa fa-upload", // Фолбекный класс
            title: "Загрузить файл/картинку"
          },
          "|",
          "preview", "side-by-side", "fullscreen"
        ],
        imageUploadFunction: function(file, onSuccess, onError) {
          // Дублируем логику в кнопку, так как EasyMDE может использовать стандартный диалог тоже
          uploadCustomFile(file, onSuccess, onError);
        }
      });

      // Подписываемся на выбор файла
      document.getElementById('wikiPageFileInput').addEventListener('change', function(e) {
        if (this.files && this.files.length > 0) {
          uploadCustomFile(this.files[0]);
          this.value = ''; 
        }
      });
    }

    // Загрузка картинок
    async function uploadCustomFile(file, onSuccess, onError) {
      const formData = new FormData();
      formData.append('file', file);
      
      // Сохраняем черновик перед загрузкой
      if (easyMDEInstance) {
        const currentContent = easyMDEInstance.value();
        localStorage.setItem('wiki_new_page_draft_safety', currentContent);
      }
      
      showNotification('Загрузка файла...', 'info');

      const url = `${authServiceUrl}/api/v1/wiki/pages/upload_temporary_image`; 
      
      try {
        const response = await fetch(url, {
          method: 'POST',
          headers: {
            'X-User-ID': actorId,
            'Authorization': `Bearer ${interServiceApiKey}`
          },
          body: formData,
          credentials: 'include'
        });

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData.error || 'Ошибка загрузки');
        }

        const data = await response.json();
        
        // Сохраняем signed_id
        if (data.signed_id) {
          uploadedTempImageIds.push(data.signed_id);
          document.getElementById('wikiPageTempImageIds').value = JSON.stringify(uploadedTempImageIds);
        }
        
        // Вставка в редактор, если передан колбек (из imageUploadFunction)
        if (onSuccess && data.url) {
          onSuccess(data.url);
        } else if (data.url) {
          // Ручная вставка, если вызвали из нашей кнопки
          const cm = easyMDEInstance.codemirror;
          const cursorPos = cm.getCursor();
          
          let insertText = '';
          if (data.type === 'image') {
            insertText = `
![${data.filename}](${data.url})
`;
          } else {
            insertText = `[Скачать ${data.filename}](${data.url})`;
          }

          cm.replaceRange(insertText, cursorPos);
          cm.focus();
        } else {
           throw new Error('URL не получен');
        }

        showNotification('Файл загружен');

      } catch (error) {
        console.error('Upload error:', error);
        if (onError) onError('Ошибка загрузки: ' + error.message);
        else showAlertNotification('Ошибка загрузки: ' + error.message);
      }
    }

    // Загрузка категорий
    async function loadWikiCategories() {
      const select = document.getElementById('wikiPageCategory');
      select.innerHTML = '<option value="" disabled selected>Загрузка...</option>';

      try {
        const url = `${authServiceUrl}/api/v1/wiki/categories`;

        const response = await fetch(url, {
          method: 'GET',
          headers: {
            'X-User-ID': actorId,
            'Authorization': `Bearer ${interServiceApiKey}`
          }
        });

        if (!response.ok) throw new Error('Ошибка загрузки категорий');
        
        const data = await response.json();
        const categories = Array.isArray(data) ? data : (data.categories || []);
        const flatCats = flattenCategories(categories);
        
        select.innerHTML = '<option value="">Без категории</option>';
        flatCats.forEach(cat => {
          const option = document.createElement('option');
          option.value = cat.id;
          option.textContent = cat.name;
          select.appendChild(option);
        });
        
        updateParentCategories(flatCats);

      } catch (error) {
        console.error('Error loading cats:', error);
        select.innerHTML = '<option value="" selected>Не удалось загрузить</option>';
      }
    }
  
    // Рекурсивная распаковка категорий
    function flattenCategories(cats, level = 0) {
      let res = [];
      cats.forEach(c => {
        c.name = "—".repeat(level) + " " + c.name;
        res.push(c);
        if (c.children && c.children.length > 0) {
          res = res.concat(flattenCategories(c.children, level + 1));
        }
      });
      return res;
    }

    // Создание страницы
    async function submitWikiPageForm() {
      const titleInput = document.getElementById('wikiPageTitle');
      const slugInput = document.getElementById('wikiPageSlug');
      const catSelect = document.getElementById('wikiPageCategory');
      const posInput = document.getElementById('wikiPagePosition');
      const publishedInput = document.getElementById('wikiPagePublished');

      if (!titleInput.value.trim()) {
        showNotification('Введите заголовок', 'error');
        titleInput.focus();
        return;
      }
      if (!easyMDEInstance.value().trim()) {
        showNotification('Содержание не может быть пустым', 'error');
        return;
      }
      if (!slugInput.value.trim()) {
        showNotification('Заполните Slug', 'error');
        return;
      }

      const formData = new FormData();
      formData.append('wiki_page[title]', titleInput.value);
      formData.append('wiki_page[slug]', slugInput.value);
      formData.append('wiki_page[content]', easyMDEInstance.value());
      formData.append('wiki_page[position]', posInput.value || 0);
      formData.append('wiki_page[published]', publishedInput.checked);
      if (catSelect.value) {
        formData.append('wiki_page[wiki_category_id]', catSelect.value);
      }
      
      // ID временных картинок
      uploadedTempImageIds.forEach(id => {
        formData.append('temp_image_ids[]', id);
      });

      try {
        showGlobalLoading();
        
        const url = `${authServiceUrl}/api/v1/wiki/pages`;

        const response = await fetch(url, {
          method: 'POST',
          headers: {
            'X-User-ID': actorId,
            'Authorization': `Bearer ${interServiceApiKey}`
          },
          body: formData,
          credentials: 'include'
        });

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData.error || 'Ошибка создания');
        }

        localStorage.removeItem('wiki_new_page_draft');

        showNotification('Страница создана');
        closeAddWikiPageModal();
        if (typeof loadWikiPages === 'function') loadWikiPages();

      } catch (error) {
        console.error(error);
        showAlertNotification(error.message);
      } finally {
        hideGlobalLoading();
      }
    }

    // --- КАТЕГОРИИ ---

    function openAddCategoryModal() {
      document.getElementById('categoryForm').reset();
      document.getElementById('addCategoryModal').showModal();
    }
  
    function generateCatSlug(title) {
      const slugInput = document.getElementById('catSlug');
      if (!slugInput || document.activeElement === slugInput) return;
      const ru = "А-а-Б-б-В-в-Г-г-Д-д-Е-е-Ё-ё-Ж-ж-З-з-И-и-Й-й-К-к-Л-л-М-м-Н-н-О-о-П-п-Р-р-С-с-Т-т-У-у-Ф-ф-Х-х-Ц-ц-Ч-ч-Ш-ш-Щ-щ-Ъ-ъ-Ы-ы-Ь-ь-Э-э-Ю-ю-Я-я".split("-");
      const en = "A-a-B-b-V-v-G-g-D-d-E-e-E-e-ZH-zh-Z-z-I-i-J-j-K-k-L-l-M-m-N-n-O-o-P-p-R-r-S-s-T-t-U-u-F-f-H-h-TS-ts-CH-ch-SH-sh-SCH-shch-'-'-Y-y-'-'-E-e-YU-yu-YA-ya".split("-");
      
      let slug = title.split('').map(char => {
        const idx = ru.indexOf(char);
        return idx !== -1 ? en[idx] : char;
      }).join('');

      slug = slug.toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .trim();
        
      slugInput.value = slug;
    }

    function updateParentCategories(cats) {
      const select = document.getElementById('catParent');
      select.innerHTML = '<option value="">Нет (Корневая)</option>';
      cats.forEach(cat => {
        const option = document.createElement('option');
        option.value = cat.id;
        option.textContent = cat.name;
        select.appendChild(option);
      });
    }

    async function submitCategory() {
      const name = document.getElementById('catName').value;
      const slug = document.getElementById('catSlug').value;
      const parentId = document.getElementById('catParent').value;

      if (!name) return showNotification('Введите название', 'error');

      const formData = new FormData();
      formData.append('wiki_category[name]', name);
      formData.append('wiki_category[slug]', slug);
      if (parentId) formData.append('wiki_category[parent_id]', parentId);

      try {
        showGlobalLoading();
        const url = `${authServiceUrl}/api/v1/wiki/categories`;

        const response = await fetch(url, {
          method: 'POST',
          headers: {
            'X-User-ID': actorId,
            'Authorization': `Bearer ${interServiceApiKey}`
          },
          body: formData,
          credentials: 'include'
        });

        if (!response.ok) throw new Error('Ошибка создания категории');

        document.getElementById('addCategoryModal').close();
        showNotification('Категория добавлена');
        loadWikiCategories();
      } catch (e) {
        showAlertNotification(e.message);
      } finally {
        hideGlobalLoading();
      }
    }

    // --- СТИЛИ EasyMDE (FINAL FIX) ---
    const customStyle = document.createElement('style');
    customStyle.innerHTML = `
      /* Обертка */
      .editor-wrapper { background-color: #262626 !important; }
      
      /* Тулбар */
      .editor-toolbar {
        border-top: none !important;
        border-left: none !important;
        border-right: none !important;
        background-color: #262626 !important;
        border-bottom: 2px solid #404040 !important;
        padding: 10px !important;
      }
      .editor-toolbar button {
        color: #d1d5db !important;
        border-color: #4b5563 !important;
        background-color: transparent !important;
        padding: 5px 10px !important;
        margin: 0 2px !important;
        width: auto !important;
        font-size: 14px;
      }
      .editor-toolbar button:hover, .editor-toolbar button.active {
        background-color: #404040 !important;
        border-color: #fbbf24 !important;
        color: #fbbf24 !important;
      }
      .editor-toolbar .separator {
        border-color: #4b5563 !important;
        margin: 0 5px !important;
      }
      
      /* Кастомная кнопка (SVG) */
      .editor-toolbar button svg {
        width: 16px;
        height: 16px;
        fill: none;
        stroke: currentColor;
      }

      /* CodeMirror (Редактор) */
      .CodeMirror {
        background-color: #262626 !important;
        color: #e5e7eb !important;
        border: none !important;
        font-family: 'Fira Code', 'Consolas', monospace;
        font-size: 14px;
        height: 500px; /* Фиксируем высоту */
      }
      .CodeMirror-gutters {
        background-color: #262626 !important;
        border-right: 1px solid #404040 !important;
      }
      .CodeMirror-linenumber {
        color: #6b7280 !important;
      }
      .CodeMirror-cursor {
        border-left-color: #fbbf24 !important;
      }
      .CodeMirror-selected {
        background-color: rgba(251, 191, 36, 0.2) !important;
      }
      
      /* Скроллбар редактора */
      .CodeMirror-vscrollbar::-webkit-scrollbar {
        width: 10px;
        height: 10px;
      }
      .CodeMirror-vscrollbar::-webkit-scrollbar-thumb {
        background: #4b5563;
        border-radius: 5px;
      }
      .CodeMirror-vscrollbar::-webkit-scrollbar-track {
        background: #262626;
      }

      /* Подсветка синтаксиса */
      .cm-s-easymde .cm-header { color: #fbbf24; font-weight: bold; }
      .cm-s-easymde .cm-quote { color: #9ca3af; font-style: italic; }
      .cm-s-easymde .cm-keyword { color: #c084fc; }
      .cm-s-easymde .cm-atom { color: #60a5fa; }
      .cm-s-easymde .cm-number { color: #f472b6; }
      .cm-s-easymde .cm-link { color: #60a5fa; text-decoration: underline; }
      .cm-s-easymde .cm-variable-2 { color: #34d399; }
      .cm-s-easymde .cm-variable { color: #e5e7eb; }
      .cm-s-easymde .cm-string { color: #a78bfa; }
      .cm-s-easymde .cm-comment { color: #6b7280; font-style: italic; }

      /* Предпросмотр */
      .editor-preview {
        background-color: #1f1f1f !important;
        color: #e5e7eb !important;
        border-right: 1px solid #404040 !important;
        padding: 20px !important;
        font-size: 15px;
        line-height: 1.6;
      }
      .editor-preview-side {
        border-left: 1px solid #404040 !important;
      }
      
      /* Типографика предпросмотра */
      .editor-preview h1, .editor-preview h2, .editor-preview h3 {
        color: #fbbf24 !important;
        border-bottom: 1px solid #4b5563 !important;
        padding-bottom: 0.3em;
        margin-top: 1.5em;
      }
      .editor-preview h1:first-child { margin-top: 0; }
      .editor-preview p { margin-bottom: 16px; color: #d1d5db; }
      .editor-preview a { color: #fbbf24 !important; text-decoration: underline; }
      
      .editor-preview blockquote {
        border-left: 4px solid #fbbf24 !important;
        padding-left: 16px;
        color: #9ca3af;
        margin-left: 0;
        background-color: rgba(251, 191, 36, 0.05);
        padding: 10px;
        border-radius: 4px;
      }
      
      .editor-preview code {
        background-color: #111827 !important;
        color: #f87171 !important;
        padding: 2px 6px;
        border-radius: 4px;
        font-family: monospace;
        font-size: 0.9em;
      }
      
      .editor-preview pre {
        background-color: #111827 !important;
        padding: 16px;
        overflow-x: auto;
        border-radius: 8px;
        border: 1px solid #374151;
      }
      .editor-preview pre code {
        background-color: transparent !important;
        padding: 0;
        color: inherit !important;
      }
      
      /* ТАБЛИЦЫ - ФИКС РАЗМЕРОВ */
      .editor-preview table {
        border-collapse: collapse;
        width: 100%;
        max-width: 100%;
        margin-bottom: 16px;
        overflow-x: auto; /* Разрешает скролл для больших таблиц */
        display: block; /* Для корректной работы overflow-x: auto */
        font-size: 14px;
      }
      .editor-preview thead { display: table-header-group; width: 100%; }
      .editor-preview tbody { display: table-row-group; width: 100%; }
      .editor-preview tr { display: table-row; width: 100%; }
      .editor-preview th, .editor-preview td {
        border: 1px solid #4b5563 !important;
        padding: 8px 12px;
        text-align: left;
        min-width: 50px; /* Чтобы не схлопывались в 0 */
      }
      .editor-preview th {
        background-color: #262626 !important;
        color: #fbbf24;
        font-weight: bold;
      }
      
      .editor-preview img {
        max-width: 100%;
        border-radius: 8px;
        height: auto;
        display: block;
        margin: 10px 0;
      }
      .editor-preview hr {
        border: 0;
        border-top: 1px solid #4b5563 !important;
        margin: 24px 0;
      }
      .editor-preview ul, .editor-preview ol { padding-left: 2em; color: #d1d5db; }
    `;
    document.head.appendChild(customStyle);
</script>
