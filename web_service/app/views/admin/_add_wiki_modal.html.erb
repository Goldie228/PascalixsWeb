<!-- _add_wiki_modal.html.erb -->
<!-- Модальное окно для добавления Wiki страницы -->
<dialog id="addWikiPageModal" class="modal"
        data-service-url="<%= ENV['AUTH_SERVICE_URL'] %>" 
        data-api-key="<%= ENV['INTER_SERVICE_API_KEY'] %>"
        data-user-id="<%= current_user.id %>">
  <div class="modal-box w-full max-w-6xl bg-[#1A1A1A] border border-amber-400 p-0 rounded overflow-hidden flex flex-col max-h-[90vh] shadow-2xl transition-all duration-300 ease-in-out">
       
    <!-- Шапка -->
    <div class="p-6 border-b border-gray-700 flex justify-between items-center bg-[#1A1A1A] z-10 shrink-0">
      <h3 class="text-2xl text-amber-400 font-bold">Добавить Wiki страницу</h3>
      <button type="button" class="text-gray-400 hover:text-white transition" onclick="closeAddWikiPageModal()">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Скроллируемая область контента -->
    <div class="flex-1 overflow-y-auto p-6 bg-[#1A1A1A] relative">
      <form id="wikiPageForm" class="space-y-6 flex flex-col h-full">
        <%= render 'wiki_editor', mode: 'create' %>
      </form>
    </div>

    <!-- Футер -->
    <div class="p-6 border-t border-gray-700 bg-[#1A1A1A] flex justify-end space-x-3 shrink-0 z-10">
      <button type="button" class="px-6 py-2 text-gray-300 bg-[#262626] border border-gray-600 rounded-lg hover:bg-[#2E2E2E] hover:text-white transition" onclick="closeAddWikiPageModal()">
        Отмена
      </button>
      <button type="button" id="createPageBtn" class="px-6 py-2 text-black bg-amber-400 border border-amber-400 rounded-lg hover:bg-amber-300 hover:border-amber-300 font-medium transition min-w-[120px]" onclick="submitWikiPageForm('create')">
        Создать страницу
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<script>
  function openAddWikiPageModal() {
    const modal = document.getElementById('addWikiPageModal');
    if (!modal) return;
    
    const config = typeof getWikiAuthConfig === 'function' ? getWikiAuthConfig('addWikiPageModal') : null;
    if (!config || !config.serviceUrl || !config.apiKey || !config.userId) {
      console.error('[AddWikiModal] Отсутствуют параметры конфигурации');
      if (typeof showAlertNotification === 'function') {
        showAlertNotification('Ошибка конфигурации: отсутствуют параметры подключения');
      }
      return;
    }
    
    document.getElementById('wikiPageForm').reset();
    document.getElementById('wikiPagePosition').value = 0;
    const tempImageIdsElement = document.getElementById('wikiPageTempImageIds');
    if (tempImageIdsElement) {
      tempImageIdsElement.value = '[]';
    }
    
    window.isSlugValid = false;
    const slugValidation = document.getElementById('slugValidation');
    if (slugValidation) {
      slugValidation.innerHTML = '';
    }
    const slugError = document.getElementById('slugError');
    if (slugError) {
      slugError.classList.add('hidden');
    }
    const createBtn = document.getElementById('createPageBtn');
    if (createBtn) {
      createBtn.disabled = false;
    }
    
    if (window.wikiEditorInstances && window.wikiEditorInstances['addWikiPageModal']) {
      window.wikiEditorInstances['addWikiPageModal'].toTextArea();
      delete window.wikiEditorInstances['addWikiPageModal'];
    }
    
    modal.showModal();
    
    setTimeout(() => {
      if (window.WikiEditor && typeof WikiEditor.initWikiEditor === 'function') {
        WikiEditor.initWikiEditor('addWikiPageModal', 'create');
      }
      
      const savedContent = localStorage.getItem('wiki_new_page_draft');
      if (savedContent && confirm('Найден сохраненный черновик. Восстановить?')) {
        if (window.wikiEditorInstances && window.wikiEditorInstances['addWikiPageModal']) {
          window.wikiEditorInstances['addWikiPageModal'].value(savedContent);
        }
      }
    }, 100);
  }

  function closeAddWikiPageModal() {
    const modal = document.getElementById('addWikiPageModal');
    if (modal) {
      if (window.wikiEditorInstances && window.wikiEditorInstances['addWikiPageModal']) {
        window.wikiEditorInstances['addWikiPageModal'].toTextArea();
        delete window.wikiEditorInstances['addWikiPageModal'];
      }
      modal.close();
    }
  }
</script>
