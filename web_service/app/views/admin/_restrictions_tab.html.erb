<div class="space-y-6">
  <!-- Заголовок блока -->
  <div class="flex items-center justify-between">
    <h4 class="text-xl font-semibold">Действующие ограничения</h4>
      <button
        id="add-restriction-btn"
        type="button"
        data-nickname=""
        onclick="openNewRestrictionModal(this)"
        class="btn bg-amber-400 text-black hover:bg-[#FFC400] transition px-4 py-2">
        Добавить ограничение
      </button>
  </div>
  <div class="w-full h-px bg-[#2D2D2D]"></div>

  <!-- Активные ограничения -->
  <div class="overflow-x-auto rounded-box overflow-hidden"
       style="max-height: 300px; overflow-y: auto;">
    <table class="table w-full text-sm">
      <thead class="text-white" style="background-color: #2D2D2D;">
        <tr>
          <th class="py-3 px-4">Тип</th>
          <th class="py-3 px-4">Причина</th>
          <th class="py-3 px-4">Выдано</th>
          <th class="py-3 px-4">Истекает</th>
          <th class="py-3 px-4">Статус</th>
          <th class="py-3 px-4">Действие</th>
        </tr>
      </thead>
      <tbody id="active-punishments-body"
             class="text-white"
             style="background-color: #3A3A3A;">
      </tbody>
    </table>
  </div>

  <!-- История ограничений -->
  <div>
    <h4 class="text-xl font-semibold mt-6">История ограничений</h4>
    <div class="w-full h-px bg-[#2D2D2D] my-2"></div>

    <div class="overflow-x-auto rounded-box overflow-hidden"
         style="max-height: 300px; overflow-y: auto;">
      <table class="table w-full text-sm">
        <thead class="text-white" style="background-color: #2D2D2D;">
          <tr>
            <th class="py-3 px-4">Тип</th>
            <th class="py-3 px-4">Причина</th>
            <th class="py-3 px-4">Выдано</th>
            <th class="py-3 px-4">Истекает</th>
            <th class="py-3 px-4">Статус</th>
          </tr>
        </thead>
        <tbody id="history-punishments-body"
               class="text-white"
               style="background-color: #3A3A3A;">
        </tbody>
      </table>
    </div>
  </div>
</div>
