<div class="space-y-4">
  <h4 class="text-xl font-semibold">Информация аккаунта</h4>
  <div class="w-full h-px bg-[#2D2D2D]"></div>

  <!-- Email -->
  <label class="block text-sm mb-1" for="email">Email</label>
  <input
    id="email"
    type="email"
    class="input w-full bg-[#2D2D2D] text-white focus:outline-none focus:bg-[#2D2D2D]"
    value="user@pascalixs.by" />

  <!-- Discord -->
  <label class="block text-sm mb-1" for="discord">Discord</label>
  <input
    id="discord"
    type="text"
    class="input w-full bg-[#2D2D2D] text-white focus:outline-none focus:bg-[#2D2D2D]"
    value="@noname" />

  <!-- Проходка -->
  <label class="block text-sm mb-1" for="pass">Проходка</label>
  <select
    id="pass"
    class="select w-full bg-[#2D2D2D] text-white focus:outline-none focus:bg-[#2D2D2D]">
    <option value="true" selected>Есть</option>
    <option value="false">Нет</option>
  </select>

  <!-- Сохранить -->
  <div class="flex justify-end pt-4">
    <button id="save-account-btn"
            type="button"
            class="btn bg-amber-400 text-black hover:bg-[#FFC400] transition duration-150">
      Сохранить изменения
    </button>
  </div>
  <!-- Опасная зона -->
  <div class="mt-8 border border-[#3A3A3A] rounded-md bg-[#1A1A1A] p-4 space-y-2">
    <h4 class="text-red-400 text-lg font-medium">Опасная зона</h4>
    <p class="text-[#AAAAAA] text-sm leading-relaxed">
      Это <span class="font-semibold">необратимое действие</span>.<br>
      После удаления аккаунта <span class="font-semibold">все данные будут уничтожены навсегда</span> — включая игровой прогресс, привязанные сервисы и возможность авторизации под вашим Minecraft ником.<br>
      <span class="font-semibold text-red-400">Вернуться будет невозможно.</span><br>
      <span class="text-[#888]">[Для админов] Вы можете восстановить доступ вручную через кнопку <span class="italic">«Восстановить»</span> во вкладке <span class="italic">«Удалённые аккаунты»</span>.</span>
    </p>
    <p class="text-[#666] text-xs italic">Мы не сохраняем резервных копий. Убедитесь в своём решении заранее.</p>
    <button id="open-delete-modal-btn"
            type="button"
            class="btn bg-[#1A1A1A] border-[#3A3A3A] text-[#bbbbbb] hover:bg-red-600 hover:text-white transition duration-150 px-4 py-2 rounded">
      Удалить аккаунт
    </button>
  </div>
</div>

<script type="text/javascript">
  document.getElementById("save-account-btn").addEventListener("click", function () {
    const nickname = document.getElementById("add-restriction-btn")?.dataset.nickname;
    const email    = document.getElementById("email").value;
    const discord  = document.getElementById("discord").value;
    const pass     = document.getElementById("pass").value;
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    if (!nickname) {
      showAlertNotification("Никнейм не определён — перезагрузите страницу");
      return;
    }

    fetch(`/admin/players/${nickname}/update_account`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": csrfToken,
        "Accept": "application/json"
      },
      body: JSON.stringify({ email, discord, pass })
    })
    .then(async response => {
      const contentType = response.headers.get("Content-Type");

      // Если это JSON — парсим, иначе читаем как текст
      const raw = contentType && contentType.includes("application/json")
        ? await response.json()
        : await response.text();

      if (!response.ok) {
        const msg = raw?.error || raw || `Ошибка: ${response.status}`;
        throw new Error(msg);
      }

      showNotification("✅ Профиль обновлён");
    })
    .catch(error => {
      console.warn("❌ Ошибка запроса:", error.message);
      showAlertNotification(error.message);
    });
  });  
</script>
