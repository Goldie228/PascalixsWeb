<div class="space-y-4">
  <h4 class="text-xl font-semibold">Информация аккаунта</h4>
  <div class="w-full h-px bg-[#2D2D2D]"></div>

  <!-- Email -->
  <label class="block text-sm mb-1" for="email">Email</label>
  <input
    id="email"
    type="email"
    class="input w-full bg-[#2D2D2D] text-white focus:outline-none focus:bg-[#2D2D2D]"
    value="user@pascalixs.by" />

  <!-- Discord -->
  <label class="block text-sm mb-1" for="discord">Discord</label>
  <input
    id="discord"
    type="text"
    class="input w-full bg-[#2D2D2D] text-white focus:outline-none focus:bg-[#2D2D2D]"
    value="@goldie228" />

  <!-- Проходка -->
  <label class="block text-sm mb-1" for="pass">Проходка</label>
  <select
    id="pass"
    class="select w-full bg-[#2D2D2D] text-white focus:outline-none focus:bg-[#2D2D2D]">
    <option value="true" selected>Есть</option>
    <option value="false">Нет</option>
  </select>

  <!-- Сохранить -->
  <div class="flex justify-end pt-4">
    <button type="submit"
            class="btn bg-amber-400 text-black hover:bg-[#FFC400] transition duration-150">
      Сохранить изменения
    </button>
  </div>
</div>
