<div class="space-y-4">
  <h4 class="text-xl font-semibold"><%= I18n.t('admin.players.profile.account_info') %></h4>
  <div class="w-full h-px bg-[#2D2D2D]"></div>

  <label class="block text-sm mb-1" for="email"><%= I18n.t('common.email') %></label>
  <input
    id="email"
    type="email"
    class="input w-full bg-[#2D2D2D] text-white focus:outline-none focus:bg-[#2D2D2D]"
    value="user@pascalixs.by" />

  <label class="block text-sm mb-1" for="discord">Discord</label>
  <input
    id="discord"
    type="text"
    class="input w-full bg-[#2D2D2D] text-white focus:outline-none focus:bg-[#2D2D2D]"
    value="@noname" />

  <label class="block text-sm mb-1" for="pass"><%= I18n.t('admin.players.profile.pass_access') %></label>
  <select
    id="pass"
    class="select w-full bg-[#2D2D2D] text-white focus:outline-none focus:bg-[#2D2D2D]">
    <option value="true" selected><%= I18n.t('common.yes_t') %></option>
    <option value="false"><%= I18n.t('common.no_t') %></option>
  </select>

  <div class="flex justify-end pt-4">
    <button id="save-account-btn"
            type="button"
            class="btn bg-amber-400 text-black hover:bg-[#FFC400] transition duration-150">
      <%= I18n.t('common.save_changes') %>
    </button>
  </div>
  
  <div class="mt-8 border border-[#3A3A3A] rounded-md bg-[#1A1A1A] p-4 space-y-2">
    <h4 class="text-red-400 text-lg font-medium"><%= I18n.t('admin.players.profile.danger_zone') %></h4>
    <p class="text-[#AAAAAA] text-sm leading-relaxed">
      <%= I18n.t('admin.players.profile.irreversible_warning_html').html_safe %>
    </p>
    <p class="text-[#666] text-xs italic"><%= I18n.t('admin.players.profile.no_backups') %></p>
    <button id="open-delete-modal-btn"
            type="button"
            class="btn bg-[#1A1A1A] border-[#3A3A3A] text-[#bbbbbb] hover:bg-red-600 hover:text-white transition duration-150 px-4 py-2 rounded">
      <%= I18n.t('admin.players.profile.delete_account') %>
    </button>
  </div>
</div>

<script type="text/javascript">
  document.getElementById("save-account-btn").addEventListener("click", function () {
    const nickname = document.getElementById("add-restriction-btn")?.dataset.nickname;
    const email    = document.getElementById("email").value;
    const discord  = document.getElementById("discord").value;
    const pass     = document.getElementById("pass").value;
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    if (!nickname) {
      showAlertNotification("<%= I18n.t('admin.players.errors.undefined_nickname') %>");
      return;
    }

    fetch(`/admin/players/${nickname}/update_account`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": csrfToken,
        "Accept": "application/json"
      },
      body: JSON.stringify({ email, discord, pass })
    })
    .then(async response => {
      const contentType = response.headers.get("Content-Type");
      const raw = contentType?.includes("application/json") ? await response.json() : await response.text();

      if (!response.ok) {
        const msg = raw?.error || raw || `<%= I18n.t('common.errors.generic') %>: ${response.status}`;
        throw new Error(msg);
      }

      showNotification("<%= I18n.t('admin.players.notifications.profile_updated') %>");
    })
    .catch(error => {
      showAlertNotification("<%= I18n.t('common.errors.request_failed') %>");
    });
  });  
</script>
