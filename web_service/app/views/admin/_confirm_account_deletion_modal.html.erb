<dialog id="confirm_account_deletion_modal" class="modal">
  <div class="modal-box w-full max-w-xl bg-[#1A1A1A] border border-red-500 p-8 rounded">
    <!-- Заголовок -->
    <h3 class="text-2xl text-red-400 font-bold mb-4">
      Вы уверены, что хотите удалить аккаунт?
    </h3>

    <!-- Описание -->
    <p class="text-sm text-[#AAAAAA] leading-relaxed mb-6">
      Это <span class="font-semibold text-red-400">необратимое действие</span>. Все данные будут <span class="font-semibold">уничтожены навсегда</span>.<br>
      <span class="text-[#888]">[Для админов] После удаления восстановление доступа возможно только через админскую панель.</span>
    </p>

    <!-- Действия -->
    <div class="modal-action flex justify-end space-x-3">
      <button
        type="button"
        class="btn text-sm px-4 py-2 text-gray-300 bg-[#2D2D2D] hover:bg-[#3A3A3A] transition"
        onclick="closeDeletionModal()"
      >
        Отмена
      </button>

      <button
        id="delete-account-btn"
        type="button"
        class="btn bg-red-600 text-white hover:bg-red-700 px-4 py-2 text-sm font-semibold transition"
        onclick="proceedAccountDeletion()"
      >
        Да, удалить
      </button>
    </div>
  </div>

  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<script type="text/javascript">
  const deletionModal = document.getElementById("confirm_account_deletion_modal");

  document.getElementById("open-delete-modal-btn")?.addEventListener("click", () => {
    if (deletionModal) deletionModal.showModal();

    const nickname = document.getElementById("add-restriction-btn")?.dataset.nickname;
    const confirmBtn = document.getElementById("delete-account-btn");
    if (confirmBtn && nickname) {
      confirmBtn.dataset.nickname = nickname;
    }
    console.log("Удаление запущено...");
  });

  function closeDeletionModal() {
    if (deletionModal) deletionModal.close();
  }

  function proceedAccountDeletion() {
    const deleteBtn = document.getElementById("delete-account-btn");
    const nickname = deleteBtn?.dataset.nickname;
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    if (!nickname) {
      showAlertNotification("Никнейм не найден. Перезагрузите страницу.");
      return;
    }

    fetch(`/admin/players/${nickname}/delete_account`, {
      method: "DELETE",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": csrfToken,
        "Accept": "application/json"
      }
    })
    .then(async response => {
      const contentType = response.headers.get("Content-Type");
      const raw = contentType?.includes("application/json") ? await response.json() : await response.text();

      if (!response.ok) {
        const msg = raw?.error || raw || `Ошибка: ${response.status}`;
        throw new Error(msg);
      }

      deletionModal.close();
      showNotification("Аккаунт успешно удалён");
    })
    .catch(error => {
      console.warn("❌ Ошибка удаления:", error.message);
      showAlertNotification(error.message);
    });
  }
</script>
