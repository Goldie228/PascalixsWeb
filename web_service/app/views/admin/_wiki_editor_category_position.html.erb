<!--
  _wiki_editor_category_position.html.erb
  Компонент для выбора категории и позиции Wiki страницы.
  Включает drag-and-drop превью для визуального выбора позиции.
-->
<div class="grid grid-cols-1 gap-4 md:gap-6 shrink-0 w-full">
  <!-- Категория -->
  <div class="w-full min-w-0">
    <label for="wikiPageCategory" class="block text-white mb-2 font-medium">Категория</label>
    <div class="flex gap-2 w-full">
      <select id="wikiPageCategory" name="wiki_category_id" class="flex-1 min-w-0 bg-[#262626] text-white border-2 border-gray-600 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 outline-none rounded-lg px-3 py-2 transition-colors cursor-pointer text-sm md:text-base">
        <option value="" disabled>Выберите категорию...</option>
        <% if local_assigns[:categories] %>
          <% local_assigns[:categories].each do |category| %>
            <option value="<%= category.id %>" <%= 'selected' if local_assigns[:category_id] && category.id == local_assigns[:category_id].to_i %>><%= category.name %></option>
          <% end %>
        <% end %>
      </select>
      <button type="button" class="border-2 border-amber-400 text-amber-400 hover:bg-amber-400/10 transition flex items-center justify-center gap-1 bg-[#262626] px-3 py-2 rounded-lg" title="Добавить категорию" onclick="WikiEditorCategory.openAddCategoryModal()">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>
    <div id="categoryPath" class="text-xs text-gray-400 mt-2 break-all"></div>
  </div>

  <!-- Позиция с drag-and-drop превью -->
  <div class="w-full min-w-0">
    <label class="block text-white mb-2 font-medium">
      Позиция в списке
      <span id="positionHint" class="text-xs text-gray-400 font-normal ml-2"></span>
    </label>
    
    <!-- Скрытый input для отправки позиции -->
    <input type="hidden" id="wikiPagePosition" name="position" value="<%= local_assigns[:position] || 0 %>">
    
    <!-- Drag-and-drop превью списка -->
    <div id="positionPreviewContainer" class="bg-[#262626] border-2 border-gray-600 rounded-lg p-3 min-h-[150px] max-h-[300px] overflow-y-auto transition-colors focus-within:border-amber-400">
      <div id="positionPreviewLoading" class="text-center text-gray-400 py-6">
        <svg class="animate-spin h-6 w-6 mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="text-sm">Загрузка списка страниц...</span>
      </div>
      <div id="positionPreviewList" class="hidden space-y-2"></div>
    </div>
    
    <!-- Подсказка -->
    <div id="positionStatus" class="text-xs mt-2 text-gray-400 flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      Перетащите страницу в нужную позицию
    </div>
  </div>
</div>

<script>
/**
 * Wiki Editor Category & Position Module
 * 
 * Модуль для выбора категории и позиции Wiki страницы.
 * Включает drag-and-drop превью для визуального выбора позиции.
 * 
 * Зависимости: SortableJS (загружается динамически из CDN)
 */

// Пространство имен для функций категорий
window.WikiEditorCategory = window.WikiEditorCategory || {};

// Пространство имен для управления позициями
window.WikiEditorPosition = window.WikiEditorPosition || {};

// Состояние модуля позиций
WikiEditorPosition.pagesData = [];           // Массив страниц с их позициями
WikiEditorPosition.currentPageId = null;     // ID редактируемой страницы (null для новой)
WikiEditorPosition.currentTitle = '';        // Текущий заголовок страницы
WikiEditorPosition.sortableInstance = null;  // Экземпляр SortableJS
WikiEditorPosition.isLoading = false;        // Флаг загрузки
WikiEditorPosition.currentContainerId = null; // ID текущего модального окна

/**
 * Загрузка страниц для превью позиций
 */
WikiEditorPosition.loadPagesPreview = async function(containerId) {
  if (!containerId) containerId = 'addWikiPageModal';
  
  // Предотвращаем повторные вызовы для ОДНОГО И ТОГО ЖЕ модального окна
  if (WikiEditorPosition.isLoading === containerId) {
    console.log('[WikiEditorPosition] Already loading for', containerId, ', skipping...');
    return;
  }
  
  const previousLoading = WikiEditorPosition.isLoading;
  WikiEditorPosition.isLoading = containerId;
  console.log('[WikiEditorPosition] loadPagesPreview called for:', containerId);
  
  // Ищем элементы В КОНТЕКСТЕ модального окна
  const modal = document.getElementById(containerId);
  const container = modal?.querySelector('#positionPreviewContainer') || document.getElementById('positionPreviewContainer');
  const loadingEl = modal?.querySelector('#positionPreviewLoading') || document.getElementById('positionPreviewLoading');
  const listEl = modal?.querySelector('#positionPreviewList') || document.getElementById('positionPreviewList');
  
  console.log('[WikiEditorPosition] Elements found:', { 
    container: !!container, 
    loadingEl: !!loadingEl, 
    listEl: !!listEl 
  });
  
  if (!container || !listEl) {
    console.error('[WikiEditorPosition] Required elements not found!');
    return;
  }
  
  const config = typeof getWikiAuthConfig === 'function' 
    ? getWikiAuthConfig(containerId)
    : { serviceUrl: '', apiKey: '', userId: '' };

  console.log('[WikiEditorPosition] Config:', {
    hasServiceUrl: !!config.serviceUrl,
    hasApiKey: !!config.apiKey,
    hasUserId: !!config.userId
  });

  if (!config.serviceUrl || !config.apiKey || !config.userId) {
    loadingEl.innerHTML = '<span style="color: #ef4444;">Ошибка конфигурации</span>';
    return;
  }

  // Получаем выбранную категорию
  const categorySelect = modal?.querySelector('#wikiPageCategory');
  const categoryId = categorySelect?.value || '';
  
  // Получаем ID текущей страницы (для режима редактирования)
  const pageIdInput = modal?.querySelector('#wikiPageId');
  WikiEditorPosition.currentPageId = pageIdInput?.value || null;
  
  console.log('[WikiEditorPosition] pageIdInput value:', pageIdInput?.value);
  console.log('[WikiEditorPosition] currentPageId set to:', WikiEditorPosition.currentPageId);
  
  // Получаем заголовок текущей страницы
  const titleInput = modal?.querySelector('#wikiPageTitle');
  WikiEditorPosition.currentTitle = titleInput?.value || 'Новая страница';
  
  // Сохраняем текущий контейнер для использования в renderPositionPreview
  WikiEditorPosition.currentContainerId = containerId;

  const baseUrl = config.serviceUrl.replace(/\/$/, '');
  
  // Загружаем страницы в категории
  let url = `${baseUrl}/api/v1/wiki/pages/admin_index?per_page=1000`;
  if (categoryId) {
    url += `&category_id=${categoryId}`;
  }

  console.log('[WikiEditorPosition] Fetching URL:', url);

  try {
    const response = await fetch(url, {
      method: 'GET',
      headers: {
        'X-User-ID': config.userId,
        'Authorization': `Bearer ${config.apiKey}`
      }
    });

    console.log('[WikiEditorPosition] Response status:', response.status);

    if (!response.ok) throw new Error(`HTTP ${response.status}`);

    const data = await response.json();
    console.log('[WikiEditorPosition] Data received:', data);
    
    WikiEditorPosition.pagesData = data.pages || [];
    console.log('[WikiEditorPosition] Pages count:', WikiEditorPosition.pagesData.length);
    
    // Сортируем по позиции
    WikiEditorPosition.pagesData.sort((a, b) => (a.position || 0) - (b.position || 0));
    
    // Рендерим превью
    console.log('[WikiEditorPosition] Calling renderPositionPreview...');
    await WikiEditorPosition.renderPositionPreview();
    console.log('[WikiEditorPosition] renderPositionPreview done');
    
    // Обновляем подсказку
    WikiEditorPosition.updatePositionHint();
    
    // Сбрасываем флаг загрузки
    WikiEditorPosition.isLoading = false;
    console.log('[WikiEditorPosition] Loading complete');
    
  } catch (error) {
    console.error('[WikiEditorPosition] Ошибка загрузки:', error);
    loadingEl.innerHTML = '<span style="color: #ef4444;">Ошибка загрузки списка</span>';
    WikiEditorPosition.isLoading = false;
  }
};

/**
 * Рендер превью списка с drag-and-drop
 */
WikiEditorPosition.renderPositionPreview = async function() {
  // Ищем элементы В КОНТЕКСТЕ текущего модального окна
  const containerId = WikiEditorPosition.currentContainerId || 'addWikiPageModal';
  const modal = document.getElementById(containerId);
  const loadingEl = modal?.querySelector('#positionPreviewLoading') || document.getElementById('positionPreviewLoading');
  const listEl = modal?.querySelector('#positionPreviewList') || document.getElementById('positionPreviewList');
  const positionInput = modal?.querySelector('#wikiPagePosition') || document.getElementById('wikiPagePosition');
  
  console.log('[renderPositionPreview] Rendering for:', containerId, { 
    loadingEl: !!loadingEl, 
    listEl: !!listEl,
    positionInput: !!positionInput
  });
  
  if (!listEl) return;
  
  loadingEl.style.display = 'none';
  listEl.style.display = 'block';
  
  const currentPageId = WikiEditorPosition.currentPageId;
  const currentTitle = WikiEditorPosition.currentTitle || 'Новая страница';
  const currentPosition = parseInt(positionInput?.value || '0', 10);
  
  // Проверяем режим: создание или редактирование
  const isEditMode = currentPageId && String(currentPageId) !== 'null' && String(currentPageId) !== '';
  console.log('[renderPositionPreview] Mode:', isEditMode ? 'edit' : 'create', 'currentPageId:', currentPageId);
  
  // Проверяем, есть ли текущая страница в списке
  const existingIndex = WikiEditorPosition.pagesData.findIndex(p => String(p.id) === String(currentPageId));
  
  // Если редактируем - обновляем заголовок в данных
  if (existingIndex !== -1 && isEditMode) {
    WikiEditorPosition.pagesData[existingIndex].title = currentTitle;
  }
  
  // Создаём HTML для списка
  let html = '';
  
  // Если это новая страница - добавляем её в список
  const isNewPage = !isEditMode;
  let pagesToShow = [...WikiEditorPosition.pagesData];
  
  if (isNewPage) {
    // Для новой страницы - вставляем в нужную позицию
    const insertIndex = Math.min(currentPosition, pagesToShow.length);
    pagesToShow.splice(insertIndex, 0, {
      id: 'new',
      title: currentTitle,
      position: currentPosition,
      isNew: true
    });
  }
  
  // Рендерим элементы с Tailwind классами
  console.log('[renderPositionPreview] pagesToShow:', pagesToShow.map(p => ({ id: p.id, title: p.title, isNew: p.isNew })));
  
  pagesToShow.forEach((page, index) => {
    const isCurrentPage = String(page.id) === String(currentPageId) || page.isNew;
    const label = page.isNew ? ' <span class="text-xs opacity-70">(новая)</span>' : '';
    
    console.log('[renderPositionPreview] Page:', page.id, page.title, 'isCurrentPage:', isCurrentPage, 'isNew:', page.isNew, 'currentPageId:', currentPageId);
    
    if (isCurrentPage) {
      // Текущая страница - оранжевая (без !important в inline)
      html += `
        <div 
          data-id="${page.id}" 
          data-position="${index}"
          class="flex items-center gap-3 px-3 py-2.5 rounded-lg cursor-move transition-all wiki-position-current">
          <div class="font-bold shrink-0 min-w-[28px] text-center" style="color: #000;">
            #${index + 1} ★
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-medium truncate" style="color: #000;">
              ${WikiEditorPosition.escapeHtml(page.title)}${label}
            </div>
          </div>
          <div class="shrink-0" style="color: rgba(0,0,0,0.6);">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M7 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 2zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 14zm6-8a2 2 0 1 0-.001-4.001A2 2 0 0 0 13 6zm0 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 14z"/>
            </svg>
          </div>
        </div>
      `;
    } else {
      // Другие страницы - серые (без !important в inline)
      html += `
        <div 
          data-id="${page.id}" 
          data-position="${index}"
          class="flex items-center gap-3 px-3 py-2.5 rounded-lg cursor-move transition-all wiki-position-item">
          <div class="font-bold shrink-0 min-w-[28px] text-center" style="color: #fff;">
            #${index + 1}
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-medium truncate" style="color: #fff;">
              ${WikiEditorPosition.escapeHtml(page.title)}
            </div>
          </div>
          <div class="shrink-0" style="color: #6b7280;">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M7 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 2zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 14zm6-8a2 2 0 1 0-.001-4.001A2 2 0 0 0 13 6zm0 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 14z"/>
            </svg>
          </div>
        </div>
      `;
    }
  });
  
  listEl.innerHTML = html;
  
  // Применяем стили ПОСЛЕ рендеринга (переопределение DaisyUI)
  requestAnimationFrame(() => {
    WikiEditorPosition.applyStyles(listEl);
  });
  
  // Инициализируем Sortable (async)
  await WikiEditorPosition.initSortable(listEl);
};

/**
 * Принудительное применение стилей (переопределение DaisyUI)
 * Использует setInterval для постоянного применения стилей
 */
WikiEditorPosition.applyStyles = function(listEl) {
  // Функция применения стилей к элементу
  const applyToItem = (item, isCurrent) => {
    if (isCurrent) {
      item.style.setProperty('background-color', '#f59e0b', 'important');
      item.style.setProperty('border', '2px solid #fbbf24', 'important');
    } else {
      item.style.setProperty('background-color', '#1f2937', 'important');
      item.style.setProperty('border', '2px solid #374151', 'important');
    }
  };
  
  // Функция применения стилей ко всем элементам
  const applyAll = () => {
    listEl.querySelectorAll('.wiki-position-item').forEach(item => applyToItem(item, false));
    listEl.querySelectorAll('.wiki-position-current').forEach(item => applyToItem(item, true));
  };
  
  // Применяем стили сразу
  applyAll();
  
  // Останавливаем предыдущий интервал если есть
  if (WikiEditorPosition.styleInterval) {
    clearInterval(WikiEditorPosition.styleInterval);
  }
  
  // Применяем стили каждые 100мс постоянно (пока модал открыт)
  WikiEditorPosition.styleInterval = setInterval(applyAll, 100);
  
  console.log('[WikiEditorPosition] Styles applied with permanent setInterval');
};

/**
 * Инициализация SortableJS
 */
WikiEditorPosition.initSortable = async function(element) {
  console.log('[initSortable] Starting initialization...');
  console.log('[initSortable] Element:', element, 'Children:', element?.children?.length);
  
  // Загружаем SortableJS если нужно
  if (!window.Sortable) {
    console.log('[initSortable] Loading SortableJS from CDN...');
    try {
      await new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js';
        script.onload = () => {
          console.log('[initSortable] SortableJS loaded successfully');
          resolve();
        };
        script.onerror = (e) => {
          console.error('[initSortable] Failed to load SortableJS:', e);
          reject(e);
        };
        document.head.appendChild(script);
      });
    } catch (e) {
      console.error('[WikiEditorPosition] Ошибка загрузки SortableJS:', e);
      return;
    }
  } else {
    console.log('[initSortable] SortableJS already loaded');
  }
  
  // Уничтожаем предыдущий экземпляр
  if (WikiEditorPosition.sortableInstance) {
    console.log('[initSortable] Destroying previous instance');
    WikiEditorPosition.sortableInstance.destroy();
  }
  
  console.log('[initSortable] Creating new Sortable instance...');
  
  // Создаём новый экземпляр
  WikiEditorPosition.sortableInstance = new Sortable(element, {
    animation: 150,
    ghostClass: 'sortable-ghost',
    chosenClass: 'sortable-chosen',
    dragClass: 'sortable-drag',
    filter: 'input, textarea, button, select',  // Исключаем интерактивные элементы
    preventOnFilter: false,  // Не предотвращаем события на них
    forceFallback: true,     // Используем fallback для совместимости с modal
    fallbackTolerance: 3,    // Терпимость к движению
    onStart: function(evt) {
      console.log('[SortableJS] Drag started:', evt.item);
    },
    onMove: function(evt) {
      console.log('[SortableJS] Moving:', evt.related);
      return true;
    },
    onEnd: function(evt) {
      console.log('[SortableJS] Drag ended. Old index:', evt.oldIndex, 'New index:', evt.newIndex);
      
      // Ищем элементы В КОНТЕКСТЕ текущего модального окна
      const containerId = WikiEditorPosition.currentContainerId || 'addWikiPageModal';
      const modal = document.getElementById(containerId);
      const positionInput = modal?.querySelector('#wikiPagePosition') || document.getElementById('wikiPagePosition');
      
      // Обновляем порядок в pagesData
      const oldIndex = evt.oldIndex;
      const newIndex = evt.newIndex;
      
      if (oldIndex !== undefined && newIndex !== undefined && oldIndex !== newIndex) {
        // Перемещаем элемент в массиве
        const movedItem = WikiEditorPosition.pagesData.splice(oldIndex, 1)[0];
        WikiEditorPosition.pagesData.splice(newIndex, 0, movedItem);
        
        // Обновляем позицию текущей страницы
        if (positionInput) {
          positionInput.value = newIndex;
        }
        
        console.log('[SortableJS] Updated pagesData order');
      }
      
      // Перерендериваем для обновления номеров
      WikiEditorPosition.renderPositionPreview();
      
      // Применяем стили после перерендеринга
      requestAnimationFrame(() => {
        WikiEditorPosition.applyStyles(element);
      });
      
      // Обновляем статус
      const statusEl = modal?.querySelector('#positionStatus') || document.getElementById('positionStatus');
      if (statusEl) {
        statusEl.innerHTML = `<span style="color: #10b981;">✓ Позиция: ${newIndex + 1}</span>`;
      }
    }
  });
};

/**
 * Экранирование HTML
 */
WikiEditorPosition.escapeHtml = function(str) {
  if (!str) return '';
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
};

/**
 * Обновить подсказку
 */
WikiEditorPosition.updatePositionHint = function() {
  const containerId = WikiEditorPosition.currentContainerId || 'addWikiPageModal';
  const modal = document.getElementById(containerId);
  const hintEl = modal?.querySelector('#positionHint') || document.getElementById('positionHint');
  if (!hintEl) return;
  
  const count = WikiEditorPosition.pagesData.length;
  if (count === 0) {
    hintEl.textContent = '(первая страница)';
  } else {
    hintEl.textContent = `(всего ${count} страниц)`;
  }
};

/**
 * Сброс состояния
 */
WikiEditorPosition.reset = function() {
  WikiEditorPosition.pagesData = [];
  WikiEditorPosition.currentPageId = null;
  WikiEditorPosition.currentTitle = '';
  WikiEditorPosition.isLoading = false;
  
  // Останавливаем интервал применения стилей
  if (WikiEditorPosition.styleInterval) {
    clearInterval(WikiEditorPosition.styleInterval);
    WikiEditorPosition.styleInterval = null;
  }
  
  if (WikiEditorPosition.sortableInstance) {
    WikiEditorPosition.sortableInstance.destroy();
    WikiEditorPosition.sortableInstance = null;
  }
  
  const loadingEl = document.getElementById('positionPreviewLoading');
  const listEl = document.getElementById('positionPreviewList');
  
  if (loadingEl) {
    loadingEl.style.display = 'block';
    loadingEl.innerHTML = `
      <svg class="animate-spin h-6 w-6 mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="text-sm">Загрузка списка страниц...</span>
    `;
  }
  if (listEl) {
    listEl.style.display = 'none';
    listEl.innerHTML = '';
  }
};

/**
 * Обновить заголовок в превью
 */
WikiEditorPosition.updateTitle = function(title) {
  WikiEditorPosition.currentTitle = title;
  if (WikiEditorPosition.pagesData.length > 0) {
    WikiEditorPosition.renderPositionPreview();
  }
};

// Открытие модального окна добавления категории
WikiEditorCategory.openAddCategoryModal = function() {
  if (typeof openAddCategoryModal === 'function') {
    openAddCategoryModal();
  }
};

/**
 * Загрузка категорий для конкретного модального окна
 */
WikiEditorCategory.loadCategories = async function(containerId) {
  if (!containerId) containerId = 'addWikiPageModal';
  
  const modal = document.getElementById(containerId);
  if (!modal) return;
  
  const select = modal.querySelector('#wikiPageCategory');
  if (!select) return;

  select.innerHTML = '<option value="" disabled selected>Загрузка...</option>';

  const config = typeof getWikiAuthConfig === 'function' 
    ? getWikiAuthConfig(containerId)
    : { serviceUrl: '', apiKey: '', userId: '' };

  if (!config.serviceUrl || !config.apiKey || !config.userId) {
    select.innerHTML = '<option value="" selected>Ошибка конфигурации</option>';
    return;
  }

  const url = `${config.serviceUrl.replace(/\/$/, '')}/api/v1/wiki/categories`;

  try {
    const response = await fetch(url, {
      method: 'GET',
      headers: {
        'X-User-ID': config.userId,
        'Authorization': `Bearer ${config.apiKey}`
      }
    });

    if (!response.ok) throw new Error(`HTTP ${response.status}`);

    const data = await response.json();
    window.categoriesData = Array.isArray(data) ? data : (data.categories || []);
    const flatCats = WikiEditorCategory.flattenCategories(window.categoriesData);

    select.innerHTML = '<option value="">Без категории</option>';
    flatCats.forEach(cat => {
      const option = document.createElement('option');
      option.value = cat.id;
      option.textContent = cat.name;
      select.appendChild(option);
    });

    // Обработчик изменения категории
    select.addEventListener('change', function() {
      WikiEditorCategory.updateCategoryPath(this.value);
      // Перезагружаем превью позиций
      WikiEditorPosition.loadPagesPreview(containerId);
    });

    // Загружаем начальные позиции
    await WikiEditorPosition.loadPagesPreview(containerId);

    // Слушаем изменения заголовка
    const titleInput = modal.querySelector('#wikiPageTitle');
    if (titleInput) {
      titleInput.addEventListener('input', function() {
        WikiEditorPosition.updateTitle(this.value);
      });
    }

  } catch (error) {
    console.error('[WikiEditorCategory] Ошибка:', error);
    select.innerHTML = '<option value="" selected>Ошибка загрузки</option>';
  }
};

// Обновление пути категории
WikiEditorCategory.updateCategoryPath = function(categoryId) {
  const pathElement = document.getElementById('categoryPath');
  if (!pathElement) return;
  
  if (!categoryId) {
    pathElement.textContent = '';
    return;
  }

  const path = WikiEditorCategory.getCategoryPath(window.categoriesData || [], categoryId);
  pathElement.textContent = path;
};

// Получение пути категории
WikiEditorCategory.getCategoryPath = function(categories, categoryId, path = '') {
  for (const cat of categories) {
    if (cat.id == categoryId) {
      return path ? `${path} → ${cat.name}` : cat.name;
    }
    if (cat.children?.length > 0) {
      const childPath = WikiEditorCategory.getCategoryPath(cat.children, categoryId, path ? `${path} → ${cat.name}` : cat.name);
      if (childPath) return childPath;
    }
  }
  return '';
};

// Распаковка категорий
WikiEditorCategory.flattenCategories = function(cats, level = 0) {
  let res = [];
  cats.forEach(c => {
    const name = "—".repeat(level) + " " + (c.name || '');
    res.push({ ...c, name });
    if (c.children?.length > 0) {
      res = res.concat(WikiEditorCategory.flattenCategories(c.children, level + 1));
    }
  });
  return res;
};
</script>

