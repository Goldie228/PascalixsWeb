<%= render 'shared/payment_modal' %>

<div class="w-full mx-auto pb-8" data-user-id="<%= current_user.id %>" data-time-zone="<%= session[:time_zone] || 'UTC' %>">
    <div class="mb-8 px-4">
      <div class="flex flex-col">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-center mb-4">
          Управление Wiki страницами
        </h1>
        <div class="flex justify-center md:justify-end">
          <button
            class="btn bg-amber-400 text-black hover:bg-amber-300 border-none transition flex items-center"
            onclick="openAddWikiPageModal()"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd"
                d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
                clip-rule="evenodd" />
            </svg>
            Добавить страницу
          </button>
        </div>
      </div>
    </div>

    <!-- Панель управления -->
    <div class="flex flex-col gap-6 mb-6 md:mb-8 px-4">
        <!-- Первая строка элементов управления -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="form-control w-full md:w-auto">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-amber-400 font-semibold text-sm md:text-base">На странице</span>
                    
                    <div class="dropdown dropdown-end">
                        <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                            <span class="text-xs md:text-sm" id="perPageLabel">25</span>
                            <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </label>
                        <ul class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-32 mt-1">
                            <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="25">25</a></li>
                            <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="50">50</a></li>
                            <li><a href="#" class="per-page-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="75">75</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Вторая строка элементов управления -->
        <div class="grid grid-cols-1 md:flex md:flex-row gap-4 md:gap-6 justify-between">
            <div class="flex flex-col md:flex-row gap-4 md:gap-6 w-full md:w-auto">
                <div class="form-control w-full md:w-auto">
                    <div class="flex items-center gap-2">
                        <span class="text-amber-400 font-semibold text-sm md:text-base">Направление</span>
                        
                        <div class="dropdown dropdown-end">
                            <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                                <span class="text-xs md:text-sm" id="sortOrderLabel">По убыванию</span>
                                <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </label>
                            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-44 md:w-52 mt-1">
                                <li><a href="#" class="sort-order-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="asc">По возрастанию</a></li>
                                <li><a href="#" class="sort-order-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="desc">По убыванию</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <div class="form-control w-full md:w-auto">
                    <div class="flex items-center gap-2">
                        <span class="text-amber-400 font-semibold text-sm md:text-base">Сортировать по</span>
                        <div class="dropdown dropdown-end">
                            <label tabindex="0" class="btn btn-sm md:btn-md bg-[#121212] border-2 border-amber-400 text-white hover:bg-[#1a1a1a] flex items-center gap-1 md:gap-2">
                                <span class="text-xs md:text-sm truncate max-w-[100px] md:max-w-none" id="sortByLabel">Дате создания</span>
                                <svg class="w-3 h-3 md:w-4 md:h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </label>
                            <ul class="dropdown-content z-[1] menu p-2 shadow bg-[#2D2D2D] rounded-box w-44 md:w-52 mt-1">
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="title">Заголовку</a></li>
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="position">Позиции</a></li>
                                <li><a href="#" class="sort-by-option text-white hover:bg-amber-400 hover:text-black text-sm md:text-base" data-value="created_at">Дате создания</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="w-full md:w-auto">
                <input type="text" id="searchInput" placeholder="Поиск по названию или slug..." class="input input-sm md:input-md w-full bg-[#2D2D2D] text-white placeholder-[#A0A0A0] border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition">
            </div>
        </div>
        
        <!-- Фильтры -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
            <div>
                <label class="block text-sm font-medium text-amber-400 mb-1">Статус</label>
                <select id="publishedFilter" class="select select-sm md:select-md w-full bg-[#2D2D2D] text-white border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400">
                    <option value="">Все</option>
                    <option value="true">Опубликовано</option>
                    <option value="false">Черновик</option>
                </select>
            </div>
        </div>
    </div>
    
    <!-- Таблица с данными (для десктопа) -->
    <div class="hidden md:block w-full overflow-x-auto rounded-box overflow-hidden">
        <table class="table w-full">
            <thead class="text-white" style="background-color: #2D2D2D">
                <tr>
                    <th class="py-3 px-2 md:px-4">Заголовок</th>
                    <th class="py-3 px-2 md:px-4">Категория</th>
                    <th class="py-3 px-2 md:px-4">Опубликовано</th>
                    <th class="py-3 px-2 md:px-4">Позиция</th>
                    <th class="py-3 px-2 md:px-4">Дата создания</th>
                    <th class="py-3 px-2 md:px-4">Действия</th>
                </tr>
            </thead>
            <tbody class="text-white" style="background-color: #383838">
                <!-- Данные будут загружены через JavaScript -->
            </tbody>
        </table>
    </div>
    
    <!-- Карточки для мобильных устройств -->
    <div id="cardsContainer" class="md:hidden grid grid-cols-1 gap-4 mt-4 px-4">
        <!-- Карточки будут загружены через JavaScript -->
    </div>
    
    <!-- Пагинация -->
    <div id="paginationContainer" class="flex justify-center items-center gap-2 mt-6 flex-wrap px-4 overflow-x-auto">
        <!-- Пагинация будет загружена через JavaScript -->
    </div>
</div>

<!-- Модальное окно для редактирования страницы -->
<dialog id="editWikiPageModal" class="modal">
  <div class="modal-box w-full max-w-2xl bg-[#1A1A1A] border border-amber-400 p-8 rounded">
    <h3 class="text-2xl text-amber-400 font-bold mb-4">Редактировать Wiki страницу</h3>
    <p class="text-white mb-4">Вы редактируете страницу с ID: <span id="editWikiPageId" class="font-bold"></span></p>
    <!-- Здесь будет форма редактирования, реализованная отдельно -->
    <div class="modal-action">
      <button class="btn text-sm px-4 py-2 text-gray-300 bg-[#2D2D2D] hover:bg-[#3A3A3A] transition" onclick="closeEditWikiPageModal()">
        Закрыть
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<!-- Модальное окно для подтверждения удаления -->
<dialog id="deleteConfirmModal" class="modal">
  <div class="modal-box w-full max-w-2xl bg-[#1A1A1A] border border-red-500 p-8 rounded">
    <h3 class="text-2xl text-red-500 font-bold mb-4">Удаление Wiki страницы</h3>
    <p class="text-white mb-6">Вы уверены, что хотите удалить страницу "<span id="deleteWikiPageTitle" class="font-bold"></span>"? Это действие нельзя отменить.</p>
    <div class="modal-action flex justify-end gap-3">
      <button class="btn text-sm px-4 py-2 text-gray-300 bg-[#2D2D2D] hover:bg-[#3A3A3A] transition" onclick="closeDeleteConfirmModal()">
        Отмена
      </button>
      <button class="btn text-sm px-4 py-2 text-white bg-red-500 hover:bg-red-600 transition" onclick="confirmDeleteWikiPage()">
        Удалить
      </button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button></button></form>
</dialog>

<script>
    // Глобальные переменные для хранения параметров
    let currentPage = 1;
    let perPage = 25;
    let sortBy = 'created_at';
    let sortOrder = 'desc';
    let filters = {
        published: '',
        search: ''
    };
    let isLoading = false;
    let wikiPageToDelete = null;

    const timeZone = document.querySelector('[data-time-zone]')?.getAttribute('data-time-zone') || 'UTC';
    
    // Инициализация обработчиков событий
    document.addEventListener('DOMContentLoaded', function() {
        // Загрузка данных при загрузке страницы
        loadWikiPages();
        
        // Обработчики для выпадающих списков
        document.querySelectorAll('.per-page-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                perPage = parseInt(this.getAttribute('data-value')) || 25;
                const perPageLabel = document.getElementById('perPageLabel');
                if (perPageLabel) perPageLabel.textContent = perPage;
                currentPage = 1;
                loadWikiPages();
            });
        });
        
        document.querySelectorAll('.sort-order-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                sortOrder = this.getAttribute('data-value') || 'desc';
                const sortOrderLabel = document.getElementById('sortOrderLabel');
                if (sortOrderLabel) {
                    sortOrderLabel.textContent = 
                        sortOrder === 'asc' ? 'По возрастанию' : 'По убыванию';
                }
                loadWikiPages();
            });
        });
        
        document.querySelectorAll('.sort-by-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                sortBy = this.getAttribute('data-value') || 'created_at';
                const sortByLabel = document.getElementById('sortByLabel');
                if (sortByLabel) sortByLabel.textContent = this.textContent;
                loadWikiPages();
            });
        });
        
        // Обработчик для поиска
        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                filters.search = this.value || '';
                clearTimeout(this.searchTimeout);
                this.searchTimeout = setTimeout(() => {
                    currentPage = 1;
                    loadWikiPages();
                }, 500);
            });
        }
        
        // Обработчик для фильтра по статусу публикации
        const publishedFilter = document.getElementById('publishedFilter');
        if (publishedFilter) {
            publishedFilter.addEventListener('change', function() {
                filters.published = this.value || '';
                currentPage = 1;
                loadWikiPages();
            });
        }
    });
    
    // Функции для управления индикатором загрузки
    function showGlobalLoading() {
        if (!document.getElementById('global-loading')) {
            const loadingDiv = document.createElement('div');
            loadingDiv.id = 'global-loading';
            loadingDiv.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
            loadingDiv.innerHTML = `
                <div class="flex flex-col items-center">
                    <div class="w-16 h-16 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
                    <span class="mt-4 text-amber-400 text-lg">Загрузка...</span>
                </div>
            `;
            document.body.appendChild(loadingDiv);
        }
    }
    
    function hideGlobalLoading() {
        const loadingDiv = document.getElementById('global-loading');
        if (loadingDiv) {
            loadingDiv.remove();
        }
    }
    
    // Функция для отображения индикатора загрузки в tbody
    function showLoading() {
        isLoading = true;
        
        const tableBody = document.querySelector('tbody');
        if (tableBody) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center py-10">
                        <div class="flex flex-col items-center justify-center">
                            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-400 mx-auto"></div>
                            <span class="mt-4 text-white font-medium">Загрузка...</span>
                        </div>
                    </td>
                </tr>
            `;
        }
        
        const cardsContainer = document.getElementById('cardsContainer');
        if (cardsContainer) {
            cardsContainer.innerHTML = `
                <div class="flex flex-col items-center justify-center py-10 w-full">
                    <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-400 mx-auto"></div>
                    <span class="mt-4 text-white font-medium">Загрузка...</span>
                </div>
            `;
        }
    }
    
    let isAdminView = true; // переключатель, например, по роли пользователя

    async function loadWikiPages() {
      if (isLoading) return;

      try {
        showLoading();

        const params = new URLSearchParams();
        params.append('page', currentPage);
        params.append('per_page', perPage);
        params.append('sort', sortBy);
        params.append('order', sortOrder);

        if (filters.search) params.append('search', filters.search);
        if (filters.published) params.append('published', filters.published);

        // Выбираем URL в зависимости от режима
        const baseUrl = isAdminView
          ? `${authServiceUrl}/api/v1/wiki/pages/admin_index`
          : `${authServiceUrl}/api/v1/wiki/pages`;

        const url = `${baseUrl}?${params.toString()}`;

        const response = await fetch(url, {
          method: 'GET',
          credentials: 'include',
          headers: {
            'X-User-ID': actorId,
            'Authorization': `Bearer ${interServiceApiKey}`
          }
        });

        if (!response.ok) {
          throw new Error(`Ошибка HTTP: ${response.status}`);
        }

        const data = await response.json();

        const pages = Array.isArray(data) ? data : (data.pages || []);
        const totalCount = data.total_count || (Array.isArray(data) ? data.length : 0);

        updateWikiPagesTable(pages);
        updatePagination(totalCount);

      } catch (error) {
        showAlertNotification('Ошибка загрузки Wiki страниц');
        console.error(error);
            
            const tableBody = document.querySelector('tbody');
            if (tableBody) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center py-6 text-red-400">
                            Ошибка загрузки данных
                        </td>
                    </tr>
                `;
            }
            
            const cardsContainer = document.getElementById('cardsContainer');
            if (cardsContainer) {
                cardsContainer.innerHTML = `
                    <div class="bg-[#383838] rounded-lg p-4 shadow-md text-red-400 text-center">
                        Ошибка загрузки данных
                    </div>
                `;
            }
        } finally {
            isLoading = false;
        }
    }
    
    // Функция для обновления таблицы и карточек
    function updateWikiPagesTable(pages) {
        const tableBody = document.querySelector('tbody');
        
        if (!pages || pages.length === 0) {
            if (tableBody) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center py-6 text-gray-400">
                            Страницы не найдены
                        </td>
                    </tr>
                `;
            }
            
            const cardsContainer = document.getElementById('cardsContainer');
            if (cardsContainer) {
                cardsContainer.innerHTML = `
                    <div class="bg-[#383838] rounded-lg p-4 shadow-md text-center text-gray-400">
                        Страницы не найдены
                    </div>
                `;
            }
            return;
        }
        
        if (tableBody) {
            tableBody.innerHTML = pages.map(page => {
                const pageId = page.id || 'unknown';
                const title = page.title || "Без названия";
                const slug = page.slug || "";
                const category = page.wiki_category ? page.wiki_category.name : "Без категории";
                const published = page.published || false;
                const position = page.position || 0;
                
                let createdDate = page.created_at_formatted;
                if (!createdDate && page.created_at) {
                    createdDate = formatDateWithTimeZone(page.created_at, timeZone);
                } else if (!createdDate) {
                    createdDate = "Не указано";
                }
                
                const publishedStatus = published ? 
                    `<span class="px-2 py-1 rounded-full bg-green-500 text-black text-xs">Опубликовано</span>` : 
                    `<span class="px-2 py-1 rounded-full bg-red-500 text-black text-xs">Черновик</span>`;
                
                return `
                    <tr data-page-id="${pageId}">
                        <td class="py-3 px-2 md:px-4">
                            <div class="font-bold">${escapeHtml(title)}</div>
                            <div class="text-xs text-gray-400">${escapeHtml(slug)}</div>
                        </td>
                        <td class="py-3 px-2 md:px-4">${escapeHtml(category)}</td>
                        <td class="py-3 px-2 md:px-4">${publishedStatus}</td>
                        <td class="py-3 px-2 md:px-4">${position}</td>
                        <td class="py-3 px-2 md:px-4">${escapeHtml(createdDate)}</td>
                        <td class="py-3 px-2 md:px-4">
                            <div class="flex gap-2">
                                <button class="btn btn-xs md:btn-sm bg-amber-400 text-black hover:bg-amber-300 border-none transition edit-btn" data-id="${pageId}">
                                    Редактировать
                                </button>
                                <button class="btn btn-xs md:btn-sm bg-red-500 text-white hover:bg-red-600 border-none transition delete-btn" data-id="${pageId}" data-title="${escapeHtml(title)}">
                                    Удалить
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }
        
        const cardsContainer = document.getElementById('cardsContainer');
        if (cardsContainer) {
            cardsContainer.innerHTML = pages.map(page => {
                const pageId = page.id || 'unknown';
                const title = page.title || "Без названия";
                const slug = page.slug || "";
                const category = page.wiki_category ? page.wiki_category.name : "Без категории";
                const published = page.published || false;
                const position = page.position || 0;
                
                let createdDate = page.created_at_formatted;
                if (!createdDate && page.created_at) {
                    createdDate = formatDateWithTimeZone(page.created_at, timeZone);
                } else if (!createdDate) {
                    createdDate = "Не указано";
                }
                
                const publishedStatus = published ? 
                    `<span class="px-2 py-1 rounded-full bg-green-500 text-black text-xs">Опубликовано</span>` : 
                    `<span class="px-2 py-1 rounded-full bg-red-500 text-black text-xs">Черновик</span>`;
                
                return `
                    <div class="bg-[#383838] rounded-lg p-4 shadow-md">
                        <div class="mb-4">
                            <h3 class="text-lg font-semibold text-white break-words">${escapeHtml(title)}</h3>
                            <p class="text-gray-400 text-sm">/${escapeHtml(slug)}</p>
                        </div>
                        <div class="grid grid-cols-2 gap-4 mb-4">
                            <div>
                                <p class="text-gray-400 text-sm">Статус</p>
                                <p>${publishedStatus}</p>
                            </div>
                            <div>
                                <p class="text-gray-400 text-sm">Позиция</p>
                                <p class="text-white">${position}</p>
                            </div>
                        </div>
                        <div class="text-sm mb-4">
                            <p class="text-gray-400">Категория</p>
                            <p class="text-white">${escapeHtml(category)}</p>
                        </div>
                        <div class="text-sm mb-4">
                            <p class="text-gray-400">Дата создания</p>
                            <p class="text-white">${escapeHtml(createdDate)}</p>
                        </div>
                        <div class="mt-4 flex justify-end gap-2">
                            <button class="btn btn-xs bg-amber-400 text-black hover:bg-amber-300 border-none transition edit-btn" data-id="${pageId}">
                                Редактировать
                            </button>
                            <button class="btn btn-xs bg-red-500 text-white hover:bg-red-600 border-none transition delete-btn" data-id="${pageId}" data-title="${escapeHtml(title)}">
                                Удалить
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }
        
        addWikiActionListeners();
    }
    
    function addWikiActionListeners() {
        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const pageId = this.getAttribute('data-id');
                if (pageId) {
                    openEditWikiPageModal(pageId);
                }
            });
        });
        
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const pageId = this.getAttribute('data-id');
                const pageTitle = this.getAttribute('data-title') || "Без названия";
                if (pageId) {
                    openDeleteConfirmModal(pageId, pageTitle);
                }
            });
        });
    }

    // Stub for Edit Page
    function openEditWikiPageModal(pageId) {
        if (!pageId) return;
        
        const editPageIdElement = document.getElementById('editWikiPageId');
        if (editPageIdElement) {
            editPageIdElement.textContent = pageId;
        }
        
        const modal = document.getElementById('editWikiPageModal');
        if (modal) modal.showModal();
    }

    function closeEditWikiPageModal() {
        const modal = document.getElementById('editWikiPageModal');
        if (modal) modal.close();
    }
    
    function openDeleteConfirmModal(pageId, pageTitle) {
        if (!pageId) return;
        
        wikiPageToDelete = pageId;
        const deletePageTitleElement = document.getElementById('deleteWikiPageTitle');
        if (deletePageTitleElement) {
            deletePageTitleElement.textContent = pageTitle;
        }
        
        const modal = document.getElementById('deleteConfirmModal');
        if (modal) modal.showModal();
    }
    
    function closeDeleteConfirmModal() {
        wikiPageToDelete = null;
        const modal = document.getElementById('deleteConfirmModal');
        if (modal) modal.close();
    }
    
    async function confirmDeleteWikiPage() {
        if (!wikiPageToDelete) return;
        
        try {
            showGlobalLoading();
            
            const authServiceUrl = "<%= ENV['AUTH_SERVICE_URL'] %>";
            const url = `${authServiceUrl}/api/v1/wiki/pages/${wikiPageToDelete}`;
            
            // Отправляем DELETE-запрос
            const response = await fetch(url, {
                method: 'DELETE',
                credentials: 'include',
                headers: {
                    'X-User-ID': actorId,
                    'Authorization': `Bearer ${interServiceApiKey}`
                }
            });
            
            if (!response.ok) {
                throw new Error(`Ошибка HTTP: ${response.status}`);
            }
            
            closeDeleteConfirmModal();
            showNotification('Страница успешно удалена');
            loadWikiPages();
            
        } catch (error) {
            showAlertNotification('Ошибка при удалении страницы');
            console.error('Error deleting page:', error);
        } finally {
            hideGlobalLoading();
        }
    }
    
    function formatDateWithTimeZone(dateString, timeZone) {
        if (!dateString) return "Не указано";
        const date = new Date(dateString);
        
        if (isNaN(date.getTime())) {
            return "Неверная дата";
        }
        
        let ianaTimeZone = timeZone;
        if (timeZone === 'Moscow') ianaTimeZone = 'Europe/Moscow';
        else if (timeZone === 'UTC') ianaTimeZone = 'UTC';
        
        try {
            const options = {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                timeZone: ianaTimeZone
            };
            return new Intl.DateTimeFormat('ru-RU', options).format(date);
        } catch (error) {
            console.error('Ошибка форматирования даты:', error);
            const options = { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'UTC' };
            return new Intl.DateTimeFormat('ru-RU', options).format(date);
        }
    }
    
    function updatePagination(totalCount) {
        const container = document.getElementById('paginationContainer');
        if (!container) return;
        
        const totalPages = Math.ceil(totalCount / perPage);
        
        if (totalPages <= 1) {
            container.innerHTML = '';
            return;
        }
        
        let paginationHTML = '';
        let pageRange = [];
        
        if (totalPages <= 7) {
            pageRange = Array.from({length: totalPages}, (_, i) => i + 1);
        } else {
            if (currentPage <= 4) {
                pageRange = [1, 2, 3, 4, 5, '...', totalPages];
            } else if (currentPage >= totalPages - 3) {
                pageRange = [1, '...', totalPages - 4, totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
            } else {
                pageRange = [1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages];
            }
        }
        
        if (currentPage > 1) {
            paginationHTML += `
                <button class="btn border-amber-400 bg-[#121212] text-white hover:bg-[#1a1a1a] transition btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${currentPage - 1}">
                    Назад
                </button>
            `;
        }
        
        pageRange.forEach(page => {
            if (page === '...') {
                paginationHTML += `<span class="text-white px-2 whitespace-nowrap">...</span>`;
            } else {
                const isActive = page === currentPage;
                paginationHTML += `
                    <button class="btn border-amber-400 transition ${isActive ? 'bg-amber-400 text-black font-semibold shadow-md' : 'bg-[#121212] text-white hover:bg-[#1a1a1a]'} btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${page}">
                        ${page}
                    </button>
                `;
            }
        });
        
        if (currentPage < totalPages) {
            paginationHTML += `
                <button class="btn border-amber-400 bg-[#121212] text-white hover:bg-[#1a1a1a] transition btn-xs md:btn-sm whitespace-nowrap page-btn" data-page="${currentPage + 1}">
                    Вперед
                </button>
            `;
        }
        
        container.innerHTML = paginationHTML;
        
        document.querySelectorAll('.page-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const page = parseInt(this.getAttribute('data-page'));
                if (!isNaN(page)) {
                    currentPage = page;
                    loadWikiPages();
                }
            });
        });
    }
    
    function escapeHtml(unsafe) {
        if (unsafe === null || unsafe === undefined) return '';
        return unsafe.toString()
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }
</script>
