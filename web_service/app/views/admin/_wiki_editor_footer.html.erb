<!-- _wiki_editor_footer.html.erb -->
<!-- Компонент для статуса публикации и скрытых полей -->
<div class="flex items-center gap-3 pt-4 border-t border-gray-700 shrink-0">
  <div class="form-control">
    <label class="label cursor-pointer justify-start gap-3 p-0">
      <input type="checkbox" id="wikiPagePublished" name="published" class="checkbox checkbox-warning bg-gray-700 border-gray-600 checked:bg-amber-400 checked:border-amber-400 rounded" <%= 'checked' if local_assigns[:published] %> />
      <span class="label-text text-white">Опубликовать сразу</span>
    </label>
  </div>
</div>

<script>
// Пространство имен для функций футера
window.WikiEditorFooter = window.WikiEditorFooter || {};

// Инициализация компонента при загрузке
document.addEventListener('DOMContentLoaded', function() {
  // Здесь можно добавить дополнительную логику для футера, если потребуется
});
</script>

<style>
/* Стили для футера */
.form-control {
  display: flex;
  align-items: center;
}

.checkbox {
  appearance: none;
  width: 20px;
  height: 20px;
  border: 2px solid #4b5563;
  border-radius: 4px;
  margin-right: 8px;
  position: relative;
  cursor: pointer;
  transition: all 0.2s ease;
}

.checkbox:checked {
  background-color: #fbbf24;
  border-color: #fbbf24;
}

.checkbox:checked::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #000;
  font-weight: bold;
}

.label {
  display: flex;
  align-items: center;
  cursor: pointer;
}

.label-text {
  color: #e5e7eb;
}
</style>
