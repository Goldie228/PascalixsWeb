<dialog id="new-restriction-modal" class="modal">
  <form method="dialog"
        class="modal-box bg-[#1A1A1A] text-white max-w-xl w-full p-6 relative rounded-lg shadow-lg space-y-6">
    <h3 class="text-xl font-semibold text-center pt-4">
      <%= I18n.t('admin.players.restrictions.new_title') %> <span id="new-restriction-nickname">Nickname</span>
    </h3>
    <div class="w-full h-px bg-[#2D2D2D]"></div>
    <div>
      <label for="punishment_type" class="block text-sm mb-1"><%= I18n.t('admin.players.restrictions.type') %></label>
      <select id="punishment_type"
              class="select select-bordered w-full bg-[#2D2D2D] text-white focus:outline-none">
        <option value="mute" selected><%= I18n.t('admin.players.restrictions.types.mute') %></option>
        <option value="ban"><%= I18n.t('admin.players.restrictions.types.ban') %></option>
      </select>
    </div>
    <div>
      <label for="punishment_reason" class="block text-sm mb-1"><%= I18n.t('admin.players.restrictions.reason') %></label>
      <select id="punishment_reason"
              class="select select-bordered w-full bg-[#2D2D2D] text-white focus:outline-none">
        <option value="" disabled selected>—</option>
      </select>
    </div>
    <div>
      <label class="block text-sm mb-1"><%= I18n.t('admin.players.restrictions.duration_type') %></label>
      <div class="flex gap-4 items-center">
        <label class="cursor-pointer flex items-center gap-2">
          <input type="radio" name="duration_type" value="temporary" class="radio radio-sm bg-[#2D2D2D] text-amber-400 checked:border-amber-400" checked />
          <span class="mt-0.5"><%= I18n.t('admin.players.restrictions.temporary') %></span>
        </label>
        <label class="cursor-pointer flex items-center gap-2">
          <input type="radio" name="duration_type" value="permanent" class="radio radio-sm bg-[#2D2D2D] text-amber-400 checked:border-amber-400" />
          <span class="mt-0.5"><%= I18n.t('admin.players.restrictions.permanent') %></span>
        </label>
      </div>
    </div>
    <div id="temporary-duration-fields">
      <label for="punishment_duration" class="block text-sm mb-1"><%= I18n.t('admin.players.restrictions.duration') %></label>
      <div class="flex gap-2">
        <input type="number"
               id="punishment_duration"
               class="input w-full bg-[#2D2D2D] text-white focus:outline-none"
               placeholder="60" />
        <select id="punishment_unit"
                class="select bg-[#2D2D2D] text-white focus:outline-none">
          <option value="minutes" selected><%= I18n.t('admin.players.restrictions.units.minutes') %></option>
          <option value="hours"><%= I18n.t('admin.players.restrictions.units.hours') %></option>
          <option value="days"><%= I18n.t('admin.players.restrictions.units.days') %></option>
        </select>
      </div>
    </div>
    <div class="flex justify-end gap-2 pt-2">
      <button type="button"
              class="btn bg-[#2D2D2D] text-white hover:text-amber-400 transition"
              onclick="document.getElementById('new-restriction-modal').close();">
        <%= I18n.t('common.cancel') %>
      </button>
      <button type="submit"
              class="btn bg-amber-400 text-black hover:bg-[#FFC400] transition">
        <%= I18n.t('common.add') %>
      </button>
    </div>
  </form>
</dialog>

<script>
  // Ждем полной загрузки DOM перед выполнением скрипта
  document.addEventListener('DOMContentLoaded', function() {
    const CSRF = document.querySelector('meta[name="csrf-token"]')?.content;
    
    // Глобальная функция для открытия модального окна
    window.openNewRestrictionModal = function(button) {
      const nickname = button.dataset.nickname;
      const nicknameElement = document.getElementById('new-restriction-nickname');
      
      if (nicknameElement) {
        nicknameElement.innerText = nickname;
      }
      // Подгружаем причины для текущего типа
      const typeSelect = document.getElementById("punishment_type");
      if (typeSelect) {
        loadPunishmentReasons(typeSelect.value);
      }
      // Сброс к временному наказанию при открытии
      const temporaryRadio = document.querySelector('input[name="duration_type"][value="temporary"]');
      const durationFields = document.getElementById('temporary-duration-fields');
      
      if (temporaryRadio && durationFields) {
        temporaryRadio.checked = true;
        durationFields.style.display = 'block';
      }
      const modal = document.getElementById('new-restriction-modal');
      if (modal) {
        modal.showModal();
      }
    };
    // При смене типа — перегружаем список причин
    const typeSelect = document.getElementById("punishment_type");
    if (typeSelect) {
      typeSelect.addEventListener("change", (e) => {
        loadPunishmentReasons(e.target.value);
      });
    }
    // Обработчик изменения типа наказания (временное/перманентное)
    const durationRadios = document.querySelectorAll('input[name="duration_type"]');
    if (durationRadios.length) {
      durationRadios.forEach(radio => {
        radio.addEventListener('change', (e) => {
          const isTemporary = e.target.value === 'temporary';
          const durationFields = document.getElementById('temporary-duration-fields');
          if (durationFields) {
            durationFields.style.display = isTemporary ? 'block' : 'none';
          }
        });
      });
    }
    async function loadPunishmentReasons(type) {
      const select = document.getElementById("punishment_reason");
      if (!select) return;
      
      // состояние загрузки
      select.innerHTML = '<option value="" disabled selected>—</option>';
      select.disabled = true;
      try {
        const authServiceUrl = "<%= ENV['AUTH_SERVICE_URL'] %>";
        const userId = "<%= current_user.id %>"
        const resp = await fetch(`${authServiceUrl}/api/v1/punishment_reasons?type=${encodeURIComponent(type)}`, {
          headers: { 
            "Accept": "application/json",
            "Content-Type": "application/json",
            "X-User-ID": "<%= current_user.id %>"
          },
          credentials: "include"
        });
        if (!resp.ok) throw new Error("Failed to load reasons");
        const data = await resp.json();
        // ожидаем data.reasons: [{ rule_number, description, price }]
        const reasons = (data.reasons || []).slice().sort((a, b) => a.rule_number - b.rule_number);
        select.innerHTML = '';
        select.insertAdjacentHTML('beforeend', '<option value="" disabled selected>—</option>');
        reasons.forEach(r => {
          const label = `№${r.rule_number} — ${r.description}`;
          const opt = new Option(label, String(r.rule_number));
          select.add(opt);
        });
      } catch (err) {
        console.error('Failed to load reasons:', err);
        select.innerHTML = '<option value="" disabled selected>—</option>';
        showAlertNotification("<%= I18n.t('common.errors.temporary') %>");
      } finally {
        select.disabled = false;
      }
    }
    const form = document.querySelector("#new-restriction-modal form");
    if (form) {
      form.addEventListener("submit", async function (e) {
        e.preventDefault();
        const nicknameElement = document.getElementById("new-restriction-nickname");
        const typeSelect = document.getElementById("punishment_type");
        const reasonSelect = document.getElementById("punishment_reason");
        const durationInput = document.getElementById("punishment_duration");
        const unitSelect = document.getElementById("punishment_unit");
        const durationType = document.querySelector('input[name="duration_type"]:checked');
        
        if (!nicknameElement || !typeSelect || !reasonSelect || !durationType) {
          showAlertNotification("<%= I18n.t('admin.players.errors.restriction_failed') %>");
          return;
        }
        const nickname = nicknameElement.innerText;
        const type = typeSelect.value;
        const ruleNumber = parseInt(reasonSelect.value, 10);
        
        let duration, unit;
        if (durationType.value === 'temporary') {
          if (!durationInput || !unitSelect) {
            showAlertNotification("<%= I18n.t('admin.players.errors.restriction_failed') %>");
            return;
          }
          duration = parseInt(durationInput.value, 10);
          unit = unitSelect.value;
        } else {
          // Перманентное наказание: 100 лет в минутах
          duration = 100 * 365 * 24 * 60; // 100 лет в минутах
          unit = 'minutes';
        }
        if (!ruleNumber) {
          showAlertNotification("<%= I18n.t('admin.players.errors.restriction_failed') %>");
          return;
        }
        const payload = { type, rule_number: ruleNumber, duration, unit };
        try {
          const response = await fetch(`/admin/players/${encodeURIComponent(nickname)}/punishments`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json",
              "X-CSRF-Token": CSRF
            },
            credentials: "same-origin",
            body: JSON.stringify(payload)
          });
          if (!response.ok) throw new Error("Create punishment failed");
          showNotification("<%= I18n.t('admin.players.notifications.restriction_added') %>");
          const modal = document.getElementById("new-restriction-modal");
          if (modal) {
            modal.close();
          }
        } catch (error) {
          console.error(error);
          showAlertNotification("<%= I18n.t('admin.players.errors.restriction_failed') %>");
        }
      });
    }
  });
</script>
