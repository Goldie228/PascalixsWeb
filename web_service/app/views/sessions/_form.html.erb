<div class="flex items-center justify-center min-h-screen bg-[#121212]">
  <div class="card bg-[#1A1A1A] shadow-xl rounded-lg w-[95%] max-w-[800px] mx-auto p-10 py-14">
		<%= link_to localized_root_path, class: "absolute text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-2 rounded-full transition ease-in-out duration-200", aria: { label: t('pages.minecraft_registration.buttons.back') } do %>
			<svg class="w-8 h-8 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
				<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12l4-4m-4 4 4 4"/>
			</svg>
		<% end %>

    <h2 class="text-3xl font-bold text-center text-amber-400 mb-8 mt-16"><%= t('sessions.heading') %></h2>

    <%= form_with model: @user, 
                  url: login_path, 
                  method: :post, 
                  data: { remote: true } do |form| %>
      
      <div class="space-y-10">
        <div class="form-control">
          <%= form.label :nickname, t('sessions.form.nickname_label'), class: "label-text text-xl text-gray-300 mb-4" %>
          <%= form.text_field :nickname, 
                            class: "input input-bordered w-full bg-[#2E2E2E] text-gray-300 px-5 py-6 text-lg",
                            placeholder: t('sessions.form.nickname_placeholder') %>
          <div class="error-message text-error text-sm mt-2 hidden"></div>
        </div>

        <div class="form-control">
          <%= form.label :password, t('sessions.form.password_label'), class: "label-text text-xl text-gray-300 mb-4" %>
          <div class="relative">
            <%= form.password_field :password,
                                  class: "input input-bordered w-full bg-[#2E2E2E] text-gray-300 px-5 py-6 text-lg pr-16",
                                  placeholder: t('sessions.form.password_placeholder'),
                                  id: "password" %>
            <button 
              type="button" 
              id="togglePassword" 
              class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-300 hover:text-gray-400 active:text-[#1A1A1A] focus:ring-2 focus:ring-gray-500 focus:outline-none p-2 rounded-full transition ease-in-out duration-200"
            >
              <svg 
                class="w-6 h-6" 
                aria-hidden="true" 
                xmlns="http://www.w3.org/2000/svg" 
                width="24" 
                height="24" 
                fill="none" 
                viewBox="0 0 24 24"
              >
                <path 
                  stroke="currentColor" 
                  stroke-linecap="round" 
                  stroke-linejoin="round" 
                  stroke-width="2" 
                  d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                />
              </svg>
            </button>
          </div>
          <div class="error-message text-error text-sm mt-2 hidden"></div>
        </div>
      </div>

      <%= form.submit t('sessions.login_button'), 
                     class: "btn btn-warning text-[#1A1A1A] w-full py-3 mt-14 text-lg flex items-center justify-center h-auto min-h-[3rem]" %>
    <% end %>
	
	<div class="flex w-full flex-col mt-14 mb-8">
		<div class="divider text-[#4A4A4A] before:bg-current after:bg-current"><%= t('sessions.divider_text') %></div>
	</div>

	<div class="flex justify-center">
		<%= link_to discord_auth_path(locale: I18n.locale), { method: :get, class: "btn flex items-center justify-center w-full bg-[#5865F2] hover:bg-[#4752C4] border-none text-white py-3 mb-14 text-lg h-auto min-h-[3rem] discord-login-btn" } do %>
			<svg class="w-8 h-8" viewBox="0 0 24 24">
				<path fill="currentColor" d="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09c-.01-.02-.04-.03-.07-.03c-1.5.26-2.93.71-4.27 1.33c-.01 0-.02.01-.03.02c-2.72 4.07-3.47 8.03-3.1 11.95c0 .02.01.04.03.05c1.8 1.32 3.53 2.12 5.24 2.65c.03.01.06 0 .07-.02c.4-.55.76-1.13 1.07-1.74c.02-.04 0-.08-.04-.09c-.57-.22-1.11-.48-1.64-.78c-.04-.02-.04-.08-.01-.11c.11-.08.22-.17.33-.25c.02-.02.05-.02.07-.01c3.44 1.57 7.15 1.57 10.55 0c.02-.01.05-.01.07.01c.11.09.22.17.33.26c.04.03.04.09-.01.11c-.52.31-1.07.56-1.64.78c-.04.01-.05.06-.04.09c.32.61.68 1.19 1.07 1.74c.03.01.06.02.09.01c1.72-.53 3.45-1.33 5.25-2.65c.02-.01.03-.03.03-.05c.44-4.53-.73-8.46-3.1-11.95c-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.83 2.12-1.89 2.12z"/>
			</svg>
			<span><%= t('sessions.buttons.discord_login') %></span>
		<% end %>
	</div>

	<div class="flex justify-center">
		<%= link_to t('sessions.trouble_logging_in'), localized_root_path, class: "link link-hover text-center text-[#6B6B6B]" %>
	</div>
  </div>
</div>

<%= render 'shared/notification' %>

<script>
	document.addEventListener("DOMContentLoaded", function () {
	const csrfToken = document.querySelector('[name="csrf-token"]')?.content;

	const setupPasswordToggle = (toggleId, passwordId) => {
		const toggle = document.getElementById(toggleId);
		const password = document.getElementById(passwordId);

		if (toggle && password) {
		toggle.addEventListener("click", function () {
			const type = password.getAttribute("type") === "password" ? "text" : "password";
			password.setAttribute("type", type);

			this.innerHTML =
			type === "text"
				? '<svg class="w-6 h-6 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" d="M21 12c0 1.2-4.03 6-9 6s-9-4.8-9-6c0-1.2 4.03-6 9-6s9 4.8 9 6Z"/><path stroke="currentColor" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>'
				: '<svg class="w-6 h-6 text-gray-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>';

			this.setAttribute(
			"aria-label",
			type === "text"
				? "<%= j t('pages.minecraft_registration.buttons.hide_password') %>"
				: "<%= j t('pages.minecraft_registration.buttons.show_password') %>"
			);
		});
		}
	};

	setupPasswordToggle("togglePassword", "password");

	const form = document.querySelector("form");
	if (form) {
		const errorMessages = document.querySelectorAll(".error-message");
		const inputs = form.querySelectorAll('input[type="text"], input[type="password"]');

		const clearErrors = () => {
		errorMessages.forEach((msg) => {
			msg.classList.add("hidden");
			msg.textContent = "";
		});
		inputs.forEach((input) => {
			input.classList.remove("input-error");
		});
		};

		const showErrors = (errors) => {
		clearErrors();
		Object.entries(errors).forEach(([field, messages]) => {
			const inputField = form.querySelector(`[name="${field}"]`);
			if (inputField) {
			const errorContainer = inputField.closest(".form-control").querySelector(".error-message");
			if (errorContainer) {
				errorContainer.textContent = messages[0];
				errorContainer.classList.remove("hidden");
				inputField.classList.add("input-error");
			}
			}
		});
		};

		form.addEventListener("submit", function (e) {
		e.preventDefault();

		const csrfToken = document.querySelector('[name="csrf-token"]')?.content;

		const submitButton = form.querySelector('input[type="submit"], button[type="submit"]');
		submitButton.disabled = true;
		submitButton.textContent = "<%= j t('sessions.form.submitting') %>";

		const formData = new FormData(form);
		const jsonData = {
			nickname: formData.get("nickname"),
			password: formData.get("password"),
		};

		fetch(form.action, {
			method: "POST",
			headers: {
			"Content-Type": "application/json",
			"X-CSRF-Token": csrfToken,
			Accept: "application/json",
			},
			body: JSON.stringify(jsonData),
		})
			.then((response) => {
			return response.json().then((data) => ({ data, status: response.status }));
			})
			.then(({ data, status }) => {
			if (status === 201 || status === 200) {
				clearErrors();
				// Success notification
				showNotification(data.message || "<%= j t('sessions.login_success') %>");
				setTimeout(() => {
				window.location.href = data.redirect_to;
				}, 1500);
			} else {
				showErrors(data.errors || {});
				showAlertNotification(data.message || "<%= j t('sessions.login_failure') %>");
				submitButton.disabled = false;
				submitButton.textContent = "<%= j t('sessions.form.submit') %>";
			}
			})
			.catch((error) => {
			console.error("Error:", error);
			showAlertNotification("<%= j t('sessions.login_failure') %>");
			submitButton.disabled = false;
			submitButton.textContent = "<%= j t('sessions.form.submit') %>";
			});
		});
	}
	});
</script>
