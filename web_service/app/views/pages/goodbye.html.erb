<div class="scale-in">
  <div class="min-h-screen bg-[#121212] flex flex-col items-center justify-center p-6 text-center">
    <div class="max-w-2xl mx-auto">
      <!-- Логотип и заголовок -->
      <div class="mb-8">
        <div class="text-amber-400 text-5xl font-bold mb-2"><%= t('goodbye_page.title') %></div>
        <div class="text-gray-400 text-sm uppercase tracking-widest"><%= t('goodbye_page.subtitle') %></div>
      </div>

      <!-- Основное сообщение -->
      <div class="bg-[#1A1A1A] rounded-xl p-8 md:p-10 border border-[#3A3A3A] mb-8">
        <h1 class="text-2xl md:text-3xl font-bold text-white mb-6"><%= t('goodbye_page.heading') %></h1>
        
        <div class="text-gray-300 mb-6 leading-relaxed">
          <%= t('goodbye_page.message') %>
        </div>

        <%= link_to t('goodbye_page.back_button'), localized_root_path, class: "btn bg-amber-400 hover:bg-amber-300 text-[#1a1a1a] font-medium py-2 px-6 rounded transition" %>
      </div>

      <!-- Копирайт -->
      <div class="mt-8 text-gray-500 text-xs">
        © <%= Time.current.year %> <%= t('goodbye_page.copyright') %>
      </div>
    </div>
  </div>
</div>
