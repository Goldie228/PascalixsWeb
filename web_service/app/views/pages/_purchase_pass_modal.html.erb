<dialog id="pass_purchase_modal" class="modal">
  <div class="modal-box max-w-lg w-full bg-[#1A1A1A] border-2 border-yellow-400 relative min-h-[450px] flex flex-col justify-center items-center">
        <!-- Кнопка закрытия (крестик) -->
        <form method="dialog">
            <button class="btn btn-circle btn-ghost absolute right-6 top-6 p-2 hover:bg-[#333333]" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" 
                        class="w-6 h-6 text-gray-400 hover:text-gray-500 transition-colors" 
                        fill="none" 
                        viewBox="0 0 24 24" 
                        stroke="currentColor">
                    <path stroke-linecap="round" 
                                stroke-linejoin="round" 
                                stroke-width="2" 
                                d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </form>
    <!-- Контейнер для основного содержимого -->
    <div class="w-full flex flex-col items-center">
        <!-- Заголовок -->
        <h3 class="font-bold text-4xl text-center text-white mb-4">
        <%= t("pages.home_page.modal.title") %>
        </h3>
        
        <!-- Цена -->
        <div class="text-center mb-6">
            <p id="pass-price" class="text-5xl font-bold text-amber-400">
                <span class="loading loading-spinner loading-md"></span>
            </p>
        </div>
        
        <!-- Сообщение -->
        <div class="text-center mb-8">
            <p class="text-[#A0A0A0] text-lg">
                <%= t("pages.home_page.modal.message") %>
            </p>
        </div>
        
        <!-- Кнопка авторизации -->
        <div class="flex justify-center">
            <%= link_to discord_auth_path(locale: I18n.locale), 
            data: { turbo: false, method: :get }, 
            class: "btn flex items-center gap-4 bg-[#5865F2] hover:bg-[#4752C4] border-none text-white px-6 py-8 text-xl discord-login-btn" do %>
                <svg class="w-8 h-8" viewBox="0 0 24 24">
                    <path fill="currentColor" d="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09c-.01-.02-.04-.03-.07-.03c-1.5.26-2.93.71-4.27 1.33c-.01 0-.02.01-.03.02c-2.72 4.07-3.47 8.03-3.1 11.95c0 .02.01.04.03.05c1.8 1.32 3.53 2.12 5.24 2.65c.03.01.06 0 .07-.02c.4-.55.76-1.13 1.07-1.74c.02-.04 0-.08-.04-.09c-.57-.22-1.11-.48-1.64-.78c-.04-.02-.04-.08-.01-.11c.11-.08.22-.17.33-.25c.02-.02.05-.02.07-.01c3.44 1.57 7.15 1.57 10.55 0c.02-.01.05-.01.07.01c.11.09.22.17.33.26c.04.03.04.09-.01.11c-.52.31-1.07.56-1.64.78c-.04.01-.05.06-.04.09c.32.61.68 1.19 1.07 1.74c.03.01.06.02.09.01c1.72-.53 3.45-1.33 5.25-2.65c.02-.01.03-.03.03-.05c.44-4.53-.73-8.46-3.1-11.95c-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.83 2.12-1.89 2.12z"/>
                </svg>
                <span><%= t("buttons.register_discord") %></span>
            <% end %>
        </div>
    </div>
  </div>
  <!-- Затемнённый фон для закрытия по клику вне окна -->
  <form method="dialog" class="modal-backdrop">
    <button></button>
  </form>
</dialog>

<script>
  // Функция для получения CSRF-токена
  function getCsrfToken() {
    const token = document.querySelector('meta[name="csrf-token"]')?.content;
    return token || '';
  }

  // Функция для отображения уведомлений
  function showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 animate-fadeIn ${
      type === 'error' ? 'bg-red-500' : 
      type === 'success' ? 'bg-green-500' : 
      'bg-blue-500'
    } text-white`;
    notification.textContent = message;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
      notification.remove();
    }, 5000);
  }

  // Функция для получения цены продукта
  async function getPassPrice() {
    try {
      // Проверяем, что URL сервиса определен
      const authServiceUrl = "<%= ENV['AUTH_SERVICE_URL'] %>";
      console.log('URL auth_service:', authServiceUrl);
      
      // Сначала получаем URL из окружения через ERB и сохраняем в чистую JS переменную
      const authServiceUrlFromEnv = "<%= ENV['AUTH_SERVICE_URL'] %>";

      // Теперь работаем только в контексте JavaScript, без ERB-тегов внутри логики
      const url = (authServiceUrl && !authServiceUrl.includes('<%')) 
          ? `${authServiceUrl}/api/v1/product/pass_purchase`
          : `${authServiceUrlFromEnv}/api/v1/product/pass_purchase`;
      
      console.log('Запрашиваю цену по URL:', url);
      
      const response = await fetch(url, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': getCsrfToken()
        },
        credentials: 'same-origin'
      });
      
      console.log('Статус ответа:', response.status);
      
      if (response.ok) {
        const data = await response.json();
        console.log('Полученные данные:', data);
        return data.price;
      } else if (response.status === 404) {
        console.error('Продукт не найден: pass_purchase');
        return null;
      } else if (response.status === 422) {
        console.error('Цена не установлена для продукта: pass_purchase');
        return null;
      } else {
        console.error('Ошибка при получении цены продукта:', response.status);
        return null;
      }
    } catch (error) {
      console.error('Исключение при получении цены продукта:', error);
      return null;
    }
  }

  // Функция для обновления цены в модальном окне
  async function updatePassPrice() {
    const priceElement = document.getElementById('pass-price');
    
    // Показываем индикатор загрузки
    priceElement.innerHTML = '<span class="loading loading-spinner loading-md"></span>';
    
    // Получаем цену
    const price = await getPassPrice();
    
    if (price !== null) {
      // Обновляем цену
      priceElement.textContent = price + " USD";
    } else {
      // Показываем ошибку
      priceElement.textContent = 'Цена недоступна';
      priceElement.classList.add('text-red-500');
      showNotification('Не удалось получить цену продукта. Пожалуйста, попробуйте позже.', 'error');
    }
  }

  // Открытие модального окна
  async function openPassPurchaseModal() {
    const modal = document.getElementById("pass_purchase_modal");
    if (modal) {
      // Сбрасываем состояние цены
      const priceElement = document.getElementById('pass-price');
      priceElement.textContent = '';
      priceElement.classList.remove('text-red-500');
      
      // Открываем модальное окно
      modal.showModal();
      
      // Загружаем цену
      await updatePassPrice();
    }
  }

  // Закрытие модального окна
  function closePassPurchaseModal() {
    const modal = document.getElementById("pass_purchase_modal");
    if (modal) {
      modal.close();
    }
  }

  // Добавляем стили для анимаций
  const style = document.createElement('style');
  style.innerHTML = `
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
      animation: fadeIn 0.3s ease-out forwards;
    }
  `;
  document.head.appendChild(style);

  // Делаем функции доступными глобально
  window.openPassPurchaseModal = openPassPurchaseModal;
  window.closePassPurchaseModal = closePassPurchaseModal;
  
  // Добавляем псевдоним для обратной совместимости
  window.openModal = openPassPurchaseModal;
  window.closeModal = closePassPurchaseModal;
</script>
