<div class="bg-[#1A1A1A] rounded-lg shadow-lgpt-2 pl-2 pr-0 mt-4 mb-4 mx-auto px-4 py-8 w-[90%] max-w-8xl overflow-hidden">
  <!-- Мобильная версия (скрыта на десктопе) -->
  <div class="xl:hidden">
    <div class="text-center">
      <h1 class="text-2xl font-bold text-white mb-3">
        <%= t('pages.home_page.sta_field') %>
      </h1>
      <div class="h-1 w-[70%] bg-amber-400 mx-auto rounded mb-4"></div>
    </div>

    <p class="text-[#A0A0A0] text-base text-center px-2 mb-6">
      <%= t('server_description') %>
    </p>

    <div class="flex flex-col items-center space-y-4">
      <% if !current_user || current_user&.role_name == "User" %>
  			<button class="btn btn-warning rounded-full text-[#1A1A1A] px-12 py-6 text-xl w-full max-w-[300px] hover:bg-[#FFC400] shadow-lg hover:shadow-xl transition duration-200 ease-in-out" onclick="openModal()">
  				<%= t('buttons.buy_access') %>
  			</button>
      <% else %>
        <%= link_to t("pages.home_page.dashboard"), user_profile_path, class: "btn btn-warning rounded-full text-[#1A1A1A] px-12 py-6 text-xl w-full max-w-[300px] hover:bg-[#FFC400] shadow-lg hover:shadow-xl transition duration-200 ease-in-out"
        %>
      <% end %>
						
			<button class="btn btn-outline btn-warning rounded-full px-12 py-6 text-xl hover:text-[#1A1A1A] shadow-lg hover:shadow-xl transition duration-200 ease-in-out" 
							data-clipboard-text="<%= t('server_ip')%>">
				<%= t('server_ip')%>
			</button>
    </div>

    <div class="mt-6 text-gray-400 text-center">
      <p class="text-xs"><%= t('footer.version_note') %></p>
      <p class="text-[10px] text-gray-500 mt-1"><%= t('footer.server_version') %></p>
    </div>
  </div>

  <!-- Десктоп версия (скрыта на мобильных) -->
  <div class="hidden xl:flex mt-15 mb-15">
    <div class="flex-grow flex flex-col justify-center">
      <div class="text-center">
        <h1 class="text-4xl font-bold text-white mb-4">
          <%= t('pages.home_page.sta_field') %>
        </h1>
        <div class="h-1 w-[90%] bg-amber-400 mx-auto rounded"></div>
      </div>

      <p class="text-[#A0A0A0] text-lg text-center p-4">
        <%= t('server_description') %>
      </p>

      <div class="flex justify-center items-center space-x-8">
        <% if !current_user || current_user&.role_name == "User" %>
          <button class="btn btn-warning rounded-full text-[#1A1A1A] px-12 py-6 text-xl shadow-lg hover:shadow-xl hover:bg-[#FFC400] hover:text-black transition duration-200 ease-in-out" onclick="openModal()">
            <%= t('buttons.buy_access') %>
          </button>
        <% else %>
          <%= link_to t("pages.home_page.dashboard"), user_profile_path, class: "btn btn-warning rounded-full text-[#1A1A1A] px-12 py-6 text-xl shadow-lg hover:shadow-xl hover:bg-[#FFC400] hover:text-black transition duration-200 ease-in-out"
          %>
        <% end %>
        
        <button 
					class="btn btn-outline btn-warning rounded-full px-12 py-6 text-xl hover:text-[#1A1A1A] shadow-lg hover:shadow-xl transition duration-200 ease-in-out" 
					data-clipboard-text="<%= t('server_ip')%>">
					<%= t('server_ip')%>
				</button>
      </div>

      <div class="mt-8 text-gray-400 text-center">
        <p class="text-sm"><%= t('footer.version_note') %></p>
        <p class="text-xs text-gray-500 mt-1"><%= t('footer.server_version') %></p>
      </div>
    </div>

    <!-- Правая часть (только для десктопа) -->
    <div class="flex-none relative w-[40%] h-[300px]">
      <div class="bg-[#2D2D2D] rounded-l-4xl rounded-r-none p-2 w-full h-full relative">
        <!-- Картинка, частично выходящая за границы фигуры -->
        <img 
          src="<%= asset_path('home_page/STA.png') %>" 
          class="absolute -top-[30%] -left-[10%] h-[130%]"
        >
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
  document.addEventListener('DOMContentLoaded', function() {
    const clipboard = new ClipboardJS('[data-clipboard-text]');

    clipboard.on('success', function(e) {
      showNotification('<%= t("buttons.copy_ip") %>!');
      e.clearSelection();
    });

    clipboard.on('error', function(e) {
      showNotification('<%= t("errors.copy_failed") %>');
    });
  });
</script>
