<div class="min-h-screen bg-[#121212] flex flex-col items-center justify-center p-6 text-center">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8">
      <svg class="w-24 h-24 mx-auto text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
    </div>

    <div class="bg-[#1A1A1A] rounded-xl p-8 md:p-10 border border-[#3A3A3A] mb-8">
      <h1 class="text-2xl md:text-3xl font-bold text-white mb-6">
        <%= t('check_email_page_7Fk3.title') %>
      </h1>
      
      <div class="text-gray-300 mb-6 leading-relaxed">
        <%= t('check_email_page_7Fk3.subtitle') %>
        <div class="mt-3 text-lg font-semibold text-amber-400"><%= @email %></div>
      </div>

      <div class="bg-[#2b2b2b] p-4 rounded-lg border border-amber-400/20 mb-6">
        <div class="text-amber-400 font-medium mb-2">
          <%= t('check_email_page_7Fk3.next_steps_title') %>
        </div>
        <div class="text-white/90 text-left text-sm space-y-2">
          <% t('check_email_page_7Fk3.next_steps').each_with_index do |step, index| %>
            <div class="flex items-start">
              <div class="text-amber-400 mr-2"><%= index + 1 %>.</div>
              <div><%= step %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to t('check_email_page_7Fk3.home_button'), localized_root_path, class: "btn bg-amber-400 hover:bg-amber-300 border-none text-[#1a1a1a] font-medium py-3 px-6 rounded transition" %>
    </div>
  </div>
</div>
