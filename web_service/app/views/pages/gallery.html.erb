
<%= render 'shared/navbar' %>

<!-- Основной фон проекта -->
<div class="min-h-screen text-white font-sans" data-controller="gallery">
    
    <!-- Заголовок -->
    <h1 class="text-4xl font-bold text-center mt-12 mb-8"><%= t('views.gallery.title') %></h1>

    <!-- ПАНЕЛЬ УПРАВЛЕНИЯ (Всегда видна) -->
    <div id="galleryControlPanel" class="flex flex-col md:flex-row justify-between items-stretch md:items-center gap-3 md:gap-6 mb-8 px-4 md:px-20 w-full sticky top-15 md:top-30 z-20 bg-[#121212] py-4">
        
        <!-- Сортировка (Стиль Players) -->
        <div class="w-full md:w-auto">
            <div class="form-control">
                <div class="dropdown dropdown-bottom w-full md:w-64">
                    <label tabindex="0" class="btn bg-[#121212] border border-white/10 text-white hover:bg-[#1a1a1a] hover:border-amber-400 flex justify-between items-center h-full py-3 px-4 transition-all duration-200">
                        <span class="text-sm md:text-base font-medium" id="currentSortLabel"><%= t('views.gallery.sort.newest') %></span>
                        <svg class="w-4 h-4 text-amber-400 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </label>
                    <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-lg bg-[#2D2D2D] rounded-box w-full mt-1 border border-white/10">
                        <li><a onclick="app.gallery.setSort('newest')" class="text-white hover:bg-amber-400 hover:text-black transition"><%= t('views.gallery.sort.newest') %></a></li>
                        <li><a onclick="app.gallery.setSort('oldest')" class="text-white hover:bg-amber-400 hover:text-black transition"><%= t('views.gallery.sort.oldest') %></a></li>
                        <li><a onclick="app.gallery.setSort('az')" class="text-white hover:bg-amber-400 hover:text-black transition"><%= t('views.gallery.sort.az') %></a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Поиск (Стиль Players) -->
        <div class="w-full md:w-auto mt-2 md:mt-0">
            <div class="relative w-full md:w-[300px]">
                <input
                    type="text"
                    id="gallerySearch"
                    placeholder="<%= t('views.gallery.search.placeholder') %>"
                    class="input w-full bg-[#2D2D2D] text-white placeholder-[#A0A0A0] border-2 border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition pl-10 py-3 rounded-lg"
                >
                <div class="absolute left-3 top-1/2 transform -translate-y-1/2 pointer-events-none">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- КОНТЕНТ -->
    <div class="px-4 md:px-20 pb-20 min-h-screen">
        
        <!-- СПИСОК АЛЬБОМОВ -->
        <div id="albumsContainer">
            <!-- Загрузка -->
            <div id="albumsLoader" class="w-full flex justify-center py-20 hidden">
                <div class="w-12 h-12 border-4 border-[#1A1A1A] border-t-amber-400 rounded-full animate-spin"></div>
            </div>

            <!-- Сетка Альбомов -->
            <div id="albumsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Карточки рендерятся тут -->
            </div>

            <!-- Пагинация Альбомов -->
            <div id="albumsPagination" class="flex justify-center items-center gap-2 mt-12 flex-wrap"></div>
        </div>

        <!-- ПРОСМОТР АЛЬБОМА (Скрыт по умолчанию) -->
        <div id="albumViewContainer" class="hidden">
            
            <!-- Навигация: Назад -->
            <div class="mb-8">
                <button onclick="app.gallery.closeAlbum()" class="flex items-center gap-2 text-gray-400 hover:text-white transition font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    <%= t('views.gallery.back') %>
                </button>
            </div>

            <!-- Заголовок Альбома -->
            <div class="bg-[#1A1A1A] rounded-xl p-8 mb-10">
                <h2 id="albumTitle" class="text-3xl md:text-4xl font-bold text-white mb-2"></h2>
                <p id="albumDescription" class="text-gray-400 text-lg"></p>
                <div class="mt-4 flex gap-4 text-sm text-gray-500">
                    <span id="albumDate" class="flex items-center gap-1"></span>
                    <span>•</span>
                    <span id="albumCount"></span>
                </div>
            </div>

            <!-- Сетка Фотографий (Social Media Style: Masonry + Captions) -->
            <div id="photosGrid" class="columns-1 sm:columns-2 md:columns-3 xl:columns-4 gap-6 space-y-6">
                <!-- Фото рендерятся тут -->
            </div>
        </div>
    </div>

    <!-- LIGHTBOX (Минималистичный) -->
    <div id="lightbox" class="fixed inset-0 z-50 bg-black/95 hidden flex justify-center items-center backdrop-blur-sm">
        <!-- Кнопка закрытия -->
        <button onclick="app.gallery.closeLightbox()" class="absolute top-4 right-4 text-white/70 hover:text-amber-400 z-50 p-2 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <!-- Навигация стрелки -->
        <button onclick="app.gallery.prevPhoto()" class="absolute left-4 text-white/50 hover:text-amber-400 z-50 p-4 transition-colors hidden md:block">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </button>
        <button onclick="app.gallery.nextPhoto()" class="absolute right-4 text-white/50 hover:text-amber-400 z-50 p-4 transition-colors hidden md:block">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </button>

        <!-- Изображение -->
        <div class="relative max-h-[85vh] max-w-[90vw]">
            <img id="lightboxImage" src="" alt="<%= t('views.gallery.lightbox.full_view') %>" class="max-h-[85vh] max-w-[90vw] object-contain shadow-2xl rounded-sm">
            
            <!-- Тут выводим название фото, если оно есть -->
            <div id="lightboxCaption" class="hidden absolute bottom-4 left-0 right-0 text-center">
                <span class="bg-black/60 text-white px-4 py-2 rounded-lg text-sm backdrop-blur-md"></span>
            </div>
        </div>
        
        <!-- Счетчик страниц -->
        <div class="absolute bottom-4 left-4 text-gray-400 text-xs font-mono">
            <span id="lightboxCounter"></span>
        </div>
    </div>
</div>

<script>
// Встраиваем переводы в JS
window.app = window.app || {};
window.app.galleryI18n = {
    locale: "<%= I18n.locale %>",
    sort: {
        newest: "<%= j t('views.gallery.sort.newest') %>",
        oldest: "<%= j t('views.gallery.sort.oldest') %>",
        az: "<%= j t('views.gallery.sort.az') %>"
    },
    errors: {
        loading: "<%= j t('views.gallery.errors.loading') %>",
        open_failed: "<%= j t('views.gallery.errors.open_failed') %>"
    },
    no_results: "<%= j t('views.gallery.no_results') %>",
    album: {
        empty: "<%= j t('views.gallery.album.empty') %>",
        no_description: "<%= j t('views.gallery.album.no_description') %>",
        photos: {
            one: "<%= j t('views.gallery.album.photos.one') %>",
            few: "<%= j t('views.gallery.album.photos.few') %>",
            many: "<%= j t('views.gallery.album.photos.many') %>",
            other: "<%= j t('views.gallery.album.photos.other') %>"
        }
    }
};

window.app.gallery = (function() {
    const authServiceUrl = "<%= ENV['AUTH_SERVICE_URL'] %>";
    const i18n = window.app.galleryI18n;
    
    // Хелпер для множественного числа
    const pluralize = (count) => {
        if (i18n.locale === 'ru') {
            const mod10 = count % 10;
            const mod100 = count % 100;
            if (mod10 === 1 && mod100 !== 11) return i18n.album.photos.one.replace('%{count}', count);
            if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return i18n.album.photos.few.replace('%{count}', count);
            return i18n.album.photos.many.replace('%{count}', count);
        } else {
            return i18n.album.photos.other.replace('%{count}', count);
        }
    };

    let state = {
        currentPage: 1,
        perPage: 12,
        totalPages: 1,
        albums: [],
        currentAlbum: null,
        currentPhotos: [],
        currentPhotoIndex: 0,
        search: '',
        sort: 'newest'
    };

    const els = {
        albumsContainer: document.getElementById('albumsContainer'),
        albumsGrid: document.getElementById('albumsGrid'),
        albumsLoader: document.getElementById('albumsLoader'),
        albumsPagination: document.getElementById('albumsPagination'),
        albumViewContainer: document.getElementById('albumViewContainer'),
        photosGrid: document.getElementById('photosGrid'),
        currentSortLabel: document.getElementById('currentSortLabel'),
        // Детали
        albumTitle: document.getElementById('albumTitle'),
        albumDescription: document.getElementById('albumDescription'),
        albumDate: document.getElementById('albumDate'),
        albumCount: document.getElementById('albumCount'),
        // Инпуты
        searchInput: document.getElementById('gallerySearch'),
        // Lightbox
        lightbox: document.getElementById('lightbox'),
        lightboxImage: document.getElementById('lightboxImage'),
        lightboxCounter: document.getElementById('lightboxCounter'),
        lightboxCaption: document.getElementById('lightboxCaption')
    };

    function init() {
        // Сохраняем ссылку на панель управления для работы с IntersectionObserver
        const controlPanel = document.querySelector('[data-controller="gallery"]').querySelector('div.flex');

        els.searchInput.addEventListener('input', debounce((e) => {
            state.search = e.target.value;
            state.currentPage = 1;
            loadAlbums();
        }, 500));

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeLightbox();
            if (!els.lightbox.classList.contains('hidden')) {
                if (e.key === 'ArrowLeft') prevPhoto();
                if (e.key === 'ArrowRight') nextPhoto();
            }
        });

        // Добавляем класс при скролле для subtle shadow эффекта
        let ticking = false;
        window.addEventListener('scroll', () => {
            if (!ticking) {
                window.requestAnimationFrame(() => {
                    controlPanel.classList.toggle('shadow-lg', window.scrollY > 10);
                    ticking = false;
                });
                ticking = true;
            }
        });

        loadAlbums();
    }

    function setSort(sortType) {
        state.sort = sortType;
        state.currentPage = 1;
        els.currentSortLabel.textContent = i18n.sort[sortType];
        loadAlbums();
    }

    async function loadAlbums() {
        els.albumsGrid.innerHTML = '';
        els.albumsLoader.classList.remove('hidden');

        try {
            const params = new URLSearchParams();
            params.append('page', state.currentPage);
            params.append('per_page', state.perPage);
            params.append('published', 'true'); 
            if (state.search) params.append('search', state.search);
            
            if (state.sort === 'newest') { params.append('sort', 'created_at'); params.append('order', 'desc'); }
            if (state.sort === 'oldest') { params.append('sort', 'created_at'); params.append('order', 'asc'); }
            if (state.sort === 'az') { params.append('sort', 'title'); params.append('order', 'asc'); }

            const response = await fetch(`${authServiceUrl}/api/v1/galleries?${params.toString()}`);
            if (!response.ok) throw new Error('Ошибка');
            
            const data = await response.json();
            state.albums = data.galleries || [];
            state.totalPages = Math.ceil((data.total_count || 0) / state.perPage);
            
            renderAlbums();
            renderPagination();

        } catch (error) {
            console.error(error);
            els.albumsGrid.innerHTML = `<div class="col-span-full text-center text-red-500 py-10">${i18n.errors.loading}</div>`;
        } finally {
            els.albumsLoader.classList.add('hidden');
        }
    }

    function renderAlbums() {
        if (state.albums.length === 0) {
            els.albumsGrid.innerHTML = `<div class="col-span-full text-center py-10 text-gray-500">${i18n.no_results}</div>`;
            return;
        }

        els.albumsGrid.innerHTML = state.albums.map(album => {
            const coverUrl = album.cover_url 
                ? album.cover_url 
                : 'https://via.placeholder.com/400x300/1A1A1A/FFD700?text=No+Cover';
            
            const date = new Date(album.created_at).toLocaleDateString(i18n.locale === 'ru' ? 'ru-RU' : 'en-US', {
                year: 'numeric', month: 'long', day: 'numeric'
            });

            // Стиль: Чистая карточка, обводка появляется при наведении
            return `
            <div class="bg-[#1A1A1A] rounded-xl overflow-hidden border border-white/5 hover:border-amber-400 transition duration-300 group cursor-pointer shadow-md hover:shadow-xl" onclick="app.gallery.openAlbum(${album.id})">
                <!-- Обложка -->
                <div class="relative w-full aspect-[4/3] overflow-hidden bg-[#252525]">
                    <img src="${coverUrl}" loading="lazy" alt="${escapeHtml(album.title)}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                </div>
                <!-- Контент -->
                <div class="p-5">
                    <h3 class="text-lg font-bold text-white mb-1 truncate group-hover:text-amber-400 transition-colors">${escapeHtml(album.title)}</h3>
                    <div class="flex justify-between items-center text-sm text-gray-400">
                        <span class="flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            ${album.photos_count || 0}
                        </span>
                        <span>${date}</span>
                    </div>
                </div>
            </div>
            `;
        }).join('');
    }

    async function openAlbum(id) {
        try {
            const response = await fetch(`${authServiceUrl}/api/v1/galleries/${id}`);
            if (!response.ok) throw new Error(i18n.errors.open_failed);
            
            const album = await response.json();
            state.currentAlbum = album;
            state.currentPhotos = album.photos || [];

            els.albumTitle.textContent = album.title;
            els.albumDescription.textContent = album.description || i18n.album.no_description;
            els.albumDate.textContent = new Date(album.created_at).toLocaleDateString(i18n.locale === 'ru' ? 'ru-RU' : 'en-US');
            els.albumCount.textContent = pluralize(state.currentPhotos.length);

            renderPhotos();

            // Скрываем панель управления
            document.getElementById('galleryControlPanel').classList.add('hidden');

            // Переключение видов
            els.albumsContainer.classList.add('hidden');
            els.albumViewContainer.classList.remove('hidden');
            
            // Скролл вверх
            window.scrollTo({ top: 0, behavior: 'smooth' });

        } catch (error) {
            console.error(error);
            alert(i18n.errors.open_failed);
        }
    }

    function renderPhotos() {
        if (state.currentPhotos.length === 0) {
            els.photosGrid.innerHTML = `<div class="col-span-full text-center py-10 text-gray-500">${i18n.album.empty}</div>`;
            return;
        }

        els.photosGrid.innerHTML = state.currentPhotos.map((photo, index) => {
            // Определяем есть ли название
            const hasTitle = photo.title && photo.title.trim().length > 0;
            
            // Стиль Social Media: Карточка с фото и текстом снизу
            return `
            <div class="break-inside-avoid mb-6 group cursor-pointer" onclick="app.gallery.openLightbox(${index})">
                <div class="bg-[#121212] rounded-xl overflow-hidden border border-white/5 hover:border-amber-400 transition duration-300 shadow-sm hover:shadow-lg">
                    
                    <!-- Фото -->
                    <div class="relative overflow-hidden">
                        <img src="${photo.file_url}" loading="lazy" alt="Photo" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500">
                        <!-- Оверлей при наведении -->
                        <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    </div>
                    
                    <!-- Подпись (пост стиль) -->
                    ${hasTitle ? `
                    <div class="p-4 border-t border-white/5 bg-[#1A1A1A]">
                        <h4 class="text-white font-medium text-sm leading-snug">${escapeHtml(photo.title)}</h4>
                    </div>
                    ` : ''}
                </div>
            </div>
            `;
        }).join('');
    }

    function closeAlbum() {
        state.currentAlbum = null;
        state.currentPhotos = [];
        
        // Показываем панель управления
        document.getElementById('galleryControlPanel').classList.remove('hidden');
        
        // Переключение видов
        els.albumViewContainer.classList.add('hidden');
        els.albumsContainer.classList.remove('hidden');
    }

    // Lightbox Logic
    function openLightbox(index) {
        state.currentPhotoIndex = index;
        updateLightboxContent();
        els.lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden'; // Блокируем скролл
    }

    function updateLightboxContent() {
        const photo = state.currentPhotos[state.currentPhotoIndex];
        if (!photo) return;

        const nextIdx = (state.currentPhotoIndex + 1) % state.currentPhotos.length;
        const prevIdx = (state.currentPhotoIndex - 1 + state.currentPhotos.length) % state.currentPhotos.length;
        
        if (state.currentPhotos[nextIdx]) new Image().src = state.currentPhotos[nextIdx].file_url;
        if (state.currentPhotos[prevIdx]) new Image().src = state.currentPhotos[prevIdx].file_url;

        els.lightboxImage.src = photo.file_url;
        els.lightboxCounter.textContent = `${state.currentPhotoIndex + 1} / ${state.currentPhotos.length}`;
        
        // Показываем подпись в лайтбоксе
        if(photo.title && photo.title.trim().length > 0) {
            els.lightboxCaption.querySelector('span').textContent = photo.title;
            els.lightboxCaption.classList.remove('hidden');
        } else {
            els.lightboxCaption.classList.add('hidden');
        }
    }

    function closeLightbox() {
        els.lightbox.classList.add('hidden');
        document.body.style.overflow = '';
    }

    function nextPhoto() {
        state.currentPhotoIndex = (state.currentPhotoIndex + 1) % state.currentPhotos.length;
        updateLightboxContent();
    }

    function prevPhoto() {
        state.currentPhotoIndex = (state.currentPhotoIndex - 1 + state.currentPhotos.length) % state.currentPhotos.length;
        updateLightboxContent();
    }

    function renderPagination() {
        if (state.totalPages <= 1) {
            els.albumsPagination.innerHTML = '';
            return;
        }

        let html = '';
        const pageRange = [];
        const current = state.currentPage;
        const total = state.totalPages;

        if (total <= 7) {
            for (let i = 1; i <= total; i++) pageRange.push(i);
        } else {
            if (current <= 4) pageRange.push(1, 2, 3, 4, 5, '...', total);
            else if (current >= total - 3) pageRange.push(1, '...', total - 4, total - 3, total - 2, total - 1, total);
            else pageRange.push(1, '...', current - 1, current, current + 1, '...', total);
        }

        pageRange.forEach(p => {
            if (p === '...') {
                html += `<span class="text-gray-500 px-2">...</span>`;
            } else {
                const activeClass = p === current ? 'bg-amber-400 text-black font-semibold shadow-md border-amber-400' : 'bg-[#121212] text-white border-amber-400 hover:bg-[#1a1a1a]';
                html += `<button onclick="app.gallery.goToPage(${p})" class="btn border-2 transition ${activeClass} w-10 h-10 min-h-0 px-0 mx-1 rounded-lg">${p}</button>`;
            }
        });

        els.albumsPagination.innerHTML = html;
    }

    function goToPage(page) {
        state.currentPage = page;
        loadAlbums();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function debounce(func, wait) {
        let timeout;
        return function(...args) {
            clearTimeout(timeout);
            timeout = setTimeout(() => func.apply(this, args), wait);
        };
    }

    function escapeHtml(unsafe) {
        if (!unsafe) return '';
        return unsafe.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    return {
        init,
        setSort,
        openAlbum,
        closeAlbum,
        openLightbox,
        closeLightbox,
        nextPhoto,
        prevPhoto,
        goToPage
    };
})();

document.addEventListener('DOMContentLoaded', window.app.gallery.init);
</script>

<%= render 'shared/footer' %>
