# =============================================================================
# PascalixsWeb - Environment Configuration
# =============================================================================
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# =============================================================================

# Rails Environment
RAILS_ENV=development

# =============================================================================
# Service Ports (используются в Procfile)
# =============================================================================
WEB_SERVICE_PORT=3001
AUTH_SERVICE_PORT=3002
MAILER_SERVICE_PORT=3003
MINECRAFT_SERVICE_PORT=3004

# =============================================================================
# Service URLs (для межсервисного взаимодействия)
# =============================================================================
WEB_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3002
MAILER_SERVICE_URL=http://localhost:3003
MINECRAFT_SERVICE_URL=http://localhost:3004

# =============================================================================
# Infrastructure
# =============================================================================
REDIS_URL=redis://localhost:6380
KAFKA_BROKERS=localhost:29092

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8124
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=SuperSecure123

# =============================================================================
# Auth Service - OAuth Credentials
# =============================================================================
# Получите эти ключи на соответствующих платформах:
# Discord: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twitch: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TikTok: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# =============================================================================
# Inter-service Communication
# =============================================================================
INTER_SERVICE_API_KEY=your_secure_api_key_here
AUTH_VERSION=v1

# =============================================================================
# Minecraft Service
# =============================================================================
MC_SERVER_IP=your_minecraft_server_ip

# =============================================================================
# Mailer Service - SMTP Configuration
# =============================================================================
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=
SMTP_PASSWORD=
APP_HOST=example.com

# =============================================================================
# Database (Production)
# =============================================================================
# Auth Service Database
DB_HOST=localhost
WEB_DB_USERNAME=
WEB_DB_PASSWORD=
WEB_DB_DATABASE=pascalixs_auth_production

# Minecraft Service Database
MC_DB_USERNAME=
MC_DB_PASSWORD=
MC_DB_DATABASE=pascalixs_minecraft_production

# =============================================================================
# Development Database (Minecraft Service)
# =============================================================================
MC_DEV_DB_USERNAME=
MC_DEV_DB_PASSWORD=
MC_DEV_DB_DATABASE=pascalixs_minecraft_development
