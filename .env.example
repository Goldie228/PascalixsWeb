# ============================================================
# PascalixsWeb - Environment Configuration
# ============================================================
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# ============================================================

# Rails Environment
RAILS_ENV=development
SECRET_KEY_BASE=your-rails-secret-key

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# Kafka
# ============================================================
KAFKA_BROKERS=localhost:29092

# ============================================================
# ClickHouse (только web-portal)
# ============================================================
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=pascalixs

# ============================================================
# MySQL
# ============================================================
DATABASE_URL=mysql2://root:root@localhost:3306/identity_service

# ============================================================
# Сервисы
# ============================================================
AUTH_SERVICE_URL=http://localhost:3001
WEB_SERVICE_URL=http://localhost:3000
MINECRAFT_SERVICE_URL=http://localhost:3003
MAILER_SERVICE_URL=http://localhost:3004

# ============================================================
# Email (notification-service)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ============================================================
# Межсервисная аутентификация
# ============================================================
INTER_SERVICE_API_KEY=your-secret-api-key-change-in-production

# ============================================================
# Auth Service - OAuth Credentials
# ============================================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3001/auth/twitch/callback

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/auth/tiktok/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ============================================================
# Minecraft
# ============================================================
MINECRAFT_SERVER_IP=play.pascalixs.fun
MINECRAFT_SERVER_PORT=25565
AUTHME_API_KEY=
LUCKPERMS_API_KEY=
