# ============================================================
# PascalixsWeb - Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# This is a TEMPLATE: all values below are safe placeholders.
# Replace every CHANGE_ME / your-* value before starting services.
# The real .env is git-ignored and must never be committed.
# ============================================================

# ===== General (Rails) =====
# Environment for all four Rails services (development | production | test)
RAILS_ENV=development
# Secret used by Rails (sessions, cookies, message verification); generate with `rails secret`
SECRET_KEY_BASE=CHANGE_ME
# Optional: Puma thread count and AR connection pool size (default 3 in Puma)
RAILS_MAX_THREADS=3
# Optional: Puma PID file location (only needed when running Puma as a daemon)
PIDFILE=

# ===== Infrastructure (Redis/Kafka/ClickHouse/MySQL) =====
# Ports below are the HOST-side ports exposed by docker-compose.yml (see `ports:` there).
# Redis (host:6380 -> container:6379); use the db number per service if you want isolation
REDIS_URL=redis://localhost:6380
# Kafka bootstrap servers (host:29093 -> container:29092 via docker-compose)
KAFKA_BROKERS=localhost:29093
# ClickHouse connection (host:8124 -> container:8123 via docker-compose)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8124
# ClickHouse credentials; must match the clickhouse service in docker-compose.yml (empty password by default)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_ME
# Full ClickHouse HTTP URL (used by docker-compose service environments)
CLICKHOUSE_URL=http://localhost:8124
# ClickHouse database name (created on the clickhouse container)
CLICKHOUSE_DB=pascalixs
# MySQL connection string for services that use DATABASE_URL (identity-service, game-service).
# docker-compose exposes MySQL on host port 3307; inside compose the service name `mysql` is used instead.
DATABASE_URL=mysql2://root:CHANGE_ME@localhost:3307/identity_service
# MySQL host used by production database.yml files (identity-service and game-service)
DB_HOST=localhost
# identity-service production database credentials
WEB_DB_USERNAME=your-db-username
WEB_DB_PASSWORD=your-db-password
WEB_DB_DATABASE=identity_service
# game-service production database credentials
MC_DB_USERNAME=your-db-username
MC_DB_PASSWORD=your-db-password
MC_DB_DATABASE=game_service

# ===== Inter-service auth =====
# Shared secret sent between services (X-Api-Key / Authorization headers); must be identical on all 4 services
INTER_SERVICE_API_KEY=CHANGE_ME
# API version segment used in inter-service routes, e.g. /api/v1/... (identity-service + web-portal)
AUTH_VERSION=v1

# ===== Service URLs =====
# Base URLs services use to call each other (localhost for host dev, service names inside docker-compose)
IDENTITY_SERVICE_URL=http://localhost:3001
WEB_PORTAL_URL=http://localhost:3000
GAME_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004

# ===== Identity service =====
# OAuth providers - register your app on each platform and paste the credentials here.
# Discord: https://discord.com/developers/applications
DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_CLIENT_SECRET=CHANGE_ME
# Google (also used for YouTube): https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
# Twitch: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=CHANGE_ME
TWITCH_CLIENT_SECRET=CHANGE_ME
# TikTok: https://developers.tiktok.com/
# Note: identity-service reads TIKTOK_CLIENT_KEY (not TIKTOK_CLIENT_ID); TIKTOK_CLIENT_ID is kept for compatibility
TIKTOK_CLIENT_KEY=CHANGE_ME
TIKTOK_CLIENT_SECRET=CHANGE_ME
TIKTOK_CLIENT_ID=
# Redirect URIs to register in each provider's dashboard (the app itself builds callbacks as
# http://localhost:3001/api/<AUTH_VERSION>/auth|integrations/<provider>/callback)
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
TWITCH_REDIRECT_URI=http://localhost:3001/auth/twitch/callback
TIKTOK_REDIRECT_URI=http://localhost:3001/auth/tiktok/callback
# Port used by the root Procfile (foreman) for identity-service; docker-compose ignores this (fixed to 3001)
AUTH_SERVICE_PORT=3002

# ===== Web portal =====
# Puma port for web-portal (matches docker-compose)
PORT=3000

# ===== Game service =====
# Puma port for game-service (matches docker-compose)
PORT=3003
# Port used by the root Procfile (foreman) for game-service; docker-compose ignores this (fixed to 3003)
MINECRAFT_SERVICE_PORT=3004
# Minecraft server address checked via api.mcsrvstat.us by CheckUsersStatusWorker
MC_SERVER_IP=your-minecraft-server-address
# Minecraft server shown to players (IP/hostname and port)
MINECRAFT_SERVER_IP=play.your-domain.fun
MINECRAFT_SERVER_PORT=25565
# AuthMe (authentication plugin) API key on the Minecraft server
AUTHME_API_KEY=
# LuckPerms (permissions plugin) API key on the Minecraft server
LUCKPERMS_API_KEY=

# ===== Notification service (SMTP) =====
# Port used by the root Procfile (foreman) for notification-service; docker-compose ignores this (fixed to 3004)
MAILER_SERVICE_PORT=3003
# SMTP provider (read by docker-compose and passed to notification-service)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
# SMTP settings read directly by notification-service mailer config
SMTP_ADDRESS=smtp.example.com
SMTP_DOMAIN=example.com
SMTP_USERNAME=
# Public host used in outgoing mail links and the "From" address (noreply@APP_HOST)
APP_HOST=example.com
# Firebase Cloud Messaging (optional push notifications; leave empty to disable)
FCM_SERVER_KEY=
FCM_PROJECT_ID=pascalixs

# ===== Frontend =====
# Base URL of the web-portal API used by the React SPA (Vite dev: localhost:3000)
VITE_API_BASE_URL=http://localhost:3000
