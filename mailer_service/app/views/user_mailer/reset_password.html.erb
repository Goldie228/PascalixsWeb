<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Сброс пароля PascaLixs</title>
  <style>
    body, table, td, p, a {
      font-family: 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }
    
    body {
      background-color: #121212;
      color: #e0e0e0;
      margin: 0;
      padding: 0;
      text-align: center;
      height: 100% !important;
    }
    
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 30px 15px;
    }
    
    .card {
      background-color: #1A1A1A;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
      padding: 40px 30px;
      text-align: center;
    }
    
    .logo {
      font-size: 28px;
      font-weight: 700;
      color: #FFBF00;
      letter-spacing: 0.3px;
      margin-bottom: 5px;
    }
    
    .subtitle {
      color: #BBBBBB;
      font-size: 16px;
      margin-bottom: 30px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    
    .header {
      font-size: 24px;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: 0.3px;
      margin: 25px 0;
    }
    
    .message {
      font-size: 17px;
      line-height: 1.6;
      color: #e0e0e0;
      text-align: center;
      margin: 25px 0;
    }
    
    .confirmation-button {
      display: inline-block;
      background-color: #FFBF00;
      color: #1A1A1A !important;
      border-radius: 6px;
      padding: 14px 28px;
      margin: 30px 0;
      font-size: 18px;
      font-weight: 600;
      text-decoration: none;
      letter-spacing: 0.3px;
      transition: background-color 0.2s;
      border: 2px solid #FFBF00 !important;
    }
    
    .details-box {
      background-color: #2E2E2E;
      border-radius: 8px;
      padding: 20px;
      text-align: center;
      margin: 35px auto;
      max-width: 500px;
    }
    
    .detail-item {
      margin-bottom: 15px;
      padding-bottom: 15px;
      border-bottom: 1px solid #3A3A3A;
    }
    
    .detail-item:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }
    
    .detail-label {
      color: #BBBBBB;
      font-size: 14px;
      margin-bottom: 5px;
    }
    
    .detail-value {
      color: #FFFFFF;
      font-size: 16px;
      font-weight: 500;
    }
    
    .security-message {
      font-size: 16px;
      line-height: 1.5;
      color: #e0e0e0;
      background-color: #2A2A2A;
      padding: 15px;
      border-radius: 6px;
      text-align: center;
      max-width: 500px;
      margin: 25px auto;
    }
    
    .warning-text {
      color: #FFBF00;
      font-weight: 700;
    }
    
    .footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #333333;
      font-size: 14px;
      color: #999999;
      line-height: 1.5;
    }
    
    .manual-link {
      word-break: break-all;
      color: #FFBF00 !important;
      text-decoration: underline;
      font-size: 14px;
      margin-top: 20px;
      display: inline-block;
      font-weight: 500;
    }
    
    .lock-icon {
      width: 80px;
      height: 80px;
      margin: 0 auto 20px;
      background-color: #2A2A2A;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #FFBF00;
    }
    
    .lock-icon svg {
      width: 40px;
      height: 40px;
      fill: none;
      stroke: #FFBF00;
      stroke-width: 2;
    }

    /* Для лучшей поддержки в почтовых клиентах */
    @media screen and (max-width: 480px) {
      .card {
        padding: 30px 15px;
      }
      
      .header {
        font-size: 22px;
      }
      
      .message {
        font-size: 16px;
      }
      
      .confirmation-button {
        font-size: 16px;
        padding: 12px 24px;
      }
      
      .details-box {
        padding: 15px;
      }
      
      .lock-icon {
        width: 70px;
        height: 70px;
      }
    }
  </style>
</head>
<body style="background-color: #121212; color: #e0e0e0; margin: 0; padding: 0; text-align: center;">
  <center>
    <table border="0" cellpadding="0" cellspacing="0" width="100%" height="100%" style="background-color: #121212;">
      <tr>
        <td align="center" valign="top" style="padding: 20px 0;">
          <table class="container" border="0" cellpadding="0" cellspacing="0" width="600" style="background-color: #121212;">
            <tr>
              <td align="center" valign="top">
                <table class="card" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #1A1A1A; border-radius: 12px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2); padding: 40px 30px;">
                  <tr>
                    <td align="center" style="color: #e0e0e0;">
                      <div class="logo" style="font-size: 28px; font-weight: 700; color: #FFBF00; letter-spacing: 0.3px; margin-bottom: 5px;">PascaLixs</div>
                      <div class="subtitle" style="color: #BBBBBB; font-size: 16px; margin-bottom: 30px; text-transform: uppercase; letter-spacing: 1px;">
                        <%= t('password_reset.email.subtitle') %>
                      </div>
                      
                      <div class="header" style="font-size: 24px; font-weight: 700; color: #FFFFFF; letter-spacing: 0.3px; margin: 25px 0;">
                        <%= t('password_reset.email.header') %>
                      </div>
                      
                      <p class="message" style="font-size: 17px; line-height: 1.6; color: #e0e0e0; text-align: center; margin: 25px 0;">
                        <%= t('password_reset.email.message1') %>
                      </p>
                      <p class="message" style="font-size: 17px; line-height: 1.6; color: #e0e0e0; text-align: center; margin: 25px 0;">
                        <%= t('password_reset.email.message2') %>
                      </p>
                      
                      <a href="<%= @reset_url %>" class="confirmation-button" style="display: inline-block; background-color: #FFBF00; color: #1A1A1A !important; border-radius: 6px; padding: 14px 28px; margin: 30px 0; font-size: 18px; font-weight: 600; text-decoration: none; letter-spacing: 0.3px; border: 2px solid #FFBF00 !important;">
                        <%= t('password_reset.email.button_text') %>
                      </a>
                      
                      <table class="details-box" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #2E2E2E; border-radius: 8px; padding: 20px; text-align: center; margin: 35px auto; max-width: 500px;">
                        <tr>
                          <td align="center">
                            <div class="detail-item" style="margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #3A3A3A;">
                              <div class="detail-label" style="color: #BBBBBB; font-size: 14px; margin-bottom: 5px;">
                                <%= t('password_reset.email.nickname_label') %>
                              </div>
                              <div class="detail-value" style="color: #FFFFFF; font-size: 16px; font-weight: 500;"><%= @nickname %></div>
                            </div>

                            <div class="detail-item" style="margin-bottom: 15px; padding-bottom: 15px; border-bottom: none;">
                              <div class="detail-label" style="color: #BBBBBB; font-size: 14px; margin-bottom: 5px;">
                                <%= t('password_reset.email.request_time_label') %>
                              </div>
                              <div class="detail-value" style="color: #FFFFFF; font-size: 16px; font-weight: 500;"><%= Time.current.in_time_zone(@time_zone).strftime(t('email_change.date_format')) %></div>
                            </div>
                          </td>
                        </tr>
                      </table>
                      
                      <p class="message" style="font-size: 17px; line-height: 1.6; color: #e0e0e0; text-align: center; margin: 25px 0;">
                        <%= t('password_reset.email.manual_link_message') %>
                      </p>
                      <a href="<%= @reset_url %>" class="manual-link" style="word-break: break-all; color: #FFBF00 !important; text-decoration: underline; font-size: 14px; margin-top: 20px; display: inline-block; font-weight: 500;">
                        <%= @reset_url %>
                      </a>
                      
                      <div class="security-message" style="font-size: 16px; line-height: 1.5; color: #e0e0e0; background-color: #2A2A2A; padding: 15px; border-radius: 6px; text-align: center; max-width: 500px; margin: 25px auto;">
                        <p>
                          <span class="warning-text" style="color: #FFBF00; font-weight: 700;">
                            <%= t('password_reset.email.security_message.warning') %>
                          </span> 
                          <%= t('password_reset.email.security_message.part1') %>
                        </p>
                        <p><%= t('password_reset.email.security_message.part2') %></p>
                        <p style="margin-top: 10px;"><%= t('password_reset.email.security_message.part3') %></p>
                      </div>
                      
                      <div class="footer" style="margin-top: 40px; padding-top: 20px; border-top: 1px solid #333333; font-size: 14px; color: #999999; line-height: 1.5;">
                        <p><%= t('password_reset.email.footer.auto') %></p>
                        <p><%= t('password_reset.email.footer.copyright', year: Time.current.in_time_zone(@time_zone).year) %></p>
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </center>
</body>
</html>
